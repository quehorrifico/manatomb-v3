{{ define "card_detail_modal" }}
  <div id="card-detail-modal"
       class="mt-modal hidden"
       role="dialog"
       aria-modal="true"
       aria-labelledby="card-detail-modal-title">
    <div class="mt-modal-panel mt-card-detail-modal__panel" tabindex="-1">
      <button type="button"
              class="mt-card-detail-modal__close"
              data-close-modal
              aria-label="Close card details">
        <span aria-hidden="true">×</span>
      </button>

      <div class="mt-card-detail-modal__layout">
        <div class="mt-card-detail-modal__media">
          <img data-field="image"
               alt=""
               class="mt-card-detail-modal__image">
          <p data-field="image-fallback"
             class="mt-card-detail-modal__image-fallback hidden">Card image unavailable</p>
        </div>

        <div class="mt-card-detail-modal__content">
          <header class="mt-card-detail-modal__header">
            <div class="mt-card-detail-modal__title-row">
              <h3 id="card-detail-modal-title"
                  class="mt-card-detail-modal__title"
                  data-field="name"></h3>
              <span class="mt-card-detail-modal__mana"
                    data-field="mana-cost"
                    aria-label="Mana cost"></span>
            </div>
            <p class="mt-card-detail-modal__type" data-field="type-line"></p>
          </header>

          <div class="mt-card-detail-modal__oracle" data-field="oracle-text"></div>

          <dl class="mt-card-detail-modal__facts">
            <div>
              <dt>Price</dt>
              <dd data-field="price-usd">—</dd>
            </div>
            <div>
              <dt>Artist</dt>
              <dd data-field="artist">—</dd>
            </div>
          </dl>

          <div class="mt-card-detail-modal__printing">
            <div class="mt-card-detail-modal__printing-control" data-field="printing-group">
              <label for="card-detail-printing-select">Printing</label>
              <select id="card-detail-printing-select"
                      data-field="printing-select"
                      class="mt-control mt-control--sm">
                <option value="">Latest printing</option>
              </select>
            </div>
            <p data-field="printing-meta" class="mt-card-detail-modal__printing-meta hidden"></p>
          </div>

          <div class="mt-card-detail-modal__actions">
            <a data-field="open-page-link"
               class="hidden mt-btn mt-btn--secondary mt-btn--sm">
              View card page
            </a>
            <button type="button"
                    class="mt-btn mt-btn--secondary mt-btn--sm hidden"
                    data-flip-card>
              Flip card
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
{{ end }}
