{{ define "commander_search_card" }}
  <li class="mt-commander-browser-card" data-card-detail-root>
    <button
      type="button"
      class="mt-commander-browser-card__button"
      data-card-detail
      data-oracle-id="{{ .OracleID }}"
      data-scryfall-id="{{ .ScryfallID }}"
      data-name="{{ .Name }}"
      data-mana-cost="{{ .ManaCost }}"
      data-type-line="{{ .TypeLine }}"
      data-image-uri="{{ .ImageURI }}"
      data-price="{{ .PriceUSD }}"
      data-artist="{{ .Artist }}"
      data-set-code="{{ .SetCode }}"
      data-set-name="{{ .SetName }}"
      data-released-at="{{ .ReleasedAt }}"
      data-faces='{{ .FacesJSON }}'
      aria-label="View {{ .Name }} and choose a printing">
      <span class="mt-commander-browser-card__media">
        {{ if .ImageURI }}
          <img src="{{ .ImageURI }}"
               alt=""
               loading="lazy"
               decoding="async">
        {{ else }}
          <span class="mt-commander-browser-card__fallback">Image unavailable</span>
        {{ end }}
      </span>
      <span class="mt-commander-browser-card__copy">
        <strong>{{ .Name }}</strong>
        <span>{{ .TypeLine }}</span>
      </span>
    </button>
    <span class="hidden js-oracle-text">{{ .OracleText }}</span>
  </li>
{{ end }}

{{ define "commanders_search" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $clearSearchPath := print "/commanders/search?return_to=" (urlquery $ctx.ReturnTo) }}

  <div class="mt-commander-browser">
    <nav class="mt-commander-browser__return" aria-label="Return to deck">
      <a href="{{ $ctx.ReturnTo }}">← {{ $ctx.ReturnLabel }}</a>
    </nav>

    <header class="mt-commander-browser__heading">
      <h1>Choose a commander</h1>
      <p>Search by name or explore a recommendation. Open a card to choose its exact printing.</p>
    </header>

    <form method="GET" action="/commanders/search" class="mt-commander-browser__search" role="search">
      <input type="hidden" name="return_to" value="{{ $ctx.ReturnTo }}">
      <label for="commander-browser-search" class="sr-only">Search commanders by name</label>
      <div class="mt-commander-browser__search-field" data-card-autocomplete-root>
        <input
          id="commander-browser-search"
          type="search"
          name="q"
          value="{{ $ctx.Query }}"
          placeholder="Search commanders by name"
          class="mt-control"
          autocomplete="off"
          enterkeyhint="search"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="commander-browser-search-menu"
          aria-expanded="false"
          aria-haspopup="listbox"
          data-card-autocomplete-input
          data-card-autocomplete-commander-only="true">
        <div
          id="commander-browser-search-menu"
          data-card-autocomplete-menu
          class="mt-autocomplete-menu mt-commander-browser__search-menu hidden"
          role="listbox"></div>
      </div>
      <button type="submit" class="sr-only">Search commanders</button>
    </form>

    {{ if $ctx.Query }}
      <section class="mt-commander-browser__section" aria-labelledby="commander-browser-results-title">
        <div class="mt-commander-browser__section-heading">
          <div>
            <h2 id="commander-browser-results-title">Search results</h2>
            <p>{{ len $ctx.Results }} matching commander{{ if ne (len $ctx.Results) 1 }}s{{ end }}</p>
          </div>
          <a href="{{ $clearSearchPath }}">Clear search</a>
        </div>

        {{ if $ctx.Results }}
          <ul class="mt-commander-browser__grid">
            {{ range $ctx.Results }}
              {{ template "commander_search_card" . }}
            {{ end }}
          </ul>
        {{ else }}
          <div class="mt-commander-browser__empty">
            <p>No eligible commanders matched “{{ $ctx.Query }}”. Try a shorter or differently spelled name.</p>
          </div>
        {{ end }}
      </section>
    {{ end }}

    <section class="mt-commander-browser__section" aria-labelledby="commander-browser-recommended-title">
      <div class="mt-commander-browser__section-heading">
        <div>
          <h2 id="commander-browser-recommended-title">Recommended commanders</h2>
          <p>A fresh selection of popular eligible commanders.</p>
        </div>
      </div>

      {{ if $ctx.Recommended }}
        <ul class="mt-commander-browser__grid">
          {{ range $ctx.Recommended }}
            {{ template "commander_search_card" . }}
          {{ end }}
        </ul>
      {{ else }}
        <div class="mt-commander-browser__empty">
          <p>Recommendations are unavailable right now. You can still search by name.</p>
        </div>
      {{ end }}
    </section>

    <div id="card-detail-modal"
         class="mt-modal hidden"
         role="dialog"
         aria-modal="true"
         aria-labelledby="card-detail-modal-title">
      <div class="mt-modal-panel mt-card-detail-modal__panel" tabindex="-1">
        <button type="button"
                class="mt-card-detail-modal__close"
                data-close-modal
                aria-label="Close card details">
          <span aria-hidden="true">×</span>
        </button>

        <div class="mt-card-detail-modal__layout">
          <div class="mt-card-detail-modal__media">
            <img data-field="image"
                 alt=""
                 class="mt-card-detail-modal__image">
            <p data-field="image-fallback"
               class="mt-card-detail-modal__image-fallback hidden">Card image unavailable</p>
          </div>

          <div class="mt-card-detail-modal__content">
            <header class="mt-card-detail-modal__header">
              <div class="mt-card-detail-modal__title-row">
                <h3 id="card-detail-modal-title"
                    class="mt-card-detail-modal__title"
                    data-field="name"></h3>
                <span class="mt-card-detail-modal__mana"
                      data-field="mana-cost"
                      aria-label="Mana cost"></span>
              </div>
              <p class="mt-card-detail-modal__type" data-field="type-line"></p>
            </header>

            <div class="mt-card-detail-modal__oracle" data-field="oracle-text"></div>

            <dl class="mt-card-detail-modal__facts">
              <div>
                <dt>Price</dt>
                <dd data-field="price-usd">—</dd>
              </div>
              <div>
                <dt>Artist</dt>
                <dd data-field="artist">—</dd>
              </div>
            </dl>

            <div class="mt-card-detail-modal__printing">
              <div class="mt-card-detail-modal__printing-control" data-field="printing-group">
                <span class="mt-card-detail-modal__printing-label" data-field="printing-label">Printing</span>
                <div class="mt-card-detail-modal__printing-grid"
                     data-field="printing-grid"
                     role="listbox"
                     aria-label="Card printings"></div>
              </div>
              <p data-field="printing-meta" class="mt-card-detail-modal__printing-meta hidden"></p>
            </div>

            <div class="mt-card-detail-modal__actions">
              <a data-field="open-page-link"
                 class="hidden mt-btn mt-btn--secondary mt-btn--sm">
                View card page
              </a>
              <button type="button"
                      class="mt-btn mt-btn--secondary mt-btn--sm hidden"
                      data-flip-card>
                Flip card
              </button>
              <form method="POST" action="/decks/new/commander">
                <input type="hidden" name="commander_name" value="" data-field="sticky-name-input">
                <input type="hidden" name="commander_print_id" value="" data-field="sticky-print-input">
                <input type="hidden" name="return_to" value="{{ $ctx.ReturnTo }}">
                <button type="submit" class="mt-btn mt-btn--primary mt-btn--sm">
                  Select Commander
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    {{ template "card_detail_modal_script" . }}
  </div>

  {{ template "layout_footer" . }}
{{ end }}
