{{ define "deck_show_cards_view_script" }}
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var isGuest = {{ if .Data.WorkbenchMode }}true{{ else if .CurrentUser }}false{{ else }}true{{ end }};
    var sourceList = document.getElementById('signed-deck-cards-source') || document.getElementById('guest-deck-cards');
    var guestEmpty = document.getElementById('guest-deck-cards-empty');
    var signedDeckEmpty = document.getElementById('signed-deck-cards-empty');
    var signedDeckCountLabel = document.getElementById('signed-deck-count-label');
    var signedMaybeList = document.getElementById('signed-maybeboard-cards');
    var signedMaybeEmpty = document.getElementById('signed-maybeboard-empty');
    var signedMaybeCountLabel = document.getElementById('signed-maybeboard-count-label');
    var viewRoot = document.getElementById('signed-deck-cards-view');
    var groupSelect = document.getElementById('signed-group-mode');
    var sortSelect = document.getElementById('signed-sort-mode');
    var sortDirectionSelect = document.getElementById('signed-sort-direction');
    var layoutSelect = document.getElementById('signed-layout-mode');
    var previewApi = window.mtDeckCardPreview || null;
    var prefKey = 'manatomb.deckViewPrefs';
    var deckID = {{ .Data.Deck.ID }};
    var signedMutationBusy = false;
    var actionPath = '/decks/' + String(deckID);
    var lastSubmitter = null;
    var miniActionClass = 'mt-btn mt-btn--secondary mt-btn--xs';
    var microActionClass = 'mt-btn mt-btn--secondary mt-btn--micro';

    if (!sourceList || !viewRoot || !groupSelect || !sortSelect || !sortDirectionSelect || !layoutSelect) return;

    function toInt(v, fallback) {
      var n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return Math.floor(n);
    }

    function toFloat(v, fallback) {
      var n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return n;
    }

    function normalize(s) {
      return String(s || '').replace(/\s+/g, ' ').trim();
    }

    function loadPrefs() {
      try {
        var raw = localStorage.getItem(prefKey);
        if (!raw) return {};
        var obj = JSON.parse(raw);
        if (!obj || typeof obj !== 'object') return {};
        return obj;
      } catch (e) {
        return {};
      }
    }

    function savePrefs(obj) {
      try {
        localStorage.setItem(prefKey, JSON.stringify(obj));
      } catch (e) {
        // ignore
      }
    }

    function syncHTMLFromDoc(doc, id) {
      if (!doc || !id) return;
      var current = document.getElementById(id);
      var fresh = doc.getElementById(id);
      if (!current || !fresh) return;
      current.innerHTML = fresh.innerHTML;
      current.className = fresh.className;
    }

    function syncSignedStateFromDoc(doc) {
      if (isGuest || !doc) return;

      var nextSource = doc.getElementById('signed-deck-cards-source');
      if (nextSource && sourceList) {
        sourceList.innerHTML = nextSource.innerHTML;
      }

      var nextDeckEmpty = doc.getElementById('signed-deck-cards-empty');
      if (nextDeckEmpty && signedDeckEmpty) {
        signedDeckEmpty.textContent = nextDeckEmpty.textContent;
        signedDeckEmpty.classList.toggle('hidden', nextDeckEmpty.classList.contains('hidden'));
      }

      var nextDeckCount = doc.getElementById('signed-deck-count-label');
      if (nextDeckCount && signedDeckCountLabel) {
        signedDeckCountLabel.textContent = nextDeckCount.textContent;
      }

      var nextMaybeList = doc.getElementById('signed-maybeboard-cards');
      if (nextMaybeList && signedMaybeList) {
        signedMaybeList.innerHTML = nextMaybeList.innerHTML;
        signedMaybeList.classList.toggle('hidden', nextMaybeList.classList.contains('hidden'));
      }

      var nextMaybeEmpty = doc.getElementById('signed-maybeboard-empty');
      if (nextMaybeEmpty && signedMaybeEmpty) {
        signedMaybeEmpty.textContent = nextMaybeEmpty.textContent;
        signedMaybeEmpty.classList.toggle('hidden', nextMaybeEmpty.classList.contains('hidden'));
      }

      var nextMaybeCount = doc.getElementById('signed-maybeboard-count-label');
      if (nextMaybeCount && signedMaybeCountLabel) {
        signedMaybeCountLabel.textContent = nextMaybeCount.textContent;
      }

      var metricNodes = document.querySelectorAll('[id^="deck-analytics-"]');
      for (var i = 0; i < metricNodes.length; i++) {
        var cur = metricNodes[i];
        if (!cur || !cur.id) continue;
        if (cur.id === 'deck-analytics-extras') continue;
        if (cur.id === 'deck-analytics-example-hand') continue;
        if (cur.id === 'deck-analytics-example-hand-empty') continue;
        var fresh = doc.getElementById(cur.id);
        if (!fresh) continue;
        cur.textContent = fresh.textContent;
      }

      syncHTMLFromDoc(doc, 'deck-guide-checks');
      syncHTMLFromDoc(doc, 'deck-guide-warnings-panel');
      syncHTMLFromDoc(doc, 'deck-analytics-extras');
      if (window.mtDeckRenderExtrasFromDOM) window.mtDeckRenderExtrasFromDOM();

      if (window.mtDeckSyncManaCurveBars) window.mtDeckSyncManaCurveBars();
    }

    function formPayload(form, submitter) {
      var body = new URLSearchParams();
      if (!form) return body;
      var formData = new FormData(form);
      if (submitter && submitter.name && !formData.has(submitter.name)) {
        formData.append(submitter.name, submitter.value || '');
      }
      formData.forEach(function (value, key) {
        body.append(key, String(value));
      });
      if (submitter && submitter.name && !body.has(submitter.name)) {
        body.append(submitter.name, submitter.value || '');
      }
      return body;
    }

    function fieldsPayload(fields) {
      var body = new URLSearchParams();
      if (!fields || typeof fields !== 'object') return body;
      var keys = Object.keys(fields);
      for (var i = 0; i < keys.length; i++) {
        var key = keys[i];
        var value = fields[key];
        if (value === undefined || value === null) continue;
        body.append(key, String(value));
      }
      return body;
    }

    async function submitSignedDeckMutationRequest(url, body, submitter) {
      if (isGuest) return;
      if (signedMutationBusy) return;
      signedMutationBusy = true;

      var disabledBefore = false;
      if (submitter) {
        disabledBefore = !!submitter.disabled;
        submitter.disabled = true;
      }

      try {
        var res = await fetch(url || actionPath, {
          method: 'POST',
          body: body.toString(),
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
          },
          credentials: 'same-origin',
        });
        if (!res.ok) throw new Error('request failed');
        var html = await res.text();
        var parsed = (new DOMParser()).parseFromString(html, 'text/html');
        if (!parsed.getElementById('signed-deck-cards-source')) {
          window.location.reload();
          return;
        }

        syncSignedStateFromDoc(parsed);
        cards = readCardsFromSource();
        renderDeckCards();
      } catch (e) {
        window.location.reload();
      } finally {
        if (submitter) submitter.disabled = disabledBefore;
        signedMutationBusy = false;
      }
    }

    async function submitSignedDeckMutation(form, submitter) {
      if (isGuest || !form) return;
      await submitSignedDeckMutationRequest(
        form.action || actionPath,
        formPayload(form, submitter),
        submitter
      );
    }

    async function submitSignedDeckFieldMutation(fields, submitter) {
      if (isGuest) return;
      await submitSignedDeckMutationRequest(
        actionPath,
        fieldsPayload(fields),
        submitter
      );
    }

    function bindPreview(node, card) {
      if (!node || !previewApi) return;
      var needsGuestFetch = isGuest && !normalize(card.imageURI || '') && typeof window.mtDeckGuestShowCardPreview === 'function';
      if (previewApi.tapMode && previewApi.toggle) {
        node.addEventListener('click', function (event) {
          if (event.target && event.target.closest) {
            if (event.target.closest('button, a, input, select, textarea, form')) return;
          }
          if (needsGuestFetch) {
            window.mtDeckGuestShowCardPreview(card.name || '', event, node);
            return;
          }
          previewApi.toggle(card.imageURI || '', card.name || '', event, node);
        });
      } else {
        node.addEventListener('mouseenter', function (event) {
          if (previewApi.move) previewApi.move(event);
          if (needsGuestFetch) {
            window.mtDeckGuestShowCardPreview(card.name || '', event, node);
            return;
          }
          previewApi.show(card.imageURI || '', card.name || '');
        });
        node.addEventListener('mousemove', function (event) {
          if (previewApi.move) previewApi.move(event);
        });
        node.addEventListener('mouseleave', function () {
          previewApi.hide();
        });
      }
    }

    function readCardsFromSource() {
      var out = [];
      if (!sourceList) return out;

      var nodes = sourceList.querySelectorAll('li[data-card-name]');
      for (var i = 0; i < nodes.length; i++) {
        var node = nodes[i];
        var name = normalize(node.getAttribute('data-card-name'));
        var qty = toInt(node.getAttribute('data-card-qty'), 0);
        if (!name || !Number.isFinite(qty) || qty <= 0) continue;

        out.push({
          cardID: normalize(node.getAttribute('data-card-id')),
          name: name,
          qty: qty,
          typeLine: normalize(node.getAttribute('data-card-type-line')),
          oracleText: normalize(node.getAttribute('data-card-oracle-text')),
          cmc: toFloat(node.getAttribute('data-card-cmc'), 0),
          priceUSD: normalize(node.getAttribute('data-card-price')),
          imageURI: normalize(node.getAttribute('data-card-image-uri')),
        });
      }
      return out;
    }

    var cards = [];

    function typeBucket(card) {
      var t = String(card.typeLine || '').toLowerCase();
      if (t.indexOf('land') >= 0) return 'Lands';
      if (t.indexOf('creature') >= 0) return 'Creatures';
      if (t.indexOf('artifact') >= 0) return 'Artifacts';
      if (t.indexOf('enchantment') >= 0) return 'Enchantments';
      if (t.indexOf('instant') >= 0) return 'Instants';
      if (t.indexOf('sorcery') >= 0) return 'Sorceries';
      if (t.indexOf('planeswalker') >= 0) return 'Planeswalkers';
      if (t.indexOf('battle') >= 0) return 'Battles';
      return 'Other';
    }

    function cmcBucket(card) {
      var t = String(card.typeLine || '').toLowerCase();
      if (t.indexOf('land') >= 0) return 'Lands';
      var cmc = toInt(Math.floor(Number(card.cmc || 0)), 0);
      if (cmc < 0) return '0';
      return String(cmc);
    }

    function categoryBucket(card) {
      var t = String(card.typeLine || '').toLowerCase();
      var o = String(card.oracleText || '').toLowerCase();

      if (t.indexOf('land') >= 0) return 'Lands';
      if (/\bpopulate\b/.test(o)) return 'Populate';
      if (/players can\'t|can\'t cast|spells cost \{[0-9xwubrgc\/]+\} more|skip (their|your) (untap|draw|combat) step|don\'t untap during|enters tapped/.test(o)) return 'Stax';
      if (/mill(s|ed)? |put the top .* cards? of .* library into .* graveyard/.test(o)) return 'Mill';
      if (/search your library for (a|an|up to .*?) card/.test(o)) return 'Tutor';
      if (/search your library for (a|up to .*?) land|add \{[wubrgc]\}|treasure token|mana of any color/.test(o)) return 'Ramp';
      if (/draw (a|two|three|x) card|draw cards|whenever .* draw/.test(o)) return 'Draw';
      if (/from your graveyard to your hand|return .* from your graveyard|cast .* from your graveyard|reanimate|return target .* card from your graveyard/.test(o)) return 'Recursion';
      if (/hexproof|indestructible|protection from|ward \{/.test(o)) return 'Protection';
      if (/destroy all|exile all|all creatures|gets -\d\/-\d/.test(o)) return 'Board Wipes';
      if (/counter target/.test(o)) return 'Countermagic';
      if (/destroy target|exile target|return target .* to.* hand|fight target/.test(o)) return 'Removal';
      if (/create .* token/.test(o)) return 'Token Makers';
      if (/you win the game|each opponent loses the game|an opponent loses the game/.test(o)) return 'Win Conditions';
      return 'Utility';
    }

    function normalizePrice(price) {
      var n = Number(String(price || '').replace(/[^0-9.]/g, ''));
      if (!Number.isFinite(n) || n < 0) return null;
      return n;
    }

    function cardComparator(sortMode, sortDirection) {
      var dir = sortDirection === 'desc' ? -1 : 1;

      function cmpByName(a, b) {
        return String(a.name || '').localeCompare(String(b.name || ''));
      }

      return function (a, b) {
        var cmp = 0;
        if (sortMode === 'cmc') {
          var aCMC = Number(a.cmc || 0);
          var bCMC = Number(b.cmc || 0);
          cmp = aCMC - bCMC;
          if (cmp === 0) cmp = cmpByName(a, b);
        } else if (sortMode === 'type') {
          cmp = String(a.typeLine || '').localeCompare(String(b.typeLine || ''));
          if (cmp === 0) cmp = cmpByName(a, b);
        } else if (sortMode === 'price') {
          var aPrice = normalizePrice(a.priceUSD);
          var bPrice = normalizePrice(b.priceUSD);
          if (aPrice === null && bPrice === null) {
            cmp = cmpByName(a, b);
          } else if (aPrice === null) {
            cmp = 1;
          } else if (bPrice === null) {
            cmp = -1;
          } else {
            cmp = aPrice - bPrice;
            if (cmp === 0) cmp = cmpByName(a, b);
          }
        } else {
          cmp = cmpByName(a, b);
        }

        return cmp * dir;
      };
    }

    function groupedCards(groupMode, sortMode, sortDirection) {
      var groups = {};
      var order = [];
      var compareCards = cardComparator(sortMode, sortDirection);

      function ensureGroup(name) {
        if (!groups[name]) {
          groups[name] = [];
          order.push(name);
        }
      }

      for (var i = 0; i < cards.length; i++) {
        var card = cards[i];
        var name = 'All Cards';
        if (groupMode === 'type') {
          name = typeBucket(card);
        } else if (groupMode === 'cmc') {
          name = cmcBucket(card);
        } else if (groupMode === 'category') {
          name = categoryBucket(card);
        }
        ensureGroup(name);
        groups[name].push(card);
      }

      var ordered = [];
      var preferred = [];
      if (groupMode === 'type') {
        preferred = ['Lands', 'Creatures', 'Artifacts', 'Enchantments', 'Instants', 'Sorceries', 'Planeswalkers', 'Battles', 'Other'];
      } else if (groupMode === 'category') {
        preferred = ['Lands', 'Stax', 'Populate', 'Mill', 'Tutor', 'Ramp', 'Draw', 'Recursion', 'Protection', 'Board Wipes', 'Countermagic', 'Removal', 'Token Makers', 'Win Conditions', 'Utility'];
      }

      if (groupMode === 'cmc') {
        if (groups['Lands']) {
          ordered.push({ name: 'Lands', cards: groups['Lands'] });
          delete groups['Lands'];
        }

        var numericKeys = [];
        var otherKeys = [];
        var cmcKeys = Object.keys(groups);
        for (var ck = 0; ck < cmcKeys.length; ck++) {
          var key = cmcKeys[ck];
          if (/^\d+$/.test(key)) {
            numericKeys.push(key);
          } else {
            otherKeys.push(key);
          }
        }
        numericKeys.sort(function (a, b) { return Number(a) - Number(b); });
        otherKeys.sort(function (a, b) { return a.localeCompare(b); });

        var orderedKeys = numericKeys.concat(otherKeys);
        for (var ok = 0; ok < orderedKeys.length; ok++) {
          var cmcGroup = orderedKeys[ok];
          ordered.push({ name: cmcGroup, cards: groups[cmcGroup] });
        }
        for (var ci = 0; ci < ordered.length; ci++) {
          ordered[ci].cards = ordered[ci].cards.slice().sort(compareCards);
        }
        return ordered;
      }

      if (preferred.length > 0) {
        for (var p = 0; p < preferred.length; p++) {
          var groupName = preferred[p];
          if (groups[groupName]) {
            ordered.push({ name: groupName, cards: groups[groupName] });
            delete groups[groupName];
          }
        }
        var rest = Object.keys(groups).sort(function (a, b) { return a.localeCompare(b); });
        for (var r = 0; r < rest.length; r++) {
          ordered.push({ name: rest[r], cards: groups[rest[r]] });
        }
        for (var oi = 0; oi < ordered.length; oi++) {
          ordered[oi].cards = ordered[oi].cards.slice().sort(compareCards);
        }
        return ordered;
      }

      for (var j = 0; j < order.length; j++) {
        ordered.push({ name: order[j], cards: groups[order[j]] });
      }
      for (var k = 0; k < ordered.length; k++) {
        ordered[k].cards = ordered[k].cards.slice().sort(compareCards);
      }
      return ordered;
    }

    function signedMutationButton(fields, className, label) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = className;
      button.textContent = label;
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        submitSignedDeckFieldMutation(fields, button);
      });
      return button;
    }

    function adjustGuestCard(cardName, delta) {
      if (!isGuest) return;
      if (typeof window.mtDeckGuestAdjustCard !== 'function') return;
      window.mtDeckGuestAdjustCard(cardName, delta);
    }

    function moveGuestCardToMaybe(cardName) {
      if (!isGuest) return;
      if (typeof window.mtDeckGuestMoveCardToMaybe !== 'function') return;
      window.mtDeckGuestMoveCardToMaybe(cardName);
    }

    function guestAdjustButton(cardName, delta, className, label) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = className;
      button.textContent = label;
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        adjustGuestCard(cardName, delta);
      });
      return button;
    }

    function guestMoveButton(cardName, className, label) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = className;
      button.textContent = label;
      button.setAttribute('data-card-name', cardName || '');
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        var target = event.currentTarget;
        if (!target || !target.getAttribute) return;
        moveGuestCardToMaybe(target.getAttribute('data-card-name') || '');
      });
      return button;
    }

    function sectionCardTotal(section) {
      var total = 0;
      for (var i = 0; i < section.cards.length; i++) total += section.cards[i].qty;
      return total;
    }

    function renderListSection(section, root) {
      var box = document.createElement('section');
      box.className = 'mt-collection-panel p-0';

      var head = document.createElement('div');
      head.className = 'mt-collection-panel__head px-3 py-2';
      var title = document.createElement('p');
      title.className = 'text-base font-semibold uppercase tracking-wide text-slate-300';
      title.textContent = section.name;
      var count = document.createElement('p');
      count.className = 'text-[11px] text-slate-500';
      count.textContent = String(sectionCardTotal(section)) + ' cards';
      head.appendChild(title);
      head.appendChild(count);
      box.appendChild(head);

      var list = document.createElement('ul');
      list.className = 'divide-y divide-slate-800 text-sm';

      for (var i = 0; i < section.cards.length; i++) {
        var card = section.cards[i];
        var row = document.createElement('li');
        row.className = 'mt-list-row px-3';
        bindPreview(row, card);

        var left = document.createElement('div');
        var p = document.createElement('p');
        p.className = 'mt-list-row__title';
        p.textContent = String(card.qty) + 'x ' + card.name;
        left.appendChild(p);

        row.appendChild(left);
        var actions = document.createElement('div');
        actions.className = 'mt-list-row__actions';
        if (isGuest) {
          actions.appendChild(guestMoveButton(card.name, miniActionClass, 'Maybe'));
          actions.appendChild(guestAdjustButton(card.name, -1, miniActionClass, '−'));
          actions.appendChild(guestAdjustButton(card.name, 1, miniActionClass, '+'));
        } else {
          actions.appendChild(signedMutationButton({ action: 'to_maybe', card_id: card.cardID }, miniActionClass, 'Maybe'));
          actions.appendChild(signedMutationButton({ action: 'inc_main', card_id: card.cardID }, miniActionClass, '+'));
          actions.appendChild(signedMutationButton({ card_id: card.cardID }, miniActionClass, '−'));
        }
        row.appendChild(actions);
        list.appendChild(row);
      }

      box.appendChild(list);
      root.appendChild(box);
    }

    function displayPrice(card) {
      var price = normalizePrice(card.priceUSD);
      if (price === null) return '—';
      return '$' + price.toFixed(2);
    }

    function renderCombinedTable(sections, root) {
      var box = document.createElement('section');
      box.className = 'mt-collection-panel p-0 overflow-hidden';
      var wrap = document.createElement('div');
      wrap.className = 'overflow-x-auto';
      var table = document.createElement('table');
      table.className = 'min-w-full text-xs';

      var thead = document.createElement('thead');
      thead.className = 'bg-slate-900/70 text-slate-400 uppercase tracking-wide';
      var trHead = document.createElement('tr');
      var headCols = ['Qty', 'Card', 'MV', 'Type', 'Price', ''];
      for (var h = 0; h < headCols.length; h++) {
        var th = document.createElement('th');
        th.className = h === headCols.length - 1
          ? 'px-3 py-2 text-right'
          : 'px-3 py-2 text-left';
        th.textContent = headCols[h];
        trHead.appendChild(th);
      }
      thead.appendChild(trHead);
      table.appendChild(thead);

      var tbody = document.createElement('tbody');
      var showGroupHeaders = sections.length > 1 || (groupSelect && groupSelect.value !== 'none');
      for (var s = 0; s < sections.length; s++) {
        var section = sections[s];

        if (showGroupHeaders) {
          var groupRow = document.createElement('tr');
          groupRow.className = 'border-t border-slate-700';
          var groupCell = document.createElement('td');
          groupCell.colSpan = 6;
          groupCell.className = 'px-3 py-2 bg-slate-900/70 text-base font-semibold uppercase tracking-wide text-slate-300';
          groupCell.textContent = section.name + ' (' + String(sectionCardTotal(section)) + ')';
          groupRow.appendChild(groupCell);
          tbody.appendChild(groupRow);
        }

        for (var i = 0; i < section.cards.length; i++) {
          var card = section.cards[i];
          var row = document.createElement('tr');
          row.className = 'border-t border-slate-800 hover:bg-slate-900/40 transition-colors';
          bindPreview(row, card);

          var qtyCell = document.createElement('td');
          qtyCell.className = 'px-3 py-2 text-slate-300';
          qtyCell.textContent = String(card.qty);
          row.appendChild(qtyCell);

          var nameCell = document.createElement('td');
          nameCell.className = 'px-3 py-2 text-slate-100 font-medium';
          nameCell.textContent = card.name;
          row.appendChild(nameCell);

          var cmcCell = document.createElement('td');
          cmcCell.className = 'px-3 py-2 text-slate-300';
          var cmc = Number(card.cmc || 0);
          cmcCell.textContent = String(Number.isFinite(cmc) ? Math.round(cmc * 100) / 100 : 0);
          row.appendChild(cmcCell);

          var typeCell = document.createElement('td');
          typeCell.className = 'px-3 py-2 text-slate-300 whitespace-nowrap';
          typeCell.textContent = card.typeLine || '—';
          row.appendChild(typeCell);

          var priceCell = document.createElement('td');
          priceCell.className = 'px-3 py-2 text-slate-300 whitespace-nowrap';
          priceCell.textContent = displayPrice(card);
          row.appendChild(priceCell);

          var actionCell = document.createElement('td');
          actionCell.className = 'px-3 py-2 text-right';
          var actions = document.createElement('div');
          actions.className = 'mt-list-row__actions justify-end';
          if (isGuest) {
            actions.appendChild(guestMoveButton(card.name, miniActionClass, 'Maybe'));
            actions.appendChild(guestAdjustButton(card.name, -1, miniActionClass, '−'));
            actions.appendChild(guestAdjustButton(card.name, 1, miniActionClass, '+'));
          } else {
            actions.appendChild(signedMutationButton({ action: 'to_maybe', card_id: card.cardID }, miniActionClass, 'Maybe'));
            actions.appendChild(signedMutationButton({ action: 'inc_main', card_id: card.cardID }, miniActionClass, '+'));
            actions.appendChild(signedMutationButton({ card_id: card.cardID }, miniActionClass, '−'));
          }
          actionCell.appendChild(actions);
          row.appendChild(actionCell);

          tbody.appendChild(row);
        }

        // Spacer line between groups while keeping one aligned table.
        if (s < sections.length - 1) {
          var spacerRow = document.createElement('tr');
          var spacerCell = document.createElement('td');
          spacerCell.colSpan = 6;
          spacerCell.className = 'h-2 bg-slate-950';
          spacerRow.appendChild(spacerCell);
          tbody.appendChild(spacerRow);
        }
      }
      table.appendChild(tbody);
      wrap.appendChild(table);
      box.appendChild(wrap);
      root.appendChild(box);
    }

    function artGridCardNode(card) {
      var wrap = document.createElement('article');
      wrap.className = 'mt-art-card mt-art-card--grid';
      bindPreview(wrap, card);

      if (card.imageURI) {
        var img = document.createElement('img');
        img.src = card.imageURI;
        img.alt = card.name;
        img.className = 'w-full h-auto block';
        wrap.appendChild(img);
      } else {
        var fallback = document.createElement('div');
        fallback.className = 'mt-art-card__fallback h-[174px]';
        fallback.textContent = card.name;
        wrap.appendChild(fallback);
      }

      var qty = document.createElement('span');
      qty.className = 'mt-art-card__badge';
      qty.textContent = String(card.qty) + 'x';
      wrap.appendChild(qty);

      var foot = document.createElement('div');
      foot.className = 'mt-art-card__toolbar';

      if (isGuest) {
        foot.appendChild(guestMoveButton(card.name, microActionClass, 'Mb'));
        foot.appendChild(guestAdjustButton(card.name, -1, microActionClass, '−'));
        foot.appendChild(guestAdjustButton(card.name, 1, microActionClass, '+'));
      } else {
        foot.appendChild(signedMutationButton({ action: 'to_maybe', card_id: card.cardID }, microActionClass, 'Mb'));
        foot.appendChild(signedMutationButton({ action: 'inc_main', card_id: card.cardID }, microActionClass, '+'));
        foot.appendChild(signedMutationButton({ card_id: card.cardID }, microActionClass, '−'));
      }
      wrap.appendChild(foot);
      return wrap;
    }

    function renderGridSection(section, root) {
      var box = document.createElement('section');
      box.className = 'mt-collection-panel space-y-2';
      var head = document.createElement('div');
      head.className = 'mt-collection-panel__head px-1';
      var title = document.createElement('p');
      title.className = 'text-base font-semibold uppercase tracking-wide text-slate-300';
      title.textContent = section.name;
      var count = document.createElement('p');
      count.className = 'text-[11px] text-slate-500';
      count.textContent = String(sectionCardTotal(section)) + ' cards';
      head.appendChild(title);
      head.appendChild(count);
      box.appendChild(head);
      var container = document.createElement('div');
      container.className = 'grid grid-cols-2 sm:grid-cols-3 gap-2';

      for (var i = 0; i < section.cards.length; i++) {
        var node = artGridCardNode(section.cards[i]);
        container.appendChild(node);
      }

      box.appendChild(container);
      root.appendChild(box);
    }

    function stackCardNode(card) {
      var wrap = document.createElement('article');
      wrap.className = 'mt-art-card mt-art-card--stack';
      bindPreview(wrap, card);

      if (card.imageURI) {
        var img = document.createElement('img');
        img.src = card.imageURI;
        img.alt = card.name;
        img.className = 'w-full h-full object-cover block';
        wrap.appendChild(img);
      } else {
        var fallback = document.createElement('div');
        fallback.className = 'mt-art-card__fallback w-full h-full';
        fallback.textContent = card.name;
        wrap.appendChild(fallback);
      }

      var topStrip = document.createElement('div');
      topStrip.className = 'mt-art-card__toolbar mt-art-card__toolbar--top';

      var name = document.createElement('p');
      name.className = 'mt-art-card__title';
      name.title = card.name;
      name.textContent = String(card.qty) + 'x ' + card.name;
      topStrip.appendChild(name);

      if (isGuest) {
        topStrip.appendChild(guestMoveButton(card.name, microActionClass, 'Mb'));
        topStrip.appendChild(guestAdjustButton(card.name, -1, microActionClass, '−'));
        topStrip.appendChild(guestAdjustButton(card.name, 1, microActionClass, '+'));
      } else {
        topStrip.appendChild(signedMutationButton({ action: 'to_maybe', card_id: card.cardID }, microActionClass, 'Mb'));
        topStrip.appendChild(signedMutationButton({ action: 'inc_main', card_id: card.cardID }, microActionClass, '+'));
        topStrip.appendChild(signedMutationButton({ card_id: card.cardID }, microActionClass, '−'));
      }

      wrap.appendChild(topStrip);
      return wrap;
    }

    function renderStacksSection(section, root) {
      var box = document.createElement('section');
      box.className = 'mt-collection-panel mt-collection-panel--compact space-y-1 w-[170px]';
      var head = document.createElement('div');
      head.className = 'mt-collection-panel__head px-0.5 pb-1';
      var title = document.createElement('p');
      title.className = 'text-base font-semibold uppercase tracking-wide text-slate-300';
      title.textContent = section.name;
      var count = document.createElement('p');
      count.className = 'text-[11px] text-slate-500';
      count.textContent = String(sectionCardTotal(section)) + ' cards';
      head.appendChild(title);
      head.appendChild(count);
      box.appendChild(head);

      var pile = document.createElement('div');
      pile.className = 'relative w-full';
      var peek = 24;
      var cardHeight = 224;
      pile.style.height = String(cardHeight + Math.max(0, section.cards.length - 1) * peek) + 'px';

      for (var i = 0; i < section.cards.length; i++) {
        var node = stackCardNode(section.cards[i]);
        node.style.position = 'absolute';
        node.style.left = '0';
        node.style.top = String(i * peek) + 'px';
        node.style.zIndex = String(i + 1);
        pile.appendChild(node);
      }

      box.appendChild(pile);
      root.appendChild(box);
    }

    function renderDeckCards() {
      var groupMode = groupSelect.value || 'none';
      var sortMode = sortSelect.value || 'name';
      var sortDirection = sortDirectionSelect.value || 'asc';
      var layoutMode = layoutSelect.value || 'text';
      var sections = groupedCards(groupMode, sortMode, sortDirection);

      // Grouped sections get packed into columns so multiple groups can be seen
      // side-by-side instead of each taking a full row.
      if (groupMode === 'none') {
        viewRoot.className = 'space-y-3';
      } else if (layoutMode === 'text') {
        viewRoot.className = 'grid gap-3 md:grid-cols-2 xl:grid-cols-3 items-start';
      } else if (layoutMode === 'table') {
        viewRoot.className = 'space-y-3';
      } else if (layoutMode === 'art_stacked') {
        viewRoot.className = 'flex flex-wrap items-start gap-1.5';
      } else {
        viewRoot.className = 'grid gap-4 md:grid-cols-2 xl:grid-cols-3 items-start';
      }

      viewRoot.innerHTML = '';
      if (sections.length === 0) {
        var empty = document.createElement('p');
        empty.className = 'text-sm text-slate-400';
        empty.textContent = 'No cards.';
        viewRoot.appendChild(empty);
        return;
      }

      if (layoutMode === 'table') {
        renderCombinedTable(sections, viewRoot);
      } else {
        for (var i = 0; i < sections.length; i++) {
          if (layoutMode === 'art_stacked') {
            renderStacksSection(sections[i], viewRoot);
          } else if (layoutMode === 'art_grid') {
            renderGridSection(sections[i], viewRoot);
          } else {
            renderListSection(sections[i], viewRoot);
          }
        }
      }
    }

    var prefs = loadPrefs();
    if (prefs.groupMode) groupSelect.value = prefs.groupMode;
    if (prefs.sortMode) sortSelect.value = prefs.sortMode;
    if (prefs.sortDirection) sortDirectionSelect.value = prefs.sortDirection;
    if (prefs.layoutMode === 'list') prefs.layoutMode = 'text';
    if (prefs.layoutMode) layoutSelect.value = prefs.layoutMode;

    function persistAndRender() {
      savePrefs({
        groupMode: groupSelect.value,
        sortMode: sortSelect.value,
        sortDirection: sortDirectionSelect.value,
        layoutMode: layoutSelect.value,
      });
      cards = readCardsFromSource();
      renderDeckCards();
    }

    groupSelect.addEventListener('change', persistAndRender);
    sortSelect.addEventListener('change', persistAndRender);
    sortDirectionSelect.addEventListener('change', persistAndRender);
    layoutSelect.addEventListener('change', persistAndRender);

    if (!isGuest) {
      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) return;
        var submitEl = target.closest('button[type="submit"], input[type="submit"]');
        if (!submitEl) return;
        lastSubmitter = submitEl;
      }, true);

      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || !form.getAttribute) return;
        var rawAction = form.getAttribute('action') || form.action || '';
        if (!rawAction) return;
        var path = '';
        try {
          path = (new URL(rawAction, window.location.origin)).pathname;
        } catch (e) {
          path = normalize(rawAction);
        }
        if (path !== actionPath) return;

        event.preventDefault();
        var submitter = event.submitter || null;
        if (!submitter && lastSubmitter && lastSubmitter.form === form) {
          submitter = lastSubmitter;
        }
        submitSignedDeckMutation(form, submitter);
      }, true);
    }

    if (isGuest) {
      document.addEventListener('mtDeckGuestDraftRendered', function () {
        cards = readCardsFromSource();
        renderDeckCards();
      });
    }

    sourceList.classList.add('hidden');
    if (guestEmpty) guestEmpty.classList.add('hidden');
    viewRoot.classList.remove('hidden');
    persistAndRender();
  });
  </script>
{{ end }}
