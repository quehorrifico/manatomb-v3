{{ define "saved_deck_picker" }}
  {{ $ctx := .Data }}
  {{ if .CurrentUser }}
    <div id="saved-deck-picker-modal"
         class="mt-modal mt-saved-deck-picker-modal hidden"
         data-saved-deck-picker-modal
         role="dialog"
         aria-modal="true"
         aria-labelledby="saved-deck-picker-title"
         aria-describedby="saved-deck-picker-description">
      <div class="mt-modal-panel mt-saved-deck-picker" tabindex="-1">
        <button type="button" class="mt-saved-deck-picker__close" data-close-deck-picker aria-label="Close saved deck picker">&times;</button>

        <header class="mt-saved-deck-picker__header">
          <h3 id="saved-deck-picker-title" data-deck-picker-card-name>Select a deck</h3>
          <p id="saved-deck-picker-description">Add this card to the mainboard of one of your saved decks.</p>
        </header>

        <label class="mt-saved-deck-picker__search">
          <span class="mt-field-label">Find a deck</span>
          <input type="search"
                 class="mt-control"
                 placeholder="Deck name, commander, or format"
                 autocomplete="off"
                 data-deck-picker-search>
        </label>

        <p data-deck-picker-status class="mt-saved-deck-picker__status" hidden role="status"></p>

        <div data-deck-picker-empty class="mt-saved-deck-picker__empty" hidden>
          No saved decks match that search.
        </div>

        <div data-deck-picker-no-decks class="mt-saved-deck-picker__empty {{ if $ctx.SavedDecks }}hidden{{ end }}">
          <p>You do not have any saved decks yet.</p>
          <a href="/decks/new" class="mt-btn mt-btn--primary mt-btn--sm">Build a Deck</a>
        </div>

        <div class="mt-saved-deck-picker__list" data-deck-picker-list>
          {{ range $ctx.SavedDecks }}
            <button type="button"
                    class="mt-saved-deck-picker__option"
                    data-deck-picker-option
                    data-deck-id="{{ .ID }}"
                    data-deck-name="{{ .Name }}"
                    data-commander-name="{{ .CommanderName }}"
                    data-format="{{ .Format }}">
              <span class="mt-saved-deck-picker__option-copy">
                <strong>{{ .Name }}</strong>
                {{ if .Description }}<span class="mt-saved-deck-picker__description">{{ .Description }}</span>{{ end }}
                <span class="mt-saved-deck-picker__meta">
                  <span>{{ if .Format }}{{ .Format }}{{ else }}Commander{{ end }}</span>
                  <span>{{ if .CommanderName }}{{ .CommanderName }}{{ else }}No commander{{ end }}</span>
                  <span>{{ if .IsPublic }}Public{{ else }}Private{{ end }}</span>
                  {{ if .PowerBracket }}<span>{{ .PowerBracket }}</span>{{ end }}
                </span>
              </span>
              <span class="mt-saved-deck-picker__add">Add <span aria-hidden="true">&rarr;</span></span>
            </button>
          {{ end }}
        </div>
      </div>
    </div>
  {{ end }}
{{ end }}
