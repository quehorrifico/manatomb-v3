{{ define "card_show_script" }}
  {{ $ctx := .Data }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var cardUI = window.ManatombCardUI || {};
      var trimValue = cardUI.trimValue || function (value) {
        return String(value || "").trim();
      };
      var escapeHTML = cardUI.escapeHTML || function (value) {
        return String(value || "");
      };
      var renderManaSymbols = cardUI.renderManaSymbols || function () {
        return "";
      };
      var renderCardTextMarkup = cardUI.renderCardTextMarkup || function (text) {
        return trimValue(text);
      };
      var formatPrintingLabel = cardUI.formatPrintingLabel || function (printing, index) {
        return "Printing " + String((Number(index) || 0) + 1);
      };
      var releaseSortValue = cardUI.releaseSortValue || function () {
        return "";
      };

      var baseCard = {{ toJSON $ctx.Card }};
      var printings = {{ toJSON $ctx.Printings }};

      var heroShell = document.querySelector("[data-card-hero-shell]");
      var heroImage = document.querySelector("[data-card-hero-image]");
      var heroFallback = document.querySelector("[data-card-hero-fallback]");
      var faceTabs = document.querySelector("[data-card-face-tabs]");
      var nameEl = document.querySelector("[data-card-name]");
      var manaEl = document.querySelector("[data-card-mana]");
      var typeEl = document.querySelector("[data-card-type]");
      var oracleEl = document.querySelector("[data-card-oracle]");
      var flavorGroup = document.querySelector("[data-card-flavor-group]");
      var flavorEl = document.querySelector("[data-card-flavor]");
      var powerToughnessRow = document.querySelector("[data-card-power-toughness]");
      var formatLegalitiesEl = document.querySelector("[data-card-format-legalities]");
      var favoriteForm = document.querySelector("[data-card-favorite-form]");
      var favoriteScryfallID = document.querySelector("[data-card-favorite-scryfall-id]");
      var favoriteAction = document.querySelector("[data-card-favorite-action]");
      var favoriteReturnTo = document.querySelector("[data-card-favorite-return-to]");
      var favoriteButton = document.querySelector("[data-card-favorite-button]");
      var favoriteSymbol = document.querySelector("[data-card-favorite-symbol]");
      var favoriteContext = document.querySelector("[data-card-favorite-context]");
      var profileArtStatus = document.querySelector("[data-card-profile-art-status]");
      var profileArtInputs = Array.from(document.querySelectorAll("[data-card-profile-art-scryfall-id]"));
      var addLoginLink = document.querySelector("[data-card-add-login-link]");
      var printingsGrid = document.querySelector("[data-printings-grid]");
      var printingsEmpty = document.querySelector("[data-printings-empty]");
      var printingsCount = document.querySelector("[data-printings-count]");
      var printingsSort = document.querySelector("[data-printings-sort]");
      var profileArtMenus = Array.from(document.querySelectorAll("[data-card-profile-art-menu]"));

      function closeProfileArtMenus(exceptMenu) {
        profileArtMenus.forEach(function (menu) {
          if (menu !== exceptMenu) menu.open = false;
        });
      }

      profileArtMenus.forEach(function (menu) {
        menu.addEventListener("toggle", function () {
          if (menu.open) closeProfileArtMenus(menu);
        });
      });

      document.addEventListener("click", function (event) {
        profileArtMenus.forEach(function (menu) {
          if (menu.open && !menu.contains(event.target)) menu.open = false;
        });
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeProfileArtMenus();
      });

      var detailEls = {
        manaValue: document.querySelector("[data-card-mana-value]"),
        colors: document.querySelector("[data-card-colors]"),
        colorIdentity: document.querySelector("[data-card-color-identity]"),
        power: document.querySelector("[data-card-power]"),
        toughness: document.querySelector("[data-card-toughness]"),
        loyalty: document.querySelector("[data-card-loyalty]"),
        price: document.querySelector("[data-card-price]"),
        artist: document.querySelector("[data-card-artist]"),
        set: document.querySelector("[data-card-set]"),
        setCode: document.querySelector("[data-card-set-code]"),
        collector: document.querySelector("[data-card-collector]"),
        rarity: document.querySelector("[data-card-rarity]"),
        released: document.querySelector("[data-card-released]"),
        lang: document.querySelector("[data-card-lang]"),
        layout: document.querySelector("[data-card-layout]"),
        edhrec: document.querySelector("[data-card-edhrec]"),
        oracleID: document.querySelector("[data-card-oracle-id]"),
        scryfallID: document.querySelector("[data-card-scryfall-id]")
      };

      var state = {
        printingIndex: 0,
        faceIndex: 0,
        heroRotated: false,
        favoritePrintingCount: Number({{ toJSON $ctx.FavoritePrintingCount }}) || 0
      };

      function currentPrinting() {
        return printings[state.printingIndex] || printings[0] || null;
      }

      function currentFaces(printing) {
        if (!printing || !Array.isArray(printing.Faces)) {
          return [];
        }
        return printing.Faces;
      }

      function currentFace(printing) {
        if (isSplitLayout(currentLayout(printing))) {
          return null;
        }
        var faces = currentFaces(printing);
        if (!faces.length) return null;
        if (state.faceIndex < 0 || state.faceIndex >= faces.length) {
          state.faceIndex = 0;
        }
        return faces[state.faceIndex];
      }

      function isSplitLayout(layout) {
        return trimValue(layout).toLowerCase() === "split";
      }

      function currentLayout(printing) {
        return trimValue(printing && printing.Layout) || trimValue(baseCard.Layout);
      }

      function setText(el, value, fallback) {
        if (!el) return;
        el.textContent = trimValue(value) || fallback || "N/A";
      }

      function cardStatValue(value) {
        value = trimValue(value);
        if (!value || value.toUpperCase() === "N/A") {
          return "";
        }
        return value;
      }

      function normalizeLegalityStatus(value) {
        switch (trimValue(value).toLowerCase()) {
        case "legal":
        case "not_legal":
        case "restricted":
        case "banned":
          return trimValue(value).toLowerCase();
        default:
          return "unknown";
        }
      }

      function legalityStatusLabel(status, fallback) {
        fallback = trimValue(fallback);
        if (fallback) return fallback;
        switch (status) {
        case "legal":
          return "Legal";
        case "not_legal":
          return "Not legal";
        case "restricted":
          return "Restricted";
        case "banned":
          return "Banned";
        default:
          return "Unknown";
        }
      }

      function renderFormatLegalities(items) {
        if (!formatLegalitiesEl) return;

        formatLegalitiesEl.innerHTML = "";
        if (!Array.isArray(items) || !items.length) {
          var emptyItem = document.createElement("li");
          emptyItem.className = "mt-card-format-legalities__empty";
          emptyItem.textContent = "Legality data unavailable.";
          formatLegalitiesEl.appendChild(emptyItem);
          return;
        }

        items.forEach(function (item) {
          var status = normalizeLegalityStatus(item && item.Status);
          var row = document.createElement("li");
          var format = document.createElement("span");
          var statusEl = document.createElement("span");

          format.className = "mt-card-format-legalities__format";
          format.textContent = trimValue(item && item.Format) || "Unknown format";
          statusEl.className = "mt-card-format-legalities__status";
          statusEl.setAttribute("data-legality-status", status);
          statusEl.textContent = legalityStatusLabel(status, item && item.StatusLabel);

          row.appendChild(format);
          row.appendChild(statusEl);
          formatLegalitiesEl.appendChild(row);
        });
      }

      function formatPrintingFooter(printing) {
        if (!printing) {
          return { set: "Unknown set", price: "Not listed" };
        }
        var setName = trimValue(printing.SetName);
        var setCode = trimValue(printing.SetCode).toUpperCase();
        var price = trimValue(printing.PriceUSD);
        var setLabel = setName || setCode || "Unknown set";
        if (setName && setCode) {
          setLabel += " (" + setCode + ")";
        }
        return {
          set: setLabel,
          price: price || "Not listed"
        };
      }

      function setHeroImage(src, alt) {
        src = trimValue(src);
        alt = trimValue(alt) || trimValue(baseCard.Name) || "Card";
        if (!heroImage || !heroFallback) return;

        if (src) {
          heroImage.src = src;
          heroImage.alt = alt;
          heroImage.classList.remove("hidden");
          heroFallback.classList.add("hidden");
        } else {
          heroImage.src = "";
          heroImage.alt = "";
          heroImage.classList.add("hidden");
          heroFallback.classList.remove("hidden");
          heroFallback.textContent = alt;
        }
        applyHeroRotation();
      }

      function applyHeroRotation() {
        if (heroImage) {
          heroImage.classList.toggle("is-rotated", state.heroRotated);
        }
        if (heroShell) {
          heroShell.style.overflow = state.heroRotated ? "visible" : "";
          heroShell.style.zIndex = state.heroRotated ? "40" : "";
        }
      }

      function setHeroRotated(rotated) {
        state.heroRotated = !!rotated;
        applyHeroRotation();
      }

      function pathForPrinting(printing) {
        var scryfallID = trimValue(printing && printing.ScryfallID);
        var url = new URL(window.location.href);
        if (scryfallID) {
          url.searchParams.set("printing", scryfallID);
        } else {
          url.searchParams.delete("printing");
        }
        return url.pathname + url.search + url.hash;
      }

      function updatePrintingURL(printing, replace) {
        if (!window.history || typeof window.history.pushState !== "function") return;

        var nextPath = pathForPrinting(printing);
        var currentPath = window.location.pathname + window.location.search + window.location.hash;
        if (nextPath === currentPath) return;

        if (replace) {
          window.history.replaceState({ printing: trimValue(printing && printing.ScryfallID) }, "", nextPath);
        } else {
          window.history.pushState({ printing: trimValue(printing && printing.ScryfallID) }, "", nextPath);
        }
      }

      function loginPathForPrinting(printing) {
        return "/login?next=" + encodeURIComponent(pathForPrinting(printing));
      }

      function updateFavoriteForm(printing) {
        if (!favoriteForm || !favoriteScryfallID || !favoriteAction || !favoriteButton) return;

        var scryfallID = trimValue(printing && printing.ScryfallID);
        var favorited = !!(printing && printing.IsFavorited);
        favoriteForm.classList.toggle("hidden", !scryfallID);
        favoriteScryfallID.value = scryfallID;
        if (favoriteReturnTo) {
          favoriteReturnTo.value = pathForPrinting(printing);
        }
        favoriteAction.value = favorited ? "unfavorite" : "favorite";
        favoriteButton.disabled = !scryfallID;
        favoriteButton.classList.toggle("is-loved", favorited);
        favoriteButton.title = favorited ? "Remove this printing from favorites" : "Favorite this printing";
        favoriteButton.setAttribute("aria-label", favoriteButton.title);
        if (favoriteSymbol) {
          favoriteSymbol.textContent = favorited ? "♥" : "♡";
        }
      }

      function updateProfileArtForms(printing) {
        var scryfallID = trimValue(printing && printing.ScryfallID);
        profileArtInputs.forEach(function (input) {
          input.value = scryfallID;
          var form = input.closest("form");
          var button = form ? form.querySelector('button[type="submit"]') : null;
          if (button) button.disabled = !scryfallID;
        });
      }

      function updateFavoriteContext(printing, errorMessage) {
        if (!favoriteContext) return;

        errorMessage = trimValue(errorMessage);
        if (errorMessage) {
          favoriteContext.hidden = false;
          favoriteContext.setAttribute("data-status", "error");
          favoriteContext.textContent = errorMessage;
          return;
        }

        favoriteContext.removeAttribute("data-status");
        var total = Math.max(0, Number(state.favoritePrintingCount) || 0);
        var selectedIsFavorited = !!(printing && printing.IsFavorited);
        var otherCount = Math.max(0, total - (selectedIsFavorited ? 1 : 0));
        if (selectedIsFavorited) {
          if (otherCount === 1) {
            favoriteContext.textContent = "This printing and 1 other are in your favorites.";
          } else if (otherCount > 1) {
            favoriteContext.textContent = "This printing and " + String(otherCount) + " others are in your favorites.";
          } else {
            favoriteContext.textContent = "This printing is in your favorites.";
          }
        } else if (otherCount === 1) {
          favoriteContext.textContent = "You favorited another printing.";
        } else if (otherCount > 1) {
          favoriteContext.textContent = "You favorited " + String(otherCount) + " other printings.";
        } else {
          favoriteContext.textContent = "";
        }
        favoriteContext.hidden = total === 0;
      }

      function updateAddLoginLink(printing) {
        if (addLoginLink) {
          addLoginLink.href = loginPathForPrinting(printing);
        }
      }

      document.addEventListener("submit", function (event) {
        var form = event.target && event.target.closest("[data-card-favorite-form]");
        if (!form || typeof window.fetch !== "function") return;

        var button = form.querySelector("[data-card-favorite-button]");
        if (!button || button.disabled) return;

        event.preventDefault();
        button.disabled = true;
        favoriteContext && favoriteContext.removeAttribute("data-status");

        var favoriteBody = new URLSearchParams();
        new FormData(form).forEach(function (value, key) {
          favoriteBody.append(key, String(value));
        });

        var favoriteEndpoint = trimValue(form.getAttribute("action")) || "/cards/favorites/printing";
        window.fetch(favoriteEndpoint, {
          method: "POST",
          body: favoriteBody,
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
          }
        }).catch(function (error) {
          error.useNativeFallback = true;
          throw error;
        }).then(function (response) {
          return response.json().catch(function () {
            var responseError = new Error("The favorite response could not be read.");
            responseError.useNativeFallback = response.ok;
            throw responseError;
          }).then(function (payload) {
            if (!response.ok) {
              var requestError = new Error(trimValue(payload && payload.error) || "Could not update favorites. Try again.");
              requestError.loginURL = trimValue(payload && payload.login_url);
              throw requestError;
            }
            return payload;
          });
        }).then(function (payload) {
          var responseID = trimValue(payload && payload.scryfall_id).toLowerCase();
          var didFindPrinting = false;
          var wasFavorited = false;
          printings.forEach(function (printing) {
            if (trimValue(printing && printing.ScryfallID).toLowerCase() === responseID) {
              wasFavorited = !!printing.IsFavorited;
              printing.IsFavorited = !!payload.favorited;
              didFindPrinting = true;
            }
          });
          if (!didFindPrinting) {
            var reconcileError = new Error("The updated favorite could not be matched on this page.");
            reconcileError.useNativeFallback = true;
            throw reconcileError;
          }
          if (wasFavorited !== !!payload.favorited) {
            state.favoritePrintingCount += payload.favorited ? 1 : -1;
            state.favoritePrintingCount = Math.max(0, state.favoritePrintingCount);
          }

          if (payload.favorited) {
            button.classList.add("is-popping");
            window.setTimeout(function () {
              button.classList.remove("is-popping");
            }, 430);
          }
          updateFavoriteForm(currentPrinting());
          updateFavoriteContext(currentPrinting());
          renderPrintingsGrid();
        }).catch(function (error) {
          button.disabled = false;
          if (error && error.useNativeFallback) {
            form.submit();
            return;
          }
          var loginURL = trimValue(error && error.loginURL);
          if (loginURL) {
            window.location.assign(loginURL);
            return;
          }
          updateFavoriteContext(currentPrinting(), trimValue(error && error.message) || "Could not update favorites. Try again.");
        });
      });

      document.addEventListener("submit", function (event) {
        var form = event.target && event.target.closest("[data-card-profile-art-form]");
        if (!form || typeof window.fetch !== "function") return;
        var button = form.querySelector('button[type="submit"]');
        if (!button || button.disabled) return;

        event.preventDefault();
        button.disabled = true;
        if (profileArtStatus) {
          profileArtStatus.textContent = "Updating profile art…";
          profileArtStatus.removeAttribute("data-status");
        }
        var body = new URLSearchParams();
        new FormData(form).forEach(function (value, key) {
          body.append(key, String(value));
        });
        var profileArtEndpoint = trimValue(form.getAttribute("action")) || "/profile/art";
        window.fetch(profileArtEndpoint, {
          method: "POST",
          body: body,
          credentials: "same-origin",
          headers: { "Accept": "application/json" }
        }).then(function (response) {
          return response.json().catch(function () { return {}; }).then(function (payload) {
            if (!response.ok) {
              var error = new Error(trimValue(payload && payload.error) || "Could not update profile art.");
              error.redirectURL = trimValue(payload && payload.redirect_url);
              throw error;
            }
            return payload;
          });
        }).then(function (payload) {
          if (profileArtStatus) {
            profileArtStatus.textContent = trimValue(payload && payload.message) || "Profile art updated.";
          }
          var menu = form.closest("[data-card-profile-art-menu]");
          if (menu) menu.open = false;
        }).catch(function (error) {
          if (error && error.redirectURL) {
            window.location.assign(error.redirectURL);
            return;
          }
          if (profileArtStatus) {
            profileArtStatus.textContent = trimValue(error && error.message) || "Could not update profile art.";
            profileArtStatus.setAttribute("data-status", "error");
          }
        }).finally(function () {
          button.disabled = false;
        });
      });

      function renderFaceTabs(printing) {
        if (!faceTabs) return;

        faceTabs.innerHTML = "";
        if (isSplitLayout(currentLayout(printing))) {
          faceTabs.classList.remove("hidden");

          var rotateButton = document.createElement("button");
          rotateButton.type = "button";
          rotateButton.className = "mt-btn mt-btn--secondary mt-btn--sm";
          rotateButton.textContent = state.heroRotated ? "Reset" : "Rotate";
          rotateButton.title = state.heroRotated ? "Reset card orientation" : "Rotate card art";
          rotateButton.setAttribute("aria-pressed", state.heroRotated ? "true" : "false");
          rotateButton.addEventListener("click", function () {
            setHeroRotated(!state.heroRotated);
            rotateButton.textContent = state.heroRotated ? "Reset" : "Rotate";
            rotateButton.title = state.heroRotated ? "Reset card orientation" : "Rotate card art";
            rotateButton.setAttribute("aria-pressed", state.heroRotated ? "true" : "false");
          });
          faceTabs.appendChild(rotateButton);
          return;
        }

        var faces = currentFaces(printing);
        if (faces.length <= 1) {
          faceTabs.classList.add("hidden");
          return;
        }

        faceTabs.classList.remove("hidden");

        var nextIndex = (state.faceIndex + 1) % faces.length;
        var nextName = trimValue(faces[nextIndex] && faces[nextIndex].Name);
        var button = document.createElement("button");
        button.type = "button";
        button.className = "mt-btn mt-btn--secondary mt-btn--sm";
        button.textContent = "Turn Over";
        button.title = nextName ? ("Turn over to " + nextName) : "Turn over card";
        button.addEventListener("click", function () {
          state.faceIndex = nextIndex;
          renderHero();
        });
        faceTabs.appendChild(button);
      }

      function renderHero() {
        var printing = currentPrinting();
        if (!printing) return;

        if (!isSplitLayout(currentLayout(printing)) && state.heroRotated) {
          setHeroRotated(false);
        }

        var face = currentFace(printing);
        var heroName = trimValue(face && face.Name) || trimValue(printing.Name) || trimValue(baseCard.Name) || "Card";
        var heroMana = trimValue(face && face.ManaCost) || trimValue(printing.ManaCost) || trimValue(baseCard.ManaCost);
        var heroType = trimValue(face && face.TypeLine) || trimValue(printing.TypeLine) || trimValue(baseCard.TypeLine);
        var heroOracle = trimValue(face && face.OracleText) || trimValue(printing.OracleText) || trimValue(baseCard.OracleText) || "No oracle text.";
        var heroFlavor = trimValue(face && face.FlavorText) || trimValue(printing.FlavorText);
        if (!heroFlavor && (!Array.isArray(printings) || printings.length <= 1)) {
          heroFlavor = trimValue(baseCard.FlavorText);
        }
        var heroImageURI = trimValue(face && face.ImageURI) || trimValue(printing.ImageURI) || trimValue(baseCard.ImageURI);
        var heroPower = face
          ? cardStatValue(face.Power)
          : (cardStatValue(printing.Power) || cardStatValue(baseCard.Power));
        var heroToughness = face
          ? cardStatValue(face.Toughness)
          : (cardStatValue(printing.Toughness) || cardStatValue(baseCard.Toughness));
        var hasPowerToughness = face
          ? !!face.HasPowerToughness
          : !!(printing.HasPowerToughness || baseCard.HasPowerToughness);

        if (nameEl) nameEl.textContent = heroName;
        if (manaEl) manaEl.innerHTML = renderManaSymbols(heroMana) || "No mana cost";
        if (typeEl) typeEl.textContent = heroType;
        if (oracleEl) oracleEl.innerHTML = renderCardTextMarkup(heroOracle, "No oracle text.");
        if (flavorGroup) flavorGroup.hidden = !heroFlavor;
        if (flavorEl) flavorEl.innerHTML = renderCardTextMarkup(heroFlavor, "");
        if (powerToughnessRow) powerToughnessRow.hidden = !hasPowerToughness;
        setHeroImage(heroImageURI, heroName);

        setText(detailEls.manaValue, printing.ManaValue || baseCard.ManaValue, "N/A");
        setText(detailEls.colors, trimValue(face && face.Colors) || printing.Colors || baseCard.Colors, "Colorless");
        setText(detailEls.colorIdentity, trimValue(face && face.ColorIdentity) || printing.ColorIdentity || baseCard.ColorIdentity, "Colorless");
        renderFormatLegalities(printing.Legalities || baseCard.Legalities);
        setText(detailEls.power, heroPower, "N/A");
        setText(detailEls.toughness, heroToughness, "N/A");
        setText(detailEls.loyalty, trimValue(face && face.Loyalty) || printing.Loyalty || baseCard.Loyalty, "N/A");
        setText(detailEls.price, printing.PriceUSD || baseCard.PriceUSD, "Not listed");
        setText(detailEls.artist, trimValue(face && face.Artist) || printing.Artist || baseCard.Artist, "Unknown");
        setText(detailEls.set, printing.SetName || baseCard.SetName, "Unknown set");
        setText(detailEls.setCode, printing.SetCode || baseCard.SetCode, "N/A");
        setText(detailEls.collector, printing.CollectorNumber || baseCard.CollectorNumber, "N/A");
        setText(detailEls.rarity, printing.Rarity || baseCard.Rarity, "N/A");
        setText(detailEls.released, printing.ReleasedAt || baseCard.ReleasedAt, "Unknown");
        setText(detailEls.lang, printing.Lang || baseCard.Lang, "EN");
        setText(detailEls.layout, printing.Layout || baseCard.Layout, "Unknown");
        setText(detailEls.edhrec, printing.EDHRecRank || baseCard.EDHRecRank, "Unranked");
        setText(detailEls.oracleID, printing.OracleID || baseCard.OracleID, "N/A");
        setText(detailEls.scryfallID, printing.ScryfallID || baseCard.ScryfallID, "N/A");

        updateFavoriteForm(printing);
        updateFavoriteContext(printing);
        updateProfileArtForms(printing);
        updateAddLoginLink(printing);
        renderFaceTabs(printing);
      }

      function initialPrintingIndex() {
        if (!Array.isArray(printings) || !printings.length) return 0;
        var requestedPrintingID = trimValue(new URLSearchParams(window.location.search).get("printing"));
        var selectedPrintingID = requestedPrintingID || trimValue(baseCard.ScryfallID);
        if (selectedPrintingID) {
          for (var selectedIndex = 0; selectedIndex < printings.length; selectedIndex++) {
            if (trimValue(printings[selectedIndex] && printings[selectedIndex].ScryfallID).toLowerCase() === selectedPrintingID.toLowerCase()) {
              return selectedIndex;
            }
          }
        }
        return 0;
      }

      function sortedPrintingItems() {
        var items = printings.map(function (printing, index) {
          return { printing: printing, index: index };
        });

        var sortMode = printingsSort ? trimValue(printingsSort.value) : "newest";
        items.sort(function (a, b) {
          if (sortMode === "oldest") {
            return releaseSortValue(a.printing).localeCompare(releaseSortValue(b.printing));
          }
          if (sortMode === "price_low") {
            var aLow = Number(a.printing.PriceSort || 0);
            var bLow = Number(b.printing.PriceSort || 0);
            if (aLow === 0 && bLow !== 0) return 1;
            if (bLow === 0 && aLow !== 0) return -1;
            if (aLow !== bLow) return aLow - bLow;
            return formatPrintingLabel(a.printing, a.index).localeCompare(formatPrintingLabel(b.printing, b.index));
          }
          if (sortMode === "price_high") {
            var aHigh = Number(a.printing.PriceSort || 0);
            var bHigh = Number(b.printing.PriceSort || 0);
            if (aHigh === 0 && bHigh !== 0) return 1;
            if (bHigh === 0 && aHigh !== 0) return -1;
            if (aHigh !== bHigh) return bHigh - aHigh;
            return formatPrintingLabel(a.printing, a.index).localeCompare(formatPrintingLabel(b.printing, b.index));
          }
          if (sortMode === "set") {
            return formatPrintingLabel(a.printing, a.index).localeCompare(formatPrintingLabel(b.printing, b.index));
          }
          return releaseSortValue(b.printing).localeCompare(releaseSortValue(a.printing));
        });

        return items;
      }

      function renderPrintingsGrid() {
        if (!printingsGrid) return;

        var items = sortedPrintingItems();
        if (printingsCount) {
          printingsCount.textContent = "(" + String(items.length) + ")";
        }
        if (printingsEmpty) {
          printingsEmpty.hidden = items.length !== 0;
        }

        printingsGrid.innerHTML = "";
        items.forEach(function (item) {
          var printing = item.printing || {};
          var label = formatPrintingLabel(printing, item.index);
          var imageURI = trimValue(printing.ImageURI);
          var footer = formatPrintingFooter(printing);
          var isCurrent = item.index === state.printingIndex;
          var article = document.createElement("article");
          article.className = "min-w-0";
          var link = document.createElement("a");
          link.href = pathForPrinting(printing);
          link.className = "mt-printing-tile" + (isCurrent ? " is-active" : "");
          link.setAttribute("data-printing-activate", String(item.index));
          link.setAttribute("data-printing-scryfall-id", trimValue(printing.ScryfallID));
          var isFavorited = !!printing.IsFavorited;
          link.classList.toggle("is-favorited", isFavorited);
          link.setAttribute("aria-label", (isCurrent ? "Current printing: " : "Show ") + label + (isFavorited ? ", favorited" : ""));
          if (isCurrent) {
            link.setAttribute("aria-current", "true");
          }
          link.title = label;

          var mediaHTML = "";
          if (imageURI) {
            mediaHTML = '<img src="' + escapeHTML(imageURI) + '" alt="">';
          } else {
            mediaHTML = '<span class="mt-printing-tile__fallback">No image</span>';
          }
          var currentHTML = isCurrent
            ? '<span class="mt-printing-tile__current">Current</span>'
            : "";
          var favoriteHTML = isFavorited
            ? '<span class="mt-printing-tile__favorite" aria-hidden="true">♥</span>'
            : "";
          link.innerHTML =
            '<span class="mt-printing-tile__media">' + mediaHTML + favoriteHTML + '</span>' +
            '<span class="mt-printing-tile__meta">' +
              '<span class="mt-printing-tile__heading">' +
                '<span class="mt-printing-tile__set">' + escapeHTML(footer.set) + '</span>' +
                currentHTML +
              '</span>' +
              '<span class="mt-printing-tile__price">' + escapeHTML(footer.price) + '</span>' +
            '</span>';

          link.addEventListener("click", function (event) {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
              return;
            }
            event.preventDefault();
            var nextIndex = Number(link.getAttribute("data-printing-activate"));
            if (!Number.isFinite(nextIndex) || nextIndex < 0 || nextIndex >= printings.length) return;
            if (nextIndex === state.printingIndex) return;
            state.printingIndex = nextIndex;
            state.faceIndex = 0;
            setHeroRotated(false);
            updatePrintingURL(printings[state.printingIndex], false);
            renderHero();
            renderPrintingsGrid();
          });

          article.appendChild(link);
          printingsGrid.appendChild(article);
        });
      }

      if (printingsSort) {
        printingsSort.addEventListener("change", renderPrintingsGrid);
      }
      window.addEventListener("popstate", function () {
        state.printingIndex = initialPrintingIndex();
        state.faceIndex = 0;
        setHeroRotated(false);
        renderHero();
        renderPrintingsGrid();
      });

      state.printingIndex = initialPrintingIndex();
      renderHero();
      renderPrintingsGrid();
    });
  </script>
{{ end }}
