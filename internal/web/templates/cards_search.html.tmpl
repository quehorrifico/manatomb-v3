{{ define "cards_search" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-6xl mx-auto py-10 px-4 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="space-y-2">
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Advanced Card Search</h1>
      </div>

      <div class="flex flex-wrap gap-2">
        {{ if .CurrentUser }}
          <a href="/decks" class="mt-btn mt-btn--secondary mt-btn--sm">Decks</a>
        {{ end }}
        <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
      </div>
    </div>

    <section class="mt-panel p-5 sm:p-6 space-y-6">

      <form method="GET" action="/cards/search" class="space-y-6">
        <section class="space-y-3">
          <div class="grid gap-4 lg:grid-cols-3">
            <label class="block text-sm text-slate-200">
              <span class="mt-field-label">Name</span>
              <div class="relative" data-card-autocomplete-root>
                <input type="text"
                       name="q"
                       value="{{ $ctx.NameQuery }}"
                       placeholder="Thassa's Oracle"
                       class="mt-control"
                       autocomplete="off"
                       aria-autocomplete="list"
                       aria-expanded="false"
                       aria-haspopup="listbox"
                       data-card-autocomplete-input>
                <div
                  data-card-autocomplete-menu
                  class="hidden absolute left-0 right-0 top-[calc(100%+0.35rem)] z-20 overflow-hidden rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/70"
                  role="listbox"></div>
              </div>
            </label>

            <label class="block text-sm text-slate-200">
              <span class="mt-field-label">Text</span>
              <input type="text"
                     name="text"
                     value="{{ $ctx.TextQuery }}"
                     placeholder="When this creature enters, look at the top X cards of your library..."
                     class="mt-control">
            </label>

            <div class="space-y-2" data-type-filter-root>
              <div class="flex items-center justify-between gap-2">
                <span class="mt-field-label !mb-0">Type Line</span>
                <span class="text-[11px] text-slate-500">Add one or more types.</span>
              </div>

              <div class="space-y-3">
                <div class="relative">
                  <div class="flex gap-2">
                    <input type="text"
                           data-type-filter-input
                           placeholder="Search card types"
                           autocomplete="off"
                           class="mt-control">
                    <button type="button"
                            data-type-filter-toggle
                            class="mt-btn mt-btn--secondary mt-btn--sm"
                            aria-label="Show card types">
                      Types
                    </button>
                    <button type="button"
                            data-type-filter-add
                            class="mt-btn mt-btn--secondary mt-btn--sm">
                      Add
                    </button>
                  </div>

                  <div data-type-filter-menu hidden class="absolute left-0 right-0 z-20 mt-2 rounded-xl border border-slate-700 bg-slate-950/98 shadow-2xl shadow-slate-950/60">
                    <div class="max-h-56 overflow-y-auto p-2 space-y-1">
                      {{ range $ctx.TypeOptions }}
                        <button type="button"
                                data-type-filter-option="{{ . }}"
                                class="block w-full rounded-lg px-3 py-2 text-left text-sm text-slate-200 transition-colors hover:bg-slate-800 hover:text-slate-50">
                          {{ . }}
                        </button>
                      {{ end }}
                      <div data-type-filter-empty hidden class="rounded-lg px-3 py-2 text-sm text-slate-500">
                        No matching types.
                      </div>
                    </div>
                  </div>
                </div>

                <div data-type-filter-selected class="flex flex-wrap gap-2"></div>
                <div data-type-filter-hidden>
                  {{ range $ctx.TypeFilters }}
                    <input type="hidden" name="type_value" value="{{ .Value }}">
                    <input type="hidden" name="type_mode" value="{{ .Mode }}">
                  {{ end }}
                </div>
                <p data-type-filter-status class="mt-hint">Each type can be set to `IS` or `NOT`.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="space-y-3">
          <div class="mt-subpanel space-y-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="mt-field-label !mb-0">Colors</p>
              <label class="text-[11px] text-slate-400">
                <span class="sr-only">Color match mode</span>
                <select name="color_mode" class="mt-control mt-control--sm text-xs text-slate-200">
                  <option value="exact" {{ if eq $ctx.ColorMode "exact" }}selected{{ end }}>Exactly these colors</option>
                  <option value="includes" {{ if eq $ctx.ColorMode "includes" }}selected{{ end }}>Including these colors</option>
                  <option value="at_most" {{ if eq $ctx.ColorMode "at_most" }}selected{{ end }}>At most these colors</option>
                </select>
              </label>
            </div>

            <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
              <label class="mt-check-pill justify-between">
                <span>White</span>
                <input type="checkbox" name="color" value="W" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if index $ctx.ColorsSelected "W" }}checked{{ end }}>
              </label>
              <label class="mt-check-pill justify-between">
                <span>Blue</span>
                <input type="checkbox" name="color" value="U" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if index $ctx.ColorsSelected "U" }}checked{{ end }}>
              </label>
              <label class="mt-check-pill justify-between">
                <span>Black</span>
                <input type="checkbox" name="color" value="B" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if index $ctx.ColorsSelected "B" }}checked{{ end }}>
              </label>
              <label class="mt-check-pill justify-between">
                <span>Red</span>
                <input type="checkbox" name="color" value="R" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if index $ctx.ColorsSelected "R" }}checked{{ end }}>
              </label>
              <label class="mt-check-pill justify-between">
                <span>Green</span>
                <input type="checkbox" name="color" value="G" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if index $ctx.ColorsSelected "G" }}checked{{ end }}>
              </label>
              <label class="mt-check-pill justify-between">
                <span>Colorless</span>
                <input type="checkbox" name="color" value="C" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if index $ctx.ColorsSelected "C" }}checked{{ end }}>
              </label>
            </div>
          </div>
        </section>

        <section class="space-y-3">
          <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">

            <label class="block text-sm text-slate-200">
              <span class="mt-field-label">Rarity</span>
              <select name="rarity" class="mt-control">
                <option value="">Any rarity</option>
                <option value="common" {{ if eq $ctx.Rarity "common" }}selected{{ end }}>Common</option>
                <option value="uncommon" {{ if eq $ctx.Rarity "uncommon" }}selected{{ end }}>Uncommon</option>
                <option value="rare" {{ if eq $ctx.Rarity "rare" }}selected{{ end }}>Rare</option>
                <option value="mythic" {{ if eq $ctx.Rarity "mythic" }}selected{{ end }}>Mythic</option>
              </select>
            </label>

            <label class="block text-sm text-slate-200">
              <span class="mt-field-label">Set</span>
              <input type="text"
                     name="set"
                     value="{{ $ctx.SetQuery }}"
                     placeholder="Set name or code"
                     class="mt-control">
            </label>
          </div>

          <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto]">
            <label class="block text-sm text-slate-200">
              <span class="mt-field-label">Artist</span>
              <input type="text"
                     name="artist"
                     value="{{ $ctx.ArtistQuery }}"
                     placeholder="Artist name"
                     class="mt-control">
            </label>

            <div class="flex items-end">
              <label class="mt-check-pill">
                <input type="checkbox" name="commander" value="1" class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500" {{ if $ctx.CommanderOnly }}checked{{ end }}>
                <span>Commander cards only</span>
              </label>
            </div>
          </div>
        </section>

        <div class="flex flex-wrap justify-end gap-2">
          <a href="/cards/search" class="mt-btn mt-btn--secondary">Clear</a>
          <button type="submit" class="mt-btn mt-btn--primary">Search Cards</button>
        </div>
      </form>
    </section>

    <section class="space-y-3">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-slate-100">
          Results{{ if and $ctx.HasSearched $ctx.Results }} <span class="ml-1 text-xs text-slate-500">({{ len $ctx.Results }})</span>{{ end }}
        </h2>
      </div>

      {{ if $ctx.HasSearched }}
        {{ if $ctx.Results }}
          <ul class="grid gap-4 grid-cols-2 lg:grid-cols-3">
            {{ range $ctx.Results }}
              <li>
                <a href="{{ .DetailPath }}" class="mt-action-card space-y-3 block w-full text-left">
                  {{ if .ImageURI }}
                    <img src="{{ .ImageURI }}"
                         alt="{{ .Name }}"
                         class="w-full h-auto mt-card-media shadow-md shadow-slate-900/80">
                  {{ else }}
                    <div class="w-full aspect-[3/4] mt-card-media mt-card-media__fallback">
                      No image available
                    </div>
                  {{ end }}
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-slate-100">{{ .Name }}</p>
                    <p class="text-xs text-slate-400">{{ .TypeLine }}</p>
                    {{ if or .SetName .Rarity }}
                      <p class="text-xs text-slate-500">
                        {{ if .SetName }}{{ .SetName }}{{ end }}{{ if and .SetName .Rarity }} · {{ end }}{{ if .Rarity }}<span class="uppercase">{{ .Rarity }}</span>{{ end }}
                      </p>
                    {{ end }}
                  </div>
                </a>
              </li>
            {{ end }}
          </ul>
        {{ else }}
          <div class="mt-empty-state">
            <p class="text-sm text-slate-300">No cards matched your search.</p>
          </div>
        {{ end }}
      {{ else }}
        <div class="mt-empty-state">
          <p class="text-sm text-slate-300">Set a few filters and search for cards.</p>
        </div>
      {{ end }}
    </section>
  </main>

  <script id="cards-type-filters-data" type="application/json">{{ $ctx.TypeFiltersJSON }}</script>
  <script>
    (function () {
      const root = document.querySelector("[data-type-filter-root]");
      if (!root) return;

      const filtersData = document.getElementById("cards-type-filters-data");
      const input = root.querySelector("[data-type-filter-input]");
      const toggleButton = root.querySelector("[data-type-filter-toggle]");
      const addButton = root.querySelector("[data-type-filter-add]");
      const menu = root.querySelector("[data-type-filter-menu]");
      const options = Array.from(root.querySelectorAll("[data-type-filter-option]"));
      const emptyState = root.querySelector("[data-type-filter-empty]");
      const selected = root.querySelector("[data-type-filter-selected]");
      const hidden = root.querySelector("[data-type-filter-hidden]");
      const status = root.querySelector("[data-type-filter-status]");
      const colorInputs = Array.from(document.querySelectorAll('input[name="color"]'));
      const colorlessInput = document.querySelector('input[name="color"][value="C"]');

      let filters = [];
      try {
        filters = JSON.parse(filtersData ? filtersData.textContent : "[]");
      } catch (error) {
        filters = [];
      }

      function setStatus(message) {
        if (!status) return;
        status.textContent = message || "Pick a type, then set each one to IS or NOT.";
      }

      function canonicalType(value) {
        const raw = (value || "").trim().toLowerCase();
        if (!raw) return "";
        for (const option of options) {
          const optionValue = option.dataset.typeFilterOption || "";
          if (optionValue.toLowerCase() === raw) {
            return optionValue;
          }
        }
        return "";
      }

      function showMenu() {
        filterOptions();
        menu.hidden = false;
      }

      function hideMenu() {
        menu.hidden = true;
      }

      function renderFilters() {
        selected.innerHTML = "";
        hidden.innerHTML = "";

        filters.forEach(function (filter, index) {
          const chip = document.createElement("div");
          chip.className = "inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-950/80 pl-3 pr-1 py-1 text-sm text-slate-100";

          const value = document.createElement("span");
          value.textContent = filter.value;
          chip.appendChild(value);

          const toggle = document.createElement("button");
          toggle.type = "button";
          toggle.textContent = filter.mode === "not" ? "NOT" : "IS";
          toggle.className = filter.mode === "not"
            ? "rounded-full border border-rose-500/50 bg-rose-500/15 px-2 py-1 text-[11px] font-semibold uppercase tracking-wide text-rose-200 transition-colors hover:bg-rose-500/25"
            : "rounded-full border border-sky-500/50 bg-sky-500/15 px-2 py-1 text-[11px] font-semibold uppercase tracking-wide text-sky-200 transition-colors hover:bg-sky-500/25";
          toggle.addEventListener("click", function () {
            filters[index].mode = filters[index].mode === "not" ? "is" : "not";
            renderFilters();
          });
          chip.appendChild(toggle);

          const remove = document.createElement("button");
          remove.type = "button";
          remove.textContent = "X";
          remove.className = "rounded-full border border-slate-700 px-2 py-1 text-[11px] font-semibold text-slate-300 transition-colors hover:bg-slate-800 hover:text-slate-50";
          remove.addEventListener("click", function () {
            filters.splice(index, 1);
            renderFilters();
            filterOptions();
          });
          chip.appendChild(remove);

          selected.appendChild(chip);

          const valueInput = document.createElement("input");
          valueInput.type = "hidden";
          valueInput.name = "type_value";
          valueInput.value = filter.value;
          hidden.appendChild(valueInput);

          const modeInput = document.createElement("input");
          modeInput.type = "hidden";
          modeInput.name = "type_mode";
          modeInput.value = filter.mode;
          hidden.appendChild(modeInput);
        });
      }

      function filterOptions() {
        const query = (input.value || "").trim().toLowerCase();
        let visibleCount = 0;

        options.forEach(function (option) {
          const value = option.dataset.typeFilterOption || "";
          const alreadySelected = filters.some(function (filter) {
            return filter.value.toLowerCase() === value.toLowerCase();
          });
          const matches = query === "" || value.toLowerCase().includes(query);
          const visible = !alreadySelected && matches;
          option.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (emptyState) {
          emptyState.hidden = visibleCount !== 0;
        }
      }

      function addFilter(rawValue) {
        const value = canonicalType(rawValue);
        if (!value) {
          setStatus("Choose a type from the list.");
          return;
        }
        const exists = filters.some(function (filter) {
          return filter.value.toLowerCase() === value.toLowerCase();
        });
        if (exists) {
          setStatus("That type is already added.");
          return;
        }
        filters.push({ value: value, mode: "is" });
        input.value = "";
        setStatus("");
        renderFilters();
        hideMenu();
      }

      input.addEventListener("focus", function () {
        setStatus("");
        showMenu();
      });
      input.addEventListener("click", function () {
        showMenu();
      });
      input.addEventListener("input", function () {
        showMenu();
      });
      input.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          hideMenu();
          return;
        }
        if (event.key !== "Enter") return;
        event.preventDefault();

        const firstVisible = options.find(function (option) {
          return !option.hidden;
        });
        if (firstVisible) {
          addFilter(firstVisible.dataset.typeFilterOption || "");
          return;
        }
        addFilter(input.value);
      });

      toggleButton.addEventListener("click", function () {
        if (menu.hidden) {
          input.focus();
          showMenu();
          return;
        }
        hideMenu();
      });

      addButton.addEventListener("click", function () {
        addFilter(input.value);
      });

      options.forEach(function (option) {
        option.addEventListener("mousedown", function (event) {
          event.preventDefault();
          addFilter(option.dataset.typeFilterOption || "");
        });
      });

      root.addEventListener("focusin", function () {
        showMenu();
      });

      document.addEventListener("mousedown", function (event) {
        if (!root.contains(event.target)) {
          hideMenu();
        }
      });

      colorInputs.forEach(function (inputEl) {
        inputEl.addEventListener("change", function () {
          if (!colorlessInput) return;
          if (inputEl.value === "C" && inputEl.checked) {
            colorInputs.forEach(function (other) {
              if (other !== inputEl) other.checked = false;
            });
            return;
          }
          if (inputEl.value !== "C" && inputEl.checked) {
            colorlessInput.checked = false;
          }
        });
      });

      renderFilters();
      filterOptions();
      hideMenu();
    })();
  </script>

  {{ template "layout_footer" . }}
{{ end }}
