{{ define "cards_search" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <div class="mt-advanced-search-page">
    <header class="mt-advanced-search-heading">
      <h1>Advanced Search</h1>
      <p>Combine as many details as you need. Blank fields remain unrestricted.</p>
      {{ if $ctx.ShowCurrentSort }}
        <p class="mt-advanced-search-current-sort">
          Current result order:
          <strong>{{ $ctx.CurrentSortLabel }} · {{ $ctx.CurrentDirectionLabel }}</strong>
        </p>
      {{ end }}
    </header>

    {{ template "cards_search_filter_form" $ctx }}
  </div>

  {{ template "layout_footer" . }}
{{ end }}
