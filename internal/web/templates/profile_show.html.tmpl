{{ define "profile_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-6xl mx-auto px-4 py-8 space-y-5">
    <section class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div class="space-y-2">
        <p class="mt-kicker">Profile</p>
        <h1 class="mt-title">{{ $ctx.Profile.DisplayName }}</h1>
        <p class="mt-hint">{{ len $ctx.Items }} public deck{{ if ne (len $ctx.Items) 1 }}s{{ end }}</p>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="/decks/public" class="mt-btn mt-btn--secondary mt-btn--sm">Browse Decks</a>
      </div>
    </section>

    <section class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <h2 class="mt-section-label">Public Decks</h2>
        <p class="text-xs text-slate-500">{{ len $ctx.Items }} result{{ if ne (len $ctx.Items) 1 }}s{{ end }}</p>
      </div>

      {{ if $ctx.Items }}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          {{ range $ctx.Items }}
            <article class="mt-panel p-4 sm:p-5 space-y-4">
              <div class="flex gap-3">
                <div class="h-24 w-16 mt-card-media bg-slate-900 flex items-center justify-center shrink-0">
                  {{ if .CommanderImageURI }}
                    <img src="{{ .CommanderImageURI }}" alt="{{ .CommanderName }}" class="w-full h-full object-cover">
                  {{ else }}
                    <span class="text-[10px] uppercase tracking-wide text-slate-500">{{ if .CommanderName }}Commander{{ else }}Deck{{ end }}</span>
                  {{ end }}
                </div>

                <div class="min-w-0 flex-1 space-y-2">
                  <div class="space-y-1">
                    <h3 class="text-base font-semibold text-slate-100 leading-tight">{{ .Name }}</h3>
                    <div class="flex flex-wrap gap-1">
                      <span class="mt-chip">{{ if .Format }}{{ .Format }}{{ else }}Commander{{ end }}</span>
                      {{ if .PowerBracket }}
                        <span class="mt-chip">{{ .PowerBracket }}</span>
                      {{ end }}
                    </div>
                  </div>

                  {{ if .Tags }}
                    <div class="flex flex-wrap gap-1 pt-1">
                      {{ range splitTags .Tags }}
                        <span class="{{ publicTagChipClass . }}">{{ . }}</span>
                      {{ end }}
                    </div>
                  {{ end }}
                </div>
              </div>

              <div class="flex justify-end">
                <a href="/decks/public/{{ .PublicSlug }}" class="mt-btn mt-btn--secondary mt-btn--sm">Open</a>
              </div>
            </article>
          {{ end }}
        </div>
      {{ else }}
        <div class="mt-panel p-5 text-center text-sm text-slate-400">No public decks yet.</div>
      {{ end }}
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
