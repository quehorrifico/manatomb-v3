{{ define "profile_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <link rel="stylesheet" href="/assets/profile.css">

  <main class="mt-profile-page max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <section class="mt-profile-hero">
      {{ if $ctx.Stats.AvatarImageURI }}
        <img src="{{ $ctx.Stats.AvatarImageURI }}" alt="" class="mt-profile-hero__art" aria-hidden="true">
      {{ end }}
      <div class="mt-profile-hero__shade" aria-hidden="true"></div>
      <div class="mt-profile-hero__content">
        <div class="mt-profile-avatar">
          {{ if $ctx.Stats.AvatarImageURI }}
            <img src="{{ $ctx.Stats.AvatarImageURI }}" alt="{{ $ctx.Stats.AvatarAlt }}">
          {{ else }}
            <span>MT</span>
          {{ end }}
        </div>

        <div class="mt-profile-identity">
          <p class="mt-kicker">Player Profile</p>
          <h1>{{ $ctx.Profile.DisplayName }}</h1>
          <p>Joined {{ $ctx.Stats.JoinedLabel }} · {{ len $ctx.Items }} public deck{{ if ne (len $ctx.Items) 1 }}s{{ end }}</p>
        </div>

        <div class="mt-profile-actions">
          <button type="button" id="profile-share" class="mt-btn mt-btn--secondary mt-btn--sm">Share Profile</button>
          {{ if $ctx.Stats.CanEdit }}
            <button type="button" class="mt-btn mt-btn--primary mt-btn--sm" data-profile-customize-open>Customize</button>
          {{ end }}
          <p id="profile-action-status" class="mt-profile-action-status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <dl class="mt-profile-stats" aria-label="Profile totals">
      <div>
        <dt>Public Decks</dt>
        <dd>{{ len $ctx.Items }}</dd>
      </div>
      <div>
        <dt>Favorite Printings</dt>
        <dd>{{ $ctx.FavoritePagination.Total }}</dd>
      </div>
      <div>
        <dt>Cards Won</dt>
        <dd>{{ $ctx.AwardTotal }}</dd>
      </div>
      <div>
        <dt>Favorite Colors</dt>
        <dd class="mt-profile-color-stat">
          {{ if $ctx.Stats.FavoriteColorPips }}
            <span class="inline-flex items-center gap-1" aria-label="{{ $ctx.Stats.FavoriteColorCombination }}">
              {{ range $ctx.Stats.FavoriteColorPips }}
                <img src="{{ .ImageURI }}" alt="" aria-hidden="true" class="mt-mana-pip">
                <span class="sr-only">{{ .Label }}</span>
              {{ end }}
            </span>
          {{ end }}
          <span>{{ $ctx.Stats.FavoriteColorCombination }}</span>
        </dd>
      </div>
    </dl>

    <section class="mt-profile-playstyle" aria-label="Playstyle">
      <div>
        <span>Usually Plays</span>
        <strong>{{ $ctx.Stats.UsuallyPlays }}</strong>
      </div>
      <div>
        <span>Published Deck Average</span>
        <strong>{{ $ctx.Stats.AveragePowerBracket }}</strong>
      </div>
      <div class="mt-profile-playstyle__tags">
        <span>Playstyle</span>
        {{ if $ctx.Stats.Likes }}
          <div>
            {{ range $ctx.Stats.Likes }}
              <span class="{{ publicTagChipClass . }}">{{ . }}</span>
            {{ end }}
          </div>
        {{ else }}
          <strong>Not enough data</strong>
        {{ end }}
      </div>
    </section>

    <nav class="mt-profile-tabs" aria-label="Profile sections">
      <a href="/users/{{ $ctx.Profile.ID }}"
         class="mt-profile-tab {{ if eq $ctx.ActiveTab "decks" }}mt-profile-tab--active{{ end }}"
         {{ if eq $ctx.ActiveTab "decks" }}aria-current="page"{{ end }}>
        Decks <span>{{ len $ctx.Items }}</span>
      </a>
      <a href="/users/{{ $ctx.Profile.ID }}?tab=favorites"
         class="mt-profile-tab {{ if eq $ctx.ActiveTab "favorites" }}mt-profile-tab--active{{ end }}"
         {{ if eq $ctx.ActiveTab "favorites" }}aria-current="page"{{ end }}>
        Favorites <span>{{ $ctx.FavoritePagination.Total }}</span>
      </a>
      <a href="/users/{{ $ctx.Profile.ID }}?tab=achievements"
         class="mt-profile-tab {{ if eq $ctx.ActiveTab "achievements" }}mt-profile-tab--active{{ end }}"
         {{ if eq $ctx.ActiveTab "achievements" }}aria-current="page"{{ end }}>
        Achievements <span>{{ $ctx.AwardTotal }}</span>
      </a>
    </nav>

    <div class="mt-profile-content">
      {{ if eq $ctx.ActiveTab "decks" }}
        <section aria-labelledby="profile-decks-title">
          <div class="mt-profile-section-head">
            <div>
              <p class="mt-kicker">Published Collection</p>
              <h2 id="profile-decks-title">Public Decks</h2>
              <p id="profile-deck-summary">{{ len $ctx.Items }} deck{{ if ne (len $ctx.Items) 1 }}s{{ end }}</p>
            </div>
            {{ if $ctx.Items }}
              <div class="mt-profile-deck-controls">
                <label>
                  <span>Filter</span>
                  <input id="profile-deck-filter" type="search" class="mt-control mt-control--sm" placeholder="Deck, commander, tag" autocomplete="off">
                </label>
                <label>
                  <span>Sort</span>
                  <select id="profile-deck-sort" class="mt-control mt-control--sm">
                    <option value="recent">Recently Published</option>
                    <option value="name">Deck Name</option>
                    <option value="format">Format</option>
                    <option value="power">Power</option>
                  </select>
                </label>
              </div>
            {{ end }}
          </div>

          {{ if $ctx.Items }}
            <div id="profile-deck-list" class="mt-profile-deck-grid">
              {{ range $index, $item := $ctx.Items }}
                <article class="mt-profile-deck"
                         data-profile-deck
                         data-order="{{ $index }}"
                         data-name="{{ $item.Name }}"
                         data-format="{{ $item.Format }}"
                         data-power="{{ $item.PowerBracket }}"
                         data-search="{{ $item.Name }} {{ $item.CommanderName }} {{ $item.Format }} {{ $item.Tags }} {{ $item.Description }}">
                  <a href="/decks/public/{{ $item.PublicSlug }}" class="mt-profile-deck__link" aria-label="Open {{ $item.Name }}"></a>
                  <div class="mt-profile-deck__media">
                    {{ if $item.CommanderArtCropURI }}
                      <img class="mt-profile-deck__image mt-profile-deck__image--art" src="{{ $item.CommanderArtCropURI }}" alt="{{ $item.CommanderName }}" loading="lazy">
                    {{ else if $item.CommanderImageURI }}
                      <img class="mt-profile-deck__image mt-profile-deck__image--card" src="{{ $item.CommanderImageURI }}" alt="{{ $item.CommanderName }}" loading="lazy">
                    {{ else }}
                      <span>{{ if $item.CommanderName }}Commander{{ else }}Deck{{ end }}</span>
                    {{ end }}
                  </div>
                  <div class="mt-profile-deck__body">
                    <div>
                      <h3>{{ $item.Name }}</h3>
                      {{ if $item.CommanderName }}<p>{{ $item.CommanderName }}</p>{{ end }}
                    </div>
                    {{ if $item.Description }}
                      <p class="mt-profile-deck__description">{{ $item.Description }}</p>
                    {{ end }}
                    <div class="mt-profile-deck__meta">
                      {{ if $item.ColorPips }}
                        <span class="inline-flex items-center gap-1" aria-label="{{ $item.ColorIdentityName }}">
                          {{ range $item.ColorPips }}
                            <img src="{{ .ImageURI }}" alt="" aria-hidden="true" class="mt-mana-pip">
                            <span class="sr-only">{{ .Label }}</span>
                          {{ end }}
                        </span>
                      {{ end }}
                      <span class="mt-chip">{{ if $item.Format }}{{ $item.Format }}{{ else }}Commander{{ end }}</span>
                      {{ if $item.PowerBracket }}<span class="mt-chip">{{ $item.PowerBracket }}</span>{{ end }}
                    </div>
                    {{ if $item.Tags }}
                      <div class="mt-profile-deck__tags">
                        {{ range splitTags $item.Tags }}<span class="{{ publicTagChipClass . }}">{{ . }}</span>{{ end }}
                      </div>
                    {{ end }}
                  </div>
                </article>
              {{ end }}
            </div>
            <div id="profile-deck-empty" class="mt-empty-state text-center hidden">No decks match this filter.</div>
          {{ else }}
            <div class="mt-empty-state text-center">No public decks yet.</div>
          {{ end }}
        </section>
      {{ else if eq $ctx.ActiveTab "favorites" }}
        <section aria-labelledby="profile-favorites-title">
          <div class="mt-profile-section-head">
            <div>
              <p class="mt-kicker">Card Collection</p>
              <h2 id="profile-favorites-title">Favorite Printings</h2>
              <p>{{ $ctx.FavoritePagination.Total }} saved art favorite{{ if ne $ctx.FavoritePagination.Total 1 }}s{{ end }}</p>
            </div>
            <div class="mt-profile-view-options" aria-label="Favorite printing view">
              <a href="/users/{{ $ctx.Profile.ID }}?tab=favorites&amp;favorites_view=grid"
                 class="{{ if eq $ctx.FavoriteView "grid" }}mt-profile-view-option--active{{ end }}"
                 {{ if eq $ctx.FavoriteView "grid" }}aria-current="page"{{ end }}>Grid</a>
              <a href="/users/{{ $ctx.Profile.ID }}?tab=favorites&amp;favorites_view=stacks"
                 class="{{ if eq $ctx.FavoriteView "stacks" }}mt-profile-view-option--active{{ end }}"
                 {{ if eq $ctx.FavoriteView "stacks" }}aria-current="page"{{ end }}>Stacks</a>
              <a href="/users/{{ $ctx.Profile.ID }}?tab=favorites&amp;favorites_view=text"
                 class="{{ if eq $ctx.FavoriteView "text" }}mt-profile-view-option--active{{ end }}"
                 {{ if eq $ctx.FavoriteView "text" }}aria-current="page"{{ end }}>Text</a>
              <a href="/users/{{ $ctx.Profile.ID }}?tab=favorites&amp;favorites_view=table"
                 class="{{ if eq $ctx.FavoriteView "table" }}mt-profile-view-option--active{{ end }}"
                 {{ if eq $ctx.FavoriteView "table" }}aria-current="page"{{ end }}>Table</a>
            </div>
          </div>

          {{ if $ctx.FavoritePrintings }}
            <div class="mt-profile-favorites mt-profile-favorites--{{ $ctx.FavoriteView }}">
              {{ range $ctx.FavoritePrintings }}
                <article class="mt-profile-favorite"
                         data-card-detail-root
                         data-oracle-id="{{ .OracleID }}"
                         data-scryfall-id="{{ .ScryfallID }}"
                         data-detail-path="{{ .DetailPath }}"
                         data-name="{{ .Name }}"
                         data-image-uri="{{ .ImageURI }}"
                         data-price="{{ .PriceUSD }}"
                         data-artist="{{ .Artist }}"
                         data-set-code="{{ .SetCode }}"
                         data-set-name="{{ .SetName }}"
                         data-released-at="{{ .ReleasedAt }}">
                  <button type="button" class="mt-profile-favorite__media" data-card-detail aria-label="View details for {{ .Name }}">
                    {{ if .ImageURI }}
                      <img src="{{ .ImageURI }}" alt="{{ .Name }}" loading="lazy">
                    {{ else }}
                      <span>No image</span>
                    {{ end }}
                  </button>
                  <div class="mt-profile-favorite__body">
                    <button type="button" class="mt-profile-favorite__name" data-card-detail>{{ .Name }}</button>
                    <p>{{ .SetLabel }}{{ if .CollectorNumber }} #{{ .CollectorNumber }}{{ end }}</p>
                    <div class="mt-profile-favorite__details">
                      <span>{{ .Rarity }}</span>
                      <span>{{ .PriceUSD }}</span>
                      <span>Artist: {{ .Artist }}</span>
                    </div>
                  </div>
                  {{ if $ctx.Stats.CanEdit }}
                    <form method="POST" action="/cards/favorites/printing" class="mt-profile-favorite__action">
                      <input type="hidden" name="scryfall_id" value="{{ .ScryfallID }}">
                      <input type="hidden" name="action" value="unfavorite">
                      <input type="hidden" name="return_to" value="{{ $ctx.FavoriteReturnTo }}">
                      <button type="submit" class="mt-btn mt-btn--secondary mt-btn--xs">Remove</button>
                    </form>
                  {{ end }}
                </article>
              {{ end }}
            </div>
          {{ else }}
            <div class="mt-empty-state text-center">No favorite printings yet.</div>
          {{ end }}

          {{ if gt $ctx.FavoritePagination.TotalPages 1 }}
            <nav class="mt-profile-pagination" aria-label="Favorite printings pages">
              {{ if $ctx.FavoritePagination.PrevURL }}<a href="{{ $ctx.FavoritePagination.PrevURL }}" class="mt-btn mt-btn--secondary mt-btn--xs">Previous</a>{{ end }}
              <span>Page {{ $ctx.FavoritePagination.Page }} of {{ $ctx.FavoritePagination.TotalPages }}</span>
              {{ if $ctx.FavoritePagination.NextURL }}<a href="{{ $ctx.FavoritePagination.NextURL }}" class="mt-btn mt-btn--secondary mt-btn--xs">Next</a>{{ end }}
            </nav>
          {{ end }}
        </section>
      {{ else }}
        <section aria-labelledby="profile-achievements-title">
          <div class="mt-profile-section-head">
            <div>
              <p class="mt-kicker">Trophy Case</p>
              <h2 id="profile-achievements-title">Achievements</h2>
              <p>{{ $ctx.AwardTotal }} daily card{{ if ne $ctx.AwardTotal 1 }}s{{ end }} won across Mana Tomb games</p>
            </div>
          </div>

          <div class="mt-profile-award-groups">
            <section class="mt-profile-award-group" aria-labelledby="guess-awards-title">
              <div class="mt-profile-award-group__head">
                <div>
                  <h3 id="guess-awards-title">Cards Guessed Correctly</h3>
                  <p>Daily Guess the Card wins</p>
                </div>
                <strong>{{ $ctx.GuessPagination.Total }}</strong>
              </div>
              {{ if $ctx.GuessAwards }}
                <div class="mt-profile-award-grid">
                  {{ range $ctx.GuessAwards }}
                    <article data-card-detail-root
                             data-oracle-id="{{ .OracleID }}"
                             data-detail-path="{{ .DetailPath }}"
                             data-name="{{ .CardName }}"
                             data-image-uri="{{ .ImageURI }}">
                      <button type="button" data-card-detail aria-label="View details for {{ .CardName }}">
                        {{ if .ImageURI }}<img src="{{ .ImageURI }}" alt="{{ .CardName }}" loading="lazy">{{ else }}<span>Won card</span>{{ end }}
                      </button>
                      <div><strong>{{ .CardName }}</strong><span>{{ .GuessCount }} guesses</span></div>
                    </article>
                  {{ end }}
                </div>
              {{ else }}
                <p class="mt-profile-award-empty">No daily Guess the Card wins yet.</p>
              {{ end }}
              {{ if gt $ctx.GuessPagination.TotalPages 1 }}
                <nav class="mt-profile-pagination" aria-label="Cards guessed correctly pages">
                  {{ if $ctx.GuessPagination.PrevURL }}<a href="{{ $ctx.GuessPagination.PrevURL }}" class="mt-btn mt-btn--secondary mt-btn--xs">Previous</a>{{ end }}
                  <span>Page {{ $ctx.GuessPagination.Page }} of {{ $ctx.GuessPagination.TotalPages }}</span>
                  {{ if $ctx.GuessPagination.NextURL }}<a href="{{ $ctx.GuessPagination.NextURL }}" class="mt-btn mt-btn--secondary mt-btn--xs">Next</a>{{ end }}
                </nav>
              {{ end }}
            </section>

            <section class="mt-profile-award-group" aria-labelledby="tombscript-awards-title">
              <div class="mt-profile-award-group__head">
                <div>
                  <h3 id="tombscript-awards-title">Tombscript Cards Won</h3>
                  <p>Daily Tombscript wins</p>
                </div>
                <strong>{{ $ctx.SpellifyPagination.Total }}</strong>
              </div>
              {{ if $ctx.SpellifyAwards }}
                <div class="mt-profile-award-grid mt-profile-award-grid--tombscript">
                  {{ range $ctx.SpellifyAwards }}
                    <article data-card-detail-root
                             data-oracle-id="{{ .OracleID }}"
                             data-detail-path="{{ .DetailPath }}"
                             data-name="{{ .CardName }}"
                             data-image-uri="{{ .ImageURI }}">
                      <button type="button" data-card-detail aria-label="View details for {{ .CardName }}">
                        {{ if .ImageURI }}<img src="{{ .ImageURI }}" alt="{{ .CardName }}" loading="lazy">{{ else }}<span>Won card</span>{{ end }}
                      </button>
                      <div><strong>{{ .CardName }}</strong><span>{{ .GuessCount }} reveal guesses</span></div>
                    </article>
                  {{ end }}
                </div>
              {{ else }}
                <p class="mt-profile-award-empty">No daily Tombscript wins yet.</p>
              {{ end }}
              {{ if gt $ctx.SpellifyPagination.TotalPages 1 }}
                <nav class="mt-profile-pagination" aria-label="Tombscript cards pages">
                  {{ if $ctx.SpellifyPagination.PrevURL }}<a href="{{ $ctx.SpellifyPagination.PrevURL }}" class="mt-btn mt-btn--secondary mt-btn--xs">Previous</a>{{ end }}
                  <span>Page {{ $ctx.SpellifyPagination.Page }} of {{ $ctx.SpellifyPagination.TotalPages }}</span>
                  {{ if $ctx.SpellifyPagination.NextURL }}<a href="{{ $ctx.SpellifyPagination.NextURL }}" class="mt-btn mt-btn--secondary mt-btn--xs">Next</a>{{ end }}
                </nav>
              {{ end }}
            </section>
          </div>
        </section>
      {{ end }}
    </div>
  </main>

  {{ if $ctx.Stats.CanEdit }}
    <div id="profile-customize-modal" class="mt-modal hidden" role="dialog" aria-modal="true" aria-labelledby="profile-customize-title">
      <div class="mt-modal-panel mt-profile-customize-panel">
        <button type="button" class="mt-btn mt-btn--secondary mt-btn--sm mt-profile-customize-close" data-profile-customize-close>Close</button>
        <p class="mt-kicker">Profile Art</p>
        <h2 id="profile-customize-title">Customize Profile</h2>
        <p class="mt-profile-customize-copy">Choose art from one of your commanders or search for any card.</p>

        {{ if $ctx.Stats.AvatarChoices }}
          <div class="mt-profile-avatar-choices">
            {{ range $ctx.Stats.AvatarChoices }}
              <form method="POST" action="/profile/avatar">
                <input type="hidden" name="commander_name" value="{{ .Name }}">
                <button type="submit" class="{{ if .IsSelected }}mt-profile-avatar-choice--selected{{ end }}" aria-label="Use {{ .Name }} as profile art">
                  <img src="{{ .ImageURI }}" alt="">
                  <span>{{ .Name }}</span>
                </button>
              </form>
            {{ end }}
          </div>
        {{ end }}

        <form method="POST" action="/profile/avatar" class="mt-profile-avatar-search">
          <label for="profile-avatar-card">Search card art</label>
          <div>
            <input id="profile-avatar-card" name="commander_name" type="search" autocomplete="off" placeholder="Card name" class="mt-control">
            <button type="submit" class="mt-btn mt-btn--primary">Use Art</button>
          </div>
        </form>

        <div class="mt-profile-customize-footer">
          <form method="POST" action="/profile/avatar">
            <input type="hidden" name="commander_name" value="">
            <button type="submit" class="mt-btn mt-btn--secondary mt-btn--sm">Reset Art</button>
          </form>
          <a href="/settings" class="mt-btn mt-btn--secondary mt-btn--sm">Account Settings</a>
        </div>
      </div>
    </div>
  {{ end }}

  {{ template "card_detail_modal" . }}
  {{ template "card_detail_modal_script" . }}
  <script src="/assets/profile.js"></script>
  {{ template "layout_footer" . }}
{{ end }}
