{{ define "decks_workbench_return_seed" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-3xl mx-auto py-10 px-4 space-y-5">
    <section class="mt-panel p-5 sm:p-6 space-y-4">
      <div class="space-y-2">
        <p class="mt-kicker">Playtest</p>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-100">Returning to deck.</h1>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="/" class="mt-btn mt-btn--secondary">Home</a>
        <a href="{{ $ctx.NextPath }}" class="mt-btn mt-btn--primary">Open Deck</a>
      </div>
    </section>
  </main>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var payload = {{ $ctx.PayloadJSON }};
    var key = {{ printf "%q" $ctx.StorageKey }};
    var nextURL = {{ printf "%q" $ctx.NextPath }};

    try {
      if (!payload || typeof payload !== 'object') payload = {};
      payload.updatedAt = new Date().toISOString();
      var raw = JSON.stringify(payload);
      localStorage.setItem(key, raw);
      try {
        sessionStorage.setItem(key + '.playtestReturn', raw);
      } catch (e) {
        // ignore session storage failures
      }
    } catch (e) {
      // ignore storage failures
    }

    window.location.replace(nextURL);
  });
  </script>

  {{ template "layout_footer" . }}
{{ end }}
