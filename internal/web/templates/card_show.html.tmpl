{{ define "card_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-5xl mx-auto py-10 px-4 space-y-6">
    <div class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Card Detail</h1>
    </div>

    <div data-deck-action-status hidden class="rounded-2xl border px-4 py-3">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p data-deck-action-status-text class="text-sm font-medium"></p>
        <a data-deck-action-status-link href="#" class="hidden text-sm font-semibold text-sky-300 transition-colors hover:text-sky-200">Open deck</a>
      </div>
    </div>

    <section class="rounded-2xl border border-slate-800 bg-slate-950/35 p-5 sm:p-6">
      <div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-8 items-start">
        <div class="space-y-3">
          <div class="mx-auto w-full max-w-[18rem] overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/70 shadow-lg shadow-slate-950/50 lg:mx-0">
            <div class="bg-slate-950">
              {{ if $ctx.Card.ImageURI }}
                <img
                  src="{{ $ctx.Card.ImageURI }}"
                  alt="{{ $ctx.Card.Name }}"
                  data-card-hero-image
                  class="block w-full h-auto"
                />
              {{ else }}
                <img
                  src=""
                  alt=""
                  data-card-hero-image
                  class="hidden w-full h-auto"
                />
              {{ end }}

              <div
                data-card-hero-fallback
                class="{{ if $ctx.Card.ImageURI }}hidden{{ end }} flex aspect-[3/4] items-center justify-center px-6 text-center text-sm text-slate-400">
                No image available
              </div>
            </div>
          </div>

          <div data-card-face-tabs class="flex flex-wrap gap-1.5 {{ if not $ctx.Card.Faces }}hidden{{ end }}"></div>
          <p data-card-face-hint class="text-xs text-slate-500 {{ if not $ctx.Card.Faces }}hidden{{ end }}">
            Multi-face cards can be previewed here without leaving the page.
          </p>
        </div>

        <div class="space-y-4">
          <div class="space-y-3">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div class="space-y-2 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 data-card-name class="text-xl font-semibold text-slate-50">{{ $ctx.Card.Name }}</h2>
                  <div data-card-mana class="flex flex-wrap items-center gap-1">
                    {{ if $ctx.Card.ManaCost }}
                      <span class="mt-chip font-mono">{{ $ctx.Card.ManaCost }}</span>
                    {{ end }}
                  </div>
                </div>
                <p data-card-type class="text-sm text-slate-400">{{ $ctx.Card.TypeLine }}</p>
              </div>

              <div class="flex flex-wrap gap-2 md:justify-end">
                {{ if .CurrentUser }}
                  <button type="button"
                          class="mt-btn mt-btn--primary mt-btn--sm"
                          data-open-deck-picker
                          data-card-name="{{ $ctx.Card.Name }}">
                    Add To Deck
                  </button>
                {{ else }}
                  <a href="/login?next={{ urlquery $ctx.CurrentPath }}" class="mt-btn mt-btn--primary mt-btn--sm">
                    Add To Deck
                  </a>
                {{ end }}
                <a
                  href="{{ if $ctx.Card.ScryfallURI }}{{ $ctx.Card.ScryfallURI }}{{ else }}#{{ end }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-card-scryfall-link
                  class="mt-btn mt-btn--secondary mt-btn--sm {{ if not $ctx.Card.ScryfallURI }}hidden{{ end }}">
                  Scryfall
                </a>
              </div>
            </div>

            <div data-card-printing-group class="{{ if le (len $ctx.Printings) 1 }}hidden{{ end }}">
              <label class="block text-sm text-slate-200">
                <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Printing</span>
                <select data-card-printing-select class="mt-control mt-2">
                  {{ range $idx, $printing := $ctx.Printings }}
                    <option value="{{ $idx }}">
                      {{ $printing.SetName }}{{ if $printing.SetCode }} ({{ $printing.SetCode }}){{ end }}{{ if $printing.CollectorNumber }} #{{ $printing.CollectorNumber }}{{ end }}{{ if $printing.ReleasedAt }} · {{ $printing.ReleasedAt }}{{ end }}
                    </option>
                  {{ end }}
                </select>
              </label>
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/30 px-4 py-4 sm:px-5">
            <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
              <div class="flex items-start justify-between gap-4">
                <dt class="text-sm text-slate-500">Mana Value</dt>
                <dd class="text-sm font-semibold text-slate-100">{{ $ctx.Card.ManaValue }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-sm text-slate-500">Colors</dt>
                <dd class="text-sm font-semibold text-slate-100 text-right">{{ $ctx.Card.Colors }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-t border-slate-800/80 pt-3">
                <dt class="text-sm text-slate-500">Color Identity</dt>
                <dd class="text-sm font-semibold text-slate-100 text-right">{{ $ctx.Card.ColorIdentity }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-t border-slate-800/80 pt-3">
                <dt class="text-sm text-slate-500">Commander</dt>
                <dd class="text-sm font-semibold text-slate-100 text-right">{{ $ctx.Card.CommanderStatus }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-t border-slate-800/80 pt-3">
                <dt class="text-sm text-slate-500">Price</dt>
                <dd class="text-sm font-semibold text-slate-100 text-right">{{ $ctx.Card.PriceUSD }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-t border-slate-800/80 pt-3">
                <dt class="text-sm text-slate-500">Artist</dt>
                <dd class="text-sm font-semibold text-slate-100 text-right">{{ $ctx.Card.Artist }}</dd>
              </div>
            </dl>
          </div>

          <section class="rounded-xl border border-slate-800 bg-slate-950/30 px-4 py-4 sm:px-5">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Oracle Text</p>
              </div>
              <div data-card-oracle class="text-sm leading-7 text-slate-100 whitespace-pre-line">{{ $ctx.Card.OracleText }}</div>
            </div>
          </section>

          <section data-card-flavor-group class="rounded-xl border border-slate-800 bg-slate-950/30 px-4 py-4 sm:px-5" {{ if not $ctx.Card.FlavorText }}hidden{{ end }}>
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Flavor Text</p>
              </div>
              <div data-card-flavor class="text-sm leading-7 italic text-slate-300 whitespace-pre-line">{{ $ctx.Card.FlavorText }}</div>
            </div>
          </section>

          <details class="rounded-xl border border-slate-800 bg-slate-950/20 px-4 py-4 sm:px-5">
            <summary class="cursor-pointer list-none">
              <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-semibold text-slate-100">Additional Details</p>
                <p class="text-xs text-slate-500">Layout, EDHREC, and oracle identifier</p>
              </div>
            </summary>

            <dl class="grid gap-x-6 gap-y-3 pt-4 sm:grid-cols-2">
              <div class="flex items-start justify-between gap-4">
                <dt class="text-sm text-slate-500">Layout</dt>
                <dd class="text-sm font-semibold text-slate-100">{{ $ctx.Card.Layout }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-sm text-slate-500">EDHREC Rank</dt>
                <dd class="text-sm font-semibold text-slate-100">{{ $ctx.Card.EDHRecRank }}</dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-t border-slate-800/80 pt-3 sm:col-span-2">
                <dt class="text-sm text-slate-500">Oracle ID</dt>
                <dd class="text-xs font-semibold text-slate-100 break-all text-right">{{ $ctx.Card.OracleID }}</dd>
              </div>
            </dl>
          </details>
        </div>
      </div>
    </section>

    <section class="space-y-3">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-slate-100">
            Printings <span data-printings-count class="ml-1 text-xs text-slate-500">({{ len $ctx.Printings }})</span>
          </h2>
          <p class="text-sm text-slate-400">Browse available versions and promote any printing into the main detail area above.</p>
        </div>

        <div class="flex flex-wrap gap-3">
          <label class="block text-sm text-slate-200">
            <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Sort</span>
            <select data-printings-sort class="mt-control mt-control--sm">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="price_low">Cheapest first</option>
              <option value="price_high">Most expensive first</option>
              <option value="set">Set name A-Z</option>
            </select>
          </label>

          <label class="mt-check-pill self-end">
            <input type="checkbox" data-printings-english-only class="rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500">
            <span>English only</span>
          </label>
        </div>
      </div>

      <div data-printings-empty hidden class="mt-empty-state">
        <p class="text-sm text-slate-300">No printings match the current compare filters.</p>
      </div>

      <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-950/20 divide-y divide-slate-800/80" data-printings-list></div>
    </section>

    {{ template "saved_deck_picker" . }}
  </main>

  {{ template "card_ui_helpers_script" . }}
  {{ template "saved_deck_picker_script" . }}
  {{ template "card_show_script" . }}
  {{ template "layout_footer" . }}
{{ end }}
