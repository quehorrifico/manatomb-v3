{{ define "card_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <div class="mt-card-page">
    <div data-deck-action-status hidden class="mt-card-status" role="status">
      <p data-deck-action-status-text></p>
      <a data-deck-action-status-link class="hidden">Open deck</a>
    </div>

    <section class="mt-card-hero" aria-labelledby="card-detail-title">
      <div class="mt-card-visual">
        <div class="mt-card-art-shell" data-card-hero-shell>
          {{ if $ctx.Card.ImageURI }}
            <img
              src="{{ $ctx.Card.ImageURI }}"
              alt="{{ $ctx.Card.Name }}"
              data-card-hero-image
              class="mt-card-art-rotatable mt-card-art"
            />
          {{ else }}
            <img
              alt=""
              data-card-hero-image
              class="mt-card-art-rotatable mt-card-art hidden"
            />
          {{ end }}

          <div
            data-card-hero-fallback
            class="mt-card-art-fallback {{ if $ctx.Card.ImageURI }}hidden{{ end }}">
            No image available
          </div>
        </div>

        <div data-card-face-tabs class="mt-card-face-controls {{ if not $ctx.Card.Faces }}hidden{{ end }}"></div>
      </div>

      <article class="mt-card-info">
        <section class="mt-card-primary-group" aria-label="Card details">
          <div class="mt-card-primary-head">
            <h1 id="card-detail-title" data-card-name class="mt-card-primary-line">{{ $ctx.Card.Name }}</h1>
            {{ if .CurrentUser }}
              <div class="mt-card-action-stack">
                <div class="mt-card-actions" aria-label="Card actions">
                  <form method="POST" action="/cards/favorites/printing" data-card-favorite-form>
                    <input type="hidden" name="scryfall_id" value="{{ $ctx.Card.ScryfallID }}" data-card-favorite-scryfall-id>
                    <input type="hidden" name="favorite_action" value="{{ if $ctx.SelectedPrintingIsFavorited }}unfavorite{{ else }}favorite{{ end }}" data-card-favorite-action>
                    <input type="hidden" name="return_to" value="{{ $ctx.CurrentPath }}" data-card-favorite-return-to>
                    <button type="submit"
                            class="mt-heart-button{{ if $ctx.SelectedPrintingIsFavorited }} is-loved{{ end }}"
                            title="{{ if $ctx.SelectedPrintingIsFavorited }}Remove this printing from favorites{{ else }}Favorite this printing{{ end }}"
                            aria-label="{{ if $ctx.SelectedPrintingIsFavorited }}Remove this printing from favorites{{ else }}Favorite this printing{{ end }}"
                            {{ if not $ctx.Card.ScryfallID }}disabled{{ end }}
                            data-card-favorite-button>
                      <span class="mt-heart-button__symbol" data-card-favorite-symbol aria-hidden="true">{{ if $ctx.SelectedPrintingIsFavorited }}♥{{ else }}♡{{ end }}</span>
                    </button>
                  </form>
                  <button type="button"
                          class="mt-btn mt-btn--primary mt-btn--sm"
                          data-open-deck-picker
                          data-card-name="{{ $ctx.Card.Name }}">
                    Add To Deck
                  </button>
                  <details class="mt-card-profile-art" data-card-profile-art-menu>
                    <summary class="mt-btn mt-btn--secondary mt-btn--sm">Use Art</summary>
                    <div class="mt-card-profile-art__menu">
                      <form method="POST" action="/profile/art" data-card-profile-art-form>
                        <input type="hidden" name="target" value="picture">
                        <input type="hidden" name="scryfall_id" value="{{ $ctx.Card.ScryfallID }}" data-card-profile-art-scryfall-id>
                        <input type="hidden" name="return_to" value="{{ $ctx.CurrentPath }}">
                        <button type="submit">Set as profile picture</button>
                      </form>
                      <form method="POST" action="/profile/art" data-card-profile-art-form>
                        <input type="hidden" name="target" value="background">
                        <input type="hidden" name="scryfall_id" value="{{ $ctx.Card.ScryfallID }}" data-card-profile-art-scryfall-id>
                        <input type="hidden" name="return_to" value="{{ $ctx.CurrentPath }}">
                        <button type="submit">Set as profile background</button>
                      </form>
                    </div>
                  </details>
                </div>
                <p class="mt-card-profile-art__status" data-card-profile-art-status role="status" aria-live="polite"></p>
                <p class="mt-card-favorite-context"
                   data-card-favorite-context
                   role="status"
                   aria-live="polite"
                   {{ if eq $ctx.FavoritePrintingCount 0 }}hidden{{ end }}>
                  {{ if $ctx.SelectedPrintingIsFavorited }}
                    {{ if eq $ctx.OtherFavoritePrintingCount 1 }}
                      This printing and 1 other are in your favorites.
                    {{ else if gt $ctx.OtherFavoritePrintingCount 1 }}
                      This printing and {{ $ctx.OtherFavoritePrintingCount }} others are in your favorites.
                    {{ else }}
                      This printing is in your favorites.
                    {{ end }}
                  {{ else if eq $ctx.OtherFavoritePrintingCount 1 }}
                    You favorited another printing.
                  {{ else if gt $ctx.OtherFavoritePrintingCount 1 }}
                    You favorited {{ $ctx.OtherFavoritePrintingCount }} other printings.
                  {{ end }}
                </p>
              </div>
            {{ else }}
              <div class="mt-card-actions" aria-label="Card actions">
                <a href="/login?next={{ urlquery $ctx.CurrentPath }}"
                   class="mt-btn mt-btn--primary mt-btn--sm"
                   data-card-add-login-link>
                  Add To Deck
                </a>
              </div>
            {{ end }}
          </div>

          <div data-card-mana class="mt-card-primary-line mt-card-primary-mana">
            {{ if $ctx.Card.ManaCost }}<span class="font-mono">{{ $ctx.Card.ManaCost }}</span>{{ else }}No mana cost{{ end }}
          </div>
          <p data-card-type class="mt-card-primary-line">{{ $ctx.Card.TypeLine }}</p>
          <div data-card-oracle class="mt-card-primary-line mt-card-primary-rules whitespace-pre-line">{{ $ctx.Card.OracleText }}</div>
          <div data-card-flavor-group class="mt-card-primary-line mt-card-primary-flavor" {{ if not $ctx.Card.FlavorText }}hidden{{ end }}>
            <div data-card-flavor class="whitespace-pre-line">{{ $ctx.Card.FlavorText }}</div>
          </div>
          <p data-card-power-toughness class="mt-card-primary-line" {{ if not $ctx.Card.HasPowerToughness }}hidden{{ end }}>
            <span data-card-power>{{ $ctx.Card.Power }}</span>/<span data-card-toughness>{{ $ctx.Card.Toughness }}</span>
          </p>
          <p class="mt-card-primary-line">
            <span class="sr-only">Price: </span><span data-card-price>{{ $ctx.Card.PriceUSD }}</span>
          </p>
          <p class="mt-card-primary-line">
            Artist — <span data-card-artist>{{ $ctx.Card.Artist }}</span>
          </p>
          <section class="mt-card-format-legalities" aria-labelledby="card-format-legalities-title">
            <h2 id="card-format-legalities-title" class="mt-card-primary-line mt-card-format-legalities__title">
              Format legalities
            </h2>
            <ul data-card-format-legalities class="mt-card-format-legalities__list">
              {{ range $ctx.Card.Legalities }}
                <li>
                  <span class="mt-card-format-legalities__format">{{ .Format }}</span>
                  <span class="mt-card-format-legalities__status" data-legality-status="{{ .Status }}">{{ .StatusLabel }}</span>
                </li>
              {{ else }}
                <li class="mt-card-format-legalities__empty">Legality data unavailable.</li>
              {{ end }}
            </ul>
          </section>
        </section>

        <section class="mt-card-printing-group" aria-labelledby="card-printing-title">
          <h2 id="card-printing-title" class="sr-only">Printing details</h2>
          <dl class="mt-card-printing-facts">
            <div>
              <dt>Set name</dt>
              <dd data-card-set>{{ $ctx.Card.SetName }}</dd>
            </div>
            <div>
              <dt>Set code</dt>
              <dd data-card-set-code>{{ $ctx.Card.SetCode }}</dd>
            </div>
            <div>
              <dt>Collector number</dt>
              <dd data-card-collector>{{ $ctx.Card.CollectorNumber }}</dd>
            </div>
            <div>
              <dt>Rarity</dt>
              <dd data-card-rarity>{{ $ctx.Card.Rarity }}</dd>
            </div>
          </dl>
        </section>

        <details class="mt-card-more">
          <summary>Technical details</summary>
          <dl class="mt-card-facts">
            <div class="mt-card-fact">
              <dt>Mana Value</dt>
              <dd data-card-mana-value>{{ $ctx.Card.ManaValue }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Colors</dt>
              <dd data-card-colors>{{ $ctx.Card.Colors }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Color Identity</dt>
              <dd data-card-color-identity>{{ $ctx.Card.ColorIdentity }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Loyalty</dt>
              <dd data-card-loyalty>{{ $ctx.Card.Loyalty }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Released</dt>
              <dd data-card-released>{{ $ctx.Card.ReleasedAt }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Language</dt>
              <dd data-card-lang>{{ $ctx.Card.Lang }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Layout</dt>
              <dd data-card-layout>{{ $ctx.Card.Layout }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>EDHREC Rank</dt>
              <dd data-card-edhrec>{{ $ctx.Card.EDHRecRank }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Oracle ID</dt>
              <dd data-card-oracle-id class="mt-card-id">{{ $ctx.Card.OracleID }}</dd>
            </div>
            <div class="mt-card-fact">
              <dt>Scryfall ID</dt>
              <dd data-card-scryfall-id class="mt-card-id">{{ if $ctx.Card.ScryfallID }}{{ $ctx.Card.ScryfallID }}{{ else }}N/A{{ end }}</dd>
            </div>
          </dl>
        </details>
      </article>
    </section>

    <section class="mt-printings-section" aria-labelledby="printings-title">
      <header class="mt-printings-header">
        <h2 id="printings-title">
          Printings <span data-printings-count></span>
        </h2>

        <div class="mt-printings-controls">
          <label class="mt-printings-sort">
            <span class="mt-printings-sort__label">Sort</span>
            <select data-printings-sort class="mt-printings-sort__select">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="price_low">Cheapest first</option>
              <option value="price_high">Most expensive first</option>
              <option value="set">Set name A-Z</option>
            </select>
          </label>
        </div>
      </header>

      <div data-printings-empty hidden class="mt-card-empty">
        No printings available.
      </div>

      <div class="mt-printings-grid" data-printings-grid></div>
    </section>

    {{ template "saved_deck_picker" . }}
  </div>

  {{ template "card_ui_helpers_script" . }}
  {{ template "saved_deck_picker_script" . }}
  {{ template "card_show_script" . }}
  {{ template "layout_footer" . }}
{{ end }}
