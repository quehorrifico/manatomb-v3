{{ define "guess_card" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <div class="mt-guess-game">
    <header class="mt-guess-game__top">
      <div class="mt-guess-game__heading">
        <h1>Guess the Card</h1>
        {{ if and (not $ctx.Completed) (gt $ctx.PossibleCardsTotal 0) }}
          <p class="mt-guess-game__possible" aria-live="polite">Possible Cards Left {{ $ctx.PossibleCardsLeft }}</p>
        {{ end }}
      </div>
      <button type="button" class="mt-btn mt-btn--secondary mt-btn--sm mt-guess-game__help-button" data-guess-card-help-open>
        How to Play
      </button>
    </header>

    {{ if $.Flash }}
      <p class="sr-only" role="status" data-guess-card-announcement>{{ $.Flash }}</p>
    {{ end }}

    <div class="mt-guess-game__board" id="play-area" tabindex="-1">
      <section class="mt-guess-game__stage{{ if $ctx.Completed }} mt-guess-game__stage--completed{{ end }}" aria-label="Mystery card">
        <figure class="mt-guess-game__card{{ if $ctx.Completed }} mt-guess-game__card--revealed{{ else }} mt-guess-game__card--hidden{{ end }}">
          {{ if $ctx.Completed }}
            <a href="{{ $ctx.TargetDetailPath }}" class="mt-guess-game__card-link" aria-label="View {{ $ctx.TargetName }} card details">
              {{ if $ctx.TargetImageURI }}
                <img src="{{ $ctx.TargetImageURI }}" alt="{{ $ctx.TargetName }}">
              {{ else }}
                <span class="mt-guess-game__card-fallback">{{ $ctx.TargetName }}</span>
              {{ end }}
            </a>
          {{ else }}
            <div class="mt-guess-game__card-back" aria-hidden="true">
              <img src="https://cards.scryfall.io/back.png" alt="">
            </div>
            <figcaption class="sr-only">Mystery card</figcaption>
          {{ end }}
        </figure>

        {{ if $ctx.Completed }}
          <section class="mt-guess-game__result{{ if $ctx.Won }} mt-guess-game__result--won{{ else }} mt-guess-game__result--lost{{ end }}" aria-labelledby="guess-card-result-title">
            <p class="mt-guess-game__eyebrow">{{ if $ctx.Won }}Solved{{ else }}Revealed{{ end }}</p>
            <h2 id="guess-card-result-title">{{ $ctx.TargetName }}</h2>
            <div class="mt-guess-game__result-actions">
              <form method="POST" action="/games/guess-card">
                <input type="hidden" name="action" value="new">
                <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
                <button type="submit" class="mt-btn mt-btn--primary">Play Again</button>
              </form>
              {{ if .CurrentUser }}
                <a href="/users/{{ .CurrentUser.ID }}" class="mt-btn mt-btn--secondary">Profile</a>
              {{ else }}
                <a href="/login?next=/games/guess-card" class="mt-btn mt-btn--secondary">Sign In</a>
              {{ end }}
            </div>
          </section>
        {{ else }}
          <div class="mt-guess-game__stage-tools">
            <section class="mt-guess-game__clues" aria-labelledby="guess-card-clues-title">
              <h2 id="guess-card-clues-title">Revealed clues</h2>
              {{ if $ctx.Clues }}
                <dl class="mt-guess-game__clue-list">
                  {{ range $ctx.Clues }}
                    <div{{ if or (eq .Label "Rules text") (eq .Label "Flavor text") }} class="mt-guess-game__clue-item--wide"{{ end }}>
                      <dt>{{ .Label }}</dt>
                      <dd>{{ if .ValueHTML }}{{ .ValueHTML }}{{ else }}{{ .Value }}{{ end }}</dd>
                    </div>
                  {{ end }}
                </dl>
              {{ else }}
                <p class="mt-guess-game__empty">None yet.</p>
              {{ end }}
            </section>

            {{ if $ctx.CanGuess }}
              <section id="exact-guess" class="mt-guess-game__guess" aria-labelledby="guess-card-final-title" tabindex="-1">
                <div class="mt-guess-game__guess-heading">
                  <h2 id="guess-card-final-title">Name the card</h2>
                  {{ if and $ctx.IsDaily $ctx.HasAccount (gt $ctx.AwardGuessesLeft 0) }}
                    <span>{{ $ctx.AwardGuessesLeft }} award {{ if eq $ctx.AwardGuessesLeft 1 }}guess{{ else }}guesses{{ end }}</span>
                  {{ end }}
                </div>
                <form method="POST" action="/games/guess-card" class="mt-guess-game__guess-form" data-guess-card-guess-form>
                  <input type="hidden" name="action" value="guess">
                  <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
                  <input type="hidden" name="guess_number" value="{{ $ctx.NextGuessNumber }}">
                  <div class="mt-guess-game__guess-field" data-card-autocomplete-root>
                    <label for="guess-card-final" class="sr-only">Exact card name</label>
                    <input
                      id="guess-card-final"
                      name="guess"
                      type="search"
                      autocomplete="off"
                      placeholder="Exact card name"
                      class="mt-control"
                      role="combobox"
                      aria-autocomplete="list"
                      aria-controls="guess-card-final-results"
                      aria-expanded="false"
                      aria-haspopup="listbox"
                      required
                      data-card-autocomplete-submit="false"
                      data-card-autocomplete-input>
                    <div
                      id="guess-card-final-results"
                      class="mt-autocomplete-menu mt-guess-game__autocomplete hidden"
                      role="listbox"
                      data-card-autocomplete-menu></div>
                  </div>
                  <button type="submit" class="mt-btn mt-btn--primary">Guess</button>
                </form>
                <form method="POST" action="/games/guess-card" class="mt-guess-game__give-up" data-guess-card-reveal-form>
                  <input type="hidden" name="action" value="give_up">
                  <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
                  <button type="submit">Reveal card</button>
                </form>
              </section>
            {{ end }}
          </div>
        {{ end }}
      </section>

      <div class="mt-guess-game__lower{{ if $ctx.Completed }} mt-guess-game__lower--completed{{ end }}">
        <section class="mt-guess-game__history" aria-labelledby="guess-card-history-title" aria-live="polite">
          <h2 id="guess-card-history-title">Asked so far</h2>
          {{ if $ctx.History }}
            <ol id="latest-reveal" class="mt-guess-game__history-list" tabindex="-1" data-guess-latest-reveal>
              {{ range $ctx.History }}
                <li>
                  <span class="mt-guess-game__turn">Q{{ .Number }}</span>
                  <p>{{ .Question }}</p>
                  <span class="mt-guess-game__answer{{ if .Yes }} mt-guess-game__answer--yes{{ else }} mt-guess-game__answer--no{{ end }}">{{ .Answer }}</span>
                </li>
              {{ end }}
            </ol>
          {{ else }}
            <p class="mt-guess-game__empty">No questions yet.</p>
          {{ end }}
        </section>

        {{ if not $ctx.Completed }}
          <section id="question-board" class="mt-guess-game__questions" aria-labelledby="guess-card-questions-title" tabindex="-1" data-guess-question-board>
            <div class="mt-guess-game__section-heading">
              <h2 id="guess-card-questions-title">Questions</h2>
              <p class="mt-guess-game__question-count" aria-live="polite">{{ $ctx.QuestionsLeft }} left</p>
            </div>
            <p id="guess-card-question-help" class="sr-only">Choose a question. It is submitted immediately.</p>

            <div class="mt-guess-game__question-scroll">
              {{ if and $ctx.CanAsk $ctx.QuestionGroups }}
                <form method="POST" action="/games/guess-card" aria-describedby="guess-card-question-help" data-guess-card-question-form>
                  <input type="hidden" name="action" value="question">
                  <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
                  <div class="mt-guess-game__question-carousel" data-guess-question-carousel>
                    <div class="mt-guess-game__question-carousel-controls" role="group" aria-label="Question categories">
                      <button type="button" aria-label="Previous question categories" aria-controls="guess-card-question-pages" data-guess-question-previous>
                        <span aria-hidden="true">&lsaquo;</span>
                      </button>
                      <p aria-live="polite" data-guess-question-page-label>Color &amp; Rules Text</p>
                      <button type="button" aria-label="Next question categories" aria-controls="guess-card-question-pages" data-guess-question-next>
                        <span aria-hidden="true">&rsaquo;</span>
                      </button>
                    </div>
                    <div id="guess-card-question-pages" class="mt-guess-game__question-carousel-viewport" data-guess-question-viewport>
                      <div class="mt-guess-game__question-carousel-track">
                        <section class="mt-guess-game__question-groups mt-guess-game__question-page" aria-label="Color and Rules Text questions" data-guess-question-page data-page-label="Color &amp; Rules Text">
                          {{ range $ctx.QuestionGroups }}
                            {{ if or (eq .Name "Color") (eq .Name "Rules text") }}
                              {{ template "guess_card_question_group" . }}
                            {{ end }}
                          {{ end }}
                        </section>
                        <section class="mt-guess-game__question-groups mt-guess-game__question-page" aria-label="Card Type and Mana Value questions" data-guess-question-page data-page-label="Card Type &amp; Mana Value">
                          {{ range $ctx.QuestionGroups }}
                            {{ if or (eq .Name "Card type") (eq .Name "Mana value") }}
                              {{ template "guess_card_question_group" . }}
                            {{ end }}
                          {{ end }}
                        </section>
                      </div>
                    </div>
                  </div>
                </form>
              {{ else }}
                <p class="mt-guess-game__empty">No questions left.</p>
              {{ end }}
            </div>
          </section>
        {{ end }}
      </div>
    </div>
  </div>

  <div
    id="guess-card-help-modal"
    class="mt-modal mt-guess-help hidden"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="guess-card-help-title"
    aria-describedby="guess-card-help-description"
    data-auto-open="true"
    data-guess-card-help-modal
    hidden>
    <div class="mt-modal-panel mt-guess-help__panel" tabindex="-1" data-guess-card-help-panel>
      <button type="button" class="mt-guess-help__close" aria-label="Close How to Play" data-guess-card-help-close>
        <span aria-hidden="true">×</span>
      </button>
      <h2 id="guess-card-help-title">How to Play</h2>
      <div id="guess-card-help-description" class="mt-guess-help__content">
        <ol>
          <li>Ask up to eight yes-or-no questions.</li>
          <li>Each answer reveals another card clue.</li>
          <li>Enter the exact card name when you know it.</li>
        </ol>
        <div class="mt-guess-help__pool">
          <h3>Card pool</h3>
          <p>Nonland mystery cards come from Scryfall’s EDHREC ranks 1–250 and have a supported paper printing, card art, and legality in at least one tracked format. Daily uses one shared card; practice chooses randomly from the same pool.</p>
        </div>
        <p class="mt-guess-help__note">
          {{ if not $ctx.IsDaily }}Practice rounds do not award cards.{{ else if not $ctx.HasAccount }}Play as a guest, or sign in before a future Daily game to earn card awards.{{ else }}Solve the Daily card in nine or fewer card guesses to add it to your profile.{{ end }}
        </p>
      </div>
    </div>
  </div>

  {{ template "layout_footer" . }}
{{ end }}

{{ define "guess_card_question_group" }}
  <fieldset class="mt-guess-game__question-group{{ if eq .Name "Color" }} mt-guess-game__question-group--color{{ else if eq .Name "Card type" }} mt-guess-game__question-group--type{{ else if eq .Name "Mana value" }} mt-guess-game__question-group--mana{{ else if eq .Name "Rules text" }} mt-guess-game__question-group--rules{{ end }}">
    <legend>{{ .Name }}</legend>
    <div class="mt-guess-game__question-options">
      {{ range .Questions }}
        <button
          type="submit"
          name="question_id"
          value="{{ .ID }}"
          class="mt-guess-game__question{{ if or (eq .ID "color_w") (eq .ID "color_u") (eq .ID "color_b") (eq .ID "color_r") (eq .ID "color_g") (eq .ID "colorless") }} mt-guess-game__question--color-pip{{ end }}"
          aria-label="{{ .Text }}"
          data-guess-question-id="{{ .ID }}">
          {{ if or (eq .ID "color_w") (eq .ID "color_u") (eq .ID "color_b") (eq .ID "color_r") (eq .ID "color_g") (eq .ID "colorless") }}
            <img src="https://svgs.scryfall.io/card-symbols/{{ .Symbol }}.svg" alt="" aria-hidden="true">
          {{ else if .Symbol }}
            <span class="mt-guess-game__question-symbol" aria-hidden="true">{{ .Symbol }}</span>
          {{ end }}
          <span>{{ .Label }}</span>
        </button>
      {{ end }}
    </div>
  </fieldset>
{{ end }}
