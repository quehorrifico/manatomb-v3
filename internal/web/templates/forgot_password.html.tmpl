{{ define "forgot_password" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <section class="mt-auth-page" aria-labelledby="forgot-password-title">
    <header class="mt-auth-heading">
      <h1 id="forgot-password-title" class="mt-auth-title">Reset your password</h1>
      <p class="mt-auth-copy">Enter your email and we’ll send a reset link if an account exists.</p>
    </header>

    <form method="POST" action="/forgot-password" class="mt-auth-form"{{ if .Error }} aria-describedby="site-error"{{ end }}>
      <div class="mt-auth-field">
        <label for="forgot-password-email" class="mt-field-label">Email</label>
        <input
          id="forgot-password-email"
          type="email"
          name="email"
          value="{{ $d.Email }}"
          required
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          class="mt-control"
        >
      </div>

      <div class="mt-auth-actions">
        <button type="submit" class="mt-btn mt-btn--primary mt-auth-submit">Send Reset Link</button>
        <p class="mt-auth-switch">
          Remembered your password?
          <a href="/login" class="mt-auth-link">Sign in</a>
        </p>
      </div>
    </form>
  </section>

  {{ template "layout_footer" . }}
{{ end }}
