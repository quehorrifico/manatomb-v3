{{ define "forgot_password" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <main class="max-w-4xl mx-auto py-10 px-4 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="space-y-2">
        <p class="mt-kicker">Account</p>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Reset Password</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
        <a href="/login" class="mt-btn mt-btn--secondary mt-btn--sm">Log In</a>
      </div>
    </div>

    <section class="mt-panel max-w-md mx-auto p-5 sm:p-6">
      <form method="POST" action="/forgot-password" class="space-y-5">
        <label class="block text-sm text-slate-200">
          <span class="mt-field-label">Email</span>
          <input
            type="email"
            name="email"
            value="{{ $d.Email }}"
            required
            class="mt-control"
          >
        </label>

        <div class="flex flex-col gap-3 pt-1">
          <button type="submit" class="mt-btn mt-btn--primary w-full">Request Reset Link</button>
          <p class="text-[11px] text-slate-500 text-center">
            Already have a reset link?
            <a href="/reset-password" class="text-sky-300 hover:text-sky-200 font-medium">Enter it here</a>
          </p>
        </div>
      </form>
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
