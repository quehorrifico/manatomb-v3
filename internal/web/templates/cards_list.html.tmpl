{{ define "cards_list" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-6xl mx-auto py-10 px-4 space-y-6">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div class="space-y-2">
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Advanced Search Results</h1>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="{{ $ctx.EditFiltersPath }}" class="mt-btn mt-btn--primary mt-btn--sm">Edit Filters</a>
        {{ if .CurrentUser }}
          <a href="/decks" class="mt-btn mt-btn--secondary mt-btn--sm">Decks</a>
        {{ end }}
        <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
      </div>
    </div>

    {{ if $ctx.AppliedFilters }}
      <section class="mt-subpanel p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Applied Filters</p>
          <div class="flex flex-wrap gap-2">
            <a href="{{ $ctx.ClearPath }}" class="text-xs font-medium text-sky-300 transition-colors hover:text-sky-200">Clear all</a>
            <a href="{{ $ctx.EditFiltersPath }}" class="text-xs font-medium text-slate-300 transition-colors hover:text-slate-100">Edit filters</a>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          {{ range $ctx.AppliedFilters }}
            <a href="{{ .RemovePath }}"
               class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-950/80 px-3 py-1.5 text-xs text-slate-200 transition-colors hover:border-slate-500 hover:text-slate-50">
              <span>{{ .Label }}</span>
              <span aria-hidden="true" class="text-slate-500">×</span>
            </a>
          {{ end }}
        </div>
      </section>
    {{ end }}

    <section class="space-y-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-1">
          <h2 class="text-lg font-semibold text-slate-100">
            Results{{ if and $ctx.HasSearched $ctx.Results }} <span class="ml-1 text-xs text-slate-500">({{ len $ctx.Results }})</span>{{ end }}
          </h2>
          <p class="text-sm text-slate-400">
            {{ if $ctx.HasSearched }}
              Click any card image to open quick view. The modal includes printings, `Add To Deck`, and `Open Full Page`.
            {{ else }}
              Refine the query on the search page, then come back here for richer result actions.
            {{ end }}
          </p>
        </div>
      </div>

      <div data-deck-action-status hidden class="rounded-2xl border px-4 py-3">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <p data-deck-action-status-text class="text-sm font-medium"></p>
          <a data-deck-action-status-link href="#" class="hidden text-sm font-semibold text-sky-300 transition-colors hover:text-sky-200">Open deck</a>
        </div>
      </div>

      {{ if $ctx.HasSearched }}
        {{ if $ctx.Results }}
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            {{ range $ctx.Results }}
              <li>
                <article data-card-detail-root
                         data-oracle-id="{{ .OracleID }}"
                         data-detail-path="{{ .DetailPath }}"
                         data-name="{{ .Name }}"
                         data-mana-cost="{{ .ManaCost }}"
                         data-type-line="{{ .TypeLine }}"
                         data-image-uri="{{ .ImageURI }}"
                         data-price="{{ .PriceUSD }}"
                         data-artist="{{ .Artist }}"
                         data-set-code="{{ .SetCode }}"
                         data-set-name="{{ .SetName }}"
                         data-released-at="{{ .ReleasedAt }}"
                         data-faces='{{ .FacesJSON }}'>
                  <button type="button"
                          class="group relative block w-full overflow-hidden rounded-[1.5rem] border border-slate-800 bg-slate-950/70 shadow-lg shadow-slate-950/60 transition-transform duration-150 hover:-translate-y-1 hover:border-slate-600 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950"
                          data-card-detail
                          aria-label="View {{ .Name }}"
                          title="{{ .Name }}">
                    <span class="sr-only">View {{ .Name }}</span>
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent px-4 py-3 opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100">
                      <p class="text-sm font-semibold text-slate-50">{{ .Name }}</p>
                    </div>
                    <div class="aspect-[3/4] bg-slate-950">
                      {{ if .ImageURI }}
                        <img src="{{ .ImageURI }}"
                             alt="{{ .Name }}"
                             class="h-full w-full object-cover">
                      {{ else }}
                        <div class="flex h-full w-full items-center justify-center px-4 text-center text-xs text-slate-400">
                          No image available
                        </div>
                      {{ end }}
                    </div>
                  </button>
                  <div class="hidden js-oracle-text">{{ .OracleText }}</div>
                </article>
              </li>
            {{ end }}
          </ul>
        {{ else }}
          <div class="mt-empty-state space-y-2">
            <p class="text-sm font-medium text-slate-200">No cards matched those filters.</p>
          </div>
        {{ end }}
      {{ else }}
        <div class="mt-empty-state space-y-3">
          <p class="text-sm text-slate-300">There is no active advanced search yet.</p>
          <div>
            <a href="{{ $ctx.ClearPath }}" class="mt-btn mt-btn--primary mt-btn--sm">Open Advanced Search</a>
          </div>
        </div>
      {{ end }}
    </section>

    <div id="card-detail-modal" class="mt-modal hidden">
      <div class="mt-modal-panel max-w-2xl">
        <button type="button" class="absolute top-3 right-3 mt-btn mt-btn--secondary text-xs !px-3 !py-2" data-close-modal>
          Close
        </button>

        <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] items-start">
          <div class="flex items-center justify-center">
            <img data-field="image"
                 alt=""
                 class="w-full max-w-xs h-auto mt-card-media shadow-md shadow-slate-900/80">
          </div>

          <div class="space-y-3 text-sm text-slate-200">
            <h3 class="text-lg font-semibold text-slate-50" data-field="name"></h3>

            <div class="space-y-1" data-field="printing-group">
              <label for="printing-select" class="mt-field-label">Version</label>
              <select id="printing-select" data-field="printing-select"
                      class="mt-control mt-control--sm text-xs text-slate-100">
                <option value="">Latest printing</option>
              </select>
            </div>

            <p class="text-xs uppercase tracking-wide text-slate-400">
              <span data-field="type-line"></span>
            </p>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-300">
              <span>
                <span class="font-medium text-slate-200">Cost:</span>
                <span data-field="mana-cost" class="inline-flex items-center gap-1 align-middle"></span>
              </span>
              <span>
                <span class="font-medium text-slate-200">Price:</span>
                <span data-field="price-usd">—</span>
              </span>
              <span>
                <span class="font-medium text-slate-200">Artist:</span>
                <span data-field="artist">—</span>
              </span>
            </div>

            <p class="text-sm text-slate-200 whitespace-pre-line" data-field="oracle-text"></p>

            <div class="flex flex-wrap justify-between gap-2 pt-2">
              <div class="flex flex-wrap gap-2">
                {{ if .CurrentUser }}
                  <button type="button"
                          class="mt-btn mt-btn--primary text-xs !px-3 !py-2"
                          data-open-deck-picker
                          data-close-modal-selector="#card-detail-modal">
                    Add To Deck
                  </button>
                {{ else }}
                  <a href="/login?next={{ urlquery $ctx.CurrentPath }}"
                     class="mt-btn mt-btn--primary text-xs !px-3 !py-2">
                    Add To Deck
                  </a>
                {{ end }}
                <a href="#"
                   data-field="open-page-link"
                   class="hidden mt-btn mt-btn--secondary text-xs !px-3 !py-2">
                  Open Full Page
                </a>
              </div>
              <button type="button" class="mt-btn mt-btn--secondary text-xs !px-3 !py-2 hidden" data-flip-card>
                Flip Card
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {{ template "saved_deck_picker" . }}
  </main>

  {{ template "card_detail_modal_script" . }}
  {{ template "saved_deck_picker_script" . }}

  {{ template "layout_footer" . }}
{{ end }}
