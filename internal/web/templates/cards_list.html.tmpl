{{ define "cards_list" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $advanced := eq $ctx.ResultsMode "advanced" }}

  <div class="mt-card-results-page">
    <header class="mt-card-results-header">
      <div class="mt-card-results-heading">
        <h1>
          {{ if $advanced }}
            {{ if $ctx.NameQuery }}Cards matching “{{ $ctx.NameQuery }}”{{ else }}Matching cards{{ end }}
          {{ else }}
            {{ if $ctx.NameQuery }}Results for “{{ $ctx.NameQuery }}”{{ else }}Browse cards{{ end }}
          {{ end }}
        </h1>
        <p>
          {{ if gt $ctx.TotalResults 0 }}
            {{ if gt $ctx.TotalPages 1 }}
              Showing {{ $ctx.ResultStart }}–{{ $ctx.ResultEnd }} of {{ $ctx.TotalResults }} cards
            {{ else if eq $ctx.TotalResults 1 }}
              1 matching card
            {{ else }}
              {{ $ctx.TotalResults }} matching cards
            {{ end }}
          {{ else }}
            No matching cards
          {{ end }}
        </p>
        {{ if $ctx.ShowOldestPrintingNote }}
          <p>Ordered by each card’s first English printing; tiles show the printing selected for these results.</p>
        {{ end }}
      </div>

      <form method="GET" action="/cards" class="mt-card-results-sort" aria-label="Sort card results">
        {{ range $ctx.SortFields }}
          <input type="hidden" name="{{ .Name }}" value="{{ .Value }}">
        {{ end }}
        <label class="sr-only" for="cards-sort-select">Sort results</label>
        <select id="cards-sort-select"
                name="sort"
                class="mt-control"
                onchange="this.form.requestSubmit()">
          {{ range $ctx.SortOptions }}
            <option value="{{ .Value }}" {{ if eq $ctx.SelectedSort .Value }}selected{{ end }}>{{ .Label }}</option>
          {{ end }}
        </select>
        <label class="sr-only" for="cards-sort-direction">Sort direction</label>
        <select id="cards-sort-direction"
                name="sort_dir"
                class="mt-control"
                onchange="this.form.requestSubmit()">
          {{ range $ctx.DirectionOptions }}
            <option value="{{ .Value }}" {{ if eq $ctx.SelectedSortDirection .Value }}selected{{ end }}>{{ .Label }}</option>
          {{ end }}
        </select>
        <noscript>
          <button type="submit" class="mt-btn mt-btn--secondary mt-btn--sm">Apply sort</button>
        </noscript>
      </form>
    </header>

    {{ if and $advanced $ctx.AppliedFilters }}
      <nav class="mt-card-results-filter-bar" aria-label="Applied filters">
        <span class="mt-card-results-filter-label">Applied</span>
        {{ range $ctx.AppliedFilters }}
          <a href="{{ .RemovePath }}" class="mt-card-results-chip" aria-label="Remove filter: {{ .Label }}">
            <span>{{ .Label }}</span>
            <span class="mt-card-results-chip__remove" aria-hidden="true">×</span>
          </a>
        {{ end }}
        <a href="{{ $ctx.ClearPath }}" class="mt-card-results-clear">Clear all</a>
      </nav>
    {{ end }}

    <details class="mt-card-results-refine" {{ if $ctx.FiltersOpen }}open{{ end }}>
      <summary>
        <span>{{ if $advanced }}Refine filters{{ else }}Refine with filters{{ end }}</span>
      </summary>
      <div class="mt-card-results-refine__content">
        {{ template "cards_search_filter_form" $ctx.FilterForm }}
      </div>
    </details>

    {{ if $ctx.Results }}
      <ul class="mt-card-results-grid">
        {{ range $ctx.Results }}
          <li>
            <article class="mt-card-result"
                     data-card-result-tile
                     data-card-result-layout="{{ .Layout }}"
                     data-card-result-faces='{{ .FacesJSON }}'
                     data-card-result-front-image="{{ .ImageURI }}"
                     data-card-result-front-name="{{ .Name }}">
              {{ if .IsSplitLayout }}
                <button type="button"
                        class="mt-card-result__face-control"
                        data-card-result-rotate
                        data-card-result-control="rotate"
                        aria-label="Rotate card"
                        aria-pressed="false">
                  <span aria-hidden="true">↻</span>
                  <span class="sr-only">Rotate</span>
                </button>
              {{ else if .FacesJSON }}
                <button type="button"
                        class="mt-card-result__face-control"
                        data-card-result-control="turn-over"
                        data-card-result-turn-over
                        aria-label="Show back face">
                  <span aria-hidden="true">↺</span>
                  <span class="sr-only">Turn Over</span>
                </button>
              {{ end }}

              <a href="{{ .DetailPath }}"
                 class="mt-card-result__link"
                 data-card-result-link
                 aria-label="Open {{ .Name }}">
                <span class="mt-card-result__art">
                  <img {{ if .ImageURI }}src="{{ .ImageURI }}"{{ end }}
                       alt="{{ .Name }}"
                       class="mt-card-result__image {{ if not .ImageURI }}hidden{{ end }}"
                       loading="lazy"
                       decoding="async"
                       data-card-result-image>
                  <span class="mt-card-result__fallback {{ if .ImageURI }}hidden{{ end }}"
                        data-card-result-fallback>
                    {{ if .ImageURI }}No image{{ else }}{{ .Name }}{{ end }}
                  </span>
                </span>
                <span class="mt-card-result__meta">
                  <span class="mt-card-result__name" title="{{ .Name }}">{{ .Name }}</span>
                  <span class="mt-card-result__facts">
                    <span class="mt-card-result__set" title="{{ if .SetName }}{{ .SetName }}{{ if .SetCode }} ({{ .SetCode }}){{ end }}{{ else if .SetCode }}{{ .SetCode }}{{ else }}Unknown set{{ end }}">
                      {{ if .SetName }}{{ .SetName }}{{ if .SetCode }} ({{ .SetCode }}){{ end }}{{ else if .SetCode }}{{ .SetCode }}{{ else }}Unknown set{{ end }}
                    </span>
                    <span class="mt-card-result__price">{{ .PriceUSD }}</span>
                  </span>
                </span>
              </a>
            </article>
          </li>
        {{ end }}
      </ul>
    {{ else }}
      <section class="mt-card-results-empty">
        <div>
          <h2>No cards matched</h2>
          <p>Remove a filter or broaden the search above to try again.</p>
        </div>
      </section>
    {{ end }}

    {{ if gt $ctx.TotalPages 1 }}
      <nav class="mt-card-results-pagination" aria-label="Search result pages">
        {{ if $ctx.PreviousPath }}
          <a href="{{ $ctx.PreviousPath }}" class="mt-btn mt-btn--secondary mt-btn--sm">Previous</a>
        {{ else }}
          <span class="mt-card-results-pagination__disabled" aria-hidden="true"></span>
        {{ end }}
        <span class="mt-card-results-pagination__status">Page {{ $ctx.Page }} of {{ $ctx.TotalPages }}</span>
        {{ if $ctx.NextPath }}
          <a href="{{ $ctx.NextPath }}" class="mt-btn mt-btn--secondary mt-btn--sm mt-card-results-pagination__next">Next</a>
        {{ else }}
          <span class="mt-card-results-pagination__disabled" aria-hidden="true"></span>
        {{ end }}
      </nav>
    {{ end }}
  </div>

  {{ template "layout_footer" . }}
{{ end }}
