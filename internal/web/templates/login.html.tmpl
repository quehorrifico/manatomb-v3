{{ define "login" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <section class="mt-auth-page" aria-labelledby="login-title">
    <header class="mt-auth-heading">
      <h1 id="login-title" class="mt-auth-title">Sign in</h1>
      <p class="mt-auth-copy">Access your saved decks and continue building where you left off.</p>
    </header>

    <form method="POST" action="/login" class="mt-auth-form"{{ if .Error }} aria-describedby="site-error"{{ end }}>
      <input type="hidden" name="next" value="{{ $d.Next }}">

      <div class="mt-auth-field">
        <label for="login-email" class="mt-field-label">Email</label>
        <input
          id="login-email"
          type="email"
          name="email"
          value="{{ $d.Email }}"
          required
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          class="mt-control"
        >
      </div>

      <div class="mt-auth-field">
        <div class="mt-auth-field-heading">
          <label for="login-password" class="mt-field-label">Password</label>
          <a href="/forgot-password" class="mt-auth-link">Forgot password?</a>
        </div>
        <input
          id="login-password"
          type="password"
          name="password"
          required
          autocomplete="current-password"
          class="mt-control"
        >
      </div>

      <label class="mt-auth-session-choice" for="login-stay-signed-in">
        <input
          id="login-stay-signed-in"
          type="checkbox"
          name="stay_signed_in"
          value="1"
          {{ if $d.StaySignedIn }}checked{{ end }}
        >
        <span>
          <strong>Stay signed in on this device</strong>
          <small>For 30 days. Uncheck this on a shared device.</small>
        </span>
      </label>

      <div class="mt-auth-actions">
        <button type="submit" class="mt-btn mt-btn--primary mt-auth-submit">Sign In</button>
        <p class="mt-auth-switch">
          New to ManaTomb?
          <a href="/signup?next={{ urlquery $d.Next }}" class="mt-auth-link">Create an account</a>
        </p>
      </div>
    </form>
  </section>

  {{ template "layout_footer" . }}
{{ end }}
