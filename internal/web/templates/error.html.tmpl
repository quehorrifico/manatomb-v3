{{ define "error" }}
  {{ template "layout_header" . }}

  <main class="max-w-3xl mx-auto px-4 py-14">
    <section class="mt-panel p-8 text-center space-y-5">
      <div class="space-y-2">
        <p class="mt-kicker">Error</p>
        <h1 class="text-3xl font-bold text-slate-100">Something went wrong.</h1>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <button type="button" onclick="window.history.back()" class="mt-btn mt-btn--secondary">Back</button>
        <a href="/" class="mt-btn mt-btn--primary">Home</a>
      </div>
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
