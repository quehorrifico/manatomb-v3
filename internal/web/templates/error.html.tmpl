{{ define "error" }}
  {{ template "layout_header" . }}

  <div class="mt-static-page mt-static-page--message">
    <section class="mt-static-message" aria-labelledby="error-title">
      <p class="mt-static-status">Error</p>
      <h1 id="error-title" class="mt-static-title">Something went wrong.</h1>
      <p class="mt-static-lede">Try the previous page again, or return home and continue from there.</p>

      <div class="mt-static-actions" aria-label="Error recovery">
        <button type="button" onclick="window.history.back()" class="mt-btn mt-btn--secondary">Go back</button>
        <a href="/" class="mt-btn mt-btn--primary">Return home</a>
      </div>
    </section>
  </div>

  {{ template "layout_footer" . }}
{{ end }}
