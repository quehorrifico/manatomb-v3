{{ define "not_found" }}
  {{ template "layout_header" . }}

  <div class="mt-static-page mt-static-page--message">
    <section class="mt-static-message" aria-labelledby="not-found-title">
      <p class="mt-static-status">404</p>
      <h1 id="not-found-title" class="mt-static-title">Page not found.</h1>
      <p class="mt-static-lede">The page may have moved, or the link may be out of date.</p>

      <div class="mt-static-actions" aria-label="Page recovery">
        <button type="button" onclick="window.history.back()" class="mt-btn mt-btn--secondary">Go back</button>
        <a href="/" class="mt-btn mt-btn--primary">Return home</a>
      </div>
    </section>
  </div>

  {{ template "layout_footer" . }}
{{ end }}
