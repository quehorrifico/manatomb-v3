{{ define "layout_header" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  {{ with .Meta }}
    {{ if .Title }}
      <title>{{ .Title }} | Mana Tomb</title>
    {{ else }}
      <title>Mana Tomb</title>
    {{ end }}
    {{ if .Description }}<meta name="description" content="{{ .Description }}">{{ end }}
    {{ if .CanonicalURL }}<link rel="canonical" href="{{ .CanonicalURL }}">{{ end }}
    <meta property="og:site_name" content="Mana Tomb">
    <meta property="og:type" content="{{ if .Type }}{{ .Type }}{{ else }}website{{ end }}">
    {{ if .Title }}<meta property="og:title" content="{{ .Title }}">{{ end }}
    {{ if .Description }}<meta property="og:description" content="{{ .Description }}">{{ end }}
    {{ if .CanonicalURL }}<meta property="og:url" content="{{ .CanonicalURL }}">{{ end }}
    {{ if .ImageURL }}
      <meta property="og:image" content="{{ .ImageURL }}">
      {{ if .ImageAlt }}<meta property="og:image:alt" content="{{ .ImageAlt }}">{{ end }}
      <meta name="twitter:card" content="summary_large_image">
    {{ else }}
      <meta name="twitter:card" content="summary">
    {{ end }}
    {{ if .Title }}<meta name="twitter:title" content="{{ .Title }}">{{ end }}
    {{ if .Description }}<meta name="twitter:description" content="{{ .Description }}">{{ end }}
    {{ if .ImageURL }}<meta name="twitter:image" content="{{ .ImageURL }}">{{ end }}
  {{ else }}
    <title>Mana Tomb</title>
  {{ end }}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Tailwind CDN (simple, no build step) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Optional: tweak Tailwind theme a bit -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            tomb: {
              bg: "#020617",      // slate-950-ish
              surface: "#020817", // deep blue/black
              accent: "#0ea5e9",  // sky-500-ish
            }
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --mt-border: rgba(51, 65, 85, 0.9);
      --mt-border-strong: rgba(56, 189, 248, 0.45);
      --mt-surface: rgba(2, 6, 23, 0.78);
      --mt-surface-strong: rgba(15, 23, 42, 0.92);
      --mt-text-soft: rgb(148 163 184);
      --mt-text-muted: rgb(100 116 139);
      --mt-accent: rgb(14 165 233);
      --mt-accent-strong: rgb(56 189 248);
      --mt-dark: rgb(2 6 23);
    }

    @keyframes mtDeckItemIn {
      from {
        opacity: 0;
        transform: translateY(4px) scale(0.995);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes mtDeckFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .mt-nav-link {
      color: rgb(203 213 225);
      font-size: 0.86rem;
      transition: color 140ms ease;
    }

    .mt-nav-link:hover {
      color: var(--mt-accent-strong);
    }

    .mt-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border-radius: 0.68rem;
      padding: 0.72rem 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.2;
      transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }

    .mt-btn:hover {
      transform: translateY(-1px);
    }

    .mt-btn:focus-visible {
      outline: 2px solid var(--mt-accent-strong);
      outline-offset: 2px;
    }

    .mt-btn--primary {
      background: var(--mt-accent);
      color: var(--mt-dark);
      box-shadow: 0 8px 20px rgba(14, 165, 233, 0.2);
    }

    .mt-btn--primary:hover {
      background: var(--mt-accent-strong);
    }

    .mt-btn--secondary {
      border: 1px solid var(--mt-border);
      background: rgba(15, 23, 42, 0.92);
      color: rgb(226 232 240);
    }

    .mt-btn--secondary:hover {
      border-color: var(--mt-border-strong);
      color: rgb(240 249 255);
    }

    .mt-btn--light {
      background: rgb(241 245 249);
      color: var(--mt-dark);
      box-shadow: 0 8px 18px rgba(148, 163, 184, 0.18);
    }

    .mt-btn--light:hover {
      background: rgb(255 255 255);
    }

    .mt-btn--warning {
      background: rgb(252 211 77);
      color: var(--mt-dark);
      box-shadow: 0 8px 18px rgba(251, 191, 36, 0.18);
    }

    .mt-btn--warning:hover {
      background: rgb(253 230 138);
    }

    .mt-btn--danger {
      border: 1px solid rgba(239, 68, 68, 0.45);
      background: rgba(127, 29, 29, 0.3);
      color: rgb(252 165 165);
    }

    .mt-btn--danger:hover {
      border-color: rgba(248, 113, 113, 0.65);
      color: rgb(254 202 202);
    }

    .mt-btn--ghost {
      color: rgb(191 219 254);
      padding-left: 0;
      padding-right: 0;
    }

    .mt-btn--ghost:hover {
      color: rgb(224 242 254);
      transform: none;
    }

    .mt-btn--sm {
      padding: 0.56rem 0.8rem;
      font-size: 0.8rem;
      border-radius: 0.62rem;
    }

    .mt-btn--xs {
      padding: 0.42rem 0.62rem;
      font-size: 0.72rem;
      border-radius: 0.56rem;
      gap: 0.26rem;
    }

    .mt-btn--micro {
      padding: 0.2rem 0.45rem;
      font-size: 0.68rem;
      border-radius: 0.55rem;
      gap: 0.2rem;
    }

    .mt-header-search-submit,
    .mt-header-search-submit:hover {
      transform: translateY(-50%);
    }

    .mt-panel {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.8rem;
      background: var(--mt-surface);
      box-shadow: 0 12px 30px rgba(2, 6, 23, 0.24);
    }

    .mt-commander-panel {
      display: flex;
      justify-content: center;
      padding: 0;
    }

    .mt-commander-card {
      position: relative;
      width: min(100%, 13.25rem);
    }

    .mt-commander-art {
      display: block;
      width: 100%;
      aspect-ratio: 5 / 7;
      overflow: hidden;
      border: 1px solid rgba(71, 85, 105, 0.82);
      border-radius: 0.88rem;
      background: rgba(2, 6, 23, 0.9);
      box-shadow: 0 20px 38px rgba(2, 6, 23, 0.38);
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }

    .mt-commander-art:hover {
      border-color: rgba(125, 211, 252, 0.55);
      transform: translateY(-1px);
      box-shadow: 0 22px 42px rgba(2, 6, 23, 0.42);
    }

    .mt-commander-art--empty {
      display: flex;
      align-items: center;
      justify-content: center;
      border-style: dashed;
      color: rgb(148 163 184);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      box-shadow: none;
    }

    .mt-commander-menu-slot {
      position: absolute;
      right: 0.44rem;
      top: 0.44rem;
      z-index: 8;
    }

    .mt-action-menu--commander > summary {
      min-width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      border: 1px solid rgba(51, 65, 85, 0.84);
      background: rgba(2, 6, 23, 0.82);
      padding: 0;
      color: rgb(226 232 240);
      box-shadow: 0 10px 22px rgba(2, 6, 23, 0.34);
      backdrop-filter: blur(10px);
    }

    .mt-commander-flip {
      position: absolute;
      left: 50%;
      bottom: 0.5rem;
      transform: translateX(-50%);
      box-shadow: 0 10px 22px rgba(2, 6, 23, 0.28);
    }

    .mt-action-card {
      display: block;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.9rem;
      background: rgba(2, 6, 23, 0.68);
      padding: 0.85rem;
      transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.18);
    }

    .mt-action-card:hover {
      transform: translateY(-2px);
      border-color: var(--mt-border-strong);
      background: rgba(15, 23, 42, 0.96);
      box-shadow: 0 16px 34px rgba(2, 6, 23, 0.28);
    }

    .mt-kicker {
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(125, 211, 252, 0.86);
      font-weight: 700;
    }

    .mt-title {
      font-size: clamp(1.65rem, 3.2vw, 2.65rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: rgb(248 250 252);
    }

    .mt-copy {
      font-size: 0.9rem;
      color: var(--mt-text-soft);
      line-height: 1.45;
    }

    .mt-hint {
      font-size: 0.76rem;
      color: var(--mt-text-muted);
      line-height: 1.4;
    }

    .mt-chip {
      display: inline-flex;
      align-items: center;
      border-radius: 9999px;
      border: 1px solid rgba(51, 65, 85, 0.92);
      background: rgba(15, 23, 42, 0.86);
      padding: 0.14rem 0.48rem;
      font-size: 0.68rem;
      color: rgb(203 213 225);
    }

    .mt-board-tabs {
      display: inline-grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.28rem;
      width: 100%;
      max-width: 24rem;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.76rem;
      background: rgba(2, 6, 23, 0.62);
      padding: 0.24rem;
    }

    .mt-board-tab {
      display: flex;
      min-height: 2.18rem;
      align-items: center;
      justify-content: space-between;
      gap: 0.44rem;
      border-radius: 0.56rem;
      padding: 0.42rem 0.56rem;
      color: rgb(148 163 184);
      font-size: 0.74rem;
      font-weight: 700;
      line-height: 1.1;
      transition: background-color 140ms ease, color 140ms ease, box-shadow 140ms ease;
    }

    .mt-board-tab span:last-child {
      display: inline-flex;
      min-width: 1.38rem;
      height: 1.18rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background: rgba(15, 23, 42, 0.94);
      padding: 0 0.34rem;
      color: rgb(203 213 225);
      font-size: 0.64rem;
    }

    .mt-board-tab:hover,
    .mt-board-tab--active {
      background: rgba(14, 165, 233, 0.16);
      color: rgb(240 249 255);
      box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.28);
    }

    .mt-board-tab--active span:last-child {
      background: rgba(56, 189, 248, 0.22);
      color: rgb(224 242 254);
    }

    .mt-deck-toolbar {
      position: sticky;
      top: 0.6rem;
      z-index: 40;
      margin: -0.15rem -0.2rem 0;
      border: 1px solid rgba(30, 41, 59, 0.88);
      border-radius: 0.82rem;
      background: rgba(2, 6, 23, 0.88);
      padding: 0.48rem;
      box-shadow: 0 14px 28px rgba(2, 6, 23, 0.28);
      backdrop-filter: blur(14px);
    }

    .mt-autocomplete-menu {
      z-index: 160;
      max-height: min(22rem, 62vh);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .mt-field-label {
      display: block;
      margin-bottom: 0.35rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-control {
      width: 100%;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.72rem;
      background: var(--mt-surface-strong);
      padding: 0.68rem 0.86rem;
      font-size: 0.9rem;
      color: rgb(248 250 252);
      box-shadow: inset 0 1px 0 rgba(14, 165, 233, 0.04);
      transition: border-color 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
    }

    .mt-control::placeholder {
      color: rgb(100 116 139);
    }

    .mt-control:focus-visible {
      outline: 2px solid var(--mt-accent-strong);
      outline-offset: 2px;
      border-color: rgba(56, 189, 248, 0.6);
    }

    .mt-control--sm {
      padding: 0.46rem 0.62rem;
      font-size: 0.8rem;
      border-radius: 0.62rem;
    }

    .mt-section-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-stat-card {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.7rem;
      background: rgba(2, 6, 23, 0.72);
      padding: 0.58rem 0.65rem;
    }

    .mt-stat-card--button {
      display: block;
      width: 100%;
      transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
    }

    .mt-stat-card--button:hover,
    .mt-stat-card--button:focus-visible {
      border-color: rgba(56, 189, 248, 0.42);
      background: rgba(8, 47, 73, 0.28);
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.24);
      outline: none;
    }

    .mt-stat-card--button:active {
      transform: translateY(1px);
    }

    .mt-analytics-card-list__item {
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      list-style: none;
      border: 1px solid rgba(30, 41, 59, 0.75);
      border-radius: 0.58rem;
      background: rgba(2, 6, 23, 0.46);
      padding: 0.46rem 0.55rem;
    }

    .mt-analytics-card-list__item strong {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: rgb(248 250 252);
      font-size: 0.82rem;
    }

    .mt-analytics-card-list__item small {
      flex-shrink: 0;
      color: rgb(148 163 184);
      font-size: 0.68rem;
    }

    .mt-power-panel {
      border: 1px solid rgba(51, 65, 85, 0.86);
      border-radius: 0.85rem;
      background:
        linear-gradient(135deg, rgba(14, 116, 144, 0.12), rgba(2, 6, 23, 0.9) 44%, rgba(15, 23, 42, 0.78)),
        rgba(2, 6, 23, 0.78);
      padding: 0.85rem;
      box-shadow: inset 0 1px 0 rgba(148, 163, 184, 0.08);
    }

    .mt-power-badge {
      display: inline-flex;
      align-items: baseline;
      justify-content: center;
      gap: 0.08rem;
      min-width: 3.2rem;
      min-height: 3.2rem;
      border-radius: 0.8rem;
      border: 1px solid rgba(125, 211, 252, 0.38);
      background: rgba(8, 47, 73, 0.48);
      color: rgb(224 242 254);
      box-shadow: 0 12px 28px rgba(2, 6, 23, 0.22);
    }

    .mt-power-badge span {
      font-size: 0.78rem;
      font-weight: 700;
      color: rgb(125 211 252);
    }

    .mt-power-badge strong {
      font-size: 1.8rem;
      line-height: 1;
      font-weight: 800;
    }

    .mt-power-metric {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.55rem;
      border: 1px solid rgba(51, 65, 85, 0.78);
      border-radius: 0.62rem;
      background: rgba(2, 6, 23, 0.5);
      padding: 0.48rem 0.58rem;
      color: rgb(148 163 184);
    }

    .mt-power-metric strong {
      color: rgb(248 250 252);
      font-size: 0.92rem;
    }

    .mt-power-signals-list {
      display: grid;
      gap: 0.65rem;
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0;
    }

    .mt-power-signal {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.28rem 0.8rem;
      border: 1px solid rgba(51, 65, 85, 0.8);
      border-radius: 0.72rem;
      background: rgba(2, 6, 23, 0.44);
      padding: 0.68rem 0.78rem 0.72rem;
      font-size: 0.76rem;
      color: rgb(203 213 225);
      overflow: hidden;
    }

    .mt-power-signal::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      background: rgba(56, 189, 248, 0.42);
    }

    .mt-power-signal__label {
      color: rgb(148 163 184);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .mt-power-signal__value {
      color: rgb(248 250 252);
      font-size: 0.82rem;
      text-align: right;
    }

    .mt-power-signal__detail {
      grid-column: 1 / -1;
      color: rgb(148 163 184);
      line-height: 1.4;
    }

    .mt-power-signal__cards {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
      gap: 0.36rem;
      list-style: none;
      margin-top: 0.2rem;
      padding: 0;
    }

    .mt-power-signal__cards li {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      border: 1px solid rgba(51, 65, 85, 0.76);
      border-radius: 0.44rem;
      background: rgba(15, 23, 42, 0.58);
      padding: 0.32rem 0.45rem;
      color: rgb(226 232 240);
      font-size: 0.72rem;
      line-height: 1.25;
    }

    .mt-power-signal--good {
      border-color: rgba(52, 211, 153, 0.3);
      background: rgba(6, 78, 59, 0.14);
    }

    .mt-power-signal--good::before {
      background: rgba(52, 211, 153, 0.58);
    }

    .mt-power-signal--warn {
      border-color: rgba(250, 204, 21, 0.32);
      background: rgba(113, 63, 18, 0.14);
    }

    .mt-power-signal--warn::before {
      background: rgba(250, 204, 21, 0.6);
    }

    .mt-power-signal--alert {
      border-color: rgba(248, 113, 113, 0.36);
      background: rgba(127, 29, 29, 0.16);
    }

    .mt-power-signal--alert::before {
      background: rgba(248, 113, 113, 0.62);
    }

    .mt-power-signal--info {
      border-color: rgba(56, 189, 248, 0.26);
      background: rgba(12, 74, 110, 0.14);
    }

    .mt-power-signal--info::before {
      background: rgba(56, 189, 248, 0.56);
    }

    .mt-subpanel {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.85rem;
      background: rgba(2, 6, 23, 0.7);
      padding: 0.85rem;
    }

    .mt-filter-group {
      border-top: 1px solid rgba(30, 41, 59, 0.92);
      padding-top: 1.05rem;
    }

    .mt-filter-group__head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.78rem;
    }

    .mt-filter-group__body {
      padding: 0;
    }

    .mt-filter-grid {
      display: grid;
      gap: 0.9rem;
    }

    @media (min-width: 768px) {
      .mt-filter-grid--2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .mt-filter-grid--3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (min-width: 1024px) {
      .mt-filter-grid--wide {
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      }
    }

    .mt-note {
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.82rem;
      background: rgba(15, 23, 42, 0.82);
      padding: 0.72rem 0.82rem;
      font-size: 0.82rem;
      color: rgb(148 163 184);
      line-height: 1.45;
    }

    .mt-guide-check {
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.92rem;
      background: rgba(2, 6, 23, 0.72);
      padding: 0.85rem 0.95rem;
      box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.04);
    }

    .mt-guide-check--good {
      border-color: rgba(52, 211, 153, 0.34);
      background: rgba(6, 78, 59, 0.18);
    }

    .mt-guide-check--warn {
      border-color: rgba(250, 204, 21, 0.34);
      background: rgba(113, 63, 18, 0.18);
    }

    .mt-guide-check--alert {
      border-color: rgba(248, 113, 113, 0.38);
      background: rgba(127, 29, 29, 0.18);
    }

    .mt-guide-check--info {
      border-color: rgba(56, 189, 248, 0.28);
      background: rgba(12, 74, 110, 0.16);
    }

    .mt-guide-check__top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .mt-guide-check__label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-guide-check__value {
      font-size: 1.15rem;
      font-weight: 700;
      color: rgb(248 250 252);
      line-height: 1;
    }

    .mt-guide-check__target {
      font-size: 0.68rem;
      color: rgb(191 219 254);
      text-align: right;
      white-space: nowrap;
    }

    .mt-guide-check__hint {
      margin-top: 0.45rem;
      font-size: 0.77rem;
      line-height: 1.45;
      color: rgb(203 213 225);
    }

    .mt-empty-state {
      border: 1px dashed rgba(51, 65, 85, 0.92);
      border-radius: 0.9rem;
      background: rgba(2, 6, 23, 0.58);
      padding: 0.9rem 1rem;
      font-size: 0.9rem;
      color: rgb(148 163 184);
    }

    .mt-check-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 9999px;
      background: rgba(2, 6, 23, 0.82);
      padding: 0.66rem 0.92rem;
      font-size: 0.82rem;
      color: rgb(226 232 240);
      cursor: pointer;
      transition: border-color 140ms ease, background-color 140ms ease, color 140ms ease, box-shadow 140ms ease;
    }

    .mt-check-pill input {
      margin: 0;
    }

    .mt-check-pill:hover,
    .mt-check-pill:focus-within {
      border-color: rgba(56, 189, 248, 0.42);
      background: rgba(15, 23, 42, 0.92);
