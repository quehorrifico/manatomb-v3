{{ define "layout_header" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Mana Tomb</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Tailwind CDN (simple, no build step) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Optional: tweak Tailwind theme a bit -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            tomb: {
              bg: "#020617",      // slate-950-ish
              surface: "#020817", // deep blue/black
              accent: "#0ea5e9",  // sky-500-ish
            }
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --mt-border: rgba(51, 65, 85, 0.9);
      --mt-border-strong: rgba(56, 189, 248, 0.45);
      --mt-surface: rgba(2, 6, 23, 0.78);
      --mt-surface-strong: rgba(15, 23, 42, 0.92);
      --mt-text-soft: rgb(148 163 184);
      --mt-text-muted: rgb(100 116 139);
      --mt-accent: rgb(14 165 233);
      --mt-accent-strong: rgb(56 189 248);
      --mt-dark: rgb(2 6 23);
    }

    .mt-nav-link {
      color: rgb(203 213 225);
      font-size: 0.86rem;
      transition: color 140ms ease;
    }

    .mt-nav-link:hover {
      color: var(--mt-accent-strong);
    }

    .mt-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      border-radius: 0.75rem;
      padding: 0.82rem 1.15rem;
      font-size: 0.94rem;
      font-weight: 600;
      line-height: 1.2;
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
    }

    .mt-btn:hover {
      transform: translateY(-1px);
    }

    .mt-btn:focus-visible {
      outline: 2px solid var(--mt-accent-strong);
      outline-offset: 2px;
    }

    .mt-btn--primary {
      background: var(--mt-accent);
      color: var(--mt-dark);
      box-shadow: 0 8px 20px rgba(14, 165, 233, 0.2);
    }

    .mt-btn--primary:hover {
      background: var(--mt-accent-strong);
    }

    .mt-btn--secondary {
      border: 1px solid var(--mt-border);
      background: rgba(15, 23, 42, 0.92);
      color: rgb(226 232 240);
    }

    .mt-btn--secondary:hover {
      border-color: var(--mt-border-strong);
      color: rgb(240 249 255);
    }

    .mt-btn--light {
      background: rgb(241 245 249);
      color: var(--mt-dark);
      box-shadow: 0 8px 18px rgba(148, 163, 184, 0.18);
    }

    .mt-btn--light:hover {
      background: rgb(255 255 255);
    }

    .mt-btn--warning {
      background: rgb(252 211 77);
      color: var(--mt-dark);
      box-shadow: 0 8px 18px rgba(251, 191, 36, 0.18);
    }

    .mt-btn--warning:hover {
      background: rgb(253 230 138);
    }

    .mt-btn--danger {
      border: 1px solid rgba(239, 68, 68, 0.45);
      background: rgba(127, 29, 29, 0.3);
      color: rgb(252 165 165);
    }

    .mt-btn--danger:hover {
      border-color: rgba(248, 113, 113, 0.65);
      color: rgb(254 202 202);
    }

    .mt-btn--ghost {
      color: rgb(191 219 254);
      padding-left: 0;
      padding-right: 0;
    }

    .mt-btn--ghost:hover {
      color: rgb(224 242 254);
      transform: none;
    }

    .mt-btn--sm {
      padding: 0.66rem 0.92rem;
      font-size: 0.84rem;
      border-radius: 0.7rem;
    }

    .mt-btn--xs {
      padding: 0.5rem 0.72rem;
      font-size: 0.76rem;
      border-radius: 0.62rem;
      gap: 0.3rem;
    }

    .mt-btn--micro {
      padding: 0.2rem 0.45rem;
      font-size: 0.68rem;
      border-radius: 0.55rem;
      gap: 0.2rem;
    }

    .mt-panel {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.9rem;
      background: var(--mt-surface);
      box-shadow: 0 12px 30px rgba(2, 6, 23, 0.24);
    }

    .mt-action-card {
      display: block;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.9rem;
      background: rgba(2, 6, 23, 0.68);
      padding: 0.85rem;
      transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.18);
    }

    .mt-action-card:hover {
      transform: translateY(-2px);
      border-color: var(--mt-border-strong);
      background: rgba(15, 23, 42, 0.96);
      box-shadow: 0 16px 34px rgba(2, 6, 23, 0.28);
    }

    .mt-kicker {
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(125, 211, 252, 0.86);
      font-weight: 700;
    }

    .mt-title {
      font-size: clamp(1.65rem, 3.2vw, 2.65rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: rgb(248 250 252);
    }

    .mt-copy {
      font-size: 0.9rem;
      color: var(--mt-text-soft);
      line-height: 1.45;
    }

    .mt-hint {
      font-size: 0.76rem;
      color: var(--mt-text-muted);
      line-height: 1.4;
    }

    .mt-chip {
      display: inline-flex;
      align-items: center;
      border-radius: 9999px;
      border: 1px solid rgba(51, 65, 85, 0.92);
      background: rgba(15, 23, 42, 0.86);
      padding: 0.14rem 0.48rem;
      font-size: 0.68rem;
      color: rgb(203 213 225);
    }

    .mt-field-label {
      display: block;
      margin-bottom: 0.35rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-control {
      width: 100%;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.82rem;
      background: var(--mt-surface-strong);
      padding: 0.82rem 1rem;
      font-size: 0.94rem;
      color: rgb(248 250 252);
      box-shadow: inset 0 1px 0 rgba(14, 165, 233, 0.04);
      transition: border-color 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
    }

    .mt-control::placeholder {
      color: rgb(100 116 139);
    }

    .mt-control:focus-visible {
      outline: 2px solid var(--mt-accent-strong);
      outline-offset: 2px;
      border-color: rgba(56, 189, 248, 0.6);
    }

    .mt-control--sm {
      padding: 0.58rem 0.76rem;
      font-size: 0.84rem;
      border-radius: 0.72rem;
    }

    .mt-section-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-stat-card {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.8rem;
      background: rgba(2, 6, 23, 0.72);
      padding: 0.7rem 0.75rem;
    }

    .mt-subpanel {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.85rem;
      background: rgba(2, 6, 23, 0.7);
      padding: 0.85rem;
    }

    .mt-note {
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.82rem;
      background: rgba(15, 23, 42, 0.82);
      padding: 0.72rem 0.82rem;
      font-size: 0.82rem;
      color: rgb(148 163 184);
      line-height: 1.45;
    }

    .mt-guide-check {
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.92rem;
      background: rgba(2, 6, 23, 0.72);
      padding: 0.85rem 0.95rem;
      box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.04);
    }

    .mt-guide-check--good {
      border-color: rgba(52, 211, 153, 0.34);
      background: rgba(6, 78, 59, 0.18);
    }

    .mt-guide-check--warn {
      border-color: rgba(250, 204, 21, 0.34);
      background: rgba(113, 63, 18, 0.18);
    }

    .mt-guide-check--alert {
      border-color: rgba(248, 113, 113, 0.38);
      background: rgba(127, 29, 29, 0.18);
    }

    .mt-guide-check--info {
      border-color: rgba(56, 189, 248, 0.28);
      background: rgba(12, 74, 110, 0.16);
    }

    .mt-guide-check__top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .mt-guide-check__label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-guide-check__value {
      font-size: 1.15rem;
      font-weight: 700;
      color: rgb(248 250 252);
      line-height: 1;
    }

    .mt-guide-check__target {
      font-size: 0.68rem;
      color: rgb(191 219 254);
      text-align: right;
      white-space: nowrap;
    }

    .mt-guide-check__hint {
      margin-top: 0.45rem;
      font-size: 0.77rem;
      line-height: 1.45;
      color: rgb(203 213 225);
    }

    .mt-empty-state {
      border: 1px dashed rgba(51, 65, 85, 0.92);
      border-radius: 0.9rem;
      background: rgba(2, 6, 23, 0.58);
      padding: 0.9rem 1rem;
      font-size: 0.9rem;
      color: rgb(148 163 184);
    }

    .mt-check-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 9999px;
      background: rgba(2, 6, 23, 0.82);
      padding: 0.66rem 0.92rem;
      font-size: 0.82rem;
      color: rgb(226 232 240);
    }

    .mt-check-pill input {
      margin: 0;
    }

    .mt-modal {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(2, 6, 23, 0.84);
    }

    .mt-modal-panel {
      position: relative;
      width: 100%;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 1rem;
      background: rgba(2, 6, 23, 0.96);
      padding: 1rem;
      box-shadow: 0 24px 50px rgba(2, 6, 23, 0.45);
    }

    .mt-preview-panel {
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 1rem;
      background: rgba(2, 6, 23, 0.95);
      padding: 0.5rem;
      box-shadow: 0 24px 50px rgba(2, 6, 23, 0.5);
    }

    .mt-card-media {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.75rem;
      overflow: hidden;
      background: rgba(2, 6, 23, 0.92);
    }

    .mt-card-media__fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.85rem;
      color: rgb(148 163 184);
      background: rgba(15, 23, 42, 0.92);
      font-size: 0.78rem;
      line-height: 1.45;
    }

    .mt-list-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.5rem 0;
    }

    .mt-list-row__title {
      font-weight: 500;
      color: rgb(248 250 252);
    }

    .mt-list-row__actions {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: 0.5rem;
    }

    .mt-action-menu {
      position: relative;
      flex-shrink: 0;
    }

    .mt-action-menu > summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.25rem;
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.72rem;
      background: rgba(15, 23, 42, 0.92);
      padding: 0.52rem 0.7rem;
      color: rgb(226 232 240);
      font-size: 0.84rem;
      font-weight: 700;
      line-height: 1;
      cursor: pointer;
      list-style: none;
      transition: border-color 140ms ease, background-color 140ms ease, color 140ms ease;
    }

    .mt-action-menu > summary::-webkit-details-marker {
      display: none;
    }

    .mt-action-menu > summary:hover,
    .mt-action-menu[open] > summary {
      border-color: var(--mt-border-strong);
      background: rgba(15, 23, 42, 0.98);
      color: rgb(240 249 255);
    }

    .mt-action-menu__panel {
      position: absolute;
      right: 0;
      top: calc(100% + 0.4rem);
      z-index: 30;
      min-width: 12rem;
      overflow: hidden;
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.9rem;
      background: rgba(2, 6, 23, 0.98);
      box-shadow: 0 20px 40px rgba(2, 6, 23, 0.42);
    }

    .mt-action-menu__form {
      display: block;
    }

    .mt-action-menu__item {
      display: block;
      width: 100%;
      border: 0;
      border-top: 1px solid rgba(30, 41, 59, 0.92);
      background: transparent;
      padding: 0.72rem 0.9rem;
      text-align: left;
      font-size: 0.82rem;
      color: rgb(226 232 240);
      transition: background-color 140ms ease, color 140ms ease;
    }

    .mt-action-menu__panel > :first-child .mt-action-menu__item,
    .mt-action-menu__panel > .mt-action-menu__item:first-child {
      border-top: 0;
    }

    .mt-action-menu__item:hover {
      background: rgba(15, 23, 42, 0.92);
      color: rgb(240 249 255);
    }

    .mt-action-menu__item:disabled {
      cursor: not-allowed;
      color: rgb(100 116 139);
    }

    .mt-action-menu__item:disabled:hover {
      background: transparent;
      color: rgb(100 116 139);
    }

    .mt-collection-panel {
      align-self: start;
      height: fit-content;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 1rem;
      background: rgba(2, 6, 23, 0.66);
      padding: 0.65rem;
      box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.08);
    }

    .mt-collection-panel--compact {
      border-radius: 0.8rem;
      padding: 0.38rem;
    }

    .mt-collection-panel__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(30, 41, 59, 0.92);
      padding: 0 0.25rem 0.5rem;
    }

    .mt-art-card {
      position: relative;
      overflow: visible;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.72rem;
      background: rgba(2, 6, 23, 0.94);
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.28);
    }

    .mt-art-card--grid {
      width: 128px;
    }

    .mt-art-card--stack {
      width: 160px;
      height: 224px;
    }

    .mt-art-card__fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.7rem;
      color: rgb(203 213 225);
      background: rgba(15, 23, 42, 0.95);
      font-size: 0.75rem;
    }

    .mt-art-card__badge {
      position: absolute;
      left: 0.4rem;
      top: 0.4rem;
      border-radius: 0.5rem;
      background: rgba(2, 6, 23, 0.9);
      padding: 0.12rem 0.4rem;
      font-size: 0.65rem;
      font-weight: 700;
      color: rgb(125 211 252);
    }

    .mt-art-card__toolbar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.25rem;
      padding: 0;
    }

    .mt-art-card__toolbar--top {
      position: absolute;
      right: 0.4rem;
      top: 0.4rem;
      z-index: 35;
    }

    .mt-art-card__toolbar--side {
      position: absolute;
      right: 0.45rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 35;
    }

    .mt-art-card__title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.65rem;
      color: rgb(248 250 252);
    }

    .mt-deck-view-root {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .mt-deck-view-root--grouped {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .mt-deck-view-section {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.95rem;
      background: rgba(2, 6, 23, 0.62);
      overflow: visible;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section {
      width: fit-content;
      max-width: 100%;
      min-width: 13.5rem;
    }

    .mt-deck-view-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(30, 41, 59, 0.92);
      padding: 0.65rem 0.85rem;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section__head {
      padding: 0.52rem 0.68rem;
    }

    .mt-deck-view-section__title {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-deck-view-section__count {
      font-size: 0.75rem;
      color: rgb(203 213 225);
    }

    .mt-deck-view-section__body {
      padding: 0.75rem 0.85rem;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section__body {
      padding: 0.55rem 0.65rem;
    }

    .mt-deck-view-section__body--text {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .mt-deck-view-section__body--grid,
    .mt-deck-view-section__body--stacks {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .mt-deck-view-section__body--stacks {
      position: relative;
      overflow: visible;
      padding: 0.9rem 2.25rem 1rem 0.9rem;
    }

    .mt-deck-view-section__body--table {
      padding: 0;
      overflow-x: auto;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section__body--table {
      min-width: min(42rem, 100%);
    }

    .mt-deck-row__meta {
      margin-top: 0.15rem;
      font-size: 0.72rem;
      line-height: 1.4;
      color: rgb(148 163 184);
    }

    .mt-deck-art-card {
      width: 100%;
    }

    .mt-deck-view-section__body--grid .mt-deck-art-card {
      width: 138px;
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card {
      position: absolute;
      left: 0.9rem;
      top: 0;
      width: 186px;
      box-shadow: 0 18px 34px rgba(2, 6, 23, 0.42);
      transition: top 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card:hover {
      transform: translateX(0.15rem);
      box-shadow: 0 24px 42px rgba(2, 6, 23, 0.52);
      z-index: 999;
    }

    .mt-deck-art-card__media {
      position: relative;
      aspect-ratio: 5 / 7;
      overflow: hidden;
      border-radius: inherit;
      background: rgba(2, 6, 23, 0.95);
    }

    .mt-deck-art-card__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .mt-deck-art-card__body {
      padding: 0.52rem 0.58rem 0.6rem;
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card__body {
      display: none;
    }

    .mt-deck-art-card__meta {
      margin-top: 0.24rem;
      font-size: 0.68rem;
      line-height: 1.4;
      color: rgb(148 163 184);
    }

    .mt-action-menu--card > summary {
      min-width: 2rem;
      padding: 0.46rem 0.58rem;
      border-radius: 9999px;
      background: rgba(2, 6, 23, 0.88);
      box-shadow: 0 10px 20px rgba(2, 6, 23, 0.3);
    }

    .mt-action-menu--card > .mt-action-menu__panel {
      top: 50%;
      right: calc(100% + 0.45rem);
      transform: translateY(-50%);
    }

    .mt-deck-table {
      width: 100%;
      border-collapse: collapse;
    }

    .mt-deck-table th,
    .mt-deck-table td {
      border-top: 1px solid rgba(30, 41, 59, 0.92);
      padding: 0.7rem 0.85rem;
      text-align: left;
      vertical-align: middle;
    }

    .mt-deck-table thead th {
      border-top: 0;
      background: rgba(15, 23, 42, 0.92);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-deck-table tbody tr:hover {
      background: rgba(15, 23, 42, 0.48);
    }

    .mt-deck-table__name {
      font-weight: 600;
      color: rgb(248 250 252);
    }

    .mt-deck-table__sub {
      margin-top: 0.16rem;
      font-size: 0.72rem;
      color: rgb(148 163 184);
    }

    .mt-art-tile {
      width: 78px;
      flex-shrink: 0;
    }

    @media (min-width: 640px) {
      .mt-art-tile {
        width: 88px;
      }
    }

    .mt-art-tile--grid {
      width: 100%;
    }

    .mt-art-tile--grid .mt-art-tile__label {
      white-space: normal;
      line-height: 1.35;
      min-height: 2.6em;
    }

    .mt-art-tile__frame {
      position: relative;
      width: 100%;
      aspect-ratio: 5 / 7;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.65rem;
      overflow: hidden;
      background: rgba(15, 23, 42, 0.92);
    }

    .mt-art-tile__fallback {
      display: flex;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
      padding: 0.3rem;
      text-align: center;
      font-size: 0.65rem;
      color: rgb(203 213 225);
    }

    .mt-art-tile__badge {
      position: absolute;
      right: 0.35rem;
      top: 0.35rem;
      border-radius: 0.45rem;
      background: rgba(2, 6, 23, 0.92);
      padding: 0.12rem 0.4rem;
      font-size: 0.65rem;
      font-weight: 700;
      color: rgb(125 211 252);
    }

    .mt-art-tile__label {
      margin-top: 0.3rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.65rem;
      color: rgb(203 213 225);
    }
  </style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
  <div class="min-h-screen flex flex-col">
    {{ if not .HideHeader }}
      <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
        <div class="{{ if .HomeHeader }}max-w-5xl mx-auto px-4 py-2.5 flex items-center justify-between gap-4{{ else }}max-w-5xl mx-auto px-4 py-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-4{{ end }}">
          <a href="/" class="flex items-center gap-2">
            <div class="h-7 w-7 rounded-full border border-sky-400/60 bg-sky-500/10 flex items-center justify-center text-sky-300 font-bold text-xs">
              MT
            </div>
            <span class="text-base font-semibold tracking-wide">Mana Tomb</span>
          </a>

          {{ if not .HomeHeader }}
            <form action="/cards" method="GET" class="flex-1 min-w-0">
              <label for="site-card-search" class="sr-only">Search cards</label>
              <div class="relative" data-card-autocomplete-root>
                <input
                  id="site-card-search"
                  name="q"
                  type="text"
                  placeholder="Search cards"
                  class="mt-control mt-control--sm w-full !pr-24"
                  autocomplete="off"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                  data-card-autocomplete-input
                />
                <div
                  data-card-autocomplete-menu
                  class="hidden absolute left-0 right-0 top-[calc(100%+0.35rem)] z-30 overflow-hidden rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/70"
                  role="listbox"></div>
                <button
                  type="submit"
                  class="absolute right-1 top-1/2 -translate-y-1/2 mt-btn mt-btn--primary mt-btn--xs"
                >
                  Search
                </button>
              </div>
            </form>
          {{ end }}

          <nav class="flex items-center flex-wrap justify-end gap-3 text-sm">
            {{ if or (not .HomeHeader) .CurrentUser }}
              <a href="/decks/new" class="mt-nav-link">Builder</a>
              <a href="/cards/search" class="mt-nav-link">Advanced Search</a>
              <a href="/decks/public" class="mt-nav-link">Browse Decks</a>
              {{ if .CurrentUser }}
                <a href="/decks" class="mt-nav-link">My Decks</a>
                <a href="{{ userProfilePath .CurrentUser.ID }}" class="mt-nav-link">Profile</a>
              {{ end }}
            {{ end }}
            {{ if .CurrentUser }}
              <a href="/settings" class="mt-btn mt-btn--secondary text-xs !px-3 !py-2">
                Settings
              </a>
            {{ else }}
              <a href="/login" class="mt-btn mt-btn--secondary text-xs !px-3 !py-2">
                Log In
              </a>
            {{ end }}
          </nav>
        </div>
      </header>
    {{ end }}

        <main class="flex-1">
      <div class="{{ if .WideLayout }}w-full px-0 {{ if .HideHeader }}py-3{{ else }}py-6{{ end }}{{ else }}max-w-5xl mx-auto px-4 py-6{{ end }}">
        {{ if .Flash }}
          <div class="mb-3 rounded-md border border-sky-500/60 bg-sky-500/10 px-3 py-2 text-sm text-sky-200">
            {{ .Flash }}
          </div>
        {{ end }}

        {{ if .Error }}
          <div class="mb-4 rounded-md border border-red-500/70 bg-red-900/40 px-3 py-2 text-sm text-red-200">
            {{ .Error }}
          </div>
        {{ end }}
{{ end }}
