      padding: 0.56rem 0.68rem;
      text-align: left;
      vertical-align: middle;
    }

    .mt-deck-table thead th {
      border-top: 0;
      background: rgba(15, 23, 42, 0.92);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(148 163 184);
    }

    .mt-deck-table tbody tr:hover {
      background: rgba(15, 23, 42, 0.48);
    }

    .mt-deck-table__group-row td {
      border-top: 1px solid rgba(56, 189, 248, 0.2);
      background: rgba(14, 165, 233, 0.08);
      padding: 0.42rem 0.68rem;
      color: rgb(148 163 184);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .mt-deck-table__actions {
      width: 1%;
      white-space: nowrap;
    }

    .mt-deck-table__actions .mt-deck-action-cluster {
      width: 100%;
      justify-content: flex-end;
    }

    .mt-deck-table tbody tr {
      position: relative;
    }

    .mt-deck-table__menu-cell {
      position: relative;
      padding-right: 3.1rem !important;
    }

    .mt-action-menu--table-row {
      position: absolute;
      right: 0.6rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .mt-action-menu--table-row > summary {
      min-width: 1.76rem;
      height: 1.76rem;
      border-radius: 9999px;
      padding: 0;
      background: rgba(2, 6, 23, 0.88);
    }

    .mt-deck-table__qty {
      width: 5.25rem;
    }

    .mt-deck-table__board {
      width: 8.5rem;
    }

    .mt-deck-table__qty-input,
    .mt-deck-table__board-select {
      width: 100%;
      border: 1px solid rgba(51, 65, 85, 0.88);
      border-radius: 0.62rem;
      background: rgba(15, 23, 42, 0.92);
      color: rgb(226 232 240);
      font-size: 0.82rem;
      line-height: 1.2;
      outline: none;
      transition: border-color 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
    }

    .mt-deck-table__qty-input {
      max-width: 4.4rem;
      padding: 0.42rem 0.5rem;
    }

    .mt-deck-table__board-select {
      min-width: 7.4rem;
      padding: 0.42rem 0.55rem;
    }

    .mt-deck-table__qty-input:focus,
    .mt-deck-table__board-select:focus {
      border-color: rgba(56, 189, 248, 0.82);
      box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.22);
    }

    .mt-deck-table__name {
      font-weight: 600;
      color: rgb(248 250 252);
    }

    .mt-deck-table__sub {
      margin-top: 0.16rem;
      font-size: 0.72rem;
      color: rgb(148 163 184);
    }

    @media (max-width: 1100px) {
      .mt-deck-view-root--text.mt-deck-view-root--grouped {
        column-count: 2;
      }
    }

    @media (max-width: 760px) {
      .mt-deck-view-root--text.mt-deck-view-root--grouped {
        column-count: 1;
      }
    }

    .mt-art-tile {
      width: 78px;
      flex-shrink: 0;
    }

    @media (min-width: 640px) {
      .mt-art-tile {
        width: 88px;
      }
    }

    .mt-art-tile--grid {
      width: 100%;
    }

    .mt-art-tile--grid .mt-art-tile__label {
      white-space: normal;
      line-height: 1.35;
      min-height: 2.6em;
    }

    .mt-art-tile__frame {
      position: relative;
      width: 100%;
      aspect-ratio: 5 / 7;
      border: 1px solid var(--mt-border-subtle);
      border-radius: 0.65rem;
      overflow: hidden;
      background: var(--mt-surface);
    }

    .mt-art-tile__fallback {
      display: flex;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
      padding: 0.3rem;
      text-align: center;
      font-size: 0.65rem;
      color: var(--mt-text-soft);
    }

    .mt-art-tile__badge {
      position: absolute;
      right: 0.35rem;
      top: 0.35rem;
      border-radius: 0.45rem;
      background: color-mix(in srgb, var(--mt-bg) 92%, transparent);
      padding: 0.12rem 0.4rem;
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--mt-accent-text);
    }

    .mt-art-tile__menu {
      position: absolute;
      right: 0.32rem;
      top: 0.32rem;
      z-index: 6;
    }

    .mt-art-tile__menu .mt-action-menu > summary,
    .mt-action-menu--art-tile > summary {
      min-width: 1.75rem;
      height: 1.75rem;
      border-radius: 9999px;
      border: 1px solid var(--mt-border-control);
      background: color-mix(in srgb, var(--mt-bg) 84%, transparent);
      padding: 0;
      color: var(--mt-text-soft);
      box-shadow: var(--mt-shadow-card);
      backdrop-filter: blur(10px);
    }

    .mt-art-tile__label {
      margin-top: 0.3rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.65rem;
      color: var(--mt-text-soft);
    }
  </style>
