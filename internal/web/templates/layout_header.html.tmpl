      }
    }

    .mt-art-tile--grid {
      width: 100%;
    }

    .mt-art-tile--grid .mt-art-tile__label {
      white-space: normal;
      line-height: 1.35;
      min-height: 2.6em;
    }

    .mt-art-tile__frame {
      position: relative;
      width: 100%;
      aspect-ratio: 5 / 7;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.65rem;
      overflow: hidden;
      background: rgba(15, 23, 42, 0.92);
    }

    .mt-art-tile__fallback {
      display: flex;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
      padding: 0.3rem;
      text-align: center;
      font-size: 0.65rem;
      color: rgb(203 213 225);
    }

    .mt-art-tile__badge {
      position: absolute;
      right: 0.35rem;
      top: 0.35rem;
      border-radius: 0.45rem;
      background: rgba(2, 6, 23, 0.92);
      padding: 0.12rem 0.4rem;
      font-size: 0.65rem;
      font-weight: 700;
      color: rgb(125 211 252);
    }

    .mt-art-tile__menu {
      position: absolute;
      right: 0.32rem;
      top: 0.32rem;
      z-index: 6;
    }

    .mt-art-tile__menu .mt-action-menu > summary,
    .mt-action-menu--art-tile > summary {
      min-width: 1.75rem;
      height: 1.75rem;
      border-radius: 9999px;
      border: 1px solid rgba(51, 65, 85, 0.82);
      background: rgba(2, 6, 23, 0.84);
      padding: 0;
      color: rgb(226 232 240);
      box-shadow: 0 10px 20px rgba(2, 6, 23, 0.28);
      backdrop-filter: blur(10px);
    }

    .mt-art-tile__label {
      margin-top: 0.3rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.65rem;
      color: rgb(203 213 225);
    }
  </style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
  <div class="min-h-screen flex flex-col">
    {{ if not .HideHeader }}
      <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
        <div class="{{ if .HomeHeader }}max-w-5xl mx-auto px-4 py-2.5 flex items-center justify-between gap-4{{ else }}max-w-5xl mx-auto px-4 py-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-4{{ end }}">
          <a href="/" class="flex items-center gap-2">
            <div class="h-7 w-7 rounded-full border border-sky-400/60 bg-sky-500/10 flex items-center justify-center text-sky-300 font-bold text-xs">
              MT
            </div>
            <span class="text-base font-semibold tracking-wide">Mana Tomb</span>
          </a>

          {{ if not .HomeHeader }}
            <form action="/cards" method="GET" class="flex-1 min-w-0">
              <input type="hidden" name="sort" value="relevance">
              <input type="hidden" name="sort_dir" value="desc">
              <label for="site-card-search" class="sr-only">Search cards</label>
              <div class="relative" data-card-autocomplete-root>
                <input
                  id="site-card-search"
                  name="q"
                  type="text"
                  placeholder="Search cards"
                  class="mt-control mt-control--sm w-full !pr-24"
                  autocomplete="off"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                  data-card-autocomplete-input
                />
                <div
                  data-card-autocomplete-menu
                  class="mt-autocomplete-menu hidden absolute left-0 right-0 top-[calc(100%+0.35rem)] rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/70"
                  role="listbox"></div>
                <button
                  type="submit"
                  class="mt-header-search-submit absolute right-1 top-1/2 mt-btn mt-btn--primary mt-btn--xs"
                >
                  Search
                </button>
              </div>
            </form>
          {{ end }}

          <nav class="flex items-center flex-wrap justify-end gap-3 text-sm">
            {{ if or (not .HomeHeader) .CurrentUser }}
              <a href="/decks/new" class="mt-nav-link">Builder</a>
              <a href="/cards/search" class="mt-nav-link">Advanced Search</a>
              <a href="/decks/public" class="mt-nav-link">Browse Decks</a>
              {{ if .CurrentUser }}
                <a href="/decks" class="mt-nav-link">My Decks</a>
                <a href="{{ userProfilePath .CurrentUser.ID }}" class="mt-nav-link">Profile</a>
              {{ end }}
            {{ end }}
            {{ if .CurrentUser }}
              <a href="/settings" class="mt-btn mt-btn--secondary text-xs !px-3 !py-2">
                Settings
              </a>
            {{ else }}
              <a href="/login" class="mt-btn mt-btn--secondary text-xs !px-3 !py-2">
                Log In
              </a>
            {{ end }}
          </nav>
        </div>
      </header>
    {{ end }}

        <main class="flex-1">
      <div class="{{ if .WideLayout }}w-full px-0 {{ if .HideHeader }}py-3{{ else }}py-6{{ end }}{{ else }}max-w-5xl mx-auto px-4 py-6{{ end }}">
        {{ if .Flash }}
          <div class="mb-3 rounded-md border border-sky-500/60 bg-sky-500/10 px-3 py-2 text-sm text-sky-200">
            {{ .Flash }}
          </div>
        {{ end }}

        {{ if .Error }}
          <div class="mb-4 rounded-md border border-red-500/70 bg-red-900/40 px-3 py-2 text-sm text-red-200">
            {{ .Error }}
          </div>
        {{ end }}
{{ end }}
