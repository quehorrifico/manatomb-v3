{{ define "layout_header" }}
<!DOCTYPE html>
<html lang="en" data-theme="{{ .Theme }}">
<head>
  <meta charset="utf-8">
  {{ with .Meta }}
    {{ if eq .Title "ManaTomb" }}
      <title>ManaTomb</title>
    {{ else if .Title }}
      <title>{{ .Title }} | ManaTomb</title>
    {{ else }}
      <title>ManaTomb</title>
    {{ end }}
    {{ if .Description }}<meta name="description" content="{{ .Description }}">{{ end }}
    {{ if .Robots }}<meta name="robots" content="{{ .Robots }}">{{ end }}
    {{ if .CanonicalURL }}<link rel="canonical" href="{{ .CanonicalURL }}">{{ end }}
    <meta property="og:site_name" content="ManaTomb">
    <meta property="og:locale" content="en_US">
    <meta property="og:type" content="{{ if .Type }}{{ .Type }}{{ else }}website{{ end }}">
    {{ if .Title }}<meta property="og:title" content="{{ .Title }}">{{ end }}
    {{ if .Description }}<meta property="og:description" content="{{ .Description }}">{{ end }}
    {{ if .CanonicalURL }}<meta property="og:url" content="{{ .CanonicalURL }}">{{ end }}
    {{ if .ImageURL }}
      <meta property="og:image" content="{{ .ImageURL }}">
      {{ if .ImageAlt }}<meta property="og:image:alt" content="{{ .ImageAlt }}">{{ end }}
      <meta name="twitter:card" content="summary_large_image">
    {{ else }}
      <meta name="twitter:card" content="summary">
    {{ end }}
    {{ if .Title }}<meta name="twitter:title" content="{{ .Title }}">{{ end }}
    {{ if .Description }}<meta name="twitter:description" content="{{ .Description }}">{{ end }}
    {{ if .ImageURL }}<meta name="twitter:image" content="{{ .ImageURL }}">{{ end }}
    {{ if and .ImageURL .ImageAlt }}<meta name="twitter:image:alt" content="{{ .ImageAlt }}">{{ end }}
  {{ else }}
    <title>ManaTomb</title>
  {{ end }}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1512">
  <link rel="icon" href="/assets/manatomb-square-logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/theme.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <style>
    body.mt-app {
      background: var(--mt-bg);
      color: var(--mt-text);
      font-family: var(--mt-font-sans);
    }

    .mt-skip-link {
      position: fixed;
      z-index: 1000;
      top: 0.75rem;
      left: 0.75rem;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .mt-skip-link:focus {
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      border: 1px solid var(--mt-border);
      border-radius: 0.45rem;
      background: var(--mt-surface-raised);
      padding: 0.6rem 0.8rem;
      color: var(--mt-text);
      box-shadow: var(--mt-shadow-popover);
    }

    .mt-text-soft {
      color: var(--mt-text-soft);
    }

    .mt-text-primary {
      color: var(--mt-text);
    }

    .mt-text-muted {
      color: var(--mt-text-muted);
    }

    .mt-site-footer {
      border-top: 1px solid var(--mt-border-subtle);
      background: var(--mt-surface);
    }

    .mt-footer-brand {
      color: var(--mt-text);
      font-weight: 600;
      text-decoration: none;
      transition: color 140ms ease;
    }

    .mt-footer-brand:hover {
      color: var(--mt-accent-text);
    }

    .mt-footer-brand:focus-visible {
      border-radius: 0.2rem;
      outline: 2px solid var(--mt-focus);
      outline-offset: 2px;
    }

    .mt-footer-divider {
      border-color: var(--mt-border-subtle);
    }

    .mt-footer-link {
      color: var(--mt-text-muted);
      font-weight: 600;
      text-decoration: none;
      transition: color 140ms ease;
    }

    .mt-footer-link:hover {
      color: var(--mt-text);
    }

    .mt-footer-link--inline {
      text-decoration: underline;
      text-decoration-color: var(--mt-border);
      text-underline-offset: 0.18em;
    }

    .mt-footer-link:focus-visible {
      border-radius: 0.2rem;
      outline: 2px solid var(--mt-focus);
      outline-offset: 2px;
    }

    .mt-flash {
      margin-bottom: 0.75rem;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }

    .mt-flash--info {
      border: 1px solid var(--mt-border-strong);
      background: var(--mt-accent-soft);
      color: var(--mt-accent-text);
    }

    .mt-flash--error {
      border: 1px solid var(--mt-negative-border);
      background: var(--mt-negative-soft);
      color: var(--mt-negative);
    }

    .mt-autocomplete-menu {
      z-index: 30;
      overflow: hidden;
      border: 1px solid var(--mt-border);
      border-radius: 0.75rem;
      background: var(--mt-surface-strong);
      box-shadow: var(--mt-shadow-popover);
    }

    .mt-autocomplete-option {
      display: block;
      width: 100%;
      border: 0;
      border-top: 1px solid var(--mt-border-subtle);
      background: transparent;
      padding: 0.5rem 0.75rem;
      color: var(--mt-text-soft);
      font-size: 0.875rem;
      text-align: left;
      transition: background-color 120ms ease, color 120ms ease;
    }

    .mt-autocomplete-option:first-child {
      border-top: 0;
    }

    .mt-autocomplete-option:hover,
    .mt-autocomplete-option.is-active {
      background: var(--mt-surface-raised);
      color: var(--mt-accent-text);
    }

    .mt-autocomplete-option:focus-visible {
      outline: 2px solid var(--mt-focus);
      outline-offset: -2px;
    }

    @keyframes mtDeckItemIn {
      from {
        opacity: 0;
        transform: translateY(4px) scale(0.995);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes mtDeckFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .mt-site-header {
      position: relative;
      z-index: 220;
      border-bottom: 1px solid var(--mt-border-subtle);
      background: var(--mt-bg);
    }

    .mt-site-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--mt-text);
      text-decoration: none;
      white-space: nowrap;
    }

    .mt-site-brand__logo {
      display: block;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 0.45rem;
    }

    .mt-site-brand__name {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .mt-site-brand:hover {
      color: var(--mt-accent-text);
    }

    .mt-site-brand:focus-visible,
    .mt-nav-link:focus-visible,
    .mt-site-menu-toggle:focus-visible {
      border-radius: 0.2rem;
      outline: 2px solid var(--mt-focus);
      outline-offset: 2px;
    }

    .mt-site-search [data-card-autocomplete-input] {
      background: var(--mt-surface);
    }

    .mt-site-search [data-card-autocomplete-input]:focus,
    .mt-site-search [data-card-autocomplete-input]:focus-visible {
      border-color: transparent;
      outline: none;
      box-shadow: inset 0 1px 0 var(--mt-control-highlight);
    }

    .mt-nav-link {
      position: relative;
      display: inline-flex;
      min-height: 2.1rem;
      align-items: center;
      padding: 0.48rem 0.2rem 0.58rem;
      color: var(--mt-text-soft);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1.15;
      text-decoration: none;
      white-space: nowrap;
    }

    .mt-nav-link:hover {
      color: var(--mt-accent-text);
    }

    .mt-nav-link[aria-current="page"] {
      color: var(--mt-text);
    }

    .mt-nav-link[aria-current="page"]::after {
      position: absolute;
      right: 0.2rem;
      bottom: 0.12rem;
      left: 0.2rem;
      height: 2px;
      border-radius: 9999px;
      background: var(--mt-accent-strong);
      content: "";
    }

    .mt-site-nav {
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
    }

    .mt-site-nav__primary {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 0.9rem;
    }

    .mt-site-nav__account {
      display: flex;
      flex-shrink: 0;
      align-items: center;
    }

    .mt-site-account-action {
      white-space: nowrap;
    }

    .mt-site-header .mt-btn,
    .mt-site-header .mt-btn:hover {
      transform: none;
    }

    .mt-site-menu-toggle {
      display: none;
      width: 2.35rem;
      height: 2.35rem;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--mt-border-control);
      border-radius: 0.58rem;
      background: var(--mt-surface);
      color: var(--mt-text-soft);
    }

    .mt-site-menu-toggle:hover {
      border-color: var(--mt-border-strong);
      color: var(--mt-accent-text);
    }

    .mt-site-menu-toggle svg {
      width: 1.15rem;
      height: 1.15rem;
    }

    .mt-site-menu-toggle [data-menu-icon="close"],
    .mt-site-menu-toggle[aria-expanded="true"] [data-menu-icon="open"] {
      display: none;
    }

    .mt-site-menu-toggle[aria-expanded="true"] [data-menu-icon="close"] {
      display: block;
    }

    @media (max-width: 1023px) {
      .mt-site-nav {
        width: 100%;
        align-items: flex-start;
      }

      .mt-site-nav__primary {
        flex: 1;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 767px) {
      .mt-site-header__inner {
        position: relative;
        align-items: stretch;
        flex-direction: column;
      }

      .mt-site-menu-toggle {
        position: absolute;
        top: 0.75rem;
        right: 1rem;
        z-index: 2;
        display: inline-flex;
      }

      .mt-site-brand {
        min-height: 2.35rem;
        padding-right: 3rem;
      }

      .mt-site-nav {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        border-top: 1px solid var(--mt-border-subtle);
        padding-top: 0.35rem;
      }

      .mt-site-nav[data-open="true"] {
        display: flex;
      }

      .mt-site-nav__primary {
        width: 100%;
        flex: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .mt-site-nav__primary + .mt-site-nav__account {
        width: 100%;
        padding: 0.7rem 0 0.25rem;
      }

      .mt-nav-link {
        width: 100%;
        min-height: 2.75rem;
        border-bottom: 1px solid var(--mt-border-subtle);
        padding: 0.75rem 0.5rem 0.75rem 1rem;
        font-size: 0.84rem;
      }

      .mt-nav-link[aria-current="page"]::after {
        top: 0.68rem;
        right: auto;
        bottom: 0.68rem;
        left: 0;
        width: 2px;
        height: auto;
      }

      .mt-site-nav__account .mt-btn {
        width: 100%;
      }
    }

    .mt-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border-radius: 0.68rem;
      padding: 0.72rem 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: inherit;
      line-height: 1.2;
      transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }

    .mt-btn:hover {
      transform: translateY(-1px);
    }

    .mt-btn:focus-visible {
      outline: 2px solid var(--mt-focus);
      outline-offset: 2px;
    }

    .mt-btn--primary {
      background: var(--mt-accent);
      color: var(--mt-on-accent);
      box-shadow: var(--mt-shadow-accent);
    }

    .mt-btn--primary:hover {
      background: var(--mt-accent-strong);
    }

    .mt-btn--secondary {
      border: 1px solid var(--mt-border-control);
      background: var(--mt-surface-strong);
      color: var(--mt-text);
    }

    .mt-btn--secondary:hover {
      border-color: var(--mt-border-strong);
      background: var(--mt-surface-raised);
      color: var(--mt-text);
    }

    .mt-btn--light {
      background: rgb(241 245 249);
      color: var(--mt-on-accent);
      box-shadow: 0 8px 18px rgba(148, 163, 184, 0.18);
    }

    .mt-btn--light:hover {
      background: rgb(255 255 255);
    }

    .mt-btn--warning {
      background: rgb(252 211 77);
      color: var(--mt-on-accent);
      box-shadow: 0 8px 18px rgba(251, 191, 36, 0.18);
    }

    .mt-btn--warning:hover {
      background: rgb(253 230 138);
    }

    .mt-btn--danger {
      border: 1px solid rgba(239, 68, 68, 0.45);
      background: rgba(127, 29, 29, 0.3);
      color: rgb(252 165 165);
    }

    .mt-btn--danger:hover {
      border-color: rgba(248, 113, 113, 0.65);
      color: rgb(254 202 202);
    }

    .mt-btn--ghost {
      color: rgb(191 219 254);
      padding-left: 0;
      padding-right: 0;
    }

    .mt-btn--ghost:hover {
      color: rgb(224 242 254);
      transform: none;
    }

    .mt-btn--sm {
      padding: 0.56rem 0.8rem;
      font-size: 0.8rem;
      border-radius: 0.62rem;
    }

    .mt-btn--xs {
      padding: 0.42rem 0.62rem;
      font-size: 0.72rem;
      border-radius: 0.56rem;
      gap: 0.26rem;
    }

    .mt-btn--micro {
      padding: 0.2rem 0.45rem;
      font-size: 0.68rem;
      border-radius: 0.55rem;
      gap: 0.2rem;
    }

    .mt-home-action {
      width: 100%;
      min-height: 3.5rem;
      height: 100%;
      text-align: center;
    }

    .mt-home-search-shell,
    .mt-site-search-shell {
      position: relative;
      display: flex;
      min-width: 0;
      align-items: stretch;
      border: 1px solid var(--mt-border-control);
      border-radius: 0.72rem;
      background: var(--mt-surface-strong);
    }

    .mt-home-search-shell .mt-home-search-input,
    .mt-site-search-shell .mt-site-search-input {
      height: 100%;
      min-width: 0;
      border: 0;
      border-radius: 0.68rem 0 0 0.68rem;
      background: transparent;
      box-shadow: inset 0 1px 0 var(--mt-control-highlight);
    }

    .mt-home-search-shell .mt-home-search-input:focus-visible,
    .mt-site-search-shell .mt-site-search-input:focus-visible {
      border-color: transparent;
      outline: none;
      box-shadow: inset 0 1px 0 var(--mt-control-highlight);
    }

    .mt-home-search-random,
    .mt-site-search-random {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      border: 0;
      border-left: 1px solid var(--mt-border-strong);
      border-radius: 0 0.68rem 0.68rem 0;
      background: var(--mt-accent-soft);
      padding: 0.68rem clamp(0.7rem, 3vw, 1rem);
      color: var(--mt-accent-text);
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
      white-space: nowrap;
    }

    .mt-home-search-random:hover,
    .mt-home-search-random:focus-visible,
    .mt-site-search-random:hover,
    .mt-site-search-random:focus-visible {
      border-left-color: var(--mt-accent-strong);
      background: var(--mt-surface-raised);
      color: var(--mt-text);
    }

    .mt-home-search-random:focus-visible,
    .mt-site-search-random:focus-visible {
      outline: 2px solid var(--mt-focus);
      outline-offset: -3px;
    }

    @keyframes mtHeartPop {
      0% { transform: scale(1); }
      38% { transform: scale(1.38); }
      64% { transform: scale(0.92); }
      100% { transform: scale(1); }
    }

    @keyframes mtHeartBurstLeft {
      0% { opacity: 0; transform: translate(-50%, -50%) rotate(-38deg) scale(0.45); }
      34% { opacity: 1; }
      100% { opacity: 0; transform: translate(-1.02rem, -1.02rem) rotate(-38deg) scale(1); }
    }

    @keyframes mtHeartBurstRight {
      0% { opacity: 0; transform: translate(-50%, -50%) rotate(38deg) scale(0.45); }
      34% { opacity: 1; }
      100% { opacity: 0; transform: translate(0.64rem, -1.02rem) rotate(38deg) scale(1); }
    }

    .mt-heart-button {
      position: relative;
      display: inline-grid;
      width: 2.25rem;
      height: 2.25rem;
      place-items: center;
      border: 1px solid var(--mt-border-control);
      border-radius: 9999px;
      background: var(--mt-surface);
      color: var(--mt-text-soft);
      transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
    }

    .mt-heart-button:hover {
      border-color: var(--mt-negative-border);
      background: var(--mt-negative-soft);
      color: var(--mt-negative);
    }

    .mt-heart-button:focus-visible {
      outline: 2px solid var(--mt-negative);
      outline-offset: 2px;
    }

    .mt-heart-button.is-loved {
      border-color: var(--mt-negative-border);
      background: var(--mt-negative-soft);
      color: var(--mt-negative);
    }

    .mt-heart-button__symbol {
      position: relative;
      display: grid;
      width: 1.34rem;
      height: 1.34rem;
      place-items: center;
      font-size: 1.24rem;
      line-height: 1;
      pointer-events: none;
      transform-origin: center;
    }

    .mt-heart-button__symbol::before,
    .mt-heart-button__symbol::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 0.42rem;
      height: 0.42rem;
      border-top: 2px solid currentColor;
      opacity: 0;
      pointer-events: none;
    }

    .mt-heart-button__symbol::before {
      border-left: 2px solid currentColor;
    }

    .mt-heart-button__symbol::after {
      border-right: 2px solid currentColor;
    }

    .mt-heart-button.is-popping .mt-heart-button__symbol {
      animation: mtHeartPop 430ms cubic-bezier(0.2, 0.88, 0.3, 1.25);
    }

    .mt-heart-button.is-popping .mt-heart-button__symbol::before {
      animation: mtHeartBurstLeft 430ms ease-out;
    }

    .mt-heart-button.is-popping .mt-heart-button__symbol::after {
      animation: mtHeartBurstRight 430ms ease-out;
    }

    .mt-card-art-rotatable {
      position: relative;
      z-index: 1;
      transform-origin: center center;
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .mt-card-art-rotatable.is-rotated {
      z-index: 40;
      transform: rotate(90deg);
      box-shadow: var(--mt-shadow-popover);
    }

    .mt-panel {
      border: 1px solid var(--mt-border);
      border-radius: 0.8rem;
      background: var(--mt-surface);
      box-shadow: var(--mt-shadow-panel);
    }

    .mt-commander-panel {
      display: flex;
      justify-content: center;
      padding: 0;
    }

    .mt-commander-card {
      position: relative;
      width: min(100%, 13.25rem);
    }

    .mt-commander-art {
      display: block;
      width: 100%;
      aspect-ratio: 5 / 7;
      overflow: hidden;
      border: 1px solid rgba(71, 85, 105, 0.82);
      border-radius: 0.88rem;
      background: rgba(2, 6, 23, 0.9);
      box-shadow: 0 20px 38px rgba(2, 6, 23, 0.38);
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }

    .mt-commander-art:hover {
      border-color: rgba(125, 211, 252, 0.55);
      transform: translateY(-1px);
      box-shadow: 0 22px 42px rgba(2, 6, 23, 0.42);
    }

    .mt-commander-art--empty {
      display: flex;
      align-items: center;
      justify-content: center;
      border-style: dashed;
      color: rgb(148 163 184);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      box-shadow: none;
    }

    .mt-commander-menu-slot {
      position: absolute;
      right: 0.44rem;
      top: 0.44rem;
      z-index: 8;
    }

    .mt-action-menu--commander > summary {
      min-width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      border: 1px solid rgba(51, 65, 85, 0.84);
      background: rgba(2, 6, 23, 0.82);
      padding: 0;
      color: rgb(226 232 240);
      box-shadow: 0 10px 22px rgba(2, 6, 23, 0.34);
      backdrop-filter: blur(10px);
    }

    .mt-commander-flip {
      position: absolute;
      left: 50%;
      bottom: 0.5rem;
      transform: translateX(-50%);
      box-shadow: 0 10px 22px rgba(2, 6, 23, 0.28);
    }

    .mt-action-card {
      display: block;
      border: 1px solid var(--mt-border);
      border-radius: 0.9rem;
      background: var(--mt-surface);
      padding: 0.85rem;
      transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      box-shadow: var(--mt-shadow-card);
    }

    .mt-action-card:hover {
      transform: translateY(-2px);
      border-color: var(--mt-border-strong);
      background: var(--mt-surface-raised);
      box-shadow: var(--mt-shadow-card-hover);
    }

    .mt-action-card:focus-visible {
      outline: 2px solid var(--mt-focus);
      outline-offset: 2px;
    }

    .mt-guest-home {
      min-height: calc(100vh - 3rem);
      min-height: calc(100svh - 3rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    body[data-page="guest-home"] *,
    body[data-page="guest-home"] *::before,
    body[data-page="guest-home"] *::after {
      animation: none;
      transition: none;
    }

    body[data-page="guest-home"] .mt-btn:hover,
    body[data-page="guest-home"] .mt-action-card:hover {
      transform: none;
    }

    .mt-kicker {
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--mt-accent-strong);
      font-weight: 700;
    }

    .mt-title {
      font-size: clamp(1.65rem, 3.2vw, 2.65rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.03em;
