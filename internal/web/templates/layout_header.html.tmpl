    .mt-deck-qty-btn:active,
    .mt-deck-action-cluster .mt-action-menu > summary:active,
    .mt-action-menu--table-row > summary:active {
      transform: translateY(0) scale(0.96);
    }

    .mt-deck-qty-btn:focus-visible {
      outline: 2px solid var(--mt-focus);
      outline-offset: 2px;
    }

    .mt-deck-qty-btn:disabled {
      cursor: not-allowed;
      color: rgb(100 116 139);
      transform: none;
      box-shadow: none;
    }

    .mt-collection-panel {
      align-self: start;
      height: fit-content;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 1rem;
      background: rgba(2, 6, 23, 0.66);
      padding: 0.65rem;
      box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.08);
    }

    .mt-collection-panel--compact {
      border-radius: 0.8rem;
      padding: 0.38rem;
    }

    .mt-collection-panel__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(30, 41, 59, 0.92);
      padding: 0 0.25rem 0.5rem;
    }

    .mt-art-card {
      position: relative;
      overflow: visible;
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.72rem;
      background: rgba(2, 6, 23, 0.94);
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.28);
    }

    .mt-list-row,
    .mt-deck-view-section__body--grid .mt-deck-art-card,
    .mt-deck-table tbody tr:not(.mt-deck-table__group-row) {
      animation: mtDeckItemIn 170ms ease-out both;
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card {
      animation: mtDeckFadeIn 160ms ease-out both;
    }

    .mt-art-card--grid {
      width: 128px;
    }

    .mt-art-card--stack {
      width: 160px;
      height: 224px;
    }

    .mt-art-card__fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.7rem;
      color: rgb(203 213 225);
      background: rgba(15, 23, 42, 0.95);
      font-size: 0.75rem;
    }

    .mt-art-card__badge {
      position: absolute;
      left: 0.4rem;
      top: 0.4rem;
      border-radius: 0.5rem;
      background: rgba(2, 6, 23, 0.9);
      padding: 0.12rem 0.4rem;
      font-size: 0.65rem;
      font-weight: 700;
      color: rgb(125 211 252);
    }

    .mt-art-card__toolbar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.25rem;
      padding: 0;
    }

    .mt-art-card__toolbar--top {
      position: absolute;
      right: 0.4rem;
      top: 0.4rem;
      z-index: 35;
    }

    .mt-art-card__toolbar--side {
      position: absolute;
      right: 0.45rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 35;
    }

    .mt-art-card__title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.65rem;
      color: rgb(248 250 252);
    }

    .mt-deck-view-root {
      display: flex;
      flex-direction: column;
      gap: 0.72rem;
    }

    .mt-deck-view-root--grouped {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 0.58rem;
    }

    .mt-deck-view-root--text.mt-deck-view-root--grouped {
      display: block;
      column-count: 3;
      column-gap: 1.25rem;
    }

    .mt-deck-view-root--stacks.mt-deck-view-root--grouped {
      --mt-stack-group-min: 196px;
      --mt-stack-group-gap-x: clamp(1.1rem, 1.8vw, 1.55rem);
      --mt-stack-group-gap-y: 1.15rem;
      display: grid;
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(max(var(--mt-stack-group-min), calc((100% - (4 * var(--mt-stack-group-gap-x))) / 5)), 1fr));
      align-items: start;
      gap: var(--mt-stack-group-gap-y) var(--mt-stack-group-gap-x);
    }

    .mt-deck-view-section {
      border: 1px solid rgba(30, 41, 59, 0.92);
      border-radius: 0.78rem;
      background: rgba(2, 6, 23, 0.62);
      overflow: visible;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section {
      width: fit-content;
      max-width: 100%;
      min-width: 13.5rem;
    }

    .mt-deck-view-root--text.mt-deck-view-root--grouped .mt-deck-view-section {
      width: 100%;
      min-width: 0;
      display: inline-block;
      margin: 0 0 1.05rem;
      break-inside: avoid;
    }

    .mt-deck-view-root--stacks.mt-deck-view-root--grouped .mt-deck-view-section {
      width: auto;
      min-width: 0;
      max-width: none;
      display: block;
      margin: 0;
      break-inside: avoid;
      border: 0;
      border-radius: 0;
      background: var(--mt-bg);
    }

    .mt-deck-view-root--stacks.mt-deck-view-root--grouped .mt-deck-view-section--stack-active {
      position: relative;
    }

    .mt-deck-view-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.62rem;
      border-bottom: 1px solid rgba(30, 41, 59, 0.92);
      padding: 0.55rem 0.72rem;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section__head {
      border-bottom: 0;
      padding: 0.38rem 0.54rem 0.24rem;
    }

    .mt-deck-view-root--text .mt-deck-view-section__head,
    .mt-deck-view-root--stacks.mt-deck-view-root--grouped .mt-deck-view-section__head {
      padding: 0.3rem 0.46rem 0.22rem;
    }

    .mt-deck-view-root--text.mt-deck-view-root--grouped .mt-deck-view-section__head {
      padding: 0.24rem 0.4rem 0.2rem;
    }

    .mt-deck-view-root--stacks.mt-deck-view-root--grouped .mt-deck-view-section__head {
      padding: 0.18rem 0 0.28rem;
      width: 100%;
    }

    .mt-deck-view-section__title {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: rgb(148 163 184);
