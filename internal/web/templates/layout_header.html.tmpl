<body id="top" class="mt-app min-h-screen antialiased" data-page="{{ .PageID }}">
  <script>
    (function () {
      var themeMeta = document.querySelector('meta[name="theme-color"]');
      var themeBackground = getComputedStyle(document.documentElement).getPropertyValue('--mt-palette-bg').trim();
      if (themeMeta && themeBackground) themeMeta.content = themeBackground;
    })();
  </script>
  <a class="mt-skip-link" href="#main-content">Skip to content</a>
  <div class="min-h-screen flex flex-col">
    {{ if not .HideHeader }}
      <header class="mt-site-header">
        <div class="mt-site-header__inner max-w-7xl mx-auto px-4 py-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-4">
          <a href="/" class="mt-site-brand shrink-0">
            <img class="mt-site-brand__logo" src="/assets/manatomb-square-logo.svg" alt="">
            <span class="mt-site-brand__name">ManaTomb</span>
          </a>

          <form action="/cards" method="GET" class="mt-site-search flex-1 min-w-0" role="search" aria-label="Card search">
            <input type="hidden" name="sort" value="relevance">
            <input type="hidden" name="sort_dir" value="desc">
            <label for="site-card-search" class="sr-only">Search cards</label>
            <div class="mt-site-search-shell">
              <div class="relative flex min-w-0 flex-1" data-card-autocomplete-root>
                <input
                  id="site-card-search"
                  name="q"
                  type="search"
                  placeholder="Search cards"
                  class="mt-control mt-control--sm mt-site-search-input flex-1"
                  autocomplete="off"
                  aria-autocomplete="list"
                  aria-controls="site-card-search-results"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                  data-card-autocomplete-input
                />
                <div
                  id="site-card-search-results"
                  data-card-autocomplete-menu
                  class="mt-autocomplete-menu hidden absolute left-0 right-0 top-[calc(100%+0.35rem)]"
                  role="listbox"></div>
              </div>
              <a href="/cards/random" class="mt-site-search-random">Random Card</a>
            </div>
            <button type="submit" class="sr-only">Search cards</button>
          </form>

          <button type="button"
                  class="mt-site-menu-toggle"
                  aria-label="Open navigation"
                  aria-controls="site-primary-navigation"
                  aria-expanded="false"
                  data-site-menu-toggle>
            <svg data-menu-icon="open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg data-menu-icon="close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>

          <nav id="site-primary-navigation" class="mt-site-nav" aria-label="Primary navigation" data-open="false" data-site-nav>
            <div class="mt-site-nav__primary">
              <a href="/decks/new" class="mt-nav-link"{{ if eq .ActiveNav "builder" }} aria-current="page"{{ end }}>Build a Deck</a>
              <a href="/cards/search" class="mt-nav-link"{{ if eq .ActiveNav "cards" }} aria-current="page"{{ end }}>Advanced Search</a>
              <a href="/decks/public" class="mt-nav-link"{{ if eq .ActiveNav "public-decks" }} aria-current="page"{{ end }}>Browse Public Decks</a>
              {{ if .CurrentUser }}
                <a href="{{ userProfilePath .CurrentUser.ID }}" class="mt-nav-link"{{ if eq .ActiveNav "profile" }} aria-current="page"{{ end }}>Profile</a>
              {{ end }}
            </div>
            <div class="mt-site-nav__account">
              {{ if .CurrentUser }}
                <a href="/decks" class="mt-btn mt-btn--primary mt-btn--sm mt-site-account-action"{{ if eq .ActiveNav "my-decks" }} aria-current="page"{{ end }}>
                  My Decks
                </a>
              {{ else }}
                {{ $guestAuthNext := "" }}
                {{ if eq .PageID "deck-show" }}
                  {{ $guestAuthNext = .Data.GuestAuthNextPath }}
                {{ end }}
                {{ $guestLoginPath := "/login" }}
                {{ if $guestAuthNext }}
                  {{ $guestLoginPath = print "/login?next=" (urlquery $guestAuthNext) }}
                {{ end }}
                <a href="{{ $guestLoginPath }}" class="mt-btn mt-btn--primary mt-btn--sm mt-site-account-action"{{ if eq .ActiveNav "login" }} aria-current="page"{{ end }}{{ if $guestAuthNext }} data-guest-auth-save-link{{ end }}>
                  Sign In/Sign Up
                </a>
              {{ end }}
            </div>
          </nav>

          <script>
            (function () {
              var header = document.querySelector(".mt-site-header");
              var menuToggle = header ? header.querySelector("[data-site-menu-toggle]") : null;
              var siteNav = header ? header.querySelector("[data-site-nav]") : null;

              function setMenuOpen(open) {
                if (!menuToggle || !siteNav) return;
                menuToggle.setAttribute("aria-expanded", open ? "true" : "false");
                menuToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
                siteNav.setAttribute("data-open", open ? "true" : "false");
              }

              if (menuToggle && siteNav) {
                menuToggle.addEventListener("click", function () {
                  setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
                });

                siteNav.addEventListener("click", function (event) {
                  if (event.target.closest("a")) setMenuOpen(false);
                });

                document.addEventListener("keydown", function (event) {
                  if (event.key !== "Escape" || menuToggle.getAttribute("aria-expanded") !== "true") return;
                  setMenuOpen(false);
                  menuToggle.focus();
                });

                var mobileMenuQuery = window.matchMedia("(max-width: 767px)");
                var handleMenuBreakpoint = function (event) {
                  if (!event.matches) setMenuOpen(false);
                };
                if (mobileMenuQuery.addEventListener) mobileMenuQuery.addEventListener("change", handleMenuBreakpoint);
                else mobileMenuQuery.addListener(handleMenuBreakpoint);
              }

            })();
          </script>
        </div>
      </header>
    {{ end }}

    <main id="main-content" class="flex-1" tabindex="-1">
      <div class="mt-page-shell {{ if .WideLayout }}w-full px-0 {{ if .HideHeader }}py-3{{ else }}py-6{{ end }}{{ else }}max-w-5xl mx-auto px-4 py-6{{ end }}">
        {{ if and .Flash (ne .PageID "guess-card") (ne .PageID "spellify") }}
          <div class="mt-flash mt-flash--info" role="status">
            {{ .Flash }}
          </div>
        {{ end }}

        {{ if .Error }}
          <div id="site-error" class="mt-flash mt-flash--error" role="alert">
            {{ .Error }}
          </div>
        {{ end }}
{{ end }}
