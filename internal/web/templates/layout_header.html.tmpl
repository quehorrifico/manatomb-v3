      color: rgb(224 242 254);
    }

    .mt-deck-board-switch__btn:disabled {
      cursor: default;
    }

    .mt-deck-action-cluster .mt-action-menu > summary,
    .mt-deck-qty-btn {
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.78rem;
      height: 1.78rem;
      border: 1px solid rgba(51, 65, 85, 0.92);
      border-radius: 0.58rem;
      background: rgba(15, 23, 42, 0.92);
      padding: 0;
      color: rgb(226 232 240);
      font-size: 0.8rem;
      font-weight: 800;
      line-height: 1;
      box-shadow: 0 8px 18px rgba(2, 6, 23, 0.18);
      transition: border-color 170ms ease, background-color 170ms ease, color 170ms ease, transform 170ms ease, box-shadow 170ms ease;
    }

    .mt-deck-qty-btn--bulk {
      min-width: 2.35rem;
      padding-inline: 0.24rem;
      font-size: 0.66rem;
      letter-spacing: -0.02em;
