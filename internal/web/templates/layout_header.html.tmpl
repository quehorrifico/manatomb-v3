    .mt-deck-view-root--grouped .mt-deck-view-section__title {
      display: inline-block;
      padding-bottom: 0.16rem;
      border-bottom: 1px solid rgba(125, 211, 252, 0.42);
      color: rgb(203 213 225);
      font-size: 0.9rem;
    }

    .mt-deck-view-section__count {
      font-size: 0.75rem;
      color: rgb(203 213 225);
    }

    .mt-deck-view-section__body {
      padding: 0.62rem 0.72rem;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section__body {
      padding: 0.48rem 0.58rem;
    }

    .mt-deck-view-root--text .mt-deck-view-section__body {
      padding: 0.32rem 0.5rem;
    }

    .mt-deck-view-root--text.mt-deck-view-root--grouped .mt-deck-view-section__body {
      padding: 0.22rem 0.42rem 0.28rem;
    }

    .mt-deck-view-section__body--text {
      display: flex;
      flex-direction: column;
      gap: 0.16rem;
    }

    .mt-deck-view-root--text.mt-deck-view-root--grouped .mt-deck-view-section__body--text {
      gap: 0.08rem;
    }

    .mt-deck-view-section__body--grid,
    .mt-deck-view-section__body--stacks {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 0.7rem;
    }

    .mt-deck-view-section__body--stacks {
      position: relative;
      overflow: visible;
      padding: 0.82rem 2.25rem 1rem 0.82rem;
    }

    .mt-deck-view-root--stacks.mt-deck-view-root--grouped .mt-deck-view-section__body--stacks {
      padding: 0.5rem 0 0.28rem 0;
      width: 196px;
      margin: 0 auto;
    }

    .mt-deck-view-root--stacks.mt-deck-view-root--grouped .mt-deck-view-section__body--stacks .mt-deck-art-card {
      left: 0;
    }

    .mt-deck-view-section__body--table {
      padding: 0;
      overflow-x: auto;
    }

    .mt-deck-view-root--grouped .mt-deck-view-section__body--table {
      min-width: min(42rem, 100%);
    }

    .mt-deck-row__meta {
      margin-top: 0.15rem;
      font-size: 0.72rem;
      line-height: 1.4;
      color: rgb(148 163 184);
    }

    .mt-deck-art-card {
      width: 100%;
    }

    .mt-deck-view-section__body--grid .mt-deck-art-card {
      width: clamp(210px, calc((100% - 2.8rem) / 5), 280px);
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card {
      position: absolute;
      left: 0.82rem;
      top: 0;
      width: 196px;
      height: auto;
      box-shadow: 0 18px 34px rgba(2, 6, 23, 0.42);
      will-change: top, transform;
      transition: top 190ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 160ms ease, box-shadow 160ms ease;
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card:hover {
      transform: none;
      box-shadow: 0 18px 34px rgba(2, 6, 23, 0.42);
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card--stack-active {
      outline: 1px solid rgba(56, 189, 248, 0.28);
      box-shadow: 0 26px 44px rgba(2, 6, 23, 0.56);
    }

    .mt-deck-art-card__media {
      position: relative;
      aspect-ratio: 5 / 7;
      overflow: hidden;
      border-radius: inherit;
      background: rgba(2, 6, 23, 0.95);
    }

    .mt-deck-art-card__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .mt-deck-art-card__body {
      padding: 0.44rem 0.5rem 0.52rem;
    }

    .mt-deck-view-section__body--stacks .mt-deck-art-card__body {
      display: none;
    }

    .mt-deck-art-card__meta {
      margin-top: 0.18rem;
      font-size: 0.64rem;
      line-height: 1.4;
      color: rgb(148 163 184);
    }

    .mt-action-menu--card > summary {
      min-width: 1.86rem;
      padding: 0.38rem 0.5rem;
      border-radius: 9999px;
      background: rgba(2, 6, 23, 0.88);
      box-shadow: 0 10px 20px rgba(2, 6, 23, 0.3);
    }

    .mt-action-menu--card > .mt-action-menu__panel {
      top: 50%;
      right: calc(100% + 0.45rem);
      transform: translateY(-50%);
    }

    .mt-action-menu--card.mt-action-menu--floating > .mt-action-menu__panel,
    .mt-action-menu__panel--floating {
      position: fixed;
      right: auto;
      top: auto;
      z-index: 170;
      max-height: min(24rem, calc(100vh - 1rem));
      overflow-y: auto;
      transform: none;
      overscroll-behavior: contain;
    }

    .mt-deck-table {
      width: 100%;
      border-collapse: collapse;
    }

    .mt-deck-table th,
    .mt-deck-table td {
