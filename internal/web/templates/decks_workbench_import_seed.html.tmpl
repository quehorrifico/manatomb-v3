{{ define "decks_workbench_import_seed" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-3xl mx-auto py-10 px-4 space-y-5">
    <section class="mt-panel p-5 sm:p-6 space-y-4">
      <div class="space-y-2">
        <p class="mt-kicker">Import</p>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-100">Loading deck.</h1>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="/" class="mt-btn mt-btn--secondary">Home</a>
        <a href="/decks/new/workbench" class="mt-btn mt-btn--primary">Open Deck</a>
      </div>
    </section>
  </main>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var payload = {{ $ctx.PayloadJSON }};
    var key = 'manatomb.draftDeck';
    var returnKey = key + '.playtestReturn';

    try {
      var cards = {};
      var maybeCards = {};
      if (payload && Array.isArray(payload.cards)) {
        payload.cards.forEach(function (item) {
          if (!item || !item.name || !item.qty) return;
          if (item.qty <= 0) return;
          cards[item.name] = (cards[item.name] || 0) + item.qty;
        });
      }
      if (payload && Array.isArray(payload.maybe_cards)) {
        payload.maybe_cards.forEach(function (item) {
          if (!item || !item.name || !item.qty) return;
          if (item.qty <= 0) return;
          maybeCards[item.name] = (maybeCards[item.name] || 0) + item.qty;
        });
      }

      var draft = {
        commanderName: payload.commander_name || '',
        format: payload.format || 'Sandbox',
        commanderCandidates: Array.isArray(payload.commander_candidates) ? payload.commander_candidates : [],
        name: payload.name || payload.commander_name || 'Imported Deck',
        description: payload.description || '',
        tags: '',
        cards: cards,
        maybeCards: maybeCards,
        cardMeta: {},
        updatedAt: new Date().toISOString()
      };

      var raw = JSON.stringify(draft);
      localStorage.setItem(key, raw);
      try {
        sessionStorage.setItem(returnKey, raw);
      } catch (e) {
        // ignore session storage failures
      }
    } catch (e) {
      // ignore storage failures
    }

    var nextURL = '/decks/new/workbench';
    if (payload && payload.format) {
      nextURL += '?format=' + encodeURIComponent(payload.format);
    }
    window.location.replace(nextURL);
  });
  </script>

  {{ template "layout_footer" . }}
{{ end }}
