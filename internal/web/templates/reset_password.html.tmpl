{{ define "reset_password" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <main class="max-w-4xl mx-auto py-10 px-4 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="space-y-2">
        <p class="mt-kicker">Account</p>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Choose New Password</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
        <a href="/login" class="mt-btn mt-btn--secondary mt-btn--sm">Log In</a>
      </div>
    </div>

    <section class="mt-panel max-w-md mx-auto p-5 sm:p-6">
      <form method="POST" action="/reset-password" class="space-y-5">
        <label class="block text-sm text-slate-200">
          <span class="mt-field-label">Reset Token</span>
          <input
            type="text"
            name="token"
            value="{{ $d.Token }}"
            required
            class="mt-control"
            autocomplete="off"
          >
        </label>

        <label class="block text-sm text-slate-200">
          <span class="mt-field-label">New Password</span>
          <input
            type="password"
            name="password"
            required
            class="mt-control"
          >
        </label>

        <label class="block text-sm text-slate-200">
          <span class="mt-field-label">Confirm Password</span>
          <input
            type="password"
            name="password_confirm"
            required
            class="mt-control"
          >
        </label>

        <div class="flex flex-col gap-3 pt-1">
          <button type="submit" class="mt-btn mt-btn--primary w-full">Reset Password</button>
        </div>
      </form>
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
