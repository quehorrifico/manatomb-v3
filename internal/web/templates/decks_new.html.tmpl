{{ define "decks_new" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <main class="max-w-3xl mx-auto py-10 px-4 space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">
          <span class="bg-gradient-to-br from-sky-400 via-cyan-300 to-slate-100 bg-clip-text text-transparent">
            New Deck
          </span>
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Step 2: You&apos;ve chosen a commander. Now name your deck and optionally add a description.
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="/decks"
           class="inline-flex items-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-sky-400 hover:text-sky-300 transition-colors">
          Back to my decks
        </a>
      </div>
    </div>

    <!-- Form card -->
    <section class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
      <form method="POST" action="/decks/new" class="space-y-4">

        <!-- Commander (read-only, highlighted) -->
        <div class="text-sm text-slate-200">
          <div class="rounded-lg border border-sky-700/60 bg-slate-950/90 px-3 py-3 flex items-start justify-between gap-3">
            <div class="flex items-start gap-3">
              <div class="h-10 w-10 shrink-0 rounded-md border border-sky-700/60 bg-gradient-to-br from-sky-500/30 via-cyan-400/20 to-transparent flex items-center justify-center">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-sky-200">
                  Cmdr
                </span>
              </div>
              <div>
                <p class="text-xs font-medium text-slate-400 mb-1">
                  Commander chosen
                </p>
                <p class="text-base font-semibold text-slate-50">
                  {{ $d.CommanderName }}
                </p>
                <p class="mt-1 text-[11px] text-slate-500">
                  This deck will be created as a Commander deck led by this card.
                </p>
              </div>
            </div>
            <div class="shrink-0">
              <a href="/commanders/search"
                 class="inline-flex items-center justify-center px-3 py-1.5 rounded-md 
                        border border-slate-700 bg-slate-900 text-xs text-slate-200
                        hover:border-sky-400 hover:text-sky-300 transition-colors">
                Change
              </a>
            </div>
          </div>
          <input type="hidden" name="commander_name" value="{{ $d.CommanderName }}">
        </div>

        <!-- Deck name -->
        <div class="text-sm text-slate-200">
          <label class="block">
            <span class="block text-xs font-medium text-slate-400 mb-1">Deck name</span>
            <input type="text"
                   name="name"
                   value="{{ $d.Name }}"
                   required
                   class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 
                          text-sm text-slate-100 placeholder:text-slate-500
                          focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
          </label>
        </div>

        <!-- Description -->
        <div class="text-sm text-slate-200">
          <label class="block">
            <span class="block text-xs font-medium text-slate-400 mb-1">Description (optional)</span>
            <textarea name="description"
                      rows="4"
                      class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2
                             text-sm text-slate-100 placeholder:text-slate-500
                             focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">{{ $d.Description }}</textarea>
          </label>
        </div>

        <!-- Actions -->
        <div class="flex justify-end gap-2">
          <a href="/decks"
             class="inline-flex items-center px-4 py-2 rounded-md border border-slate-700 
                    bg-slate-900 text-sm text-slate-200 hover:border-slate-500 hover:text-slate-100 transition-colors">
            Cancel
          </a>

          <button type="submit"
                  class="inline-flex items-center px-4 py-2 rounded-md 
                         bg-sky-500 text-slate-950 text-sm font-semibold 
                         hover:bg-sky-400 transition-colors focus:outline-none 
                         focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950">
            Create deck
          </button>
        </div>
      </form>
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}