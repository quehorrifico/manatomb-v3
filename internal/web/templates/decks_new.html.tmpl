{{ define "decks_new" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <main class="max-w-5xl mx-auto py-10 px-4 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="space-y-2">
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Deck Builder</h1>
      </div>
    </div>

    <section class="mt-panel p-5 sm:p-6">
      {{ if eq $d.Mode "sandbox" }}
        <div class="space-y-5">
          <div class="space-y-2">
            <p class="mt-kicker">Sandbox</p>
            <h2 class="text-xl font-semibold tracking-tight text-slate-100">Sandbox Deck</h2>
          </div>

          <div class="flex justify-end">
            <a href="/decks/new/sandbox" class="mt-btn mt-btn--primary">Start Deck</a>
          </div>
        </div>

      {{ else if eq $d.Mode "import" }}
        <div class="space-y-5">
          <div class="space-y-2">
            <p class="mt-kicker">Import</p>
            <h2 class="text-xl font-semibold tracking-tight text-slate-100">Import Deck</h2>
            <p class="mt-hint">Paste a decklist. Commander imports are detected automatically.</p>
          </div>

          <form method="POST" action="/decks/import" class="space-y-4">
            <label>
              <span class="mt-field-label">Decklist Text</span>
              <textarea name="decklist"
                        rows="12"
                        placeholder="Commander: Atraxa, Grand Unifier&#10;1 Sol Ring&#10;1 Arcane Signet&#10;1 Swords to Plowshares&#10;1 Cultivate&#10;1 Command Tower&#10;1 Forest&#10;1 Island"
                        class="mt-control">{{ $d.ImportText }}</textarea>
            </label>
            <p class="mt-hint">Example: start your commander on its own line with <code>Commander:</code>, then list the rest of the deck one card per line.</p>

            <div class="flex justify-end">
              <button type="submit" class="mt-btn mt-btn--primary">Import Deck</button>
            </div>
          </form>
        </div>
        {{ if gt (len $d.ImportUnmatched) 0 }}
          <div id="import-unmatched-modal" class="mt-modal">
            <div class="mt-modal-panel max-w-xl border-rose-500/60 bg-slate-900">
              <div class="flex items-center justify-between gap-3 mb-3">
                <h4 class="text-sm font-semibold text-rose-200">Unmatched cards</h4>
                <button type="button" data-dismiss-import-unmatched class="mt-btn mt-btn--secondary text-xs !px-3 !py-2">Dismiss</button>
              </div>
              <div class="max-h-56 overflow-y-auto rounded-md border border-rose-500/30 bg-slate-950/70 p-2">
                <ul class="space-y-1">
                  {{ range $name := $d.ImportUnmatched }}
                    <li class="text-sm text-rose-200">{{ $name }}</li>
                  {{ end }}
                </ul>
              </div>
            </div>
          </div>
          <script>
            (function () {
              const modal = document.getElementById("import-unmatched-modal");
              const dismiss = modal ? modal.querySelector("[data-dismiss-import-unmatched]") : null;
              if (!modal || !dismiss) return;
              dismiss.addEventListener("click", function () {
                modal.classList.add("hidden");
              });
            })();
          </script>
        {{ end }}

      {{ else }}
        <div class="space-y-4">
          <div class="grid gap-4 md:grid-cols-3">
            <a href="/decks/new/commander/" class="mt-action-card">
              <p class="text-lg font-semibold text-slate-100">Commander Deck</p>
              <p class="mt-hint mt-2">Build around a commander.</p>
            </a>

            <a href="/decks/new/sandbox" class="mt-action-card">
              <p class="text-lg font-semibold text-slate-100">Sandbox</p>
              <p class="mt-hint mt-2">Start from scratch.</p>
            </a>

            <a href="/decks/import" class="mt-action-card">
              <p class="text-lg font-semibold text-slate-100">Import</p>
              <p class="mt-hint mt-2">Paste a decklist.</p>
            </a>
          </div>
        </div>
      {{ end }}
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
