{{ define "home" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <section class="max-w-3xl mx-auto py-10 px-4 space-y-6">
    <div class="text-center space-y-3">
      <p class="mt-kicker">{{ if .CurrentUser }}Welcome Back{{ else }}Build MTG Decks{{ end }}</p>
      <h1 class="mt-title">
        {{ if .CurrentUser }}
          Build. Test. Win. Repeat.
        {{ else }}
          Across every format.
          <br/>
          Absolutely free.
        {{ end }}
      </h1>
    </div>

    <div class="space-y-5">
      <div class="space-y-3">
        <form action="/cards" method="GET">
          <input type="hidden" name="sort" value="relevance">
          <input type="hidden" name="sort_dir" value="desc">
          <label for="home-card-search" class="sr-only">Search for a Magic card</label>
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1" data-card-autocomplete-root>
              <input
                id="home-card-search"
                name="q"
                type="text"
                placeholder="Search for a card"
                class="mt-control flex-1"
                autocomplete="off"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-haspopup="listbox"
                data-card-autocomplete-input
              />
              <div
                data-card-autocomplete-menu
                class="hidden absolute left-0 right-0 top-[calc(100%+0.35rem)] z-20 overflow-hidden rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/70"
                role="listbox"></div>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:flex sm:shrink-0">
              <a href="/cards/random" class="mt-btn mt-btn--secondary">Random Card</a>
              <button type="submit" class="mt-btn mt-btn--primary">Search</button>
            </div>
          </div>
        </form>
      </div>

      {{ if not .CurrentUser }}
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/decks/new" class="mt-btn mt-btn--primary">Builder</a>
          <a href="/cards/search" class="mt-btn mt-btn--secondary">Advanced Search</a>
          <a href="/decks/public" class="mt-btn mt-btn--secondary">Browse Decks</a>
        </div>
      {{ end }}

      {{ if .CurrentUser }}
        {{ $recent := $ctx.RecentDecks }}
        <div class="grid gap-5 pt-1">
          <div class="space-y-3">
            <p class="mt-section-label text-center">Recent Decks</p>
            <div class="flex flex-wrap justify-center gap-2">
              {{ range $recent }}
                <a href="/decks/{{ .ID }}" class="mt-btn mt-btn--secondary mt-btn--xs">{{ .Name }}</a>
              {{ else }}
                <p class="text-xs text-slate-500">No decks.</p>
              {{ end }}
            </div>
          </div>

          <div class="mx-auto grid max-w-3xl gap-3 px-2 py-2">
            <div class="flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left">
              <div class="space-y-1">
                <p class="text-sm font-semibold text-slate-100">Guess the Card, Win the Card</p>
                <p class="text-xs text-slate-500">Solve the daily card in fewer than 10 guesses to add it to your profile.</p>
              </div>
              <a href="/games/guess-card" class="mt-btn mt-btn--primary mt-btn--sm shrink-0">Play</a>
            </div>
            <div class="flex flex-col items-center gap-3 border-t border-slate-800/80 pt-3 text-center sm:flex-row sm:justify-between sm:text-left">
              <div class="space-y-1">
                <p class="text-sm font-semibold text-slate-100">Tombscript</p>
                <p class="text-xs text-slate-500">Decode the daily card in fewer than 7 reveals to add it to your profile.</p>
              </div>
              <a href="/games/spellify" class="mt-btn mt-btn--secondary mt-btn--sm shrink-0">Play</a>
            </div>
            <div class="flex flex-col items-center gap-3 border-t border-slate-800/80 pt-3 text-center sm:flex-row sm:justify-between sm:text-left">
              <div class="space-y-1">
                <p class="text-sm font-semibold text-slate-100">Pack Crack</p>
                <p class="text-xs text-slate-500">Pick a set, open a simulated pack, and reveal each pull by hand.</p>
              </div>
              <a href="/games/pack-opening" class="mt-btn mt-btn--secondary mt-btn--sm shrink-0">Open</a>
            </div>
          </div>
        </div>
      {{ end }}
    </div>
  </section>

  {{ template "layout_footer" . }}
{{ end }}
