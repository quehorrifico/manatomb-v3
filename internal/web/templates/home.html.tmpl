{{ define "home" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <section class="max-w-3xl mx-auto py-10 px-4 space-y-6">
    <div class="text-center space-y-3">
      <p class="mt-kicker">{{ if .CurrentUser }}Welcome Back{{ else }}Build MTG Decks{{ end }}</p>
      <h1 class="mt-title">
        {{ if .CurrentUser }}
          Build. Test. Win. Repeat.
        {{ else }}
          Across every format.
          <br/>
          Absolutely free.
        {{ end }}
      </h1>
    </div>

    <div class="mt-panel p-5 sm:p-6 space-y-5">
      <div class="space-y-3">
        <form action="/cards" method="GET">
          <input type="hidden" name="sort" value="relevance">
          <input type="hidden" name="sort_dir" value="desc">
          <label for="home-card-search" class="sr-only">Search for a Magic card</label>
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1" data-card-autocomplete-root>
              <input
                id="home-card-search"
                name="q"
                type="text"
                placeholder="Search for a card"
                class="mt-control flex-1"
                autocomplete="off"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-haspopup="listbox"
                data-card-autocomplete-input
              />
              <div
                data-card-autocomplete-menu
                class="hidden absolute left-0 right-0 top-[calc(100%+0.35rem)] z-20 overflow-hidden rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/70"
                role="listbox"></div>
            </div>
            <button type="submit" class="mt-btn mt-btn--primary">Search</button>
          </div>
        </form>
      </div>

      {{ if not .CurrentUser }}
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/decks/new" class="mt-btn mt-btn--primary">Builder</a>
          <a href="/cards/search" class="mt-btn mt-btn--secondary">Advanced Search</a>
          <a href="/decks/public" class="mt-btn mt-btn--secondary">Browse Decks</a>
        </div>
      {{ end }}

      {{ if .CurrentUser }}
        {{ $recent := $ctx.RecentDecks }}
        <div class="pt-1 space-y-3">
          <p class="mt-section-label text-center">Recent Decks</p>
          <div class="flex flex-wrap justify-center gap-2">
            {{ range $recent }}
              <a href="/decks/{{ .ID }}" class="mt-btn mt-btn--secondary mt-btn--xs">{{ .Name }}</a>
            {{ else }}
              <p class="text-xs text-slate-500">No decks.</p>
            {{ end }}
          </div>
        </div>
      {{ end }}
    </div>
  </section>

  {{ template "layout_footer" . }}
{{ end }}
