{{ define "home" }}
  {{ template "layout_header" . }}
  <section class="mt-guest-home max-w-3xl mx-auto py-10 px-4 space-y-6">
    <div class="text-center space-y-3">
      <p class="mt-kicker">Build MTG Decks</p>
      <h1 class="mt-title">
        Across every format.
        <br/>
        Absolutely free.
      </h1>
    </div>

    <div class="space-y-5">
      <form action="/cards" method="GET">
        <input type="hidden" name="sort" value="relevance">
        <input type="hidden" name="sort_dir" value="desc">
        <label for="home-card-search" class="sr-only">Search for a Magic card</label>
        <div class="mt-home-search-shell">
          <div class="relative flex min-w-0 flex-1" data-card-autocomplete-root>
            <input
              id="home-card-search"
              name="q"
              type="search"
              placeholder="Search for a card"
              class="mt-control flex-1 mt-home-search-input"
              autocomplete="off"
              autofocus
              aria-autocomplete="list"
              aria-expanded="false"
              aria-haspopup="listbox"
              data-card-autocomplete-input
            />
            <div
              data-card-autocomplete-menu
              class="mt-autocomplete-menu hidden absolute left-0 right-0 top-[calc(100%+0.35rem)]"
              role="listbox"></div>
          </div>
          <a href="/cards/random" class="mt-home-search-random">Random Card</a>
        </div>
        <button type="submit" class="sr-only">Search cards</button>
      </form>

      <div class="grid grid-cols-2 gap-3 {{ if .CurrentUser }}md:grid-cols-5{{ else }}md:grid-cols-4{{ end }}">
        <a href="/decks/public" class="mt-btn mt-btn--secondary mt-btn--sm mt-home-action">Browse Public Decks</a>
        <a href="/cards/search" class="mt-btn mt-btn--secondary mt-btn--sm mt-home-action">Advanced Search</a>
        <a href="/decks/new" class="mt-btn mt-btn--secondary mt-btn--sm mt-home-action">Build a Deck</a>
        {{ if .CurrentUser }}
          <a href="/decks" class="mt-btn mt-btn--secondary mt-btn--sm mt-home-action">My Decks</a>
          <a href="{{ userProfilePath .CurrentUser.ID }}" class="mt-btn mt-btn--secondary mt-btn--sm mt-home-action">Profile</a>
        {{ else }}
          <a href="/login" class="mt-btn mt-btn--secondary mt-btn--sm mt-home-action">Sign In/Sign Up</a>
        {{ end }}
      </div>

      <section class="mt-home-games space-y-3 pt-2" aria-labelledby="home-games-title">
        <h2 id="home-games-title" class="mt-section-label text-center">Play a Game</h2>
        <div class="grid gap-3 sm:grid-cols-3">
          <a href="/games/guess-card" class="mt-action-card flex h-full flex-col text-left">
            <span class="mt-text-primary text-sm font-semibold">Guess the Card, Win the Card</span>
            <span class="mt-text-muted mt-1 text-xs leading-5">Ask yes-or-no clues, then name the hidden card.</span>
          </a>
          <a href="/games/spellify" class="mt-action-card flex h-full flex-col text-left">
            <span class="mt-text-primary text-sm font-semibold">Tombscript</span>
            <span class="mt-text-muted mt-1 text-xs leading-5">Reveal characters to decode a hidden Commander staple.</span>
          </a>
          <a href="/games/pack-opening" class="mt-action-card flex h-full flex-col text-left">
            <span class="mt-text-primary text-sm font-semibold">Pack Crack</span>
            <span class="mt-text-muted mt-1 text-xs leading-5">Choose a set and reveal a simulated booster pack.</span>
          </a>
        </div>
      </section>
    </div>
  </section>

  {{ template "layout_footer" . }}
{{ end }}
