{{ define "decks_sandbox_wip" }}
  {{ template "layout_header" . }}

  <main class="max-w-2xl mx-auto py-10 px-4 space-y-6">
    <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-6 shadow-md shadow-sky-500/10 space-y-4">
      <h2 class="text-2xl font-semibold tracking-tight">
        <span class="bg-gradient-to-br from-sky-400 via-cyan-300 to-slate-100 bg-clip-text text-transparent">
          Sandbox Builder (WIP)
        </span>
      </h2>

      <p class="text-sm text-slate-300">
        Sandbox mode is not ready yet. This page is a placeholder while the builder experience is under construction.
      </p>

      <div class="flex flex-wrap gap-2">
        <a href="/decks/new"
           class="inline-flex items-center px-4 py-2 rounded-md border border-slate-700 bg-slate-900 text-sm text-slate-200 hover:border-slate-500 hover:text-slate-100 transition-colors">
          Back to deck builder
        </a>
        <a href="/decks/new?mode=commander"
           class="inline-flex items-center px-4 py-2 rounded-md bg-sky-500 text-slate-950 text-sm font-semibold hover:bg-sky-400 transition-colors">
          Build a commander deck instead
        </a>
      </div>
    </div>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
