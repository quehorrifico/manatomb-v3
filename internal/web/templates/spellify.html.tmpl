{{ define "spellify" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <div class="mt-tombscript" data-tombscript-root>
    <header class="mt-tombscript__top">
      <div class="mt-tombscript__heading">
        {{ if $ctx.IsDaily }}<p class="mt-kicker">Daily Tombscript</p>{{ end }}
        <h1>Tombscript</h1>
      </div>
      <button type="button" class="mt-btn mt-btn--secondary mt-btn--sm mt-tombscript__help-button" data-tombscript-help-open>
        How to Play
      </button>
    </header>

    <p class="mt-tombscript__status" aria-label="Game status" aria-live="polite" aria-atomic="true">
      Remaining Guesses <strong data-tombscript-remaining>{{ $ctx.RemainingGuesses }}</strong>
    </p>

    <p class="sr-only" role="status" aria-live="polite" data-tombscript-announcement>{{ .Flash }}</p>

    <section class="mt-tombscript__game{{ if $ctx.Completed }} mt-tombscript__game--completed{{ end }}" aria-label="Tombscript puzzle">
      <figure class="mt-tombscript__card{{ if $ctx.Completed }} mt-tombscript__card--revealed{{ end }}">
        {{ if $ctx.Completed }}
          <a href="{{ $ctx.TargetDetailPath }}" class="mt-tombscript__card-link" aria-label="View {{ $ctx.TargetName }} card details">
            {{ if $ctx.TargetImageURI }}
              <img src="{{ $ctx.TargetImageURI }}" alt="{{ $ctx.TargetName }}">
            {{ else }}
              <span class="mt-tombscript__card-fallback">{{ $ctx.TargetName }}</span>
            {{ end }}
          </a>
        {{ else }}
          <div class="mt-tombscript__card-back" aria-hidden="true">
            <img src="https://cards.scryfall.io/back.png" alt="">
          </div>
          <figcaption class="sr-only">Mystery card</figcaption>
        {{ end }}
      </figure>

      <div class="mt-tombscript__puzzle">
        <section class="mt-tombscript__name" aria-labelledby="tombscript-name-label">
          <p id="tombscript-name-label" class="mt-tombscript__eyebrow">Card name</p>
          <div class="mt-tombscript__name-row">
            <p data-tombscript-name>{{ $ctx.MaskedName }}</p>
            {{ if $ctx.HasManaCost }}
              <div class="mt-tombscript__mana-cost" aria-label="Mana cost" data-tombscript-mana-cost>{{ $ctx.MaskedManaCost }}</div>
            {{ end }}
          </div>
        </section>

        <div class="mt-tombscript__text-clues">
          <section aria-labelledby="tombscript-rules-label">
            <h2 id="tombscript-rules-label">Rules text</h2>
            <p data-tombscript-rules>{{ if $ctx.HasRulesText }}{{ $ctx.MaskedRulesText }}{{ else }}No rules text.{{ end }}</p>
          </section>
          <section aria-labelledby="tombscript-flavor-label">
            <h2 id="tombscript-flavor-label">Flavor text</h2>
            <p class="mt-tombscript__flavor" data-tombscript-flavor>{{ if $ctx.HasFlavorText }}{{ $ctx.MaskedFlavorText }}{{ else }}No flavor text.{{ end }}</p>
          </section>
        </div>

        {{ if or $ctx.CanRevealChar $ctx.CanGuess }}
          <div class="mt-tombscript__actions">
            {{ if $ctx.CanRevealChar }}
              <section class="mt-tombscript__reveal" aria-label="Letter, digit, and symbol keyboard">
                <p id="tombscript-keyboard-help" class="sr-only">Choose a letter, digit, or Magic symbol. Used keys show whether they appeared on the card.</p>
                <form method="POST" action="/games/spellify" data-tombscript-character-form aria-describedby="tombscript-keyboard-help">
                  <input type="hidden" name="action" value="char">
                  <input type="hidden" name="game_id" value="{{ $ctx.GameID }}" data-tombscript-game-id>
                  <div class="mt-tombscript__keyboard" data-tombscript-keyboard>
                    <div class="mt-tombscript__key-row">
                      <button type="submit" name="char" value="q" data-tombscript-key="q">Q</button>
                      <button type="submit" name="char" value="w" data-tombscript-key="w">W</button>
                      <button type="submit" name="char" value="e" data-tombscript-key="e">E</button>
                      <button type="submit" name="char" value="r" data-tombscript-key="r">R</button>
                      <button type="submit" name="char" value="t" data-tombscript-key="t">T</button>
                      <button type="submit" name="char" value="y" data-tombscript-key="y">Y</button>
                      <button type="submit" name="char" value="u" data-tombscript-key="u">U</button>
                      <button type="submit" name="char" value="i" data-tombscript-key="i">I</button>
                      <button type="submit" name="char" value="o" data-tombscript-key="o">O</button>
                      <button type="submit" name="char" value="p" data-tombscript-key="p">P</button>
                    </div>
                    <div class="mt-tombscript__key-row">
                      <button type="submit" name="char" value="a" data-tombscript-key="a">A</button>
                      <button type="submit" name="char" value="s" data-tombscript-key="s">S</button>
                      <button type="submit" name="char" value="d" data-tombscript-key="d">D</button>
                      <button type="submit" name="char" value="f" data-tombscript-key="f">F</button>
                      <button type="submit" name="char" value="g" data-tombscript-key="g">G</button>
                      <button type="submit" name="char" value="h" data-tombscript-key="h">H</button>
                      <button type="submit" name="char" value="j" data-tombscript-key="j">J</button>
                      <button type="submit" name="char" value="k" data-tombscript-key="k">K</button>
                      <button type="submit" name="char" value="l" data-tombscript-key="l">L</button>
                    </div>
                    <div class="mt-tombscript__key-row">
                      <button type="submit" name="char" value="z" data-tombscript-key="z">Z</button>
                      <button type="submit" name="char" value="x" data-tombscript-key="x">X</button>
                      <button type="submit" name="char" value="c" data-tombscript-key="c">C</button>
                      <button type="submit" name="char" value="v" data-tombscript-key="v">V</button>
                      <button type="submit" name="char" value="b" data-tombscript-key="b">B</button>
                      <button type="submit" name="char" value="n" data-tombscript-key="n">N</button>
                      <button type="submit" name="char" value="m" data-tombscript-key="m">M</button>
                    </div>
                    <div class="mt-tombscript__key-row" role="group" aria-label="Digits">
                      <button type="submit" name="char" value="0" data-tombscript-key="0">0</button>
                      <button type="submit" name="char" value="1" data-tombscript-key="1">1</button>
                      <button type="submit" name="char" value="2" data-tombscript-key="2">2</button>
                      <button type="submit" name="char" value="3" data-tombscript-key="3">3</button>
                      <button type="submit" name="char" value="4" data-tombscript-key="4">4</button>
                      <button type="submit" name="char" value="5" data-tombscript-key="5">5</button>
                      <button type="submit" name="char" value="6" data-tombscript-key="6">6</button>
                      <button type="submit" name="char" value="7" data-tombscript-key="7">7</button>
                      <button type="submit" name="char" value="8" data-tombscript-key="8">8</button>
                      <button type="submit" name="char" value="9" data-tombscript-key="9">9</button>
                    </div>
                    <div class="mt-tombscript__symbol-row" role="group" aria-label="Magic symbols">
                      {{ range $ctx.SymbolKeys }}
                        <button
                          type="submit"
                          name="char"
                          value="{{ .Value }}"
                          aria-label="{{ .Label }}"
                          data-tombscript-key="{{ .Value }}"
                          data-tombscript-symbol-key
                          {{ if .Guessed }}disabled{{ end }}>
                          <img src="https://svgs.scryfall.io/card-symbols/{{ .AssetName }}.svg" alt="" aria-hidden="true">
                          <span class="sr-only">{{ .Label }}</span>
                        </button>
                      {{ end }}
                    </div>
                  </div>
                </form>
              </section>
            {{ end }}

            <div class="mt-tombscript__decision">
              {{ if $ctx.CanGuess }}
                <button type="button" class="mt-btn mt-btn--primary" data-tombscript-guess-open>
                  Make a Guess
                </button>
              {{ end }}
              <form method="POST" action="/games/spellify" class="mt-tombscript__give-up" data-tombscript-give-up-form>
                <input type="hidden" name="action" value="give_up">
                <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
                <button type="submit">Reveal card</button>
              </form>
            </div>
          </div>
        {{ else }}
          <section class="mt-tombscript__result" aria-labelledby="tombscript-result-title">
            <p class="mt-tombscript__eyebrow">{{ if $ctx.Won }}Solved{{ else }}Revealed{{ end }}</p>
            <h2 id="tombscript-result-title">{{ $ctx.TargetName }}</h2>
            {{ if $ctx.TargetDescription }}<p>{{ $ctx.TargetDescription }}</p>{{ end }}
            <div class="mt-tombscript__result-actions">
              <form method="POST" action="/games/spellify">
                <input type="hidden" name="action" value="new">
                <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
                <button type="submit" class="mt-btn mt-btn--primary">Play Again</button>
              </form>
              <a href="{{ $ctx.TargetDetailPath }}" class="mt-btn mt-btn--secondary">View Card</a>
            </div>
          </section>
        {{ end }}
      </div>
    </section>

    <script type="application/json" data-tombscript-state>{{ toJSON $ctx }}</script>
  </div>

  {{ if $ctx.CanGuess }}
    <div
      id="tombscript-guess-modal"
      class="mt-modal mt-tombscript-guess-modal hidden"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="tombscript-guess-modal-title"
      aria-describedby="tombscript-guess-modal-description"
      data-tombscript-guess-modal>
      <div class="mt-modal-panel mt-tombscript-guess-modal__panel" tabindex="-1" data-tombscript-guess-panel>
        <button type="button" class="mt-tombscript-modal-close" aria-label="Close card guess" data-tombscript-guess-close>
          <span aria-hidden="true">×</span>
        </button>
        <h2 id="tombscript-guess-modal-title">Make a Guess</h2>
        <p id="tombscript-guess-modal-description" class="mt-tombscript-guess-modal__remaining">
          <span data-tombscript-modal-guesses-left>{{ $ctx.RemainingCardGuesses }}</span>
          card <span data-tombscript-modal-guess-unit>{{ if eq $ctx.RemainingCardGuesses 1 }}guess{{ else }}guesses{{ end }}</span> remaining
        </p>
        <div class="mt-tombscript-guess-modal__slots" aria-label="Revealed card name" data-tombscript-guess-slots></div>
        <div class="mt-tombscript-guess-modal__history{{ if not $ctx.PreviousWrongGuesses }} hidden{{ end }}" data-tombscript-guess-history>
          <span>Previous guesses</span>
          <ul aria-label="Previous incorrect card guesses" data-tombscript-guess-history-list>
            {{ range $ctx.PreviousWrongGuesses }}<li>{{ . }}</li>{{ end }}
          </ul>
        </div>
        <form method="POST" action="/games/spellify" data-tombscript-guess-form>
          <input type="hidden" name="action" value="guess">
          <input type="hidden" name="game_id" value="{{ $ctx.GameID }}">
          <label for="tombscript-final" class="sr-only">Exact card name</label>
          <input
            id="tombscript-final"
            name="guess"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="Type the full card name"
            class="mt-control"
            required
            data-tombscript-guess-input>
          <p class="mt-tombscript-guess-modal__message hidden" role="status" aria-live="polite" data-tombscript-guess-message></p>
          <div class="mt-tombscript-guess-modal__actions">
            <button type="submit" class="mt-btn mt-btn--primary" data-tombscript-guess-submit>Submit Guess</button>
            <button type="button" class="mt-btn mt-btn--secondary" data-tombscript-guess-cancel>Keep Revealing</button>
          </div>
        </form>
      </div>
    </div>
  {{ end }}

  <div
    id="tombscript-help-modal"
    class="mt-modal mt-tombscript-help hidden"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="tombscript-help-title"
    aria-describedby="tombscript-help-description"
    data-auto-open="true"
    data-tombscript-help-modal>
    <div class="mt-modal-panel mt-tombscript-help__panel" tabindex="-1" data-tombscript-help-panel>
      <button type="button" class="mt-tombscript-modal-close" aria-label="Close How to Play" data-tombscript-help-close>
        <span aria-hidden="true">×</span>
      </button>
      <h2 id="tombscript-help-title">How to Play</h2>
      <div id="tombscript-help-description" class="mt-tombscript-help__content">
        <ol>
          <li>Choose a letter, digit, or symbol to reveal every matching spot.</li>
          <li>You have {{ $ctx.MaxGuesses }} reveals. Wrong choices still count.</li>
          <li>You have {{ $ctx.MaxCardGuesses }} chances to name the exact card.</li>
        </ol>
        <div class="mt-tombscript-help__pool">
          <h3>Card pool</h3>
          <p>Mystery cards come from Scryfall’s EDHREC ranks 1–250 and have a supported paper printing, card art, and legality in at least one tracked format. Daily uses one shared card; practice chooses randomly from the same pool.</p>
        </div>
        <p class="mt-tombscript-help__note">
          {{ if not $ctx.IsDaily }}This is a just-for-fun round. Only your first Tombscript game each day can win a card.{{ else if not $ctx.HasAccount }}This is your first game today, but guest rounds cannot win cards. Sign in before starting your first game tomorrow to be eligible.{{ else }}This is your first game today and the only prize-eligible Tombscript round. Solve it to win the card; every later round today is just for fun.{{ end }}
        </p>
      </div>
    </div>
  </div>

  {{ template "layout_footer" . }}
{{ end }}
