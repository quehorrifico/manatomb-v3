{{ define "decks_new_commander" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  {{ $choices := $ctx.Recommended }}
  {{ if $ctx.Query }}{{ $choices = $ctx.Results }}{{ end }}

  <div class="mt-commander-picker">
    <header class="mt-commander-picker__heading">
      <h1>Choose your commander</h1>
      <p>Search by name or choose from the most popular eligible commanders.</p>
    </header>

    <form method="GET" action="/decks/new/commander/" class="mt-commander-search" role="search">
      <label for="commander-search" class="sr-only">Search commanders</label>
      <div class="mt-commander-search__field" data-card-autocomplete-root>
        <input
          id="commander-search"
          type="search"
          name="q"
          value="{{ $ctx.Query }}"
          placeholder="Search commanders by name"
          class="mt-control"
          autocomplete="off"
          enterkeyhint="search"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="commander-search-menu"
          aria-expanded="false"
          aria-haspopup="listbox"
          data-card-autocomplete-input
          data-card-autocomplete-commander-only="true"
        >
        <div
          id="commander-search-menu"
          data-card-autocomplete-menu
          class="mt-autocomplete-menu mt-commander-search__menu hidden"
          role="listbox"></div>
      </div>
      <button type="submit" class="sr-only">Search commanders</button>
    </form>

    <section class="mt-commander-picker__results" aria-labelledby="commander-results-title">
      <div class="mt-commander-picker__results-heading">
        <div>
          <h2 id="commander-results-title">{{ if $ctx.Query }}Search results{{ else }}Popular commanders{{ end }}</h2>
          {{ if $ctx.Query }}
            <p>{{ len $ctx.Results }} matching commanders</p>
          {{ end }}
        </div>
        {{ if $ctx.Query }}
          <a href="/decks/new/commander/">Clear search</a>
        {{ end }}
      </div>

      {{ if $choices }}
        <ul class="mt-commander-grid"{{ if not $ctx.Query }} data-popular-commanders data-commander-seed="{{ $ctx.RecommendationSeed }}" data-commander-cursor="{{ $ctx.RecommendationCursor }}"{{ end }}>
          {{ range $choices }}
            <li data-commander-oracle-id="{{ .OracleID }}">
              <form method="POST" action="/decks/new/commander" class="mt-commander-choice">
                <input type="hidden" name="commander_name" value="{{ .Name }}">
                <input type="hidden" name="commander_print_id" value="{{ .ScryfallID }}">
                <button type="submit" aria-label="Build a deck with {{ .Name }}">
                  <span class="mt-commander-choice__media">
                    {{ if .ImageURI }}
                      <img src="{{ .ImageURI }}"
                           alt=""
                           loading="lazy"
                           decoding="async">
                    {{ else }}
                      <span class="mt-commander-choice__fallback">Image unavailable</span>
                    {{ end }}
                  </span>
                  <span class="mt-commander-choice__meta">
                    <strong>{{ .Name }}</strong>
                  </span>
                </button>
              </form>
            </li>
          {{ end }}
        </ul>

        {{ if not $ctx.Query }}
          <div class="mt-commander-picker__more">
            {{ if $ctx.HasMoreRecommendations }}
              <button type="button" class="mt-btn mt-btn--secondary" data-load-more-commanders>
                Load more
              </button>
            {{ end }}
            <p class="mt-commander-picker__more-status" data-load-more-commanders-status role="status"></p>
          </div>
        {{ end }}
      {{ else }}
        <div class="mt-commander-picker__empty">
          {{ if $ctx.Query }}
            <p>No eligible commanders matched “{{ $ctx.Query }}”. Try a shorter or differently spelled name.</p>
            <a href="/decks/new/commander/">Browse popular commanders</a>
          {{ else }}
            <p>Popular commanders are unavailable right now. You can still search by name.</p>
          {{ end }}
        </div>
      {{ end }}
    </section>
  </div>

  <script>
    (function () {
      var grid = document.querySelector("[data-popular-commanders]");
      var loadMoreButton = document.querySelector("[data-load-more-commanders]");
      var status = document.querySelector("[data-load-more-commanders-status]");
      if (!grid || !loadMoreButton) return;

      var seed = String(grid.getAttribute("data-commander-seed") || "").trim();
      var cursor = String(grid.getAttribute("data-commander-cursor") || "").trim();
      var loading = false;
      var knownOracleIDs = new Set();

      grid.querySelectorAll("[data-commander-oracle-id]").forEach(function (item) {
        var oracleID = String(item.getAttribute("data-commander-oracle-id") || "").trim();
        if (oracleID) knownOracleIDs.add(oracleID);
      });

      function hiddenField(name, value) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = name;
        input.value = value;
        return input;
      }

      function commanderChoice(item) {
        var listItem = document.createElement("li");
        listItem.setAttribute("data-commander-oracle-id", item.oracle_id);

        var form = document.createElement("form");
        form.method = "POST";
        form.action = "/decks/new/commander";
        form.className = "mt-commander-choice";
        form.appendChild(hiddenField("commander_name", item.name));
        form.appendChild(hiddenField("commander_print_id", item.scryfall_id));

        var button = document.createElement("button");
        button.type = "submit";
        button.setAttribute("aria-label", "Build a deck with " + item.name);

        var media = document.createElement("span");
        media.className = "mt-commander-choice__media";
        if (item.image_uri) {
          var image = document.createElement("img");
          image.src = item.image_uri;
          image.alt = "";
          image.loading = "lazy";
          image.decoding = "async";
          media.appendChild(image);
        } else {
          var fallback = document.createElement("span");
          fallback.className = "mt-commander-choice__fallback";
          fallback.textContent = "Image unavailable";
          media.appendChild(fallback);
        }

        var meta = document.createElement("span");
        meta.className = "mt-commander-choice__meta";
        var name = document.createElement("strong");
        name.textContent = item.name;
        meta.appendChild(name);

        button.appendChild(media);
        button.appendChild(meta);
        form.appendChild(button);
        listItem.appendChild(form);
        return listItem;
      }

      loadMoreButton.addEventListener("click", function () {
        if (loading || !seed || !cursor) return;

        loading = true;
        loadMoreButton.disabled = true;
        loadMoreButton.textContent = "Loading…";
        if (status) status.textContent = "";

        var url = new URL("/decks/new/commander/more", window.location.origin);
        url.searchParams.set("seed", seed);
        url.searchParams.set("after", cursor);

        fetch(url.toString(), {
          method: "GET",
          headers: { "Accept": "application/json" }
        }).then(function (response) {
          if (!response.ok) throw new Error("request failed");
          return response.json();
        }).then(function (payload) {
          var fragment = document.createDocumentFragment();
          var items = Array.isArray(payload.items) ? payload.items : [];
          items.forEach(function (item) {
            var oracleID = String(item && item.oracle_id ? item.oracle_id : "").trim();
            var cardName = String(item && item.name ? item.name : "").trim();
            var printID = String(item && item.scryfall_id ? item.scryfall_id : "").trim();
            if (!oracleID || !cardName || !printID || knownOracleIDs.has(oracleID)) return;
            knownOracleIDs.add(oracleID);
            item.oracle_id = oracleID;
            item.name = cardName;
            item.scryfall_id = printID;
            fragment.appendChild(commanderChoice(item));
          });
          grid.appendChild(fragment);

          cursor = String(payload.next_cursor || cursor).trim();
          grid.setAttribute("data-commander-cursor", cursor);
          loadMoreButton.hidden = payload.has_more !== true;
        }).catch(function () {
          if (status) status.textContent = "Could not load more commanders. Please try again.";
        }).finally(function () {
          loading = false;
          loadMoreButton.disabled = false;
          loadMoreButton.textContent = "Load more";
        });
      });
    })();
  </script>

  {{ template "layout_footer" . }}
{{ end }}
