    function typeSortRank(typeLine) {
      var groups = ['Lands', 'Creatures', 'Artifacts', 'Enchantments', 'Planeswalkers', 'Battles', 'Instants', 'Sorceries', 'Other'];
      var group = primaryTypeGroup(typeLine);
      var index = groups.indexOf(group);
      return index >= 0 ? index : groups.length;
    }

    function compareDeckRows(a, b) {
      var left = a || {};
      var right = b || {};
      var mode = normalizeDeckSortMode(deckSortMode);
      var leftName = normalizeName(left.cardName || '');
      var rightName = normalizeName(right.cardName || '');
      var leftMeta = left.cardMeta || {};
      var rightMeta = right.cardMeta || {};

      if (mode === 'mv') {
        var leftMV = Number(leftMeta.cmc != null ? leftMeta.cmc : 0);
        var rightMV = Number(rightMeta.cmc != null ? rightMeta.cmc : 0);
        if (!Number.isFinite(leftMV)) leftMV = 0;
        if (!Number.isFinite(rightMV)) rightMV = 0;
        if (leftMV !== rightMV) return leftMV - rightMV;
      } else if (mode === 'type') {
        var leftTypeRank = typeSortRank(leftMeta.typeLine || '');
        var rightTypeRank = typeSortRank(rightMeta.typeLine || '');
        if (leftTypeRank !== rightTypeRank) return leftTypeRank - rightTypeRank;
      } else if (mode === 'price') {
        var leftPrice = priceValue(leftMeta);
        var rightPrice = priceValue(rightMeta);
        if (leftPrice === null && rightPrice !== null) return 1;
        if (leftPrice !== null && rightPrice === null) return -1;
        if (leftPrice !== null && rightPrice !== null && leftPrice !== rightPrice) return leftPrice - rightPrice;
      }

      return leftName.localeCompare(rightName);
    }

    function groupedDeckSections(rows) {
      var mode = normalizeDeckGroupMode(deckGroupMode);
      if (mode === 'none') {
        var singleRows = rows.slice();
        singleRows.sort(compareDeckRows);
        return [{ name: '', rows: singleRows }];
      }

      var order;
      if (mode === 'type') {
        order = ['Lands', 'Creatures', 'Artifacts', 'Enchantments', 'Planeswalkers', 'Battles', 'Instants', 'Sorceries', 'Other'];
      } else if (mode === 'mv') {
        order = ['Lands', '0', '1', '2', '3', '4', '5', '6', '7+', 'Unknown'];
      } else if (mode === 'alphabet') {
        order = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
        order.push('#');
      } else {
        order = ['Free', 'Under $1', '$1-$4.99', '$5-$9.99', '$10+', 'Unknown'];
      }
      var buckets = {};

      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var groupName;
        if (mode === 'type') {
          groupName = primaryTypeGroup(row.cardMeta && row.cardMeta.typeLine ? row.cardMeta.typeLine : '');
        } else if (mode === 'mv') {
          groupName = manaValueGroup(row.cardMeta || {});
        } else if (mode === 'alphabet') {
          groupName = alphabetGroup(row.cardName || '');
        } else {
          groupName = priceGroup(row.cardMeta || {});
        }
        if (!buckets[groupName]) buckets[groupName] = [];
        buckets[groupName].push(row);
      }

      var sections = [];
      for (var j = 0; j < order.length; j++) {
        var name = order[j];
        if (!buckets[name] || buckets[name].length === 0) continue;
        buckets[name].sort(compareDeckRows);
        sections.push({ name: name, rows: buckets[name] });
        delete buckets[name];
      }

      var leftovers = Object.keys(buckets).sort(function (a, b) { return a.localeCompare(b); });
      for (var k = 0; k < leftovers.length; k++) {
        buckets[leftovers[k]].sort(compareDeckRows);
        sections.push({ name: leftovers[k], rows: buckets[leftovers[k]] });
      }
      return sections;
    }

    function sectionCardTotal(section) {
      if (!section || !Array.isArray(section.rows)) return 0;
      var total = 0;
      for (var i = 0; i < section.rows.length; i++) {
        total += Number(section.rows[i].qty || 0);
      }
      return total;
    }

