    function loadDraft() {
      try {
        var raw = '';
        var consumedPlaytestReturn = false;
        try {
          raw = sessionStorage.getItem(returnKey) || '';
          if (raw) {
            consumedPlaytestReturn = true;
            sessionStorage.removeItem(returnKey);
            localStorage.setItem(key, raw);
          }
        } catch (e) {
          raw = '';
          consumedPlaytestReturn = false;
        }
        if (!raw) {
          raw = localStorage.getItem(key);
        }
        if (!raw) return null;
        var d = JSON.parse(raw);
        if (!d || typeof d !== 'object') return null;
        if (!d.cards || typeof d.cards !== 'object') d.cards = {};
        if (!d.sideboardCards || typeof d.sideboardCards !== 'object') d.sideboardCards = {};
        if (!d.maybeCards || typeof d.maybeCards !== 'object') d.maybeCards = {};
        if (!d.cardMeta || typeof d.cardMeta !== 'object') d.cardMeta = {};
        if (typeof d.tags !== 'string') d.tags = '';
        d.name = guestDeckName;

        var urlCommander = normalizeName(commanderName);
        var draftCommander = normalizeName(d.commanderName || '');
        if (!d.format) {
          d.format = draftCommander ? 'Commander' : (deckFormat === 'Commander' ? 'Commander' : 'Sandbox');
        }
        if (String(d.format || '') !== 'Commander') {
          d.format = 'Sandbox';
        }
        if (shouldResetDraft && deckFormat === 'Commander') {
          d.format = 'Commander';
        }
        if (urlCommander && draftCommander && urlCommander.toLowerCase() !== draftCommander.toLowerCase()) {
          if (consumedPlaytestReturn || shouldAutoSave || isSignedIn) {
            // During auth-save flows, prefer the draft we already have over URL commander.
            commanderName = draftCommander;
          } else {
            return null;
          }
        } else if (!draftCommander && urlCommander) {
          d.commanderName = urlCommander;
          draftCommander = urlCommander;
        } else if (draftCommander && !urlCommander) {
          commanderName = draftCommander;
        }
        if (shouldResetDraft && deckFormat === 'Commander' && urlCommander) {
          d.commanderName = urlCommander;
          commanderName = urlCommander;
        }

        if (!Array.isArray(d.commanderCandidates)) d.commanderCandidates = [];
        return d;
      } catch (e) {
        return null;
      }
    }

