        var draftCommanderPrintID = normalizeName(d.commanderPrintID || '');
        if (!d.format) {
          d.format = draftCommander ? 'Commander' : normalizeGuestFormat(deckFormat);
        }
        d.format = normalizeGuestFormat(d.format);
        if (shouldResetDraft) {
          d.format = normalizeGuestFormat(deckFormat);
        }
        if (urlCommander && draftCommander && urlCommander.toLowerCase() !== draftCommander.toLowerCase()) {
          if (consumedPlaytestReturn || shouldAutoSave || isSignedIn) {
            // During auth-save flows, prefer the draft we already have over URL commander.
            commanderName = draftCommander;
            commanderPrintID = draftCommanderPrintID;
          } else {
            return null;
          }
        } else if (!draftCommander && urlCommander) {
          d.commanderName = urlCommander;
          d.commanderPrintID = urlCommanderPrintID;
          draftCommander = urlCommander;
          draftCommanderPrintID = urlCommanderPrintID;
        } else if (draftCommander && !urlCommander) {
          commanderName = draftCommander;
          commanderPrintID = draftCommanderPrintID;
        } else if (draftCommander && urlCommander && draftCommander.toLowerCase() === urlCommander.toLowerCase()) {
          if (draftCommanderPrintID) {
            commanderPrintID = draftCommanderPrintID;
          } else if (urlCommanderPrintID) {
            d.commanderPrintID = urlCommanderPrintID;
            draftCommanderPrintID = urlCommanderPrintID;
          }
        }
        if (shouldResetDraft && formatUsesCommander(deckFormat) && urlCommander) {
          d.commanderName = urlCommander;
          d.commanderPrintID = urlCommanderPrintID;
          commanderName = urlCommander;
          commanderPrintID = urlCommanderPrintID;
        }
        if (!formatUsesCommander(d.format) || !normalizeName(d.commanderName || '')) {
          d.commanderPrintID = '';
          commanderPrintID = '';
        } else if (!normalizeName(d.commanderPrintID || '')) {
          var commanderMeta = draftMetaForCard(d, d.commanderName);
