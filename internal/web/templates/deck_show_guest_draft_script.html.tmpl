        if (!d.cardMeta || typeof d.cardMeta !== 'object') d.cardMeta = {};
        if (typeof d.tags !== 'string') d.tags = '';
        d.name = guestDeckName;

        var urlCommander = normalizeName(commanderName);
        var draftCommander = normalizeName(d.commanderName || '');
        if (!d.format) {
          d.format = draftCommander ? 'Commander' : (deckFormat === 'Commander' ? 'Commander' : 'Sandbox');
        }
        if (String(d.format || '') !== 'Commander') {
