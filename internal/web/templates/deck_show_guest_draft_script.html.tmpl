    function appendCommanderCardActionItems(items, cardName, cardMeta, currentBoard, onSetCommander) {
      if (!allowsCommanderCardAction || normalizeDeckBoardMode(currentBoard) !== 'main') return;
      var currentCommander = normalizeName(commanderName);
      var canBeCommander = !!(cardMeta && cardMeta.isCommanderCandidate);
      if (currentCommander && currentCommander.toLowerCase() === normalizeName(cardName).toLowerCase()) {
        items.push({ label: 'Current Commander', disabled: true });
      } else if (canBeCommander) {
        items.push({
          label: 'Set as Commander',
