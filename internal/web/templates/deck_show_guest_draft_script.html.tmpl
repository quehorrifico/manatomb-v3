    function createDeckTable(sections, createActionMenu, adjustQuantity, moveBoard, setQuantity) {
      var wrap = document.createElement('div');
      wrap.className = 'mt-deck-view-section__body mt-deck-view-section__body--table';
      var groupMode = normalizeDeckGroupMode(deckGroupMode);
      var grouped = groupMode !== 'none';
      var columns = [
        { key: 'qty', label: 'Qty' },
        { key: 'card', label: 'Card' },
        { key: 'board', label: 'Board' },
        { key: 'mana', label: 'Cost' }
      ];
      if (groupMode !== 'mv') columns.push({ key: 'mv', label: 'MV' });
      if (groupMode !== 'type') columns.push({ key: 'type', label: 'Type' });
      if (groupMode !== 'price') columns.push({ key: 'price', label: 'Price' });

      var table = document.createElement('table');
      table.className = 'mt-deck-table';

      var thead = document.createElement('thead');
      var headRow = document.createElement('tr');
      columns.forEach(function (column) {
        var th = document.createElement('th');
        th.textContent = column.label;
        headRow.appendChild(th);
      });
      thead.appendChild(headRow);
      table.appendChild(thead);

      var tbody = document.createElement('tbody');
      function submitTableQuantity(row, cardMeta, input) {
        if (!input) return;
        var nextQty = Math.floor(Number(input.value || 0));
        if (!Number.isFinite(nextQty) || nextQty < 0) {
          input.value = String(row.qty);
          return;
        }
        if (nextQty === Number(row.qty || 0)) return;
        if (typeof setQuantity === 'function') {
          setQuantity(row.cardName, cardMeta, nextQty);
        } else if (typeof adjustQuantity === 'function') {
          adjustQuantity(row.cardName, cardMeta, nextQty - Number(row.qty || 0));
        }
      }

      function appendCell(tr, row, cardMeta, column) {
        var td = document.createElement('td');
        if (column.key === 'qty') {
          td.className = 'mt-deck-table__qty';
          var qtyInput = document.createElement('input');
          qtyInput.type = 'text';
          qtyInput.inputMode = 'numeric';
          qtyInput.pattern = '[0-9]*';
          qtyInput.className = 'mt-deck-table__qty-input';
          qtyInput.value = String(row.qty);
          qtyInput.setAttribute('aria-label', 'Quantity for ' + row.cardName);
          qtyInput.addEventListener('change', function () {
            submitTableQuantity(row, cardMeta, qtyInput);
          });
          qtyInput.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
              event.preventDefault();
              submitTableQuantity(row, cardMeta, qtyInput);
              qtyInput.blur();
            }
          });
          td.appendChild(qtyInput);
        } else if (column.key === 'card') {
          var name = (function (localName, localMeta) {
            return createCardViewButton(
              localName,
              'mt-deck-table__name text-left transition-colors hover:text-sky-200 focus:outline-none focus:text-sky-200',
              function () {
                openWorkbenchCardView(localName, localMeta);
              }
            );
          })(row.cardName, cardMeta);
          bindDeckHoverPreview(name, row.cardName, cardMeta);
          td.appendChild(name);
        } else if (column.key === 'board') {
          td.className = 'mt-deck-table__board';
          var boardSelect = document.createElement('select');
          boardSelect.className = 'mt-deck-table__board-select';
          boardSelect.setAttribute('aria-label', 'Board for ' + row.cardName);
          ['main', 'side', 'maybe'].forEach(function (board) {
            var option = document.createElement('option');
            option.value = board;
            option.textContent = deckBoardLabel(board);
            boardSelect.appendChild(option);
          });
          boardSelect.value = normalizeDeckBoardMode(deckBoardMode);
          boardSelect.addEventListener('change', function () {
            var targetBoard = normalizeDeckBoardMode(boardSelect.value);
            if (targetBoard === normalizeDeckBoardMode(deckBoardMode)) return;
            if (typeof moveBoard === 'function') {
              moveBoard(row.cardName, cardMeta, targetBoard, Number(row.qty || 0));
            }
          });
          td.appendChild(boardSelect);
        } else if (column.key === 'mana') {
          var manaCost = normalizeName(cardMeta.manaCost || '');
          if (manaCost) {
            var manaWrap = document.createElement('span');
            manaWrap.className = 'inline-flex flex-wrap items-center gap-1 align-middle';
            manaWrap.setAttribute('data-mana-cost', manaCost);
            td.appendChild(manaWrap);
            renderManaCostPips(manaWrap);
          } else {
            td.textContent = '—';
          }
        } else if (column.key === 'mv') {
          td.textContent = displayManaValue(cardMeta);
        } else if (column.key === 'type') {
          td.textContent = normalizeName(cardMeta.typeLine || '') || '—';
        } else if (column.key === 'price') {
          td.textContent = displayPrice(cardMeta);
        }
        tr.appendChild(td);
      }

      function attachRowActionMenu(tr, row, cardMeta) {
        if (!tr || typeof createActionMenu !== 'function') return;
        var cells = tr.children || [];
        if (cells.length === 0) return;
        var lastCell = cells[cells.length - 1];
        if (!lastCell || !lastCell.classList) return;
        var menu = createActionMenu(row.cardName, cardMeta);
        if (!menu) return;
        menu.classList.add('mt-action-menu--table-row');
        lastCell.classList.add('mt-deck-table__menu-cell');
        lastCell.appendChild(menu);
      }

      for (var s = 0; s < sections.length; s++) {
        var section = sections[s];
        if (!section || !Array.isArray(section.rows) || section.rows.length === 0) continue;
        if (grouped && section.name) {
          var groupRow = document.createElement('tr');
          groupRow.className = 'mt-deck-table__group-row';
          var groupCell = document.createElement('td');
          groupCell.colSpan = columns.length;
          groupCell.textContent = section.name + ' · ' + String(sectionCardTotal(section));
          groupRow.appendChild(groupCell);
          tbody.appendChild(groupRow);
        }

        for (var i = 0; i < section.rows.length; i++) {
          var row = section.rows[i];
          var cardMeta = row.cardMeta || {};
          var tr = document.createElement('tr');
          bindDeckHoverPreview(tr, row.cardName, cardMeta);
          for (var c = 0; c < columns.length; c++) {
            appendCell(tr, row, cardMeta, columns[c]);
          }
          attachRowActionMenu(tr, row, cardMeta);
          tbody.appendChild(tr);
        }
      }

      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }

    function layoutDeckStackSection(container, expandedIndex) {
      if (!container) return;
      var cards = Array.prototype.slice.call(container.querySelectorAll('.mt-deck-art-card'));
      if (cards.length === 0) {
        container.style.height = '';
        container.removeAttribute('data-stack-expanded-index');
        return;
      }

      var normalizedExpandedIndex = Number(expandedIndex);
      if (!Number.isFinite(normalizedExpandedIndex) || normalizedExpandedIndex < 0 || normalizedExpandedIndex >= cards.length) {
        normalizedExpandedIndex = -1;
      }
      var nextKey = String(normalizedExpandedIndex);
      if (container.getAttribute('data-stack-expanded-index') === nextKey && container.getAttribute('data-stack-laid-out') === '1') {
        return;
      }
      container.setAttribute('data-stack-expanded-index', nextKey);
      container.setAttribute('data-stack-laid-out', '1');

      var collapsedStep = 40;
      var firstCard = cards[0];
      var cardHeight = firstCard.offsetHeight || 274;
      var expandedReveal = Math.min(Math.max(cardHeight + 8, 260), 322);
      var extraSpace = normalizedExpandedIndex >= 0 ? Math.max(expandedReveal - collapsedStep, 0) : 0;

      for (var i = 0; i < cards.length; i++) {
        var card = cards[i];
        var top = i * collapsedStep;
        if (normalizedExpandedIndex >= 0 && i > normalizedExpandedIndex) {
          top += extraSpace;
        }
        card.style.top = String(top) + 'px';
        card.style.zIndex = String(i === normalizedExpandedIndex ? cards.length + 5 : i + 1);
        card.classList.toggle('mt-deck-art-card--stack-active', i === normalizedExpandedIndex);
      }

      var totalHeight = ((cards.length - 1) * collapsedStep) + cardHeight + extraSpace + 10;
      container.style.height = String(totalHeight) + 'px';
    }

    function bindDeckStackSection(container) {
      if (!container || container.getAttribute('data-stack-bound') === '1') return;
      container.setAttribute('data-stack-bound', '1');

      var cards = Array.prototype.slice.call(container.querySelectorAll('.mt-deck-art-card'));
      if (cards.length === 0) return;
      var pendingFrame = 0;

      function scheduleStackLayout(index) {
        if (pendingFrame) {
          window.cancelAnimationFrame(pendingFrame);
        }
        pendingFrame = window.requestAnimationFrame(function () {
          pendingFrame = 0;
          layoutDeckStackSection(container, index);
        });
      }

      for (var i = 0; i < cards.length; i++) {
        (function (index) {
          var card = cards[index];
          card.addEventListener('mouseenter', function () {
            scheduleStackLayout(index);
          });
          card.addEventListener('focusin', function () {
            scheduleStackLayout(index);
          });
        })(i);
      }

      container.addEventListener('mouseleave', function () {
        scheduleStackLayout(-1);
      });

      layoutDeckStackSection(container, -1);
    }

    function renderDeckSections(rows, createActionMenu, adjustQuantity, moveBoard, setQuantity) {
      if (!listEl) return;
      closeOpenDeckActionMenus();
      rows = rows || [];

      var sections = groupedDeckSections(rows);
      var viewMode = setDeckListViewMode(deckViewMode);
      listEl.innerHTML = '';
      if (rows.length === 0) return;

      if (viewMode === 'table') {
        var tableSection = document.createElement('section');
        tableSection.className = 'mt-deck-view-section mt-deck-view-section--table';
        tableSection.appendChild(createDeckTable(sections, createActionMenu, adjustQuantity, moveBoard, setQuantity));
        listEl.appendChild(tableSection);
        return;
      }

      for (var i = 0; i < sections.length; i++) {
        var section = sections[i];
        if (!section || !Array.isArray(section.rows) || section.rows.length === 0) continue;

        var body = createDeckSectionContainer(section.name, sectionCardTotal(section), viewMode);
        if (!body) continue;

        for (var j = 0; j < section.rows.length; j++) {
          var row = section.rows[j];
          if (viewMode === 'text') {
            body.appendChild(createDeckTextRow(row, createActionMenu, adjustQuantity, moveBoard));
          } else {
            body.appendChild(createDeckArtCard(row, createActionMenu, adjustQuantity, moveBoard, viewMode, j));
          }
        }

        if (viewMode === 'stacks') {
          bindDeckStackSection(body);
        }
      }
    }

    function normalizeGuestFormat(value) {
      return String(value || '') === 'Commander' ? 'Commander' : 'Sandbox';
    }

    function ensureDraftCardMetaMap(d) {
      if (!d || typeof d !== 'object') return {};
      if (!d.cards || typeof d.cards !== 'object') d.cards = {};
      if (!d.sideboardCards || typeof d.sideboardCards !== 'object') d.sideboardCards = {};
      if (!d.maybeCards || typeof d.maybeCards !== 'object') d.maybeCards = {};
      if (!d.cardMeta || typeof d.cardMeta !== 'object') d.cardMeta = {};
      return d.cardMeta;
    }

    function draftBoardMap(d, board) {
      if (!d || typeof d !== 'object') return {};
      ensureDraftCardMetaMap(d);
      switch (normalizeDeckBoardMode(board)) {
        case 'side':
          return d.sideboardCards;
        case 'maybe':
          return d.maybeCards;
        default:
          return d.cards;
      }
    }

    function boardCardIDParam(board) {
      switch (normalizeDeckBoardMode(board)) {
        case 'side':
          return 'side_card_id';
        case 'maybe':
          return 'maybe_card_id';
        default:
          return 'card_id';
      }
    }

    function boardIncrementAction(board) {
      switch (normalizeDeckBoardMode(board)) {
        case 'side':
          return 'inc_side';
        case 'maybe':
          return 'inc_maybe';
        default:
          return 'inc_main';
      }
    }

    function boardMoveAction(fromBoard, toBoard) {
      var from = normalizeDeckBoardMode(fromBoard);
      var to = normalizeDeckBoardMode(toBoard);
      if (to === 'main') return 'to_main';
      if (to === 'side') return 'to_side';
      if (from === 'side' && to === 'maybe') return 'side_to_maybe';
      return 'to_maybe';
    }

	    function normalizeDraftCardMeta(meta) {
	      if (!meta || typeof meta !== 'object') return null;
	      var cmc = Number(meta.cmc || 0);
	      if (!Number.isFinite(cmc)) cmc = 0;
	      var faces = Array.isArray(meta.faces) ? meta.faces : [];
	      var printID = normalizeName(meta.printID || meta.print_id || meta.scryfallID || meta.scryfall_id || '');
	      var preferredPrintID = normalizeName(meta.preferredPrintID || meta.preferred_print_id || printID);
	      return {
	        cardID: normalizeName(meta.cardID || meta.card_id || ''),
	        name: normalizeName(meta.name || ''),
