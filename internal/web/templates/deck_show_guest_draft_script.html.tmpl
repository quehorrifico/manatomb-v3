          tableSection.appendChild(createDeckTable(section.rows, createActionMenu));
          listEl.appendChild(tableSection);
          continue;
        }

        var body = createDeckSectionContainer(section.name, sectionCardTotal(section), viewMode);
        if (!body) continue;

        for (var j = 0; j < section.rows.length; j++) {
          var row = section.rows[j];
          if (viewMode === 'text') {
            body.appendChild(createDeckTextRow(row, createActionMenu));
          } else {
            body.appendChild(createDeckArtCard(row, createActionMenu, viewMode, j));
