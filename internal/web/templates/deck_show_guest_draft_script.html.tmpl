    function clearGroupedStackSectionLayout(section) {
      if (!section || !section.style) return;
      section.style.position = '';
      section.style.left = '';
      section.style.top = '';
      section.style.width = '';
      section.style.margin = '';
      section.style.zIndex = '';
    }

    function groupedStackSections() {
      if (!listEl) return [];
      return Array.prototype.slice.call(listEl.children || []).filter(function (child) {
        return child && child.classList && child.classList.contains('mt-deck-view-section');
      });
    }

    function groupedStackColumnCount(availableWidth, columnGap, minColumnWidth, sectionCount) {
      var columns = Math.min(5, sectionCount);
      while (columns > 1 && ((availableWidth - (columnGap * (columns - 1))) / columns) < minColumnWidth) {
        columns--;
      }
      return Math.max(columns, 1);
    }

    function shortestGroupedStackColumn(columnHeights) {
      var column = 0;
      for (var i = 1; i < columnHeights.length; i++) {
        if (columnHeights[i] < columnHeights[column]) {
          column = i;
        }
      }
      return column;
    }

    function resetGroupedStackLayout() {
      if (!listEl) return;
      if (deckStackLayoutFrame) {
        window.cancelAnimationFrame(deckStackLayoutFrame);
        deckStackLayoutFrame = 0;
      }
      listEl.style.position = '';
      listEl.style.height = '';
      listEl.removeAttribute('data-stack-layout-locked');
      listEl.removeAttribute('data-stack-layout-pending');

      var sections = groupedStackSections();
      for (var i = 0; i < sections.length; i++) {
        clearGroupedStackSectionLayout(sections[i]);
      }
    }

    function lockGroupedStackLayout() {
      if (!listEl ||
          !listEl.classList.contains('mt-deck-view-root--grouped') ||
          (!listEl.classList.contains('mt-deck-view-root--stacks') && !listEl.classList.contains('mt-deck-view-root--text'))) {
        resetGroupedStackLayout();
        return;
      }

      var sections = groupedStackSections();
      if (sections.length === 0) {
        resetGroupedStackLayout();
        return false;
      }

      var availableWidth = listEl.getBoundingClientRect().width;
      if (!Number.isFinite(availableWidth) || availableWidth < 1) {
        listEl.setAttribute('data-stack-layout-pending', '1');
        return false;
      }

      listEl.style.position = '';
      listEl.style.height = '';
      listEl.removeAttribute('data-stack-layout-locked');
      listEl.removeAttribute('data-stack-layout-pending');

      for (var i = 0; i < sections.length; i++) {
        clearGroupedStackSectionLayout(sections[i]);
      }

      var rootStyle = window.getComputedStyle(listEl);
      var rowGap = parseFloat(rootStyle.rowGap || rootStyle.gap || '0');
      if (!Number.isFinite(rowGap) || rowGap < 0) rowGap = 18;
      var columnGap = parseFloat(rootStyle.columnGap || rootStyle.gap || '0');
      if (!Number.isFinite(columnGap) || columnGap < 0) columnGap = 24;
      var textLayout = listEl.classList.contains('mt-deck-view-root--text');
      var minColumnWidth = textLayout ? 304 : 196;
      var columns = groupedStackColumnCount(availableWidth, columnGap, minColumnWidth, sections.length);
      var columnWidth = columns > 0 ? (availableWidth - (columnGap * (columns - 1))) / columns : availableWidth;
      if (!Number.isFinite(columnWidth) || columnWidth < minColumnWidth) {
        columnWidth = Math.max(minColumnWidth, availableWidth);
      }
      var columnHeights = [];
      for (var c = 0; c < columns; c++) {
        columnHeights[c] = 0;
      }

      listEl.style.position = 'relative';
      listEl.setAttribute('data-stack-layout-locked', '1');

      for (var s = 0; s < sections.length; s++) {
        var section = sections[s];
        var column = s % columns;
        if (s >= columns) {
          column = shortestGroupedStackColumn(columnHeights);
        }

        section.style.position = 'absolute';
        section.style.width = String(columnWidth) + 'px';
        section.style.left = String(column * (columnWidth + columnGap)) + 'px';
        section.style.top = String(columnHeights[column]) + 'px';
        section.style.margin = '0';
        section.style.zIndex = String(s + 1);

        columnHeights[column] += (section.offsetHeight || 0) + rowGap;
      }

      var maxHeight = 0;
      for (var h = 0; h < columnHeights.length; h++) {
        maxHeight = Math.max(maxHeight, columnHeights[h]);
      }

      listEl.style.height = String(Math.max(maxHeight - rowGap, 0)) + 'px';
      return true;
    }

    function scheduleGroupedStackLayoutLock() {
      if (!listEl) return;
      if (deckStackLayoutFrame) {
        window.cancelAnimationFrame(deckStackLayoutFrame);
      }
      deckStackLayoutFrame = window.requestAnimationFrame(function () {
        deckStackLayoutFrame = 0;
        lockGroupedStackLayout();
      });
      if (!deckStackResizeBound) {
        deckStackResizeBound = true;
        window.addEventListener('resize', function () {
          if (!listEl ||
              !listEl.classList.contains('mt-deck-view-root--grouped') ||
              (!listEl.classList.contains('mt-deck-view-root--stacks') && !listEl.classList.contains('mt-deck-view-root--text'))) return;
          scheduleGroupedStackLayoutLock();
        });
      }
      if (!deckStackResizeObserver && typeof window.ResizeObserver === 'function') {
        deckStackResizeObserver = new window.ResizeObserver(function () {
          if (!listEl) return;
          var nextWidth = listEl.getBoundingClientRect().width;
          if (!Number.isFinite(nextWidth)) return;
          var widthChanged = Math.abs(nextWidth - deckStackObservedWidth) >= 0.5;
          deckStackObservedWidth = nextWidth;
          if (nextWidth < 1 || !widthChanged ||
              !listEl.classList.contains('mt-deck-view-root--grouped') ||
              (!listEl.classList.contains('mt-deck-view-root--stacks') && !listEl.classList.contains('mt-deck-view-root--text'))) return;
          scheduleGroupedStackLayoutLock();
        });
        deckStackResizeObserver.observe(listEl);
      }
    }
    window.mtDeckRefreshCardLayout = scheduleGroupedStackLayoutLock;

