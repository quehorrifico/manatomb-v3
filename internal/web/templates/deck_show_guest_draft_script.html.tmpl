{{ define "deck_show_guest_draft_script" }}
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var isGuest = {{ if .Data.WorkbenchMode }}true{{ else if .CurrentUser }}false{{ else }}true{{ end }};
    var isSignedIn = {{ if .CurrentUser }}true{{ else }}false{{ end }};
    var deckBrowser = window.ManatombDeckBrowser;
    if (!deckBrowser) return;
    var supportedDeckFormats = {{ toJSON (supportedFormats) }};
    var commanderDeckFormats = {
      {{ range supportedFormats }}
        {{ toJSON . }}: {{ if formatRequiresCommander . }}true{{ else }}false{{ end }},
      {{ end }}
    };
    var commanderName = {{ toJSON .Data.Deck.CommanderName }};
    var commanderPrintID = {{ toJSON .Data.Deck.CommanderPrintID }};
    var initialDeckName = {{ toJSON .Data.Deck.Name }};
    var previewWrap = document.getElementById('deck-card-preview');
    var previewImg = document.getElementById('deck-card-preview-img');
    var previewFallback = document.getElementById('deck-card-preview-fallback');
    var topCommanderNameEl = document.getElementById('deck-commander-name');
    var topCommanderArtWrap = document.getElementById('deck-top-commander-art-wrap');
    var topCommanderArtImg = document.getElementById('deck-top-commander-art');
    var commanderActionTrigger = document.getElementById('deck-commander-trigger');
    var commanderMenuSlot = document.getElementById('deck-commander-menu-slot');
    var exampleHandList = document.getElementById('deck-analytics-example-hand');
    var exampleHandEmpty = document.getElementById('deck-analytics-example-hand-empty');
    var exampleHandFreshBtn = document.getElementById('deck-analytics-new-hand');
    var exampleHandFreshSlot = document.getElementById('deck-analytics-new-hand-slot');
    var exampleHandStatus = document.getElementById('deck-analytics-example-hand-status');
    var requiresTapPreview = false;
    var tapPreviewSource = null;
    var previewLastX = 0;
    var previewLastY = 0;

    try {
      requiresTapPreview = !!(window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches);
    } catch (e) {
      requiresTapPreview = false;
    }
    if (!requiresTapPreview) {
      requiresTapPreview = ('ontouchstart' in window) || ((navigator && navigator.maxTouchPoints) ? navigator.maxTouchPoints > 0 : false);
    }

    function positionDeckCardPreview(clientX, clientY) {
      if (!previewWrap) return;

      if (Number.isFinite(clientX) && Number.isFinite(clientY)) {
        previewLastX = clientX;
        previewLastY = clientY;
      }

      var x = previewLastX || 0;
      var y = previewLastY || 0;
      var viewportWidth = window.innerWidth || document.documentElement.clientWidth || 0;
      var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
      var gutterX = 86;
      var gutterY = 34;
      var width = previewWrap.offsetWidth || 256;
      var height = previewWrap.offsetHeight || 360;
      var margin = 10;
      var maxX = Math.max(margin, viewportWidth - width - margin);
      var maxY = Math.max(margin, viewportHeight - height - margin);
      var left = x < (viewportWidth / 2) ? x + gutterX : x - width - gutterX;
      var top = y < (viewportHeight / 2) ? y + gutterY : y - height - gutterY;

      if (left < margin) left = margin;
      if (left > maxX) left = maxX;
      if (top < margin) top = margin;
      if (top > maxY) top = maxY;

      previewWrap.style.left = String(left) + 'px';
      previewWrap.style.top = String(top) + 'px';
    }

    function showDeckCardPreview(imageURI, cardName, sourceNode) {
      if (!previewWrap) return;
      if (sourceNode) tapPreviewSource = sourceNode;
      if (imageURI) {
        if (previewImg) {
          previewImg.src = imageURI;
          previewImg.alt = cardName || 'Card preview';
          previewImg.classList.remove('hidden');
        }
        if (previewFallback) previewFallback.classList.add('hidden');
      } else {
        if (previewImg) previewImg.classList.add('hidden');
        if (previewFallback) {
          previewFallback.textContent = cardName || 'Card preview unavailable';
          previewFallback.classList.remove('hidden');
        }
      }
      previewWrap.classList.remove('hidden');
      positionDeckCardPreview();
    }

    function moveDeckCardPreview(event) {
      if (!event) return;
      positionDeckCardPreview(event.clientX, event.clientY);
    }

    function hideDeckCardPreview() {
      if (!previewWrap) return;
      previewWrap.classList.add('hidden');
      tapPreviewSource = null;
    }

    function toggleDeckCardPreview(imageURI, cardName, event, sourceNode) {
      if (!previewWrap) return;
      if (event) {
        moveDeckCardPreview(event);
      }
      if (tapPreviewSource && sourceNode && tapPreviewSource === sourceNode && !previewWrap.classList.contains('hidden')) {
        hideDeckCardPreview();
        return;
      }
      showDeckCardPreview(imageURI, cardName, sourceNode);
    }

    function normalizeName(s) {
      // Collapse internal whitespace and trim.
      return (s || '').replace(/\s+/g, ' ').trim();
    }

    function normalizeDeckName(value) {
      var normalized = normalizeName(value);
      if (!normalized || normalized === 'New Guest Deck' || normalized === 'New Deck') {
        return normalizeName(initialDeckName) || 'Untitled Deck';
      }
      return normalized;
    }

    function nextQuickBuildSeed() {
      var jitter = Math.floor(Math.random() * 1000);
      try {
        if (window.crypto && window.crypto.getRandomValues) {
          var buf = new Uint32Array(1);
          window.crypto.getRandomValues(buf);
          jitter = Number(buf[0] % 1000);
        }
      } catch (e) {
        jitter = Math.floor(Math.random() * 1000);
      }
      return (Date.now() * 1000) + jitter;
    }

    function manaSymbolAssetName(symbol) {
      var normalized = String(symbol || '').trim().toUpperCase();
      if (!normalized) return '';
      return normalized.replace(/\//g, '');
    }

    function renderManaCostPips(target) {
      if (!target) return;
      var raw = String(target.getAttribute('data-mana-cost') || '').trim();
      if (!raw) {
        target.textContent = '';
        return;
      }
      var tokens = raw.match(/\{[^}]+\}/g);
      if (!tokens || tokens.length === 0) {
        target.textContent = raw;
        return;
      }

      target.innerHTML = '';
      target.title = raw;
      for (var i = 0; i < tokens.length; i++) {
        var symbol = String(tokens[i] || '').replace(/^\{|\}$/g, '').trim();
        if (!symbol) continue;
        var assetName = manaSymbolAssetName(symbol);
        if (!assetName) continue;
        var img = document.createElement('img');
        img.alt = '{' + symbol + '}';
        img.src = 'https://svgs.scryfall.io/card-symbols/' + encodeURIComponent(assetName) + '.svg';
        img.className = 'h-3.5 w-3.5 inline-block';
        target.appendChild(img);
      }
    }

    renderManaCostPips(document.getElementById('deck-commander-mana-cost'));
    window.mtRenderManaCostPips = renderManaCostPips;

    var analyticsCardImageCache = {};
    var exampleHandRenderToken = 0;
    var exampleHandCards = [];
    var extrasRenderToken = 0;

	    function extractResolvedImageURI(data) {
	      if (!data || typeof data !== 'object') return '';
	      if (data.image_uri || data.imageURI) {
	        return data.image_uri || data.imageURI || '';
	      }
	      if (data.image_uris) {
	        return data.image_uris.normal || data.image_uris.large || data.image_uris.small || '';
	      }
      return '';
    }

    async function fetchLocalResolvedImage(name, exactOnly) {
      var normalized = normalizeName(name);
      if (!normalized) return '';
      try {
        var url = '/cards/resolve?q=' + encodeURIComponent(normalized);
        if (exactOnly) {
          url += '&exact=1';
        }
        var res = await fetch(url, {
          method: 'GET',
          credentials: 'same-origin'
        });
        if (!res.ok) return '';
        var data = await res.json();
        return extractResolvedImageURI(data);
      } catch (e) {
        return '';
      }
    }

    async function resolveCardImage(name, searchQuery, exactOnly) {
      var normalizedName = normalizeName(name);
      var normalizedQuery = normalizeName(searchQuery || '');
      var strictTag = exactOnly ? 'exact:' : 'fuzzy:';
      var cacheKey = normalizedQuery
        ? (strictTag + 'q:' + normalizedQuery.toLowerCase())
        : (strictTag + 'n:' + normalizedName.toLowerCase());
      if (Object.prototype.hasOwnProperty.call(analyticsCardImageCache, cacheKey)) {
        return analyticsCardImageCache[cacheKey];
      }

      var imageURI = '';
      if (normalizedName) {
        imageURI = await fetchLocalResolvedImage(normalizedName, !!exactOnly);
      }
      if (!imageURI && normalizedQuery && !exactOnly) {
        imageURI = await fetchLocalResolvedImage(normalizedQuery, false);
      }
      analyticsCardImageCache[cacheKey] = imageURI || '';
      return analyticsCardImageCache[cacheKey];
    }

    function bindTopCommanderPreview() {
      if (!topCommanderArtWrap) return;
      if (topCommanderArtWrap.getAttribute('data-preview-bound') === '1') return;
      topCommanderArtWrap.setAttribute('data-preview-bound', '1');
      topCommanderArtWrap.addEventListener('click', function () {
        if (topCommanderArtWrap.classList.contains('hidden')) return;
        if (typeof window.mtDeckOpenWorkbenchCardView !== 'function') return;
        var current = normalizeName(commanderName);
        if (!current) return;
        var draft = isGuest ? (window.mtDeckCurrentGuestDraft || null) : (window.mtDeckCurrentSavedDraft || savedDeckSeed || null);
        var cardMeta = draft ? draftMetaForCard(draft, current) : null;
        window.mtDeckOpenWorkbenchCardView(current, cardMeta, {
          imageURI: normalizeName(topCommanderArtImg && topCommanderArtImg.getAttribute('src') || ''),
          resolveExact: !(cardMeta && cardMeta.cardID),
        });
      });
    }

    function createAnalyticsArtTile(opts) {
      var name = normalizeName(opts && opts.name ? opts.name : '');
      var count = Number(opts && opts.count ? opts.count : 0);
      var caption = normalizeName(opts && opts.caption ? opts.caption : name);
      var currentImageURI = normalizeName(opts && opts.imageURI ? opts.imageURI : '');
      var tileClassName = normalizeName(opts && opts.className ? opts.className : '');
      var onOpen = opts && typeof opts.onOpen === 'function' ? opts.onOpen : null;
      var actionMenu = opts && opts.actionMenu ? opts.actionMenu : null;

      var li = document.createElement('li');
      li.className = tileClassName ? ('mt-art-tile ' + tileClassName) : 'mt-art-tile';
      if (onOpen) {
        li.tabIndex = 0;
        li.setAttribute('role', 'button');
        li.classList.add('cursor-pointer');
      }

      var cardFrame = document.createElement('div');
      cardFrame.className = 'mt-art-tile__frame';

      var img = document.createElement('img');
      img.alt = name || 'Card art';
      img.className = 'hidden w-full h-full object-cover';

      var fallback = document.createElement('div');
      fallback.className = 'mt-art-tile__fallback';
      fallback.textContent = caption || 'Card';

      cardFrame.appendChild(img);
      cardFrame.appendChild(fallback);

      if (actionMenu) {
        var menuWrap = document.createElement('div');
        menuWrap.className = 'mt-art-tile__menu';
        menuWrap.addEventListener('click', function (event) {
          event.stopPropagation();
        });
        menuWrap.appendChild(actionMenu);
        cardFrame.appendChild(menuWrap);
      }

      if (count > 1) {
        var badge = document.createElement('span');
        badge.className = 'mt-art-tile__badge';
        badge.textContent = String(count);
        cardFrame.appendChild(badge);
      }

      var label = document.createElement('p');
      label.className = 'mt-art-tile__label';
      label.textContent = caption || name || 'Card';
      label.title = caption || name || 'Card';

      li.appendChild(cardFrame);
      li.appendChild(label);

      function applyImage(uri) {
        currentImageURI = normalizeName(uri);
        if (currentImageURI) {
          img.src = currentImageURI;
          img.classList.remove('hidden');
          fallback.classList.add('hidden');
        } else {
          img.removeAttribute('src');
          img.classList.add('hidden');
          fallback.classList.remove('hidden');
        }
      }

      if (onOpen) {
        li.addEventListener('click', function () {
          onOpen();
        });
        li.addEventListener('keydown', function (event) {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          onOpen();
        });
      }

      applyImage(currentImageURI);

      return {
        node: li,
        setImage: applyImage,
      };
    }

    function buildMainboardPoolFromMap(cardMap, commander, cardMetaByName) {
      var pool = [];
      var activeCommander = normalizeName(commander).toLowerCase();
      var entries = Object.entries(cardMap || {});

      for (var i = 0; i < entries.length; i++) {
        var cardName = normalizeName(entries[i][0]);
        var qty = Number(entries[i][1] || 0);
        if (!cardName || !Number.isFinite(qty) || qty <= 0) continue;
        if (activeCommander && cardName.toLowerCase() === activeCommander) {
          qty -= 1;
        }
        var cardMeta = cardMetaByName && cardMetaByName[cardName] ? cardMetaByName[cardName] : null;
        var imageURI = normalizeName(cardMeta && cardMeta.imageURI ? cardMeta.imageURI : '');
        for (var j = 0; j < qty; j++) {
          pool.push({
            name: cardName,
            imageURI: imageURI,
            cardMeta: cardMeta,
          });
        }
      }

      return pool;
    }

    function buildSignedMainboardPool() {
      var draft = window.mtDeckCurrentSavedDraft || savedDeckSeed;
      if (!draft || typeof draft !== 'object') return [];

      var cardMetaByName = {};
      var names = Object.keys(draft.cards || {});
      for (var i = 0; i < names.length; i++) {
        var name = normalizeName(names[i]);
        if (!name) continue;
        cardMetaByName[name] = draftMetaForCard(draft, name) || null;
      }
      return buildMainboardPoolFromMap(draft.cards || {}, currentCommanderForDraft(draft), cardMetaByName);
    }

    function buildGuestMainboardPool() {
      var draft = window.mtDeckCurrentGuestDraft;
      if (!draft || typeof draft !== 'object') return [];

      var cardMetaByName = {};
      var names = Object.keys(draft.cards || {});
      for (var i = 0; i < names.length; i++) {
        var name = normalizeName(names[i]);
        if (!name) continue;
        cardMetaByName[name] = draftMetaForCard(draft, name) || null;
      }
      return buildMainboardPoolFromMap(draft.cards || {}, currentCommanderForDraft(draft), cardMetaByName);
    }

    function createOpeningHandActionMenu(cardName, cardMeta) {
      var actions = window.mtDeckOpeningHandActions;
      if (!actions || typeof actions !== 'object') return null;
      return createSimpleDeckActionMenu([
        {
          label: 'View card',
          onClick: function () {
            if (typeof actions.view === 'function') actions.view(cardName, cardMeta);
          }
        },
        {
          label: 'Change version',
          onClick: function () {
            if (typeof actions.changeVersion === 'function') actions.changeVersion(cardName, cardMeta);
          }
        },
        {
          label: 'Move to Side',
          onClick: function () {
            if (typeof actions.moveToBoard === 'function') actions.moveToBoard(cardName, cardMeta, 'side');
          }
        },
        {
          label: 'Move to Maybe',
          onClick: function () {
            if (typeof actions.moveToBoard === 'function') actions.moveToBoard(cardName, cardMeta, 'maybe');
          }
        },
        {
          label: 'Add Copy',
          onClick: function () {
            if (typeof actions.addCopy === 'function') actions.addCopy(cardName, cardMeta);
          }
        },
        {
          label: 'Remove Copy',
          onClick: function () {
            if (typeof actions.removeCopy === 'function') actions.removeCopy(cardName, cardMeta);
          }
        }
      ], 'mt-action-menu--art-tile', 'Opening hand card actions');
    }

    function normalizeExampleHandCards(cardsInHand) {
      if (!Array.isArray(cardsInHand)) return [];
      var out = [];
      for (var i = 0; i < cardsInHand.length; i++) {
        var card = cardsInHand[i] || {};
        var name = normalizeName(card.name);
        if (!name) continue;
        out.push({
          name: name,
          imageURI: normalizeName(card.imageURI || ''),
          cardMeta: card.cardMeta || null,
        });
      }
      return out;
    }

    function exampleHandCardKey(card) {
      return normalizeName(card && card.name ? card.name : '').toLowerCase();
    }

    function buildExampleHandPoolLookup(pool) {
      var lookup = {};
      if (!Array.isArray(pool)) return lookup;
      for (var i = 0; i < pool.length; i++) {
        var card = pool[i] || {};
        var key = exampleHandCardKey(card);
        if (!key) continue;
        if (!lookup[key]) lookup[key] = [];
        lookup[key].push(card);
      }
      return lookup;
    }

    function reconcileExampleHandWithPool(pool) {
      if (!exampleHandCards.length) return [];
      var lookup = buildExampleHandPoolLookup(pool);
      var next = [];
      for (var i = 0; i < exampleHandCards.length; i++) {
        var previous = exampleHandCards[i] || {};
        var key = exampleHandCardKey(previous);
        if (!key || !lookup[key] || lookup[key].length === 0) continue;
        var match = lookup[key].shift() || {};
        next.push({
          name: normalizeName(match.name || previous.name),
          imageURI: normalizeName(match.imageURI || previous.imageURI || ''),
          cardMeta: match.cardMeta || previous.cardMeta || null,
        });
      }
      return next;
    }

    function renderExampleHand(cardsInHand) {
      exampleHandCards = normalizeExampleHandCards(cardsInHand);
      if (!exampleHandList) return;

      var renderToken = ++exampleHandRenderToken;
      var oldCards = Array.prototype.slice.call(exampleHandList.querySelectorAll('[data-example-hand-card]'));
      for (var oldCardIndex = 0; oldCardIndex < oldCards.length; oldCardIndex++) {
        oldCards[oldCardIndex].remove();
      }
      if (exampleHandCards.length === 0) {
        if (exampleHandFreshSlot) exampleHandFreshSlot.classList.add('hidden');
        if (exampleHandEmpty) exampleHandEmpty.classList.remove('hidden');
        return;
      }

      if (exampleHandEmpty) exampleHandEmpty.classList.add('hidden');
      var renderedCards = 0;
      for (var i = 0; i < exampleHandCards.length; i++) {
        var card = exampleHandCards[i] || {};
        var name = normalizeName(card.name);
        if (!name) continue;
        var tile = createAnalyticsArtTile({
          name: name,
          caption: name,
          imageURI: normalizeName(card.imageURI || ''),
          className: 'mt-art-tile--grid',
          actionMenu: createOpeningHandActionMenu(name, card.cardMeta || null),
          onOpen: (function (cardName, cardMeta) {
            return function () {
              if (typeof window.mtDeckOpenWorkbenchCardView !== 'function') return;
              window.mtDeckOpenWorkbenchCardView(cardName, cardMeta, {
                resolveExact: !(cardMeta && cardMeta.cardID),
              });
            };
          })(name, card.cardMeta || null),
        });
        tile.node.setAttribute('data-example-hand-card', '');
        exampleHandList.insertBefore(tile.node, exampleHandFreshSlot || null);
        renderedCards++;

        if (!normalizeName(card.imageURI || '')) {
          (function (localTile, localName, localRenderToken) {
            resolveCardImage(localName, '').then(function (uri) {
              if (localRenderToken !== exampleHandRenderToken) return;
              if (!uri) return;
              localTile.setImage(uri);
            });
          })(tile, name, renderToken);
        }
      }

      if (exampleHandFreshSlot) {
        exampleHandFreshSlot.classList.toggle('hidden', renderedCards === 0);
      }
      if (renderedCards === 0 && exampleHandEmpty) {
        exampleHandEmpty.classList.remove('hidden');
      }
    }

    function extraArtTarget(extraName) {
      var key = normalizeName(extraName).toLowerCase();
      var lookup = {
        'treasure tokens': { name: 'Treasure' },
        'clue tokens': { name: 'Clue' },
        'food tokens': { name: 'Food' },
        'blood tokens': { name: 'Blood' },
        'map tokens': { name: 'Map' },
        'powerstone tokens': { name: 'Powerstone' },
        'incubator tokens': { name: 'Incubator' },
        'junk tokens': { name: 'Junk' },
        'role tokens': { name: 'Role' },
        'gold tokens': { name: 'Gold' },
        'other tokens': { name: 'Token' },
        'city\'s blessing': { name: 'The City\'s Blessing' },
        'the monarch': { name: 'The Monarch' },
        'the initiative': { name: 'The Initiative' },
        'day/night': { name: 'Day' },
        'energy counters': { name: 'Energy Reserve' },
        'experience counters': { name: 'Experience Counter' },
        'poison counters': { name: 'Poison Counter' },
        'shield counters': { name: 'Shield Counter' },
        'stun counters': { name: 'Stun Counter' },
        '+1/+1 counters': { name: '+1/+1 Counter' },
      };
      if (lookup[key]) return lookup[key];
      var fallback = normalizeName(extraName).replace(/\s+tokens?$/i, '').trim();
      return { name: fallback || normalizeName(extraName) };
    }

    function randomizeOrder(items) {
      for (var i = items.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = items[i];
        items[i] = items[j];
        items[j] = tmp;
      }
    }

    function readSeedExtrasFromDOM() {
      var list = document.getElementById('deck-analytics-extras');
      if (!list) return [];

      var out = [];
      var nodes = list.querySelectorAll('li[data-extra-name]');
      for (var i = 0; i < nodes.length; i++) {
        var name = normalizeName(nodes[i].getAttribute('data-extra-name') || '');
        var count = Number(nodes[i].getAttribute('data-extra-count') || 0);
        if (!name || !Number.isFinite(count) || count <= 0) continue;
        out.push({ name: name, count: count });
      }
      return out;
    }

    function exampleHandPoolSignature(pool) {
      if (!Array.isArray(pool) || pool.length === 0) return '';
      return pool.map(function (card) {
        var name = normalizeName(card && card.name ? card.name : '');
        var imageURI = normalizeName(card && card.imageURI ? card.imageURI : '');
        return name + '|' + imageURI;
      }).sort().join('\n');
    }

    function announceExampleHand(cardCount) {
      if (!exampleHandStatus) return;
      exampleHandStatus.textContent = '';
      window.requestAnimationFrame(function () {
        exampleHandStatus.textContent = cardCount === 7
          ? 'A new seven-card example hand is ready.'
          : 'A new example hand of ' + String(cardCount) + ' cards is ready.';
      });
    }

    function drawExampleHand(announce) {
      var pool = isGuest ? buildGuestMainboardPool() : buildSignedMainboardPool();
      exampleHandSignature = exampleHandPoolSignature(pool);
      if (!Array.isArray(pool) || pool.length === 0) {
        renderExampleHand([]);
        if (announce) announceExampleHand(0);
        return;
      }

      var sampled = pool.slice();
      randomizeOrder(sampled);
      var nextHand = sampled.slice(0, Math.min(7, sampled.length));
      renderExampleHand(nextHand);
      if (announce) announceExampleHand(nextHand.length);
    }

    function syncExampleHandForMainboard(force) {
      var pool = isGuest ? buildGuestMainboardPool() : buildSignedMainboardPool();
      var signature = exampleHandPoolSignature(pool);
      if (!force && signature === exampleHandSignature) return;
      if (!force && exampleHandCards.length > 0) {
        exampleHandSignature = signature;
        renderExampleHand(reconcileExampleHandWithPool(pool));
        return;
      }
      drawExampleHand(false);
    }

    if (exampleHandFreshBtn) {
      exampleHandFreshBtn.addEventListener('click', function () {
        drawExampleHand(true);
      });
    }

    function countValue(id) {
      var el = document.getElementById(id);
      if (!el) return 0;
      var n = Number((el.textContent || '').trim());
      if (!Number.isFinite(n) || n < 0) return 0;
      return n;
    }

    function syncManaCurveBars() {
      var keys = ['0', '1', '2', '3', '4', '5', '6', '7p'];
      var counts = keys.map(function (key) {
        return countValue('deck-analytics-curve-' + key);
      });
      var max = 0;
      for (var i = 0; i < counts.length; i++) {
        if (counts[i] > max) max = counts[i];
      }
      for (var j = 0; j < keys.length; j++) {
        var bar = document.getElementById('deck-curve-bar-' + keys[j]);
        if (!bar) continue;
        var val = counts[j];
        var pct = max > 0 ? Math.round((val / max) * 100) : 0;
        // Keep bars inside the chart box so labels never overflow.
        var h = val > 0 ? Math.max(6, Math.round((pct / 100) * 46)) : 4;
        bar.style.height = String(h) + 'px';
      }
    }

    if (requiresTapPreview) {
      document.addEventListener('click', function (event) {
        if (!tapPreviewSource || !previewWrap || previewWrap.classList.contains('hidden')) return;
        if (tapPreviewSource.contains(event.target)) return;
        hideDeckCardPreview();
      }, true);
    }

    if (previewWrap) {
      window.mtDeckCardPreview = {
        show: showDeckCardPreview,
        move: moveDeckCardPreview,
        hide: hideDeckCardPreview,
        toggle: toggleDeckCardPreview,
        tapMode: requiresTapPreview,
