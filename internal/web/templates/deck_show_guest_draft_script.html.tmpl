    function deckAnalyticsPayload(d) {
      var entries = Object.entries((d && d.cards) || {});
      entries.sort(function (a, b) { return a[0].localeCompare(b[0]); });

      var cards = [];
      entries.forEach(function (pair) {
        var name = String(pair[0] || '').trim();
        var qty = Number(pair[1] || 0);
        if (!name || qty <= 0) return;
        cards.push({ name: name, qty: qty });
      });

      return {
        format: normalizeGuestFormat((d && d.format) ? d.format : deckFormat),
        commander_name: currentCommanderForDraft(d),
        cards: cards,
      };
    }

    function requestGuestAnalytics(d) {
      var payload = deckAnalyticsPayload(d || {});
      var signature = JSON.stringify(payload);
      if (signature === lastAnalyticsSignature) {
        return;
      }
      lastAnalyticsSignature = signature;

      if (analyticsTimer) {
        clearTimeout(analyticsTimer);
      }

      analyticsTimer = setTimeout(function () {
        analyticsTimer = null;
        var reqToken = ++analyticsRequestToken;
        if (guestAnalyticsStatus) guestAnalyticsStatus.textContent = 'Updating...';

        fetch('/decks/analytics', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then(function (res) {
          if (!res.ok) throw new Error('request failed');
          return res.json();
        }).then(function (analytics) {
          if (reqToken !== analyticsRequestToken) return;
          renderAnalytics(analytics);
          if (guestAnalyticsStatus) guestAnalyticsStatus.textContent = '';
        }).catch(function () {
          if (reqToken !== analyticsRequestToken) return;
          if (guestAnalyticsStatus) guestAnalyticsStatus.textContent = 'Unavailable';
        });
      }, 220);
    }

    function guestBoardUndoState(d, board, cardName) {
      var normalizedBoard = normalizeDeckBoardMode(board);
      var map = draftBoardMap(d, normalizedBoard);
      var keyForCard = draftCardNameKey(map, cardName);
      var quantity = Number(keyForCard ? map[keyForCard] : 0);
      if (!Number.isFinite(quantity) || quantity < 0) quantity = 0;
      return {
        board: normalizedBoard,
        quantity: quantity
      };
    }

    function restoreGuestBoardUndoStates(cardName, expectedStates, restoreStates) {
      var latest = loadDraft();
      if (!latest) return false;
      ensureDraftCardMetaMap(latest);

      for (var i = 0; i < expectedStates.length; i++) {
        var current = guestBoardUndoState(latest, expectedStates[i].board, cardName);
        if (current.quantity !== expectedStates[i].quantity) return false;
      }

      for (var j = 0; j < restoreStates.length; j++) {
        var state = restoreStates[j];
        var map = draftBoardMap(latest, state.board);
        var existingKey = draftCardNameKey(map, cardName);
        if (state.quantity <= 0) {
          if (existingKey) delete map[existingKey];
        } else {
          map[existingKey || cardName] = state.quantity;
        }
      }

      if (!saveDraft(latest)) return false;
      render(latest);
      return true;
    }

    function adjustGuestBoardCardQuantity(board, cardName, delta) {
      var name = normalizeName(cardName);
      var step = Number(delta || 0);
      if (!name || !Number.isFinite(step) || step === 0) return;
      if (!deckUndoBusy) clearDeckUndo();

      var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      ensureDraftCardMetaMap(dd);

      var targetBoard = normalizeDeckBoardMode(board);
      var before = guestBoardUndoState(dd, targetBoard, name);
      var map = draftBoardMap(dd, targetBoard);
      var existingKey = draftCardNameKey(map, name);
      var nextQty = before.quantity + step;
      if (!Number.isFinite(nextQty) || nextQty <= 0) {
        if (existingKey) delete map[existingKey];
        nextQty = 0;
      } else {
        map[existingKey || name] = nextQty;
      }

      if (!saveDraft(dd)) return;
      render(dd);
      if (step < 0 && nextQty < before.quantity) {
        var after = { board: targetBoard, quantity: nextQty };
        showDeckUndo('Removed ' + name + '.', function () {
          return restoreGuestBoardUndoStates(name, [after], [before]);
        });
      }
    }

	    function setGuestBoardCardQuantity(board, cardName, quantity) {
	      var name = normalizeName(cardName);
	      var nextQty = Math.floor(Number(quantity || 0));
	      if (!name || !Number.isFinite(nextQty) || nextQty < 0) return;
      if (!deckUndoBusy) clearDeckUndo();

      var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      ensureDraftCardMetaMap(dd);

      var targetBoard = normalizeDeckBoardMode(board);
      var before = guestBoardUndoState(dd, targetBoard, name);
      var map = draftBoardMap(dd, targetBoard);
      var existingKey = draftCardNameKey(map, name);
      if (nextQty <= 0) {
        if (existingKey) delete map[existingKey];
      } else {
        map[existingKey || name] = nextQty;
      }

      if (!saveDraft(dd)) return;
      render(dd);
      if (nextQty < before.quantity) {
        var after = { board: targetBoard, quantity: nextQty };
        var removed = before.quantity - nextQty;
        showDeckUndo(
          'Removed ' + String(removed) + (removed === 1 ? ' copy of ' : ' copies of ') + name + '.',
          function () {
            return restoreGuestBoardUndoStates(name, [after], [before]);
          }
        );
      }
    }

    function applyGuestCardVersion(cardName, cardMeta, version, board) {
      var name = normalizeName(cardName);
      var nextMeta = buildDraftCardMetaFromVersion(name, cardMeta, version);
      if (!name || !nextMeta) return;

      var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      ensureDraftCardMetaMap(dd);
      if (!dd.boardCardMeta || typeof dd.boardCardMeta !== 'object') dd.boardCardMeta = {};
      var boardKey = normalizeDeckBoardMode(board || deckBoardMode);
      if (!dd.boardCardMeta[boardKey] || typeof dd.boardCardMeta[boardKey] !== 'object') {
        dd.boardCardMeta[boardKey] = {};
      }
      dd.cardMeta[name] = nextMeta;
      dd.boardCardMeta[boardKey][name] = nextMeta;
      if (nextMeta.name && nextMeta.name.toLowerCase() !== name.toLowerCase()) {
        dd.cardMeta[nextMeta.name] = nextMeta;
        dd.boardCardMeta[boardKey][nextMeta.name] = nextMeta;
      }
      if (nextMeta.imageURI) {
        guestPreviewCache[name.toLowerCase()] = nextMeta.imageURI;
        if (nextMeta.name) guestPreviewCache[nextMeta.name.toLowerCase()] = nextMeta.imageURI;
      }
      if (name.toLowerCase() === currentCommanderForDraft(dd).toLowerCase()) {
        commanderPrintID = normalizeName(nextMeta.preferredPrintID || nextMeta.printID || '');
        dd.commanderPrintID = commanderPrintID;
      }

      saveDraft(dd);
      render(dd);
      setGuestDeckStatus('Version updated.');
    }

    function openGuestCardVersionPicker(cardName, cardMeta, board) {
      var meta = normalizeDraftCardMeta(cardMeta) || {};
      openWorkbenchCardView(cardName, meta, {
        detailMode: 'versions',
        preferredPrintID: meta.preferredPrintID || meta.printID || '',
        printID: meta.printID || meta.preferredPrintID || '',
        versionContext: {
          onSelect: function (version) {
            applyGuestCardVersion(cardName, meta, version, board);
          }
        }
      });
    }

    function adjustGuestCardQuantity(cardName, delta) {
      adjustGuestBoardCardQuantity('main', cardName, delta);
    }

    function adjustGuestMaybeCardQuantity(cardName, delta) {
      adjustGuestBoardCardQuantity('maybe', cardName, delta);
    }

    function moveGuestCardBetweenBoards(fromBoard, toBoard, cardName) {
      moveGuestCardQuantityBetweenBoards(fromBoard, toBoard, cardName, 1);
    }

    function moveGuestCardQuantityBetweenBoards(fromBoard, toBoard, cardName, quantity) {
      var name = normalizeName(cardName);
      if (!name) return;
      if (!deckUndoBusy) clearDeckUndo();

      var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      ensureDraftCardMetaMap(dd);

      var sourceBoard = normalizeDeckBoardMode(fromBoard);
      var targetBoard = normalizeDeckBoardMode(toBoard);
      if (sourceBoard === targetBoard) return;
      var beforeSource = guestBoardUndoState(dd, sourceBoard, name);
      var beforeTarget = guestBoardUndoState(dd, targetBoard, name);
      var fromMap = draftBoardMap(dd, sourceBoard);
      var toMap = draftBoardMap(dd, targetBoard);
      var sourceKey = draftCardNameKey(fromMap, name);
      var targetKey = draftCardNameKey(toMap, name);
      var current = beforeSource.quantity;
      if (!Number.isFinite(current) || current <= 0) return;
      var moveQty = Math.floor(Number(quantity || 0));
      if (!Number.isFinite(moveQty) || moveQty <= 0 || moveQty > current) {
        moveQty = current;
      }
      var sourceAfterQty = current - moveQty;
      var targetAfterQty = beforeTarget.quantity + moveQty;
      if (sourceAfterQty <= 0) {
        if (sourceKey) delete fromMap[sourceKey];
      } else {
        fromMap[sourceKey || name] = sourceAfterQty;
      }
      toMap[targetKey || name] = targetAfterQty;

      if (!saveDraft(dd)) return;
      render(dd);
      var afterStates = [
        { board: sourceBoard, quantity: sourceAfterQty },
        { board: targetBoard, quantity: targetAfterQty }
      ];
      showDeckUndo(
        'Moved ' + (moveQty > 1 ? String(moveQty) + ' copies of ' : '') + name + ' to ' + deckBoardLabel(targetBoard) + '.',
        function () {
          return restoreGuestBoardUndoStates(name, afterStates, [beforeSource, beforeTarget]);
        }
      );
    }

    function moveGuestCardToMaybe(cardName) {
      moveGuestCardBetweenBoards('main', 'maybe', cardName);
    }

    function moveGuestMaybeToMain(cardName) {
      moveGuestCardBetweenBoards('maybe', 'main', cardName);
    }

    function collectMissingGuestMetaNames(d) {
      var out = [];
      var zones = [(d && d.cards) || {}, (d && d.sideboardCards) || {}, (d && d.maybeCards) || {}];
      for (var z = 0; z < zones.length; z++) {
        var entries = Object.entries(zones[z]);
        for (var i = 0; i < entries.length; i++) {
          var cardName = normalizeName(entries[i][0]);
          var qty = Number(entries[i][1] || 0);
          if (!cardName || !Number.isFinite(qty) || qty <= 0) continue;
          if (draftMetaForCard(d, cardName)) continue;
          var key = cardName.toLowerCase();
          if ((guestMetaAttempts[key] || 0) >= 2) continue;
          if (out.indexOf(cardName) >= 0) continue;
          out.push(cardName);
        }
      }
      return out;
    }

    async function hydrateGuestCardMeta() {
      if (guestMetaHydrating) {
        guestMetaRetryQueued = true;
        return;
      }

      var dd = loadDraft();
      if (!dd || typeof dd !== 'object') return;
      ensureDraftCardMetaMap(dd);

      var missing = collectMissingGuestMetaNames(dd);
      if (missing.length === 0) return;

      guestMetaHydrating = true;
      var changed = false;
      var limit = Math.min(missing.length, 20);

      for (var i = 0; i < limit; i++) {
        var cardName = missing[i];
        var attemptKey = cardName.toLowerCase();
        guestMetaAttempts[attemptKey] = (guestMetaAttempts[attemptKey] || 0) + 1;

        var data = await resolveCardByName(cardName);
        if (!data || !data.name) continue;

        var meta = buildDraftCardMeta(data);
        if (!meta) continue;

        dd.cardMeta[cardName] = meta;
        if (meta.name && meta.name.toLowerCase() !== attemptKey) {
          dd.cardMeta[meta.name] = meta;
        }
        changed = true;
      }

      guestMetaHydrating = false;

      if (changed) {
        guestMetaRetryQueued = false;
        saveDraft(dd);
        render(dd);
      } else if (guestMetaRetryQueued) {
        guestMetaRetryQueued = false;
        hydrateGuestCardMeta();
      }
    }

    function emitGuestDraftRendered() {
      if (typeof document === 'undefined' || !document.dispatchEvent) return;
      try {
        document.dispatchEvent(new CustomEvent('mtDeckGuestDraftRendered'));
      } catch (e) {
        // ignore browser compatibility issues
      }
    }

    function render(d) {
      d = d || { commanderName: commanderName, commanderCandidates: [], cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      ensureDraftCardMetaMap(d);
      d.format = normalizeGuestFormat(d.format);
      guestDeckName = normalizeDeckName(d.name || guestDeckName);
      d.name = guestDeckName;
      allowsCommanderCardAction = formatUsesCommander(d.format);
      if (guestFormatField) guestFormatField.value = d.format;
      if (window.mtDeckSetOverviewFormat) window.mtDeckSetOverviewFormat(allowsCommanderCardAction);
      if (window.mtDeckSetOverviewTags) window.mtDeckSetOverviewTags(d.tags || '');
      syncGuestAuthSaveLinks();

      // Name/description hydration (if present)
      if (nameEl) nameEl.textContent = guestDeckName;
      if (deckEditorHeading) deckEditorHeading.textContent = 'Edit ' + guestDeckName;
      if (guestDeckNameInput && document.activeElement !== guestDeckNameInput) {
        guestDeckNameInput.value = guestDeckName;
      }
      if (descEl) {
        var hasDesc = !!(d.description && d.description.trim());
        if (String(descEl.tagName || '').toUpperCase() === 'TEXTAREA') {
          descEl.value = hasDesc ? d.description : '';
        } else {
          descEl.textContent = hasDesc ? d.description : '';
        }
        if (descEmptyEl) descEmptyEl.classList.toggle('hidden', hasDesc);
      }

      if (!listEl) return;

      function bindGuestRowPreview(node, cardName, imageURI) {
        return;
      }

      function createGuestCardActionMenu(cardName, cardMeta, board) {
        var currentBoard = normalizeDeckBoardMode(board || deckBoardMode);
        var items = [
          {
            label: 'View card',
            onClick: function () {
              openWorkbenchCardView(cardName, cardMeta);
            }
          },
          {
            label: 'Change Version',
            onClick: function () {
              openGuestCardVersionPicker(cardName, cardMeta, currentBoard);
            }
          },
          {
            label: 'Add Copy',
            onClick: function () {
              adjustGuestBoardCardQuantity(currentBoard, cardName, 1);
            }
          },
          {
            label: 'Remove Copy',
            onClick: function () {
              adjustGuestBoardCardQuantity(currentBoard, cardName, -1);
            }
          }
        ].concat(deckMoveBoardActionItems(currentBoard, function (targetBoard) {
            moveGuestCardBetweenBoards(currentBoard, targetBoard, cardName);
        }));

        appendCommanderCardActionItems(items, cardName, cardMeta, currentBoard, function () {
          setGuestCommander(cardName);
        });
        return createSimpleDeckActionMenu(items, '', 'Card actions for ' + cardName);
      }

      var entries = Object.entries(d.cards || {});
      entries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
      var visibleRows = 0;
      var totalCards = 0;
      var deckRows = [];
      entries.forEach(function (pair) {
        var cardName = normalizeName(pair[0]);
        var qty = Number(pair[1] || 0);
        if (!cardName || !Number.isFinite(qty) || qty <= 0) return;
        if (commanderName && cardName.toLowerCase() === commanderName.toLowerCase()) {
          qty -= 1; // Commander occupies its own slot, not the 99 list.
        }
        if (qty <= 0) return;
        visibleRows += 1;
        totalCards += qty;
	        deckRows.push({
	          cardName: cardName,
	          qty: qty,
	          cardMeta: draftMetaForBoardCard(d, 'main', cardName)
	        });
      });

      var sideEntries = Object.entries(d.sideboardCards || {});
      sideEntries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
      var sideboardRows = [];
      var sideboardCardsTotal = 0;
      sideEntries.forEach(function (pair) {
        var cardName = normalizeName(pair[0]);
        var qty = Number(pair[1] || 0);
        if (!cardName || !Number.isFinite(qty) || qty <= 0) return;
        sideboardCardsTotal += qty;
	        sideboardRows.push({
	          cardName: cardName,
	          qty: qty,
	          cardMeta: draftMetaForBoardCard(d, 'side', cardName)
	        });
      });

      var maybeEntries = Object.entries(d.maybeCards || {});
      maybeEntries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
      var maybeDeckRows = [];
      var maybeCardsTotal = 0;
      maybeEntries.forEach(function (pair) {
        var cardName = normalizeName(pair[0]);
        var qty = Number(pair[1] || 0);
        if (!cardName || !Number.isFinite(qty) || qty <= 0) return;
        maybeCardsTotal += qty;
	        maybeDeckRows.push({
	          cardName: cardName,
	          qty: qty,
	          cardMeta: draftMetaForBoardCard(d, 'maybe', cardName)
	        });
      });

      var activeRows = deckRows;
      if (deckBoardMode === 'side') activeRows = sideboardRows;
      if (deckBoardMode === 'maybe') activeRows = maybeDeckRows;
      var visibleActiveRows = filterDeckRows(activeRows);
      syncDeckDisplayOptions(activeRows);
      renderDeckSections(visibleActiveRows, function (cardName, cardMeta) {
        return createGuestCardActionMenu(cardName, cardMeta, deckBoardMode);
      }, function (cardName, cardMeta, delta) {
        adjustGuestBoardCardQuantity(deckBoardMode, cardName, delta);
      }, function (cardName, cardMeta, targetBoard, quantity) {
        moveGuestCardQuantityBetweenBoards(deckBoardMode, targetBoard, cardName, quantity || 1);
      }, function (cardName, cardMeta, quantity) {
        setGuestBoardCardQuantity(deckBoardMode, cardName, quantity);
      });

      if (emptyEl) {
        emptyEl.textContent = emptyDeckBoardMessage(activeRows);
        emptyEl.classList.toggle('hidden', visibleActiveRows.length !== 0);
      }
      if (maybeEmptyEl) maybeEmptyEl.classList.add('hidden');
      if (deckCountLabel) deckCountLabel.textContent = String(totalCards);
      if (sideboardCountLabel) sideboardCountLabel.textContent = String(sideboardCardsTotal);
      if (maybeCountLabel) maybeCountLabel.textContent = String(maybeCardsTotal);
      syncDeckBoardTabs();
      renderCommanderControls(d);
      renderQuickBuildState(d);
      syncGuestCommanderOverview(d);
      window.mtDeckCurrentGuestDraft = d;
      window.mtDeckGuestSyncCommanderOverview = syncGuestCommanderOverview;
      window.mtDeckGuestAdjustCard = adjustGuestCardQuantity;
      window.mtDeckGuestAdjustBoardCard = adjustGuestBoardCardQuantity;
      window.mtDeckGuestAdjustMaybeCard = adjustGuestMaybeCardQuantity;
      window.mtDeckGuestMoveCardBetweenBoards = moveGuestCardBetweenBoards;
      window.mtDeckGuestMoveCardToMaybe = moveGuestCardToMaybe;
      window.mtDeckGuestMoveMaybeToMain = moveGuestMaybeToMain;
      window.mtDeckOpeningHandActions = {
        view: function (cardName, cardMeta) {
          openWorkbenchCardView(cardName, cardMeta);
        },
        changeVersion: function (cardName, cardMeta) {
          openGuestCardVersionPicker(cardName, cardMeta, 'main');
        },
        moveToBoard: function (cardName, cardMeta, targetBoard) {
          moveGuestCardQuantityBetweenBoards('main', targetBoard, cardName, 1);
        },
        addCopy: function (cardName) {
          adjustGuestBoardCardQuantity('main', cardName, 1);
        },
        removeCopy: function (cardName) {
          adjustGuestBoardCardQuantity('main', cardName, -1);
        }
      };
      renderCommanderActionMenu({
        currentName: function () {
          return currentCommanderForDraft(d);
        },
        view: function () {
          var current = currentCommanderForDraft(d);
          openWorkbenchCardView(current, draftMetaForCard(d, current));
        },
        changeVersion: function () {
          var current = currentCommanderForDraft(d);
          openGuestCardVersionPicker(current, draftMetaForCard(d, current), draftBoardForCard(d, current) || 'main');
        },
        moveBoards: function () {
          var current = currentCommanderForDraft(loadDraft() || d);
          var source = draftBoardForCard(loadDraft() || d, current);
          return ['main', 'side', 'maybe'].filter(function (board) {
            return board !== source;
          });
        },
        moveToBoard: function (targetBoard) {
          var dd = loadDraft() || d;
          var current = currentCommanderForDraft(dd);
          var source = draftBoardForCard(dd, current);
          if (source && source !== targetBoard) {
            moveGuestCardQuantityBetweenBoards(source, targetBoard, current, 1);
          } else if (!source) {
            adjustGuestBoardCardQuantity(targetBoard, current, 1);
          }
        },
        candidates: function () {
          return commanderCandidateNamesFromDraft(loadDraft() || d);
        },
        changeCommander: function (cardName) {
          setGuestCommander(cardName);
        }
      });
      syncExampleHandForMainboard(false);
      window.mtDeckGuestUpdateOverview = function (fields) {
        var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
        if (fields && Object.prototype.hasOwnProperty.call(fields, 'description')) {
          dd.description = String(fields.description || '').trim();
        }
        if (fields && Object.prototype.hasOwnProperty.call(fields, 'tags')) {
          dd.tags = String(fields.tags || '').trim();
        }
        if (fields && Object.prototype.hasOwnProperty.call(fields, 'format')) {
          dd.format = normalizeGuestFormat(fields.format);
        }
        saveDraft(dd);
      };
      window.mtDeckWorkspaceUpdateOverview = window.mtDeckGuestUpdateOverview;
      requestGuestAnalytics(d);
      hydrateGuestCardMeta();
      emitGuestDraftRendered();
    }

    function initSavedDeckWorkspace() {
	      function normalizeSavedState(d) {
	        if (!d || typeof d !== 'object') d = {};
	        if (!d.cards || typeof d.cards !== 'object') d.cards = {};
	        if (!d.sideboardCards || typeof d.sideboardCards !== 'object') d.sideboardCards = {};
	        if (!d.maybeCards || typeof d.maybeCards !== 'object') d.maybeCards = {};
	        if (!d.cardMeta || typeof d.cardMeta !== 'object') d.cardMeta = {};
	        if (!d.boardCardMeta || typeof d.boardCardMeta !== 'object') d.boardCardMeta = {};
	        ['main', 'side', 'maybe'].forEach(function (board) {
	          if (!d.boardCardMeta[board] || typeof d.boardCardMeta[board] !== 'object') {
	            d.boardCardMeta[board] = {};
	          }
	        });
	        if (!Array.isArray(d.commanderCandidates)) d.commanderCandidates = [];
	        if (typeof d.tags !== 'string') d.tags = '';
	        d.format = normalizeGuestFormat(d.format || deckFormat);
        d.id = Number(d.id || savedDeckID || 0);
        return d;
      }

      var savedDraft = normalizeSavedState(savedDeckSeed);
      if (!savedDraft || !savedDraft.id) {
        drawExampleHand();
        window.mtDeckRenderExtrasFromDOM();
        return;
      }

      var savedOverviewTimer = null;
      var savedOverviewPayload = null;
      var savedCommanderDetailCache = {};
      var deckMenuReturnFocus = null;

      function setDeckMenuOpen(open) {
        if (!deckMenuOverlay) return;
        deckMenuOverlay.classList.toggle('hidden', !open);
        deckMenuOverlay.classList.toggle('flex', !!open);
        deckMenuOverlay.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (deckMenuOpenBtn) deckMenuOpenBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('mt-deck-dialog-open', !!open);
        if (open) {
          deckMenuReturnFocus = document.activeElement;
          window.setTimeout(function () {
            var first = deckMenuOverlay.querySelector('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])');
            var panel = deckMenuOverlay.querySelector('.mt-deck-editor__menu');
            if (first) first.focus();
            else if (panel) panel.focus();
          }, 0);
        } else if (deckMenuReturnFocus && typeof deckMenuReturnFocus.focus === 'function') {
          deckMenuReturnFocus.focus();
          deckMenuReturnFocus = null;
        }
        if (!open && deckMenuStatus) {
          deckMenuStatus.textContent = '';
        }
      }

      function setSavedStatus(message) {
        if (!addStatus) return;
        addStatus.textContent = normalizeName(message);
        if (!addStatus.textContent) return;
        window.setTimeout(function () {
          if (addStatus && addStatus.textContent === message) {
            addStatus.textContent = '';
          }
        }, 1800);
      }

      async function postSavedMutation(url, params) {
        try {
          var res = await fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
            },
            body: params.toString()
          });
          if (!res.ok) {
            var errorText = '';
            try {
              errorText = await res.text();
            } catch (e) {
              errorText = '';
            }
            throw new Error(normalizeName(errorText) || 'Request failed.');
          }
          var next = await res.json();
          savedDraft = normalizeSavedState(next);
          return savedDraft;
        } catch (e) {
          throw e;
        }
      }

      function savedBoardUndoState(d, board, cardName) {
        var normalizedBoard = normalizeDeckBoardMode(board);
        var quantities = draftBoardMap(d, normalizedBoard);
        var quantityKey = draftCardNameKey(quantities, cardName);
        var quantity = Number(quantityKey ? quantities[quantityKey] : 0);
        if (!Number.isFinite(quantity) || quantity < 0) quantity = 0;

        var preferredPrintID = '';
        var boardMeta = d && d.boardCardMeta && typeof d.boardCardMeta === 'object'
          ? d.boardCardMeta[normalizedBoard]
          : null;
        if (boardMeta && typeof boardMeta === 'object') {
          var metaKey = draftCardNameKey(boardMeta, cardName);
          var rawMeta = metaKey ? boardMeta[metaKey] : null;
          if (rawMeta && typeof rawMeta === 'object') {
            preferredPrintID = normalizeName(rawMeta.preferredPrintID || '');
          }
        }

        return {
          board: normalizedBoard,
          quantity: quantity,
          preferred_print_id: quantity > 0 ? preferredPrintID : ''
        };
      }

      function showSavedDeckUndo(message, cardID, cardName, beforeStates, afterStates) {
        var oracleID = normalizeName(cardID);
        if (!oracleID || !Array.isArray(beforeStates) || !Array.isArray(afterStates)) return;
        showDeckUndo(message, async function () {
          var params = new URLSearchParams();
          params.set('action', 'undo_card_change');
          params.set('card_id', oracleID);
          params.set('expected_states', JSON.stringify(afterStates));
          params.set('restore_states', JSON.stringify(beforeStates));
          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
          commanderName = currentSavedCommander(next);
          renderSaved(next);
          return true;
        });
      }

      function currentSavedCommander(d) {
        if (d && typeof d === 'object') {
          return normalizeName(d.commanderName || '');
        }
        return normalizeName(commanderName);
      }

      function buildDecklistText(d) {
        var deckName = normalizeName((d && d.name) || 'Untitled Deck');
        var format = normalizeGuestFormat(d && d.format);
        var lines = ['Name: ' + deckName, 'Format: ' + format, ''];
        var rows = deckExportRows(d);

        function textIdentity(row) {
          var meta = row.meta || {};
          var value = row.name;
          var setCode = normalizeName(meta.setCode || '');
          var collectorNumber = normalizeName(meta.collectorNumber || '');
          var printID = normalizeName(meta.printID || meta.preferredPrintID || '');
          if (setCode && collectorNumber) value += ' (' + setCode.toUpperCase() + ') ' + collectorNumber;
          if (printID) value += ' {scryfall:' + printID + '}';
          return String(row.qty) + ' ' + value;
        }

        ['Commander', 'Mainboard', 'Sideboard', 'Maybeboard'].forEach(function (board) {
          var boardRows = rows.filter(function (row) { return row.board === board; });
          if (!boardRows.length && board !== 'Mainboard' && !(board === 'Commander' && formatUsesCommander(format))) return;
          if (lines[lines.length - 1] !== '') lines.push('');
          lines.push(board + ':');
          boardRows.forEach(function (row) { lines.push(textIdentity(row)); });
        });

        return lines.join('\n').trim() + '\n';
      }

      function deckExportRows(d) {
        var rows = [];
        var commanderForExport = currentSavedCommander(d);
        if (d && formatUsesCommander(d.format) && commanderForExport) {
          var commanderMeta = Object.assign({}, draftMetaForCard(d, commanderForExport) || {});
          var commanderExportPrintID = currentCommanderPrintForDraft(d);
          if (commanderExportPrintID) {
            commanderMeta.preferredPrintID = commanderExportPrintID;
            commanderMeta.printID = commanderExportPrintID;
            // The exact ID is authoritative. Avoid pairing it with stale
            // default-print set metadata if the commander version changed.
            commanderMeta.setCode = '';
            commanderMeta.collectorNumber = '';
          }
          rows.push({
            board: 'Commander',
            qty: 1,
            name: commanderForExport,
            meta: commanderMeta
          });
        }

        [
          { board: 'Mainboard', cards: (d && d.cards) || {}, key: 'main' },
          { board: 'Sideboard', cards: (d && d.sideboardCards) || {}, key: 'side' },
          { board: 'Maybeboard', cards: (d && d.maybeCards) || {}, key: 'maybe' }
        ].forEach(function (section) {
          var entries = Object.entries(section.cards || {});
          entries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
          entries.forEach(function (pair) {
            var cardName = normalizeName(pair[0]);
            var qty = Number(pair[1] || 0);
            if (!cardName || !Number.isFinite(qty) || qty <= 0) return;
            if (section.key === 'main' && commanderForExport && cardName.toLowerCase() === commanderForExport.toLowerCase()) {
              qty -= 1;
            }
            if (qty <= 0) return;
            rows.push({
              board: section.board,
              qty: qty,
              name: cardName,
              meta: draftMetaForBoardCard(d, section.key, cardName) || draftMetaForCard(d, cardName) || {}
            });
          });
        });

        return rows;
      }

      function csvCell(value) {
        var text = String(value == null ? '' : value);
        if (/[",\r\n]/.test(text)) {
          return '"' + text.replace(/"/g, '""') + '"';
        }
        return text;
      }

      function buildDecklistCSV(d) {
        var rows = deckExportRows(d);
        var deckName = normalizeName((d && d.name) || 'Untitled Deck');
        var format = normalizeGuestFormat(d && d.format);
        var lines = [['Board', 'Quantity', 'Name', 'Set', 'Collector Number', 'Print ID', 'Deck Name', 'Format'].map(csvCell).join(',')];
        rows.forEach(function (row) {
          var meta = row.meta || {};
          lines.push([
            row.board,
            row.qty,
            row.name,
            normalizeName(meta.setCode || ''),
            normalizeName(meta.collectorNumber || ''),
            normalizeName(meta.printID || meta.preferredPrintID || ''),
            deckName,
            format
          ].map(csvCell).join(','));
        });
        return lines.join('\n');
      }

      function deckExportBaseName(d) {
        var base = normalizeName((d && d.name) || 'deck').toLowerCase();
        base = base.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        return base || 'deck';
      }

      function downloadDeckFile(filename, content, mimeType) {
        var blob = new Blob([content], { type: mimeType });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.setTimeout(function () {
          URL.revokeObjectURL(url);
        }, 1000);
      }

      function exportSavedDeck(format) {
        var kind = normalizeName(format).toLowerCase();
        if (!savedDraft) return;

        if (kind === 'csv') {
          var csv = buildDecklistCSV(savedDraft);
          downloadDeckFile(deckExportBaseName(savedDraft) + '.csv', csv, 'text/csv;charset=utf-8');
          setDeckMenuStatus('CSV exported.');
          return;
        }

        var text = buildDecklistText(savedDraft);
        if (!text) {
          setDeckMenuStatus('Nothing to export yet.');
          return;
        }
        downloadDeckFile(deckExportBaseName(savedDraft) + '.txt', text, 'text/plain;charset=utf-8');
        setDeckMenuStatus('TXT exported.');
      }

      async function saveSavedDeckName() {
        if (!deckMenuNameInput) return;
        var nextName = normalizeName(deckMenuNameInput.value);
        if (!nextName) {
          setDeckMenuStatus('Deck name cannot be empty.');
          deckMenuNameInput.focus();
          return;
        }
        if (savedDraft && nextName === normalizeName(savedDraft.name || '')) {
          if (guestOverviewStatus) guestOverviewStatus.textContent = 'Changes save automatically.';
          return;
        }

        var params = new URLSearchParams();
        params.set('id', String(savedDraft.id));
        params.set('name', nextName);

        try {
          var next = await postSavedMutation('/decks/settings', params);
          renderSaved(next);
          setDeckMenuStatus('Deck name updated.');
          if (guestOverviewStatus) guestOverviewStatus.textContent = 'Deck name saved.';
        } catch (e) {
          setDeckMenuStatus(e && e.message ? e.message : 'Could not update deck name.');
          if (guestOverviewStatus) guestOverviewStatus.textContent = 'Could not save the deck name.';
        }
      }

      async function copySavedDecklist() {
        var text = buildDecklistText(savedDraft);
        if (!text) {
          setDeckMenuStatus('Nothing to copy yet.');
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          setDeckMenuStatus('Decklist copied.');
        } catch (e) {
          try {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            setDeckMenuStatus('Decklist copied.');
          } catch (e2) {
            setDeckMenuStatus('Could not copy decklist.');
          }
        }
      }

      async function syncSavedCommanderOverview(d) {
        if (!window.mtDeckSetCommanderOverview) return;

        var current = currentSavedCommander(d);
        if (!current) {
          window.mtDeckSetCommanderOverview(null);
          return;
        }

        var meta = draftMetaForCard(d, current);
        if (meta) {
          window.mtDeckSetCommanderOverview({
            name: current,
            mana_cost: meta.manaCost || '',
            type_line: meta.typeLine || '',
            oracle_text: meta.oracleText || '',
            image_uri: meta.imageURI || '',
            faces: Array.isArray(meta.faces) ? meta.faces : []
          });
          if (normalizeName(d && d.commanderPrintID ? d.commanderPrintID : '')) {
            return;
          }
        }

        var cacheKey = current.toLowerCase();
        if (savedCommanderDetailCache[cacheKey]) {
          window.mtDeckSetCommanderOverview(savedCommanderDetailCache[cacheKey]);
          return;
        }

        var resolved = await resolveCardByName(current, true);
        if (!resolved || !resolved.name) return;
        if (currentSavedCommander(savedDraft).toLowerCase() !== cacheKey) return;
        savedCommanderDetailCache[cacheKey] = resolved;
        window.mtDeckSetCommanderOverview(resolved);
      }

      async function setSavedCommander(cardName) {
        var picked = normalizeName(cardName);
        if (!picked) return;
        try {
          var params = new URLSearchParams();
          params.set('id', String(savedDraft.id));
          params.set('commander_name', picked);
          var next = await postSavedMutation('/decks/commander', params);
          commanderName = currentSavedCommander(next);
          renderSaved(next);
          setSavedStatus('Commander set to ' + commanderName + '.');
        } catch (e) {
          setSavedStatus(e && e.message ? e.message : 'Could not update commander.');
        }
      }

      async function savedCardIDForAction(cardMeta, cardName) {
        var currentID = normalizeName(cardMeta && cardMeta.cardID ? cardMeta.cardID : '');
        if (currentID) return currentID;
        var resolved = await resolveCardByName(cardName, true);
        if (!resolved || !resolved.oracle_id) {
          resolved = await resolveCardByName(cardName, false);
        }
        return normalizeName(resolved && resolved.oracle_id ? resolved.oracle_id : '');
      }

      async function adjustSavedCardQuantity(cardMeta, delta, board, cardName) {
        if (!deckUndoBusy) clearDeckUndo();
        var displayName = normalizeName(cardName || (cardMeta && cardMeta.name) || '');
        var actionCardID = await savedCardIDForAction(cardMeta, cardName || (cardMeta && cardMeta.name) || '');
        if (!actionCardID) return;
        var targetBoard = normalizeDeckBoardMode(board || 'main');
        var beforeState = savedBoardUndoState(savedDraft, targetBoard, displayName);
        try {
          var params = new URLSearchParams();
          params.set(boardCardIDParam(targetBoard), actionCardID);
          if (Number(delta || 0) > 0) {
            params.set('action', boardIncrementAction(targetBoard));
          }
          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
          commanderName = currentSavedCommander(next);
          renderSaved(next);
          var afterState = savedBoardUndoState(next, targetBoard, displayName);
          if (Number(delta || 0) < 0 && afterState.quantity < beforeState.quantity) {
            showSavedDeckUndo(
              'Removed ' + displayName + '.',
              actionCardID,
              displayName,
              [beforeState],
              [afterState]
            );
          }
        } catch (e) {
          setSavedStatus(e && e.message ? e.message : 'Could not update card.');
        }
      }

      async function setSavedCardQuantity(cardMeta, quantity, board, cardName) {
        if (!deckUndoBusy) clearDeckUndo();
        var displayName = normalizeName(cardName || (cardMeta && cardMeta.name) || '');
        var actionCardID = await savedCardIDForAction(cardMeta, cardName || (cardMeta && cardMeta.name) || '');
        if (!actionCardID) return;
        var targetBoard = normalizeDeckBoardMode(board || 'main');
        var nextQty = Math.floor(Number(quantity || 0));
        if (!Number.isFinite(nextQty) || nextQty < 0) return;
        var beforeState = savedBoardUndoState(savedDraft, targetBoard, displayName);
        try {
          var params = new URLSearchParams();
          params.set(boardCardIDParam(targetBoard), actionCardID);
          params.set('action', 'set_qty');
          params.set('quantity', String(nextQty));
          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
          commanderName = currentSavedCommander(next);
          renderSaved(next);
          var afterState = savedBoardUndoState(next, targetBoard, displayName);
          if (afterState.quantity < beforeState.quantity) {
            var removed = beforeState.quantity - afterState.quantity;
            showSavedDeckUndo(
              'Removed ' + String(removed) + (removed === 1 ? ' copy of ' : ' copies of ') + displayName + '.',
              actionCardID,
              displayName,
              [beforeState],
              [afterState]
            );
          }
        } catch (e) {
          setSavedStatus(e && e.message ? e.message : 'Could not update card.');
        }
      }

	      async function moveSavedCardBetweenBoards(cardMeta, fromBoard, toBoard, cardName, quantity) {
        if (!deckUndoBusy) clearDeckUndo();
        var displayName = normalizeName(cardName || (cardMeta && cardMeta.name) || '');
	        var actionCardID = await savedCardIDForAction(cardMeta, cardName || (cardMeta && cardMeta.name) || '');
	        if (!actionCardID) return;
        var sourceBoard = normalizeDeckBoardMode(fromBoard || 'main');
        var targetBoard = normalizeDeckBoardMode(toBoard || 'main');
        if (sourceBoard === targetBoard) return;
        var beforeStates = [
          savedBoardUndoState(savedDraft, sourceBoard, displayName),
          savedBoardUndoState(savedDraft, targetBoard, displayName)
        ];
        try {
          var params = new URLSearchParams();
          params.set(boardCardIDParam(sourceBoard), actionCardID);
          var moveQty = Math.floor(Number(quantity || 0));
          if (Number.isFinite(moveQty) && moveQty > 1) {
            params.set('action', 'set_board');
            params.set('to_board', targetBoard);
            params.set('quantity', String(moveQty));
          } else {
            params.set('action', boardMoveAction(sourceBoard, targetBoard));
          }
          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
          commanderName = currentSavedCommander(next);
          renderSaved(next);
          var afterStates = [
            savedBoardUndoState(next, sourceBoard, displayName),
            savedBoardUndoState(next, targetBoard, displayName)
          ];
          var moved = Math.max(0, beforeStates[0].quantity - afterStates[0].quantity);
          if (moved > 0) {
            showSavedDeckUndo(
              'Moved ' + (moved > 1 ? String(moved) + ' copies of ' : '') + displayName + ' to ' + deckBoardLabel(targetBoard) + '.',
              actionCardID,
              displayName,
              beforeStates,
              afterStates
            );
          }
        } catch (e) {
	          setSavedStatus(e && e.message ? e.message : 'Could not move card.');
	        }
	      }

	      async function setSavedCardVersion(cardMeta, board, cardName, version) {
        if (!deckUndoBusy) clearDeckUndo();
	        var meta = normalizeDraftCardMeta(cardMeta) || {};
	        var actionCardID = await savedCardIDForAction(meta, cardName || meta.name || '');
	        var printID = normalizeName(version && (version.scryfall_id || version.scryfallID || version.printID || version.print_id) || '');
	        if (!actionCardID || !printID) return;
	        var targetBoard = normalizeDeckBoardMode(board || 'main');
	        try {
	          var params = new URLSearchParams();
	          params.set(boardCardIDParam(targetBoard), actionCardID);
	          params.set('action', 'set_print');
	          params.set('print_id', printID);
	          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
	          commanderName = currentSavedCommander(next);
	          renderSaved(next);
	          setSavedStatus('Version updated.');
	        } catch (e) {
	          setSavedStatus(e && e.message ? e.message : 'Could not update version.');
	        }
	      }

	      function openSavedCardVersionPicker(cardName, cardMeta, board) {
	        var targetBoard = normalizeDeckBoardMode(board || deckBoardMode || 'main');
	        var meta = normalizeDraftCardMeta(cardMeta) || {};
	        openWorkbenchCardView(cardName, meta, {
	          detailMode: 'versions',
	          preferredPrintID: meta.preferredPrintID || meta.printID || '',
	          printID: meta.printID || meta.preferredPrintID || '',
	          versionContext: {
	            onSelect: function (version) {
	              setSavedCardVersion(meta, targetBoard, cardName, version);
	            }
	          }
	        });
	      }

	      async function applySavedCommanderVersion(cardName, cardMeta, version) {
	        var current = normalizeName(cardName);
	        if (!current) return;
	        var meta = normalizeDraftCardMeta(cardMeta) || draftMetaForCard(savedDraft, current) || {};
	        var actionCardID = await savedCardIDForAction(meta, current);
	        var printID = normalizeName(version && (version.scryfall_id || version.scryfallID || version.printID || version.print_id) || '');
	        if (!actionCardID || !printID) return;
	        try {
	          var params = new URLSearchParams();
	          params.set('card_id', actionCardID);
	          params.set('action', 'set_commander_print');
	          params.set('print_id', printID);
	          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
	          commanderName = currentSavedCommander(next);
	          renderSaved(next);
	          setSavedStatus('Commander version updated.');
	        } catch (e) {
	          setSavedStatus(e && e.message ? e.message : 'Could not update commander version.');
	        }
	      }

	      function openSavedCommanderVersionPicker(cardName, cardMeta) {
	        var current = normalizeName(cardName);
	        var meta = normalizeDraftCardMeta(cardMeta) || {};
	        openWorkbenchCardView(current, meta, {
	          detailMode: 'versions',
	          preferredPrintID: meta.preferredPrintID || meta.printID || '',
	          printID: meta.printID || meta.preferredPrintID || '',
	          versionContext: {
	            onSelect: function (version) {
	              applySavedCommanderVersion(current, meta, version);
	            }
	          }
	        });
	      }

	      async function submitSavedAddCard(raw, zone) {
	        var value = normalizeName(raw);
        if (!value) return;
        if (!deckUndoBusy) clearDeckUndo();
        var targetZone = normalizeDeckBoardMode(zone || deckBoardMode || 'main');
        try {
          var params = new URLSearchParams();
          params.set('card_name', value);
          params.set('zone', targetZone);
          var next = await postSavedMutation('/decks/' + savedDraft.id, params);
          commanderName = currentSavedCommander(next);
          renderSaved(next);
          if (addInput) {
            addInput.value = '';
            addInput.focus();
          }
          setSavedStatus(targetZone === 'main' ? ('Added ' + value + '.') : ('Added ' + value + ' to ' + (targetZone === 'side' ? 'sideboard' : 'maybeboard') + '.'));
        } catch (e) {
          setSavedStatus(e && e.message ? e.message : 'Could not add card.');
        }
      }

      async function runSavedQuickBuild() {
        if (quickBuildBusy) return;
        if (!quickBuildEligibleState(savedDraft)) {
          setSavedStatus('Quick Build only works on an empty commander deck with your commander selected.');
          return;
        }

        quickBuildBusy = true;
        setQuickBuildSummary('');
        renderQuickBuildState(savedDraft);
        setSavedStatus('Building starter list…');

        try {
          var requestSeed = nextQuickBuildSeed();
          var out = await postQuickBuild({
            deck_id: savedDraft.id,
            commander_name: currentSavedCommander(savedDraft),
            format: savedDraft.format || 'Commander',
            seed: requestSeed
          });
          var next = normalizeSavedState(out && out.workspace ? out.workspace : null);
          commanderName = currentSavedCommander(next);
          quickBuildLastSeed = Number((out && out.summary && out.summary.seed) || requestSeed || 0);
          if (quickBuildBtn) quickBuildBtn.dataset.quickBuildSeed = quickBuildLastSeed ? String(quickBuildLastSeed) : '';
          setQuickBuildSummary(out && out.summary && out.summary.explanation ? out.summary.explanation : '');
          renderSaved(next);
          setSavedStatus('Starter shell added. This is a playtest-ready first draft.');
        } catch (e) {
          setSavedStatus(e && e.message ? e.message : 'Could not build a starter shell.');
        } finally {
          quickBuildBusy = false;
          renderQuickBuildState(savedDraft);
        }
      }

      function submitSavedOverviewNow() {
        if (!savedOverviewPayload) return;
        var fields = savedOverviewPayload;
        savedOverviewPayload = null;

        var params = new URLSearchParams();
        params.set('action', 'save_overview');
        params.set('format', normalizeGuestFormat(fields.format || savedDraft.format || 'Sandbox'));
        params.set('tags', String(fields.tags || ''));
        params.set('description', String(fields.description || ''));

        postSavedMutation('/decks/' + savedDraft.id, params).then(function (next) {
          commanderName = currentSavedCommander(next);
          renderSaved(next);
        }).catch(function () {
          // keep the current UI state; the next successful save will resync it
        });
      }

      window.mtDeckWorkspaceUpdateOverview = function (fields) {
        if (!fields || typeof fields !== 'object') return;
        savedDraft.tags = String(fields.tags || '');
        savedDraft.description = String(fields.description || '');
        savedDraft.format = normalizeGuestFormat(fields.format || savedDraft.format || 'Sandbox');
        savedOverviewPayload = {
          tags: savedDraft.tags,
          description: savedDraft.description,
          format: savedDraft.format
        };
        if (savedOverviewTimer) window.clearTimeout(savedOverviewTimer);
        savedOverviewTimer = window.setTimeout(submitSavedOverviewNow, 180);
      };

      function renderSaved(d) {
        d = normalizeSavedState(d);
        savedDraft = d;
        commanderName = currentSavedCommander(d);
        allowsCommanderCardAction = formatUsesCommander(d.format);
        if (window.mtDeckSetOverviewFormat) window.mtDeckSetOverviewFormat(allowsCommanderCardAction);
        if (window.mtDeckSetOverviewTags) window.mtDeckSetOverviewTags(d.tags || '');
        if (guestFormatField) guestFormatField.value = d.format;

        var entries = Object.entries(d.cards || {});
        entries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        var visibleRows = 0;
        var totalCards = 0;
        var deckRows = [];

        function createSavedCardActionMenu(cardName, cardMeta, board) {
          var currentBoard = normalizeDeckBoardMode(board || deckBoardMode);
          var items = [
            {
              label: 'View card',
              onClick: function () {
                openWorkbenchCardView(cardName, cardMeta);
              }
            },
            {
              label: 'Change Version',
              onClick: function () {
                openSavedCardVersionPicker(cardName, cardMeta, currentBoard);
              }
            },
            {
              label: 'Add Copy',
              onClick: function () {
                adjustSavedCardQuantity(cardMeta, 1, currentBoard, cardName);
              }
            },
            {
              label: 'Remove Copy',
              onClick: function () {
                adjustSavedCardQuantity(cardMeta, -1, currentBoard, cardName);
              }
            }
          ].concat(deckMoveBoardActionItems(currentBoard, function (targetBoard) {
              moveSavedCardBetweenBoards(cardMeta, currentBoard, targetBoard, cardName);
          }));

          appendCommanderCardActionItems(items, cardName, cardMeta, currentBoard, function () {
            setSavedCommander(cardName);
          });
          return createSimpleDeckActionMenu(items, '', 'Card actions for ' + cardName);
        }

        for (var i = 0; i < entries.length; i++) {
          var cardName = normalizeName(entries[i][0]);
          var qty = Number(entries[i][1] || 0);
          if (!cardName || !Number.isFinite(qty) || qty <= 0) continue;
          if (commanderName && cardName.toLowerCase() === commanderName.toLowerCase()) {
            qty -= 1;
          }
          if (qty <= 0) continue;

	          visibleRows += 1;
	          totalCards += qty;

	          var cardMeta = draftMetaForBoardCard(d, 'main', cardName) || {};
	          deckRows.push({
            cardName: cardName,
            qty: qty,
            cardMeta: cardMeta
          });
        }

        var sideEntries = Object.entries(d.sideboardCards || {});
        sideEntries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        var sideboardRows = [];
        var sideboardCardsTotal = 0;
        for (var s = 0; s < sideEntries.length; s++) {
          var sideCardName = normalizeName(sideEntries[s][0]);
          var sideQty = Number(sideEntries[s][1] || 0);
	          if (!sideCardName || !Number.isFinite(sideQty) || sideQty <= 0) continue;
	          sideboardCardsTotal += sideQty;
	          sideboardRows.push({
	            cardName: sideCardName,
	            qty: sideQty,
	            cardMeta: draftMetaForBoardCard(d, 'side', sideCardName) || {}
	          });
        }

        var maybeEntries = Object.entries(d.maybeCards || {});
        maybeEntries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        var maybeDeckRows = [];
        var maybeCardsTotal = 0;
        for (var m = 0; m < maybeEntries.length; m++) {
          var maybeCardName = normalizeName(maybeEntries[m][0]);
          var maybeQty = Number(maybeEntries[m][1] || 0);
	          if (!maybeCardName || !Number.isFinite(maybeQty) || maybeQty <= 0) continue;
	          maybeCardsTotal += maybeQty;
	          maybeDeckRows.push({
	            cardName: maybeCardName,
	            qty: maybeQty,
	            cardMeta: draftMetaForBoardCard(d, 'maybe', maybeCardName) || {}
	          });
        }

        var activeRows = deckRows;
        if (deckBoardMode === 'side') activeRows = sideboardRows;
        if (deckBoardMode === 'maybe') activeRows = maybeDeckRows;
        var visibleActiveRows = filterDeckRows(activeRows);
        syncDeckDisplayOptions(activeRows);
        renderDeckSections(visibleActiveRows, function (cardName, cardMeta) {
          return createSavedCardActionMenu(cardName, cardMeta, deckBoardMode);
        }, function (cardName, cardMeta, delta) {
          adjustSavedCardQuantity(cardMeta, delta, deckBoardMode, cardName);
        }, function (cardName, cardMeta, targetBoard, quantity) {
          moveSavedCardBetweenBoards(cardMeta, deckBoardMode, targetBoard, cardName, quantity || 1);
        }, function (cardName, cardMeta, quantity) {
          setSavedCardQuantity(cardMeta, quantity, deckBoardMode, cardName);
        });

        if (emptyEl) {
          emptyEl.textContent = emptyDeckBoardMessage(activeRows);
          emptyEl.classList.toggle('hidden', visibleActiveRows.length !== 0);
        }
        if (deckCountLabel) deckCountLabel.textContent = String(totalCards);
        if (sideboardCountLabel) sideboardCountLabel.textContent = String(sideboardCardsTotal);
        if (maybeCountLabel) maybeCountLabel.textContent = String(maybeCardsTotal);
        syncDeckBoardTabs();
        if (guestAnalyticsStatus) guestAnalyticsStatus.textContent = '';
        if (d.analytics) renderAnalytics(d.analytics);
        if (savedDeckNameEl) savedDeckNameEl.textContent = d.name || 'Deck';
        if (deckEditorHeading) deckEditorHeading.textContent = 'Edit ' + (d.name || 'Deck');
        if (deckMenuTitle) deckMenuTitle.textContent = d.name || 'Deck';
        if (deckMenuNameInput) deckMenuNameInput.value = d.name || '';
        if (deckMenuVisibilityBtn) {
          deckMenuVisibilityBtn.textContent = d.isPublic ? 'Set Private' : 'Set Public';
        }
        renderQuickBuildState(d);

        window.mtDeckCurrentSavedDraft = d;
        window.mtDeckOpeningHandActions = {
          view: function (cardName, cardMeta) {
            openWorkbenchCardView(cardName, cardMeta);
          },
          changeVersion: function (cardName, cardMeta) {
            openSavedCardVersionPicker(cardName, cardMeta, 'main');
          },
          moveToBoard: function (cardName, cardMeta, targetBoard) {
            moveSavedCardBetweenBoards(cardMeta, 'main', targetBoard, cardName, 1);
          },
          addCopy: function (cardName, cardMeta) {
            adjustSavedCardQuantity(cardMeta, 1, 'main', cardName);
          },
          removeCopy: function (cardName, cardMeta) {
            adjustSavedCardQuantity(cardMeta, -1, 'main', cardName);
          }
        };
        renderCommanderActionMenu({
          currentName: function () {
            return currentSavedCommander(savedDraft);
          },
          view: function () {
            var current = currentSavedCommander(savedDraft);
            openWorkbenchCardView(current, draftMetaForCard(savedDraft, current));
          },
          changeVersion: function () {
            var current = currentSavedCommander(savedDraft);
            openSavedCommanderVersionPicker(current, draftMetaForCard(savedDraft, current));
          },
          moveBoards: function () {
            var current = currentSavedCommander(savedDraft);
            var source = draftBoardForCard(savedDraft, current);
            return ['main', 'side', 'maybe'].filter(function (board) {
              return board !== source;
            });
          },
          moveToBoard: function (targetBoard) {
            var current = currentSavedCommander(savedDraft);
            var meta = draftMetaForCard(savedDraft, current) || {};
            var source = draftBoardForCard(savedDraft, current);
            if (source && source !== targetBoard) {
              moveSavedCardBetweenBoards(meta, source, targetBoard, current, 1);
            } else if (!source) {
              adjustSavedCardQuantity(meta, 1, targetBoard, current);
            }
          },
          candidates: function () {
            return commanderCandidateNamesFromDraft(savedDraft);
          },
          changeCommander: function (cardName) {
            setSavedCommander(cardName);
          }
        });
        syncExampleHandForMainboard(false);
        syncSavedCommanderOverview(d);
      }

      if (addForm && addInput) {
        addForm.addEventListener('submit', function (event) {
          event.preventDefault();
          if (addStatus) addStatus.textContent = '';
          var raw = normalizeName(addInput.value);
          if (!raw) return;
          var targetZone = addZoneField ? normalizeDeckBoardMode(addZoneField.value) : deckBoardMode;
          if (event && event.submitter) {
            targetZone = normalizeDeckBoardMode(event.submitter.getAttribute('data-add-zone') || event.submitter.getAttribute('value') || event.submitter.value || targetZone);
          }
          setDeckAddZone(targetZone);
          submitSavedAddCard(raw, targetZone);
        });
      }

      if (deckMenuOpenBtn) {
        deckMenuOpenBtn.addEventListener('click', function () {
          setDeckMenuOpen(true);
        });
      }
      if (deckMenuCloseBtn) {
        deckMenuCloseBtn.addEventListener('click', function () {
          setDeckMenuOpen(false);
        });
      }
      if (deckMenuOverlay) {
        deckMenuOverlay.addEventListener('click', function (event) {
          if (event.target === deckMenuOverlay) {
            setDeckMenuOpen(false);
          }
        });
        deckMenuOverlay.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            event.preventDefault();
            setDeckMenuOpen(false);
            return;
          }
          if (event.key !== 'Tab') return;

          var focusable = Array.prototype.slice.call(deckMenuOverlay.querySelectorAll(
            'button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )).filter(function (node) {
            return !node.hidden && node.offsetParent !== null;
          });
          if (!focusable.length) {
            event.preventDefault();
            return;
          }
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });
      }
      if (deckMenuCopyBtn) {
        deckMenuCopyBtn.addEventListener('click', function () {
          copySavedDecklist();
        });
      }
      if (deckMenuExportTxtBtn) {
        deckMenuExportTxtBtn.addEventListener('click', function () {
          exportSavedDeck('txt');
        });
      }
      if (deckMenuExportCsvBtn) {
        deckMenuExportCsvBtn.addEventListener('click', function () {
          exportSavedDeck('csv');
        });
      }
      if (deckMenuNameInput) {
        deckMenuNameInput.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            deckMenuNameInput.blur();
          }
        });
        deckMenuNameInput.addEventListener('blur', function () {
          saveSavedDeckName();
        });
      }
      if (deckMenuVisibilityBtn) {
        deckMenuVisibilityBtn.addEventListener('click', function () {
          var params = new URLSearchParams();
          params.set('id', String(savedDraft.id));
          params.set('sharing_submitted', '1');
          if (!savedDraft.isPublic) {
            params.set('is_public', '1');
          }
          postSavedMutation('/decks/settings', params).then(function (next) {
            renderSaved(next);
            setDeckMenuStatus(next.isPublic ? 'Deck is now public.' : 'Deck is now private.');
          }).catch(function (e) {
            setDeckMenuStatus(e && e.message ? e.message : 'Could not update visibility.');
          });
        });
      }

      if (deckGroupModeField) {
        deckGroupModeField.addEventListener('change', function () {
          persistDeckGroupMode(deckGroupModeField.value);
          renderSaved(savedDraft);
        });
      }
      if (deckSortModeField) {
        deckSortModeField.addEventListener('change', function () {
          persistDeckSortMode(deckSortModeField.value);
          renderSaved(savedDraft);
        });
      }
      if (deckSortDirectionButton) {
        deckSortDirectionButton.addEventListener('click', function () {
          persistDeckSortDirection(deckSortDirection === 'desc' ? 'asc' : 'desc');
          renderSaved(savedDraft);
        });
      }
      if (deckViewModeField) {
        deckViewModeField.addEventListener('change', function () {
          persistDeckViewMode(deckViewModeField.value);
          renderSaved(savedDraft);
        });
      }
      if (deckFilterField) {
        deckFilterField.addEventListener('input', function () {
          setDeckFilterQuery(deckFilterField.value);
          renderSaved(savedDraft);
        });
        deckFilterField.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          deckFilterField.value = '';
          setDeckFilterQuery('');
          renderSaved(savedDraft);
        });
      }
      for (var sb = 0; sb < deckBoardTabButtons.length; sb++) {
        deckBoardTabButtons[sb].addEventListener('click', function () {
          persistDeckBoardMode(this.getAttribute('data-deck-board-tab') || 'main');
          renderSaved(savedDraft);
        });
      }
      if (quickBuildBtn) {
        quickBuildBtn.addEventListener('click', function () {
          runSavedQuickBuild();
        });
      }

      renderSaved(savedDraft);
    }

    if (!isGuest) {
      initSavedDeckWorkspace();
      return;
    }

    // Init
    var draft = loadDraft();
    if (!draft) {
      draft = guestWorkspaceSeedDraft() || {
        commanderName: commanderName,
        commanderPrintID: commanderPrintID,
        format: normalizeGuestFormat(deckFormat),
        commanderCandidates: [],
        name: guestDeckName,
        description: '',
        tags: '',
        cards: {},
        sideboardCards: {},
        maybeCards: {},
        cardMeta: {}
      };
      saveDraft(draft);
    }

    var normalizedDraftCommander = normalizeName(draft.commanderName || '');
    var normalizedDraftCommanderPrintID = normalizeName(draft.commanderPrintID || '');
    if (!commanderName && normalizedDraftCommander) {
      commanderName = normalizedDraftCommander;
      commanderPrintID = normalizedDraftCommanderPrintID;
    } else if (commanderName && !normalizedDraftCommander) {
      draft.commanderName = commanderName;
      draft.commanderPrintID = commanderPrintID;
      saveDraft(draft);
    } else if (normalizedDraftCommander) {
      commanderPrintID = normalizedDraftCommanderPrintID || commanderPrintID;
    }

    render(draft);

    function commitGuestDeckName() {
      if (!guestDeckNameInput) return;
      var nextName = normalizeDeckName(guestDeckNameInput.value);
      guestDeckName = nextName;
      guestDeckNameInput.value = nextName;
      if (nameEl) nameEl.textContent = nextName;
      if (deckEditorHeading) deckEditorHeading.textContent = 'Edit ' + nextName;

      var currentDraft = loadDraft() || draft;
      guestDeckName = nextName;
      currentDraft.name = nextName;
      saveDraft(currentDraft);
      draft = currentDraft;
      if (guestOverviewStatus) guestOverviewStatus.textContent = '';
    }

    if (guestDeckNameInput) {
      guestDeckNameInput.addEventListener('input', function () {
        if (nameEl) nameEl.textContent = normalizeName(guestDeckNameInput.value) || normalizeDeckName('');
      });
      guestDeckNameInput.addEventListener('blur', commitGuestDeckName);
      guestDeckNameInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          guestDeckNameInput.blur();
        }
      });
    }

    if (deckGroupModeField) {
      deckGroupModeField.addEventListener('change', function () {
        persistDeckGroupMode(deckGroupModeField.value);
        render(loadDraft() || draft);
      });
    }
    if (deckSortModeField) {
      deckSortModeField.addEventListener('change', function () {
        persistDeckSortMode(deckSortModeField.value);
        render(loadDraft() || draft);
      });
    }
    if (deckSortDirectionButton) {
      deckSortDirectionButton.addEventListener('click', function () {
        persistDeckSortDirection(deckSortDirection === 'desc' ? 'asc' : 'desc');
        render(loadDraft() || draft);
      });
    }
    if (deckViewModeField) {
      deckViewModeField.addEventListener('change', function () {
        persistDeckViewMode(deckViewModeField.value);
        render(loadDraft() || draft);
      });
    }
    if (deckFilterField) {
      deckFilterField.addEventListener('input', function () {
        setDeckFilterQuery(deckFilterField.value);
        render(loadDraft() || draft);
      });
      deckFilterField.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        deckFilterField.value = '';
        setDeckFilterQuery('');
        render(loadDraft() || draft);
      });
    }
    for (var gb = 0; gb < deckBoardTabButtons.length; gb++) {
      deckBoardTabButtons[gb].addEventListener('click', function () {
        persistDeckBoardMode(this.getAttribute('data-deck-board-tab') || 'main');
        render(loadDraft() || draft);
      });
    }

    if (guestFormatField) {
      guestFormatField.addEventListener('change', function () {
        setGuestFormat(guestFormatField.value);
      });
    }

    if (addForm && addInput) {
      addForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (addStatus) addStatus.textContent = '';

        var raw = normalizeName(addInput.value);
        if (!raw) return;

        // Basic guardrails
        if (raw.length > 80) {
          if (addStatus) addStatus.textContent = 'That name looks too long. Please paste a real card name.';
          return;
        }

        var zone = addZoneField ? normalizeDeckBoardMode(addZoneField.value) : normalizeDeckBoardMode(pendingGuestAddZone || deckBoardMode);
        if (e && e.submitter) {
          var submitZone = normalizeName(e.submitter.getAttribute('data-add-zone') || e.submitter.getAttribute('value') || e.submitter.value || '');
          zone = normalizeDeckBoardMode(submitZone || zone);
        } else {
          zone = normalizeDeckBoardMode(pendingGuestAddZone);
        }
        setDeckAddZone(zone);

        // Disable while validating
        var submitBtns = addForm.querySelectorAll('button[type="submit"]');
        for (var bi = 0; bi < submitBtns.length; bi++) {
          submitBtns[bi].disabled = true;
        }

        var cardData = await resolveCardByName(raw);

        for (var bj = 0; bj < submitBtns.length; bj++) {
          submitBtns[bj].disabled = false;
        }
        if (!cardData || !cardData.name) {
          if (addStatus) addStatus.textContent = 'No MTG card found close to that name. Check spelling or try Card Search.';
          return;
        }

        var canonical = normalizeName(cardData.name);
        if (!canonical) {
          if (addStatus) addStatus.textContent = 'No MTG card found close to that name. Check spelling or try Card Search.';
          return;
        }

        var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
        dd.cards = dd.cards || {};
        dd.maybeCards = dd.maybeCards || {};
        ensureDraftCardMetaMap(dd);
        clearDeckUndo();

        // Use canonical name so we don't store duplicates with different casing.
        if (zone === 'maybe') {
          dd.maybeCards[canonical] = (dd.maybeCards[canonical] || 0) + 1;
        } else if (zone === 'side') {
          dd.sideboardCards[canonical] = (dd.sideboardCards[canonical] || 0) + 1;
        } else {
          dd.cards[canonical] = (dd.cards[canonical] || 0) + 1;
        }
        var meta = buildDraftCardMeta(cardData);
        if (meta) {
          dd.cardMeta[canonical] = meta;
          if (meta.isCommanderCandidate) {
            if (!Array.isArray(dd.commanderCandidates)) dd.commanderCandidates = [];
            if (dd.commanderCandidates.map(function (x) { return String(x || '').toLowerCase(); }).indexOf(canonical.toLowerCase()) < 0) {
              dd.commanderCandidates.push(canonical);
            }
          }
        }

        saveDraft(dd);
        render(dd);

        addInput.value = '';
        addInput.focus();

        if (addStatus) {
          addStatus.textContent = zone === 'maybe'
            ? ('Added ' + canonical + ' to maybeboard.')
            : (zone === 'side' ? ('Added ' + canonical + ' to sideboard.') : ('Added ' + canonical + '.'));
        }
        setTimeout(function () {
          if (addStatus) addStatus.textContent = '';
        }, 1500);
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async function () {
        var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
        var commanderForCopy = currentCommanderForDraft(dd);
        var lines = [];
        if (formatUsesCommander(dd.format || deckFormat)) {
          lines.push('Commander:');
          if (commanderForCopy) {
            lines.push('1 ' + commanderForCopy);
          }
          lines.push('');
        }
        var entries = Object.entries(dd.cards || {});
        entries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        lines.push('Mainboard:');
        var renderedMainboard = false;
        entries.forEach(function (pair) {
          var cardName = normalizeName(pair[0]);
          var qty = Number(pair[1] || 0);
          if (!cardName || !Number.isFinite(qty) || qty <= 0) return;
          if (commanderForCopy && cardName.toLowerCase() === commanderForCopy.toLowerCase()) {
            qty -= 1;
          }
          if (qty <= 0) return;
          renderedMainboard = true;
          lines.push(qty + ' ' + cardName);
        });
        if (!renderedMainboard) lines.push('');
        var sideboardEntries = Object.entries(dd.sideboardCards || {});
        sideboardEntries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        if (sideboardEntries.length > 0) {
          lines.push('');
          lines.push('Sideboard:');
          sideboardEntries.forEach(function (pair) {
            lines.push(pair[1] + ' ' + pair[0]);
          });
        }
        var maybeEntries = Object.entries(dd.maybeCards || {});
        maybeEntries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        if (maybeEntries.length > 0) {
          lines.push('');
          lines.push('Maybeboard:');
          maybeEntries.forEach(function (pair) {
            lines.push(pair[1] + ' ' + pair[0]);
          });
        }
        var text = lines.join('\n');

        try {
          await navigator.clipboard.writeText(text);
          if (copyStatus) copyStatus.textContent = 'Copied decklist to clipboard.';
        } catch (e) {
          // Fallback
          try {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            if (copyStatus) copyStatus.textContent = 'Copied decklist to clipboard.';
          } catch (e2) {
            if (copyStatus) copyStatus.textContent = 'Could not copy automatically. You can manually select/copy from the card list.';
          }
        }

        setTimeout(function () {
          if (copyStatus) copyStatus.textContent = '';
        }, 2500);
      });
    }

    function draftRowsForBoard(draft, board, quantities) {
      return Object.entries(quantities || {}).map(function (pair) {
        var name = pair[0];
        var qty = pair[1];
        var meta = draftMetaForBoardCard(draft, board, name) || {};
        return {
          name: name,
          oracle_id: normalizeName(meta.cardID || meta.oracleID || ''),
          qty: qty,
          preferred_print_id: normalizeName(meta.preferredPrintID || meta.printID || ''),
          set_code: normalizeName(meta.setCode || ''),
          collector_number: normalizeName(meta.collectorNumber || '')
        };
      }).filter(function (item) {
        return item && item.name && item.qty && item.qty > 0;
      });
    }

    function draftCardMetaForBoard(draft, board, quantities) {
      var out = {};
      Object.keys(quantities || {}).forEach(function (name) {
        var meta = draftMetaForBoardCard(draft, board, name);
        if (meta) out[name] = meta;
      });
      return out;
    }

    function launchGuestPlaytest() {
      var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      guestDeckName = normalizeDeckName(guestDeckNameInput ? guestDeckNameInput.value : guestDeckName);
      dd.name = guestDeckName;
      dd.description = String(descEl ? descEl.value : (dd.description || '')).trim();
      dd.tags = String(guestTagsField ? guestTagsField.value : (dd.tags || '')).trim();
      dd.format = normalizeGuestFormat(guestFormatField ? guestFormatField.value : (dd.format || deckFormat));
      saveDraft(dd);
      var commanderForPlaytest = currentCommanderForDraft(dd);
      var cards = draftRowsForBoard(dd, 'main', dd.cards);
      var maybeCards = draftRowsForBoard(dd, 'maybe', dd.maybeCards);
      var sideboardCards = draftRowsForBoard(dd, 'side', dd.sideboardCards);
      var playtestCardMeta = Object.assign(
        {},
        (dd.cardMeta && typeof dd.cardMeta === 'object') ? dd.cardMeta : {},
        draftCardMetaForBoard(dd, 'main', dd.cards)
      );

      var payload = {
        commander_name: commanderForPlaytest,
        commander_print_id: currentCommanderPrintForDraft(dd),
        format: normalizeGuestFormat(dd.format || deckFormat),
        name: guestDeckName,
        description: dd.description || '',
        tags: dd.tags || '',
        cards: cards,
        sideboard_cards: sideboardCards,
        maybe_cards: maybeCards,
        commander_candidates: Array.isArray(dd.commanderCandidates) ? dd.commanderCandidates : [],
        card_meta: playtestCardMeta,
        board_card_meta: (dd.boardCardMeta && typeof dd.boardCardMeta === 'object') ? dd.boardCardMeta : {},
        sandbox: isSandboxDraft,
      };

      var form = document.createElement('form');
      form.method = 'POST';
      form.action = '/decks/new/playtest';

      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'payload';
      input.value = JSON.stringify(payload);
      form.appendChild(input);

      document.body.appendChild(form);
      form.submit();
    }

    if (isGuest && playtestBtn) {
      playtestBtn.addEventListener('click', launchGuestPlaytest);
    }
    if (quickBuildBtn) {
      quickBuildBtn.addEventListener('click', function () {
        runGuestQuickBuild();
      });
    }

    async function importDraftToAccount() {
      if (saveInProgress) return false;

      var dd = loadDraft();
      if (!dd) {
        if (copyStatus) copyStatus.textContent = 'No draft found to save.';
        return false;
      }

      var commanderForSave = currentCommanderForDraft(dd);
      var cards = draftRowsForBoard(dd, 'main', dd.cards);
      var sideboardCards = draftRowsForBoard(dd, 'side', dd.sideboardCards);
      var maybeCards = draftRowsForBoard(dd, 'maybe', dd.maybeCards);
      if (!commanderForSave && cards.length === 0 && sideboardCards.length === 0 && maybeCards.length === 0) {
        if (copyStatus) copyStatus.textContent = 'Add cards before saving this deck.';
        if (guestOverviewStatus) guestOverviewStatus.textContent = 'Add a card before saving this deck.';
        return false;
      }

      var payload = {
        format: normalizeGuestFormat(dd.format || deckFormat),
        commander_name: commanderForSave,
        commander_print_id: currentCommanderPrintForDraft(dd),
        name: normalizeDeckName(dd.name),
        description: dd.description || '',
        tags: dd.tags || '',
        cards: cards,
        sideboard_cards: sideboardCards,
        maybe_cards: maybeCards,
        card_meta: (dd.cardMeta && typeof dd.cardMeta === 'object') ? dd.cardMeta : {},
      };

      saveInProgress = true;
      try {
        if (copyStatus) copyStatus.textContent = 'Saving…';
        if (guestOverviewStatus) {
          guestOverviewStatus.textContent = 'Saving deck…';
          guestOverviewStatus.setAttribute('data-save-state', 'saving');
        }

        var res = await fetch('/decks/import/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          var failureMessage = 'Could not save deck. Please try again.';
          try {
            var failure = await res.json();
            if (failure && failure.error) failureMessage = failure.error;
            if (failure && Array.isArray(failure.unresolved) && failure.unresolved.length) {
              failureMessage += ' ' + failure.unresolved.slice(0, 2).join(' ');
            }
          } catch (parseError) {
            // Keep the concise fallback message.
          }
          if (copyStatus) copyStatus.textContent = failureMessage;
          if (guestOverviewStatus) {
            guestOverviewStatus.textContent = failureMessage;
            guestOverviewStatus.setAttribute('data-save-state', 'error');
          }
          return false;
        }

        var out = await res.json();
        if (out && out.deck_id) {
          try { localStorage.removeItem(key); } catch (e) {}
          try {
            var cleaned = new URL(window.location.href);
            cleaned.searchParams.delete('save_guest');
            if (window.history && window.history.replaceState) {
              window.history.replaceState({}, '', cleaned.pathname + cleaned.search);
            }
          } catch (cleanupError) {
            // Redirecting to the saved deck does not depend on URL cleanup.
          }
          window.location.href = '/decks/' + out.deck_id;
          return true;
        }

        if (copyStatus) copyStatus.textContent = 'Saved, but did not receive a deck id.';
        if (guestOverviewStatus) {
          guestOverviewStatus.textContent = 'Saved, but the deck could not be opened. Try again.';
          guestOverviewStatus.setAttribute('data-save-state', 'error');
        }
        return false;
      } catch (e) {
        if (copyStatus) copyStatus.textContent = 'Could not save deck. Please try again.';
        if (guestOverviewStatus) {
          guestOverviewStatus.textContent = 'Could not save deck. Please try again.';
          guestOverviewStatus.setAttribute('data-save-state', 'error');
        }
        return false;
      } finally {
        saveInProgress = false;
      }
    }

    function bindSave(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('click', function () {
        importDraftToAccount();
      });
    }

    bindSave('guest-save-to-account');

    if (isSignedIn && shouldAutoSave) {
      if (copyStatus) copyStatus.textContent = 'Signed in. Saving imported local deck…';
      importDraftToAccount();
    }
  });
  </script>
