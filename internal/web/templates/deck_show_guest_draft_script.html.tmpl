    function primaryTypeGroup(typeLine) {
      var text = normalizeName(typeLine).toLowerCase();
      if (!text) return 'Other';
      if (text.indexOf('land') >= 0) return 'Lands';
      if (text.indexOf('creature') >= 0) return 'Creatures';
      if (text.indexOf('artifact') >= 0) return 'Artifacts';
      if (text.indexOf('enchantment') >= 0) return 'Enchantments';
      if (text.indexOf('planeswalker') >= 0) return 'Planeswalkers';
      if (text.indexOf('battle') >= 0) return 'Battles';
      if (text.indexOf('instant') >= 0) return 'Instants';
      if (text.indexOf('sorcery') >= 0) return 'Sorceries';
      return 'Other';
    }

    function manaValueGroup(cardMeta) {
      var typeLine = normalizeName(cardMeta && cardMeta.typeLine ? cardMeta.typeLine : '');
      if (primaryTypeGroup(typeLine) === 'Lands') return 'Lands';
      var raw = Number(cardMeta && cardMeta.cmc != null ? cardMeta.cmc : 0);
      if (!Number.isFinite(raw)) return 'Unknown';
      if (raw >= 7) return '7+';
      if (raw <= 0) return '0';
      return String(Math.floor(raw));
    }

    function alphabetGroup(cardName) {
      var normalized = normalizeName(cardName);
      if (!normalized) return '#';
      var first = normalized.charAt(0).toUpperCase();
      return /^[A-Z]$/.test(first) ? first : '#';
    }

    function priceValue(cardMeta) {
      var raw = normalizeName(cardMeta && cardMeta.priceUSD ? cardMeta.priceUSD : '');
      if (!raw) return null;
      var parsed = Number(String(raw).replace(/[^0-9.]/g, ''));
      if (!Number.isFinite(parsed)) return null;
      return parsed;
    }

    function priceGroup(cardMeta) {
      var value = priceValue(cardMeta);
      if (value === null) return 'Unknown';
      if (value === 0) return 'Free';
      if (value < 1) return 'Under $1';
      if (value < 5) return '$1-$4.99';
      if (value < 10) return '$5-$9.99';
      return '$10+';
    }

    function displayPrice(cardMeta) {
      var value = priceValue(cardMeta);
      if (value === null) return '—';
      if (value === 0) return '$0.00';
      return '$' + value.toFixed(2);
    }

    function displayManaValue(cardMeta) {
      if (primaryTypeGroup(cardMeta && cardMeta.typeLine ? cardMeta.typeLine : '') === 'Lands') {
        return 'Land';
      }
      var raw = Number(cardMeta && cardMeta.cmc != null ? cardMeta.cmc : 0);
      if (!Number.isFinite(raw)) return '—';
      if (Math.round(raw) === raw) return String(raw);
      return String(raw.toFixed(1)).replace(/\.0$/, '');
    }

    function displayManaValueSummary(cardMeta) {
      var value = displayManaValue(cardMeta);
      if (value === 'Land' || value === '—') return value;
      return value + ' MV';
    }

    function typeSortRank(typeLine) {
      var groups = ['Lands', 'Creatures', 'Artifacts', 'Enchantments', 'Planeswalkers', 'Battles', 'Instants', 'Sorceries', 'Other'];
      var group = primaryTypeGroup(typeLine);
      var index = groups.indexOf(group);
      return index >= 0 ? index : groups.length;
    }

    function compareDeckRows(a, b) {
      var left = a || {};
      var right = b || {};
      var mode = normalizeDeckSortMode(deckSortMode);
      var leftName = normalizeName(left.cardName || '');
      var rightName = normalizeName(right.cardName || '');
      var leftMeta = left.cardMeta || {};
      var rightMeta = right.cardMeta || {};

      if (mode === 'mv') {
        var leftMV = Number(leftMeta.cmc != null ? leftMeta.cmc : 0);
        var rightMV = Number(rightMeta.cmc != null ? rightMeta.cmc : 0);
        if (!Number.isFinite(leftMV)) leftMV = 0;
        if (!Number.isFinite(rightMV)) rightMV = 0;
        if (leftMV !== rightMV) return leftMV - rightMV;
      } else if (mode === 'type') {
        var leftTypeRank = typeSortRank(leftMeta.typeLine || '');
        var rightTypeRank = typeSortRank(rightMeta.typeLine || '');
        if (leftTypeRank !== rightTypeRank) return leftTypeRank - rightTypeRank;
      } else if (mode === 'price') {
        var leftPrice = priceValue(leftMeta);
        var rightPrice = priceValue(rightMeta);
        if (leftPrice === null && rightPrice !== null) return 1;
        if (leftPrice !== null && rightPrice === null) return -1;
        if (leftPrice !== null && rightPrice !== null && leftPrice !== rightPrice) return leftPrice - rightPrice;
      }

      return leftName.localeCompare(rightName);
    }

    function groupedDeckSections(rows) {
      var mode = normalizeDeckGroupMode(deckGroupMode);
      if (mode === 'none') {
        var singleRows = rows.slice();
        singleRows.sort(compareDeckRows);
        return [{ name: '', rows: singleRows }];
      }

      var order;
      if (mode === 'type') {
        order = ['Lands', 'Creatures', 'Artifacts', 'Enchantments', 'Planeswalkers', 'Battles', 'Instants', 'Sorceries', 'Other'];
      } else if (mode === 'mv') {
        order = ['Lands', '0', '1', '2', '3', '4', '5', '6', '7+', 'Unknown'];
      } else if (mode === 'alphabet') {
        order = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
        order.push('#');
      } else {
        order = ['Free', 'Under $1', '$1-$4.99', '$5-$9.99', '$10+', 'Unknown'];
      }
      var buckets = {};

      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var groupName;
        if (mode === 'type') {
          groupName = primaryTypeGroup(row.cardMeta && row.cardMeta.typeLine ? row.cardMeta.typeLine : '');
        } else if (mode === 'mv') {
          groupName = manaValueGroup(row.cardMeta || {});
        } else if (mode === 'alphabet') {
          groupName = alphabetGroup(row.cardName || '');
        } else {
          groupName = priceGroup(row.cardMeta || {});
        }
        if (!buckets[groupName]) buckets[groupName] = [];
        buckets[groupName].push(row);
      }

      var sections = [];
      for (var j = 0; j < order.length; j++) {
        var name = order[j];
        if (!buckets[name] || buckets[name].length === 0) continue;
        buckets[name].sort(compareDeckRows);
        sections.push({ name: name, rows: buckets[name] });
        delete buckets[name];
      }

      var leftovers = Object.keys(buckets).sort(function (a, b) { return a.localeCompare(b); });
      for (var k = 0; k < leftovers.length; k++) {
        buckets[leftovers[k]].sort(compareDeckRows);
        sections.push({ name: leftovers[k], rows: buckets[leftovers[k]] });
      }
      return sections;
    }

    function sectionCardTotal(section) {
      if (!section || !Array.isArray(section.rows)) return 0;
      var total = 0;
      for (var i = 0; i < section.rows.length; i++) {
        total += Number(section.rows[i].qty || 0);
      }
      return total;
    }

    function setDeckFilterQuery(value) {
      deckFilterQuery = normalizeName(value).toLowerCase();
      return deckFilterQuery;
    }

    function deckRowFilterText(row) {
      row = row || {};
      var cardMeta = row.cardMeta || {};
      return [
        row.cardName || '',
        cardMeta.name || '',
        cardMeta.typeLine || '',
        cardMeta.oracleText || '',
        cardMeta.manaCost || '',
        displayManaValue(cardMeta),
        displayPrice(cardMeta)
      ].join(' ').toLowerCase();
    }

    function filterDeckRows(rows) {
      rows = Array.isArray(rows) ? rows : [];
      var query = deckFilterQuery || '';
      if (!query) return rows;
      var terms = query.split(/\s+/).filter(Boolean);
      if (terms.length === 0) return rows;
      return rows.filter(function (row) {
        var haystack = deckRowFilterText(row);
        for (var i = 0; i < terms.length; i++) {
          if (haystack.indexOf(terms[i]) === -1) return false;
        }
        return true;
      });
    }

    function appendDeckGroupHeader(name, qty) {
      if (!listEl || !name) return;
      var li = document.createElement('li');
      li.className = 'py-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400';
      li.textContent = name + ' (' + String(qty) + ')';
      listEl.appendChild(li);
    }

    function setDeckListViewMode(viewMode) {
      var normalized = normalizeDeckViewMode(viewMode);
      if (!listEl) return normalized;
      var grouped = normalizeDeckGroupMode(deckGroupMode) !== 'none' && normalized !== 'table';
      listEl.className = 'mt-deck-view-root mt-deck-view-root--' + normalized + (grouped ? ' mt-deck-view-root--grouped' : '');
      return normalized;
    }

    function createDeckSectionContainer(name, qty, viewMode) {
      if (!listEl) return null;

      var section = document.createElement('section');
      section.className = 'mt-deck-view-section';

      if (normalizeDeckGroupMode(deckGroupMode) !== 'none' && name) {
        var head = document.createElement('div');
        head.className = 'mt-deck-view-section__head';

        var title = document.createElement('p');
        title.className = 'mt-deck-view-section__title';
        title.textContent = name;
        head.appendChild(title);

        var count = document.createElement('p');
        count.className = 'mt-deck-view-section__count';
        count.textContent = String(qty);
        head.appendChild(count);

        section.appendChild(head);
      }

      var body = document.createElement('div');
      body.className = 'mt-deck-view-section__body mt-deck-view-section__body--' + normalizeDeckViewMode(viewMode);
      section.appendChild(body);
      listEl.appendChild(section);

      return body;
    }

    function createCardViewButton(label, className, onOpen) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'border-0 bg-transparent p-0 ' + className;
      btn.textContent = label;
      btn.addEventListener('click', function () {
        onOpen();
      });
      return btn;
