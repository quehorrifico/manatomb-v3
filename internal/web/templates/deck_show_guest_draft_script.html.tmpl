    function layoutDeckStackSection(container, expandedIndex) {
      if (!container) return;
      var cards = Array.prototype.slice.call(container.querySelectorAll('.mt-deck-art-card'));
      if (cards.length === 0) {
        container.style.height = '';
        return;
      }

      var collapsedStep = 34;
      var firstCard = cards[0];
      var cardHeight = firstCard.offsetHeight || 260;
      var expandedReveal = Math.max(cardHeight - 28, 190);
      var extraSpace = expandedIndex >= 0 ? (expandedReveal - collapsedStep) : 0;

      for (var i = 0; i < cards.length; i++) {
        var card = cards[i];
        var top = i * collapsedStep;
        if (expandedIndex >= 0 && i > expandedIndex) {
          top += extraSpace;
        }
        card.style.top = String(top) + 'px';
        card.style.zIndex = String(i === expandedIndex ? cards.length + 5 : i + 1);
      }

      var totalHeight = ((cards.length - 1) * collapsedStep) + cardHeight + extraSpace + 10;
      container.style.height = String(totalHeight) + 'px';
    }

    function bindDeckStackSection(container) {
      if (!container || container.getAttribute('data-stack-bound') === '1') return;
      container.setAttribute('data-stack-bound', '1');

      var cards = Array.prototype.slice.call(container.querySelectorAll('.mt-deck-art-card'));
      if (cards.length === 0) return;

      for (var i = 0; i < cards.length; i++) {
        (function (index) {
          var card = cards[index];
          card.addEventListener('mouseenter', function () {
            layoutDeckStackSection(container, index);
          });
          card.addEventListener('focusin', function () {
            layoutDeckStackSection(container, index);
          });
        })(i);
      }

      container.addEventListener('mouseleave', function () {
        layoutDeckStackSection(container, -1);
      });

      layoutDeckStackSection(container, -1);
    }

    function renderDeckSections(rows, createActionMenu) {
      if (!listEl) return;

      var sections = groupedDeckSections(rows || []);
      var viewMode = setDeckListViewMode(deckViewMode);
      listEl.innerHTML = '';

      for (var i = 0; i < sections.length; i++) {
        var section = sections[i];
        if (!section || !Array.isArray(section.rows) || section.rows.length === 0) continue;

        if (viewMode === 'table') {
          var tableSection = document.createElement('section');
          tableSection.className = 'mt-deck-view-section';

          if (normalizeDeckGroupMode(deckGroupMode) !== 'none' && section.name) {
            var tableHead = document.createElement('div');
            tableHead.className = 'mt-deck-view-section__head';

            var tableTitle = document.createElement('p');
            tableTitle.className = 'mt-deck-view-section__title';
            tableTitle.textContent = section.name;
            tableHead.appendChild(tableTitle);

            var tableCount = document.createElement('p');
            tableCount.className = 'mt-deck-view-section__count';
            tableCount.textContent = String(sectionCardTotal(section)) + ' cards';
            tableHead.appendChild(tableCount);

            tableSection.appendChild(tableHead);
