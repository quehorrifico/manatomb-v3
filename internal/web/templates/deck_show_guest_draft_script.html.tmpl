          }
        } catch (e) {
          raw = '';
          consumedPlaytestReturn = false;
        }
        if (!raw) {
          raw = localStorage.getItem(key);
        }
        if (!raw) return null;
        var d = JSON.parse(raw);
        if (!d || typeof d !== 'object') return null;
        if (!d.cards || typeof d.cards !== 'object') d.cards = {};
        if (!d.sideboardCards || typeof d.sideboardCards !== 'object') d.sideboardCards = {};
        if (!d.maybeCards || typeof d.maybeCards !== 'object') d.maybeCards = {};
        if (!d.cardMeta || typeof d.cardMeta !== 'object') d.cardMeta = {};
        if (!d.boardCardMeta || typeof d.boardCardMeta !== 'object') d.boardCardMeta = {};
        if (!d.boardCardMeta.main || typeof d.boardCardMeta.main !== 'object') d.boardCardMeta.main = {};
        if (!d.boardCardMeta.side || typeof d.boardCardMeta.side !== 'object') d.boardCardMeta.side = {};
