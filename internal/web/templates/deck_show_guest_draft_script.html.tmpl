    function bindDeckHoverPreview(target, cardName, cardMeta) {
      if (!target || requiresTapPreview) return;
      var resolvedImageURI = normalizeName(cardMeta && cardMeta.imageURI ? cardMeta.imageURI : '');
      var resolving = false;

      function show(event) {
        if (event) moveDeckCardPreview(event);
        showDeckCardPreview(resolvedImageURI, cardName, target);
        if (resolvedImageURI || resolving) return;
        resolving = true;
        resolveCardImage(cardName, '', true).then(function (uri) {
          resolving = false;
          if (!uri) return;
          resolvedImageURI = uri;
          if (tapPreviewSource === target && previewWrap && !previewWrap.classList.contains('hidden')) {
            showDeckCardPreview(resolvedImageURI, cardName, target);
          }
        }).catch(function () {
          resolving = false;
        });
      }

      target.addEventListener('mouseenter', show);
      target.addEventListener('mousemove', moveDeckCardPreview);
      target.addEventListener('mouseleave', hideDeckCardPreview);
      target.addEventListener('focusin', show);
      target.addEventListener('focusout', hideDeckCardPreview);
