      var currentCommander = currentCommanderNameForState(d);
      if (!currentCommander) return false;
      if (cardMapQuantityTotal((d && d.sideboardCards) || {}) > 0) return false;
      if (cardMapQuantityTotal((d && d.maybeCards) || {}) > 0) return false;
      return visibleNonCommanderQuantity((d && d.cards) || {}, currentCommander) === 0;
    }

    function quickBuildCardsPayload(cardMap) {
      var out = [];
      var entries = Object.entries(cardMap || {});
      entries.sort(function (a, b) { return String(a[0] || '').localeCompare(String(b[0] || '')); });
      for (var i = 0; i < entries.length; i++) {
        var name = normalizeName(entries[i][0]);
        var qty = Number(entries[i][1] || 0);
        if (!name || !Number.isFinite(qty) || qty <= 0) continue;
        out.push({ name: name, qty: qty });
      }
      return out;
    }

    function setQuickBuildSummary(message) {
      if (!quickBuildSummaryEl) return;
      var text = String(message || '').trim();
      quickBuildSummaryEl.textContent = text;
      quickBuildSummaryEl.classList.toggle('hidden', !text);
    }

    function renderQuickBuildState(d) {
      var eligible = quickBuildEligibleState(d);
      var format = normalizeGuestFormat(d && d.format ? d.format : deckFormat);
      var currentCommander = currentCommanderNameForState(d);
      var mainEmpty = visibleNonCommanderQuantity((d && d.cards) || {}, currentCommander) === 0;
      var showOnboarding = deckBoardMode === 'main' && !deckFilterQuery && mainEmpty;
      var showQuickBuild = deckBoardMode === 'main' && (quickBuildBusy || eligible);
      if (quickBuildWrap) {
        quickBuildWrap.classList.toggle('hidden', !(showOnboarding || showQuickBuild));
      }
      if (quickBuildBtn) {
        quickBuildBtn.disabled = quickBuildBusy || !eligible;
        quickBuildBtn.textContent = quickBuildBusy ? 'Building starter list…' : 'Quick Build';
        quickBuildBtn.classList.toggle('hidden', !showQuickBuild);
      }
      if (emptyStateTitleEl && quickBuildCopyEl) {
        if (format === 'Standard') {
          emptyStateTitleEl.textContent = 'Start your Standard deck';
          quickBuildCopyEl.textContent = 'Search above to add your first card. You’re building toward a 60-card mainboard.';
        } else if (format === 'Sandbox') {
          emptyStateTitleEl.textContent = 'Start with any card';
          quickBuildCopyEl.textContent = 'Search above to add your first card. Sandbox has no deck-size or format restrictions.';
        } else if (formatUsesCommander(format)) {
          emptyStateTitleEl.textContent = currentCommander
            ? 'Build around your commander'
            : 'Choose a commander to begin';
          quickBuildCopyEl.textContent = showQuickBuild && currentCommander
            ? 'Search above, or create a starter built around ' + currentCommander + '.'
            : (currentCommander
              ? 'Search above to add your first card.'
              : 'Open the commander card above to choose a legendary leader from this deck.');
        } else {
          emptyStateTitleEl.textContent = 'Start your ' + format + ' deck';
          quickBuildCopyEl.textContent = 'Search above to add your first card.';
        }
      }
      if (emptyEl && (showOnboarding || showQuickBuild)) {
        emptyEl.classList.add('hidden');
      }
      if (!quickBuildBusy && eligible) {
        setQuickBuildSummary('');
      }
    }

    async function postQuickBuild(payload) {
      var res = await fetch('/decks/quick-build', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload || {})
      });
      if (!res.ok) {
        var errorText = '';
        try {
          errorText = await res.text();
        } catch (e) {
          errorText = '';
        }
        throw new Error(normalizeName(errorText) || 'Quick Build failed.');
      }
      return res.json();
    }

    async function syncGuestCommanderOverview(d) {
      if (!window.mtDeckSetCommanderOverview) return;

      var current = currentCommanderForDraft(d);
      if (!current) {
        window.mtDeckSetCommanderOverview(null);
        return;
      }

      var meta = draftMetaForCard(d, current);
      if (meta) {
        window.mtDeckSetCommanderOverview({
          name: current,
          mana_cost: meta.manaCost || '',
          type_line: meta.typeLine || '',
          oracle_text: meta.oracleText || '',
          image_uri: meta.imageURI || '',
          faces: Array.isArray(meta.faces) ? meta.faces : []
        });
        if (currentCommanderPrintForDraft(d)) {
          return;
        }
      }

      var cacheKey = current.toLowerCase();
      if (guestCommanderDetailCache[cacheKey]) {
        window.mtDeckSetCommanderOverview(guestCommanderDetailCache[cacheKey]);
        return;
      }

      var resolved = await resolveCardByName(current, true);
      if (!resolved || !resolved.name) return;
      var latest = loadDraft() || d || {};
      if (normalizeName(currentCommanderForDraft(latest)).toLowerCase() !== cacheKey) return;
      guestCommanderDetailCache[cacheKey] = resolved;
      window.mtDeckSetCommanderOverview(resolved);
    }

    async function setGuestCommander(cardName) {
      var picked = normalizeName(cardName);
      if (!picked) return;

      var dd = loadDraft() || { commanderName: commanderName, commanderCandidates: [], cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      dd.cards = dd.cards || {};
      dd.maybeCards = dd.maybeCards || {};
      ensureDraftCardMetaMap(dd);

      var previousCommander = normalizeName(currentCommanderForDraft(dd));
      var previousCommanderMeta = normalizeDraftCardMeta(
        previousCommander ? draftMetaForCard(dd, previousCommander) : null
      );
      var meta = draftMetaForCard(dd, picked);
      var resolved = null;

      if (!meta || !meta.isCommanderCandidate) {
        resolved = await resolveCardByName(picked, true);
        if (resolved && resolved.name) {
          var resolvedMeta = buildDraftCardMeta(resolved);
          if (resolvedMeta) {
            meta = resolvedMeta;
            dd.cardMeta[picked] = resolvedMeta;
          }
        }
      }

      if (!meta || !meta.isCommanderCandidate) {
        setGuestDeckStatus('That card cannot be your commander.');
        return;
      }

      commanderName = picked;
      dd.commanderName = commanderName;
      commanderPrintID = normalizeName(meta.preferredPrintID || meta.printID || '');
      dd.commanderPrintID = commanderPrintID;

      if (previousCommander && previousCommander.toLowerCase() !== commanderName.toLowerCase()) {
        var previousKey = draftCardNameKey(dd.cards, previousCommander);
        var previousQty = previousKey ? Number(dd.cards[previousKey] || 0) : 0;
        if (!Number.isFinite(previousQty) || previousQty <= 0) {
          var previousResolved = await resolveCardByName(previousCommander, true);
          var previousCanonical = previousCommander;
          if (previousResolved && previousResolved.name) {
            var resolvedName = normalizeName(previousResolved.name);
            if (resolvedName) previousCanonical = resolvedName;
          }
          var canonicalKey = draftCardNameKey(dd.cards, previousCanonical);
          if (!canonicalKey) canonicalKey = previousCanonical;
          dd.cards[canonicalKey] = Number(dd.cards[canonicalKey] || 0) + 1;

          var previousMeta = previousCommanderMeta || buildDraftCardMeta(previousResolved);
          if (previousMeta) {
            dd.cardMeta[canonicalKey] = previousMeta;
          }
        }
      }

      if (!Array.isArray(dd.commanderCandidates)) dd.commanderCandidates = [];
      if (dd.commanderCandidates.map(function (x) { return String(x || '').toLowerCase(); }).indexOf(commanderName.toLowerCase()) < 0) {
        dd.commanderCandidates.push(commanderName);
      }

      if (resolved && resolved.name) {
        guestCommanderDetailCache[commanderName.toLowerCase()] = resolved;
      }

      saveDraft(dd);
      render(dd);
      setGuestDeckStatus('Commander set to ' + commanderName + '.');
    }

    function setTopCommanderArt(imageURI, name) {
      if (!commanderTopArtWrap || !commanderTopArt) return;
      var uri = normalizeName(imageURI);
      var cardName = normalizeName(name);
      if (!uri) {
        commanderTopArt.removeAttribute('src');
        commanderTopArt.alt = 'Commander art';
        commanderTopArtWrap.classList.add('hidden');
        return;
      }
      commanderTopArt.src = uri;
      commanderTopArt.alt = (cardName || 'Commander') + ' commander art';
      commanderTopArtWrap.classList.remove('hidden');
    }

    function syncTopCommanderArt(d) {
      var current = normalizeName(commanderName);
      if (!current) {
        setTopCommanderArt('', '');
        return;
      }

      var meta = draftMetaForCard(d, current);
      var imageURI = normalizeName(meta && meta.imageURI ? meta.imageURI : '');
      if (imageURI) {
        setTopCommanderArt(imageURI, current);
        return;
      }

      setTopCommanderArt('', current);
      resolveCardImage(current, '', true).then(function (uri) {
        if (normalizeName(commanderName).toLowerCase() !== current.toLowerCase()) return;
        if (!uri) return;
        setTopCommanderArt(uri, current);
      });
    }

    function renderCommanderControls(d) {
      var current = commanderName ? commanderName : 'No commander selected';
      if (commanderTopEl) commanderTopEl.textContent = current;
      syncTopCommanderArt(d);
    }

    function currentCommanderForDraft(d) {
      var fromDraft = normalizeName(d && d.commanderName ? d.commanderName : '');
      if (fromDraft) return fromDraft;
      return normalizeName(commanderName);
    }

    function currentCommanderPrintForDraft(d) {
      var current = currentCommanderForDraft(d);
      if (!current) return '';
      var explicit = normalizeName(d && d.commanderPrintID ? d.commanderPrintID : commanderPrintID);
      if (explicit) return explicit;
      var meta = draftMetaForCard(d, current);
      return normalizeName(meta && (meta.preferredPrintID || meta.printID) || '');
    }

    function setGuestFormat(nextFormat) {
      var format = normalizeGuestFormat(nextFormat);
      var dd = loadDraft() || { commanderName: commanderName, cards: {}, sideboardCards: {}, maybeCards: {}, cardMeta: {} };
      dd.cards = dd.cards || {};
      dd.maybeCards = dd.maybeCards || {};
      ensureDraftCardMetaMap(dd);

      var previousCommander = normalizeName(currentCommanderForDraft(dd));
      if (formatUsesCommander(format)) {
        if (!formatUsesCommander(dd.format)) {
          commanderName = '';
          commanderPrintID = '';
          dd.commanderName = '';
          dd.commanderPrintID = '';
        }
        dd.format = format;
      } else {
        if (previousCommander) {
          var existingKey = draftCardNameKey(dd.cards, previousCommander);
          if (!existingKey) existingKey = previousCommander;
          if (Number(dd.cards[existingKey] || 0) <= 0) {
            dd.cards[existingKey] = 1;
          }
        }
        commanderName = '';
        commanderPrintID = '';
        dd.commanderName = '';
        dd.commanderPrintID = '';
        dd.format = format;
      }

      if (guestFormatField) guestFormatField.value = dd.format;
      saveDraft(dd);
      render(dd);
      if (guestOverviewStatus) guestOverviewStatus.textContent = '';
    }

    async function runGuestQuickBuild() {
      if (quickBuildBusy) return;

      var dd = loadDraft() || {
        commanderName: commanderName,
        format: 'Commander',
        commanderCandidates: [],
        name: guestDeckName,
        description: '',
        tags: '',
        cards: {},
        sideboardCards: {},
        maybeCards: {},
        cardMeta: {}
      };
      dd.cards = dd.cards || {};
      dd.maybeCards = dd.maybeCards || {};
      ensureDraftCardMetaMap(dd);

      if (!quickBuildEligibleState(dd)) {
        setGuestDeckStatus('Quick Build only works on an empty commander deck with your commander selected.');
        return;
      }

      quickBuildBusy = true;
      setQuickBuildSummary('');
      renderQuickBuildState(dd);
      if (addStatus) addStatus.textContent = 'Building starter list…';

      try {
        var requestSeed = nextQuickBuildSeed();
        var out = await postQuickBuild({
          name: guestDeckName,
          description: String(dd.description || ''),
          tags: String(dd.tags || ''),
          commander_name: currentCommanderForDraft(dd),
          format: dd.format || 'Commander',
          seed: requestSeed,
          cards: quickBuildCardsPayload(dd.cards),
          sideboard_cards: quickBuildCardsPayload(dd.sideboardCards),
          maybe_cards: quickBuildCardsPayload(dd.maybeCards)
        });

        var next = out && out.workspace && typeof out.workspace === 'object' ? out.workspace : null;
        if (!next) {
          throw new Error('Quick Build failed.');
        }

        commanderName = normalizeName(next.commanderName || commanderName);
        commanderPrintID = normalizeName(next.commanderPrintID || currentCommanderPrintForDraft(dd));
        next.commanderPrintID = commanderPrintID;
        next.name = guestDeckName;
        next.description = typeof next.description === 'string' ? next.description : String(dd.description || '');
        next.tags = typeof next.tags === 'string' ? next.tags : String(dd.tags || '');

        quickBuildLastSeed = Number((out && out.summary && out.summary.seed) || requestSeed || 0);
        if (quickBuildBtn) quickBuildBtn.dataset.quickBuildSeed = quickBuildLastSeed ? String(quickBuildLastSeed) : '';
        setQuickBuildSummary(out && out.summary && out.summary.explanation ? out.summary.explanation : '');
        saveDraft(next);
        render(next);
        setGuestDeckStatus('Starter shell added. This is a playtest-ready first draft.');
      } catch (e) {
        setGuestDeckStatus(e && e.message ? e.message : 'Could not build a starter shell.');
      } finally {
        quickBuildBusy = false;
        renderQuickBuildState(loadDraft() || dd);
      }
    }

    function setAnalyticsField(id, value) {
      var el = document.getElementById(id);
      if (!el) return;
      el.textContent = String(value);
    }

    function renderDeckExtras(extras) {
      var list = document.getElementById('deck-analytics-extras');
      if (!list) return;

      var renderToken = ++extrasRenderToken;
      list.innerHTML = '';
      if (!Array.isArray(extras) || extras.length === 0) {
        var empty = document.createElement('li');
        empty.className = 'mt-deck-editor__empty';
        empty.textContent = 'None.';
        list.appendChild(empty);
        return;
      }

      var rendered = 0;
      for (var i = 0; i < extras.length; i++) {
        var extra = extras[i] || {};
        var name = normalizeName(extra.name || '');
        var count = Number(extra.count || 0);
        if (!name || !Number.isFinite(count) || count <= 0) continue;

        var target = extraArtTarget(name);
        var tile = createAnalyticsArtTile({
          name: name,
          caption: name,
          count: count,
        });
        list.appendChild(tile.node);
        rendered += 1;

        (function (localTile, localTarget, localRenderToken) {
          resolveCardImage(localTarget.name || '', '', true).then(function (uri) {
            if (localRenderToken !== extrasRenderToken) return;
            if (!uri) return;
            localTile.setImage(uri);
          });
        })(tile, target, renderToken);
      }

      if (rendered === 0) {
        var fallback = document.createElement('li');
        fallback.className = 'mt-deck-editor__empty';
        fallback.textContent = 'None.';
        list.appendChild(fallback);
      }
    }

    function guideToneClass(tone) {
      switch (String(tone || 'info')) {
        case 'good':
          return 'mt-guide-check mt-guide-check--good';
        case 'warn':
          return 'mt-guide-check mt-guide-check--warn';
        case 'alert':
          return 'mt-guide-check mt-guide-check--alert';
        default:
          return 'mt-guide-check mt-guide-check--info';
      }
    }

    function renderGuideChecks(checks) {
      var root = document.getElementById('deck-guide-checks');
      if (!root) return;

      root.innerHTML = '';
      if (!Array.isArray(checks) || checks.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'mt-note';
        empty.textContent = 'Add cards to get guide feedback.';
        root.appendChild(empty);
        return;
      }

      for (var i = 0; i < checks.length; i++) {
        var check = checks[i] || {};
        var card = document.createElement('article');
        card.className = guideToneClass(check.tone);

        var top = document.createElement('div');
        top.className = 'mt-guide-check__top';

        var left = document.createElement('div');
        left.className = 'space-y-1';

        var label = document.createElement('p');
        label.className = 'mt-guide-check__label';
        label.textContent = normalizeName(check.label || '') || 'Guide';
        left.appendChild(label);

        var value = document.createElement('p');
        value.className = 'mt-guide-check__value';
        value.textContent = normalizeName(check.value || '') || '0';
        left.appendChild(value);

        top.appendChild(left);

        var targetText = normalizeName(check.target || '');
        if (targetText) {
          var target = document.createElement('p');
          target.className = 'mt-guide-check__target';
          target.textContent = targetText;
          top.appendChild(target);
        }

        card.appendChild(top);

        var hintText = normalizeName(check.hint || '');
        if (hintText) {
          var hint = document.createElement('p');
          hint.className = 'mt-guide-check__hint';
          hint.textContent = hintText;
          card.appendChild(hint);
        }

        root.appendChild(card);
      }
    }

    function renderGuideWarnings(warnings) {
      var panel = document.getElementById('deck-guide-warnings-panel');
      var list = document.getElementById('deck-guide-warnings-list');
      if (!panel || !list) return;

      list.innerHTML = '';
      if (!Array.isArray(warnings) || warnings.length === 0) {
        panel.classList.add('hidden');
        return;
      }

      panel.classList.remove('hidden');
      for (var i = 0; i < warnings.length; i++) {
        var warningText = normalizeName(warnings[i]);
        if (!warningText) continue;
        var item = document.createElement('li');
        item.textContent = warningText;
        list.appendChild(item);
      }

      if (list.children.length === 0) {
        panel.classList.add('hidden');
      }
    }

    function analyticsStatLabel(key) {
      var labels = {
        all: 'Cards',
        lands: 'Lands',
        nonlands: 'Nonlands',
        ramp: 'Ramp',
        draw: 'Draw',
        interaction: 'Interaction',
      };
      return labels[key] || 'Cards';
    }

    function analyticsStatCards(key) {
      if (!currentDeckAnalytics || typeof currentDeckAnalytics !== 'object') return [];
      var statCards = currentDeckAnalytics.stat_cards || currentDeckAnalytics.statCards || {};
      var cards = statCards && Array.isArray(statCards[key]) ? statCards[key] : [];
      return cards.slice();
    }

    function renderAnalyticsStatCardList(key) {
      key = String(key || '').trim() || 'all';
      activeAnalyticsStatKey = key;
      if (!analyticsCardListPanel || !analyticsCardList || !analyticsCardListTitle) return;

      analyticsCardListTitle.textContent = analyticsStatLabel(key);
      analyticsCardList.innerHTML = '';
      analyticsCardListPanel.classList.remove('hidden');
      if (analyticsStatExplorer) analyticsStatExplorer.classList.add('is-expanded');
      for (var buttonIndex = 0; buttonIndex < analyticsStatButtons.length; buttonIndex++) {
        var buttonKey = analyticsStatButtons[buttonIndex].getAttribute('data-analytics-stat') || '';
        analyticsStatButtons[buttonIndex].setAttribute('aria-expanded', buttonKey === key ? 'true' : 'false');
      }

      var cards = analyticsStatCards(key);
      if (cards.length === 0) {
        var empty = document.createElement('li');
        empty.className = 'mt-analytics-card-list__item';
        var emptyName = document.createElement('strong');
        emptyName.textContent = 'No cards found';
        empty.appendChild(emptyName);
        analyticsCardList.appendChild(empty);
        return;
      }

      for (var i = 0; i < cards.length; i++) {
        var card = cards[i] || {};
        var name = normalizeName(card.name || card.Name || '');
        if (!name) continue;
        var qty = Number(card.qty || card.Qty || 0);
        if (!Number.isFinite(qty) || qty <= 0) qty = 1;

        var item = document.createElement('li');
        item.className = 'mt-analytics-card-list__item';

        var title = document.createElement('strong');
        title.textContent = String(qty) + ' ' + name;
        item.appendChild(title);

        var reason = normalizeName(card.reason || card.Reason || '');
        var categories = Array.isArray(card.categories || card.Categories) ? (card.categories || card.Categories) : [];
        if (!reason && categories.length > 0) {
          reason = categories.slice(0, 3).map(normalizeName).filter(Boolean).join(', ');
        }
        if (reason) {
          var meta = document.createElement('small');
          meta.textContent = reason;
          item.appendChild(meta);
        }

        analyticsCardList.appendChild(item);
      }
    }

    function hideAnalyticsStatCardList() {
      activeAnalyticsStatKey = '';
      if (analyticsCardListPanel) analyticsCardListPanel.classList.add('hidden');
      if (analyticsStatExplorer) analyticsStatExplorer.classList.remove('is-expanded');
      for (var buttonIndex = 0; buttonIndex < analyticsStatButtons.length; buttonIndex++) {
        analyticsStatButtons[buttonIndex].setAttribute('aria-expanded', 'false');
      }
    }

    function analyticsManaStats(kind) {
      if (!currentDeckAnalytics || typeof currentDeckAnalytics !== 'object') return [];
      var key = kind === 'sources' ? 'mana_sources' : 'mana_pips';
      var fallbackKey = kind === 'sources' ? 'manaSources' : 'manaPips';
      var stats = currentDeckAnalytics[key] || currentDeckAnalytics[fallbackKey] || [];
      return Array.isArray(stats) ? stats : [];
    }

    function normalizedManaStat(raw) {
      raw = raw && typeof raw === 'object' ? raw : {};
      var symbol = normalizeName(raw.symbol || raw.Symbol || '').toUpperCase();
      if (['W', 'U', 'B', 'R', 'G', 'C'].indexOf(symbol) === -1) return null;
      var count = Number(raw.count || raw.Count || 0);
      if (!Number.isFinite(count) || count < 0) count = 0;
      return {
        symbol: symbol,
        label: normalizeName(raw.label || raw.Label || '') || symbol,
        imageURI: normalizeName(raw.image_uri || raw.imageURI || raw.ImageURI || '') || ('https://svgs.scryfall.io/card-symbols/' + symbol + '.svg'),
        count: Math.round(count),
        cards: Array.isArray(raw.cards || raw.Cards) ? (raw.cards || raw.Cards) : []
      };
    }

    function manaStatForSelection(kind, symbol) {
      var stats = analyticsManaStats(kind);
      for (var i = 0; i < stats.length; i++) {
        var stat = normalizedManaStat(stats[i]);
        if (stat && stat.symbol === symbol) return stat;
      }
      return null;
    }

    function syncManaSegmentSelection() {
      var segments = document.querySelectorAll('[data-mana-profile-segment]');
      for (var i = 0; i < segments.length; i++) {
        var isActive = !!activeManaSelection &&
          segments[i].getAttribute('data-mana-profile-kind') === activeManaSelection.kind &&
          segments[i].getAttribute('data-mana-profile-symbol') === activeManaSelection.symbol;
        segments[i].setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }
    }

    function closeManaLockedPanel() {
      activeManaSelection = null;
      if (manaLockedPanel) manaLockedPanel.classList.add('hidden');
      if (manaLockedList) manaLockedList.innerHTML = '';
      syncManaSegmentSelection();
    }

    function showManaLockedPanel(kind, symbol) {
      var stat = manaStatForSelection(kind, symbol);
      if (!stat || stat.count <= 0 || !manaLockedPanel || !manaLockedList) {
        closeManaLockedPanel();
        return;
      }

      activeManaSelection = { kind: kind, symbol: symbol };
      var isSources = kind === 'sources';
      if (manaLockedTitle) {
        manaLockedTitle.textContent = stat.label + (isSources ? ' mana sources' : ' pips in costs');
      }
      if (manaLockedSummary) {
        var cardCount = stat.cards.length;
        manaLockedSummary.textContent = String(stat.count) + (isSources ? ' source' : ' pip') + (stat.count === 1 ? '' : 's') +
          ' across ' + String(cardCount) + ' card' + (cardCount === 1 ? '' : 's') + '.';
      }

      manaLockedList.innerHTML = '';
      for (var i = 0; i < stat.cards.length; i++) {
        var card = stat.cards[i] || {};
        var name = normalizeName(card.name || card.Name || '');
        if (!name) continue;
        var qty = Number(card.qty || card.Qty || 0);
        if (!Number.isFinite(qty) || qty <= 0) qty = 1;

        var item = document.createElement('li');
        item.className = 'mt-analytics-card-list__item';
        var title = document.createElement('strong');
        title.textContent = String(qty) + ' ' + name;
        item.appendChild(title);

        var reason = normalizeName(card.reason || card.Reason || '');
        if (reason) {
          var meta = document.createElement('small');
          meta.textContent = reason;
          item.appendChild(meta);
        }
        manaLockedList.appendChild(item);
      }

      manaLockedPanel.classList.remove('hidden');
      syncManaSegmentSelection();
    }

    function toggleManaLockedPanel(kind, symbol) {
      if (activeManaSelection && activeManaSelection.kind === kind && activeManaSelection.symbol === symbol &&
          manaLockedPanel && !manaLockedPanel.classList.contains('hidden')) {
        closeManaLockedPanel();
        return;
      }
      showManaLockedPanel(kind, symbol);
    }

    function renderManaProfile(kind, rawStats) {
      var bar = document.querySelector('[data-mana-profile-bar="' + kind + '"]');
      var legend = document.querySelector('[data-mana-profile-legend="' + kind + '"]');
      var empty = document.querySelector('[data-mana-profile-empty="' + kind + '"]');
      if (!bar || !legend) return;

      bar.innerHTML = '';
      legend.innerHTML = '';
      var visible = [];
      for (var i = 0; i < rawStats.length; i++) {
        var stat = normalizedManaStat(rawStats[i]);
        if (stat && stat.count > 0) visible.push(stat);
      }
      bar.classList.toggle('hidden', visible.length === 0);
      legend.classList.toggle('hidden', visible.length === 0);
      if (empty) empty.classList.toggle('hidden', visible.length !== 0);

      for (var j = 0; j < visible.length; j++) {
        var current = visible[j];
        var segment = document.createElement('button');
        segment.type = 'button';
        segment.className = 'mt-deck-editor__mana-segment mt-deck-editor__mana-segment--' + current.symbol.toLowerCase();
        segment.style.flexGrow = String(current.count);
        segment.style.flexBasis = '0px';
        segment.setAttribute('data-mana-profile-segment', '');
        segment.setAttribute('data-mana-profile-kind', kind);
        segment.setAttribute('data-mana-profile-symbol', current.symbol);
        segment.setAttribute('aria-pressed', 'false');
        segment.setAttribute('aria-label', current.label + ': ' + String(current.count) + (kind === 'sources' ? ' mana sources. Show cards.' : ' pips. Show cards.'));
        segment.title = current.label + ': ' + String(current.count);
        segment.addEventListener('click', function () {
          toggleManaLockedPanel(
            this.getAttribute('data-mana-profile-kind') || 'pips',
            this.getAttribute('data-mana-profile-symbol') || ''
          );
        });
        bar.appendChild(segment);

        var legendItem = document.createElement('li');
        var legendLabel = document.createElement('span');
        var pip = document.createElement('img');
        pip.src = current.imageURI;
        pip.alt = '';
        pip.loading = 'lazy';
        legendLabel.appendChild(pip);
        legendLabel.appendChild(document.createTextNode(current.label));
        var legendCount = document.createElement('strong');
        legendCount.textContent = String(current.count);
        legendItem.appendChild(legendLabel);
        legendItem.appendChild(legendCount);
        legend.appendChild(legendItem);
      }
    }

