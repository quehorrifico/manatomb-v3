    function normalizeDeckGroupMode(value) {
      switch (String(value || '').toLowerCase()) {
        case 'alphabet':
          return 'alphabet';
        case 'type':
          return 'type';
        case 'mv':
          return 'mv';
        case 'price':
          return 'price';
        default:
