{{ define "deck_playtest" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $deck := $ctx.Deck }}
  {{ $authNext := $ctx.AuthNextPath }}
  {{ if not $authNext }}
    {{ $authNext = "/decks/new" }}
  {{ end }}

  <main class="w-full px-3 xl:px-4 overflow-hidden">
    <div class="pt-playtest-root">
      <section class="pt-battlefield-section mt-panel p-4 sm:p-5 flex-1 min-h-0 flex flex-col">
        <p id="pt-status" class="sr-only" aria-live="polite"></p>

        <div class="relative flex-1 min-h-0">
          <div id="pt-zone-battlefield"
               data-zone="battlefield"
               class="pt-drop-zone pt-battlefield-zone h-full rounded-xl bg-slate-950/80 p-3 relative overflow-hidden"></div>
        </div>
      </section>

      <section class="pt-zones-section flex flex-col min-h-0">
        <div class="pt-zones-grid flex-1 min-h-0">
          <div class="pt-zone-card">
            <div class="flex items-center justify-between gap-2">
              <p id="pt-count-hand" class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Hand (0)</p>
            </div>
            <div id="pt-zone-hand"
                 data-zone="hand"
                 class="pt-drop-zone pt-hand-zone mt-2 flex-1 min-h-0 rounded-xl bg-slate-950/80 p-1.5 flex gap-1.5 overflow-x-auto overflow-y-hidden items-start"></div>
          </div>

          <div class="pt-side-grid">
            <div class="pt-zone-card">
              <div class="relative flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <p id="pt-count-library" class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Library (0)</p>
                  <button id="pt-library-menu-toggle"
                          type="button"
                          class="pt-menu-trigger"
                          aria-label="Library menu">
                    ...
                  </button>
                </div>
                <div id="pt-library-menu"
                     class="hidden pt-inline-menu">
                  <button id="pt-library-menu-draw"
                          type="button"
                          class="pt-inline-menu__item">
                    Draw
                  </button>
                  <button id="pt-library-menu-draw-x"
                          type="button"
                          class="pt-inline-menu__item">
                    Draw X
                  </button>
                  <button id="pt-library-menu-shuffle"
                          type="button"
                          class="pt-inline-menu__item">
                    Shuffle
                  </button>
                  <button id="pt-library-menu-search"
                          type="button"
                          class="pt-inline-menu__item">
                    Search Library
                  </button>
                  <button id="pt-library-menu-reveal"
                          type="button"
                          class="pt-inline-menu__item">
                    Reveal
                  </button>
                  <button id="pt-library-menu-reveal-x"
                          type="button"
                          class="pt-inline-menu__item">
                    Reveal X
                  </button>
                  <button id="pt-library-menu-scry"
                          type="button"
                          class="pt-inline-menu__item">
                    Scry
                  </button>
                  <button id="pt-library-menu-scry-x"
                          type="button"
                          class="pt-inline-menu__item">
                    Scry X
                  </button>
                  <button id="pt-library-menu-surveil"
                          type="button"
                          class="pt-inline-menu__item">
                    Surveil
                  </button>
                  <button id="pt-library-menu-surveil-x"
                          type="button"
                          class="pt-inline-menu__item">
                    Surveil X
                  </button>
                  <button id="pt-library-menu-mill"
                          type="button"
                          class="pt-inline-menu__item">
                    Mill
                  </button>
                  <button id="pt-library-menu-mill-x"
                          type="button"
                          class="pt-inline-menu__item">
                    Mill X
                  </button>
                  <button id="pt-library-menu-keyword-toggle"
                          type="button"
                          class="pt-inline-menu__item pt-inline-menu__item--split"
                          aria-expanded="false">
                    <span>Keyword</span>
                    <span aria-hidden="true">›</span>
                  </button>
                  <div id="pt-library-menu-keyword-panel"
                       class="hidden pt-library-menu__panel">
                    <button id="pt-library-menu-discover"
                            type="button"
                            class="pt-inline-menu__item">
                      Discover X
                    </button>
                    <button id="pt-library-menu-cascade"
                            type="button"
                            class="pt-inline-menu__item">
                      Cascade
                    </button>
                    <button id="pt-library-menu-reveal-until-toggle"
                            type="button"
                            class="pt-inline-menu__item pt-inline-menu__item--split"
                            aria-expanded="false">
                      <span>Reveal Until</span>
                      <span aria-hidden="true">›</span>
                    </button>
                    <div id="pt-library-menu-reveal-until-panel"
                         class="hidden pt-library-menu__panel">
                      <button type="button"
                              class="pt-inline-menu__item pt-library-reveal-until"
                              data-reveal-until="creature">
                        Creature
                      </button>
                      <button type="button"
                              class="pt-inline-menu__item pt-library-reveal-until"
                              data-reveal-until="land">
                        Land
                      </button>
                      <button type="button"
                              class="pt-inline-menu__item pt-library-reveal-until"
                              data-reveal-until="basic-land">
                        Basic Land
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div id="pt-zone-library"
                   data-zone="library"
                   class="pt-drop-zone pt-side-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden cursor-pointer"></div>
            </div>

            <div class="pt-zone-card">
              <div class="flex items-center justify-between gap-2">
                <p id="pt-count-graveyard" class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Graveyard (0)</p>
              </div>
              <div id="pt-zone-graveyard"
                   data-zone="graveyard"
                   class="pt-drop-zone pt-side-zone pt-stack-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden"></div>
            </div>

            <div class="pt-zone-card">
              <div class="flex items-center justify-between gap-2">
                <p id="pt-count-exile" class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Exile (0)</p>
              </div>
              <div id="pt-zone-exile"
                   data-zone="exile"
                   class="pt-drop-zone pt-side-zone pt-stack-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden"></div>
            </div>

            <div class="pt-zone-card">
              <div class="relative flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <p id="pt-count-command" class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Command (0)</p>
                  <button id="pt-command-menu-toggle"
                          type="button"
                          class="pt-menu-trigger"
                          aria-label="Command Zone menu">
                    ...
                  </button>
                </div>
                <div id="pt-command-menu"
                     class="hidden pt-inline-menu">
                  <div class="pt-command-tax" aria-label="Commander tax">
                    <button id="pt-command-tax-down"
                            type="button"
                            class="pt-command-tax__step"
                            aria-label="Decrease commander tax">
                      -
                    </button>
                    <span class="pt-command-tax__label">Tax <span id="pt-command-tax-value">0</span></span>
                    <button id="pt-command-tax-up"
                            type="button"
                            class="pt-command-tax__step"
                            aria-label="Increase commander tax">
                      +
                    </button>
                  </div>
                </div>
              </div>
              <div id="pt-zone-command"
                   data-zone="command"
                   class="pt-drop-zone pt-side-zone pt-stack-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="pt-game-bar" aria-label="Game controls">
        <div class="pt-toolbar-buttons">
          <button id="pt-toolbar-turn"
                  type="button"
                  class="pt-toolbar-button">
            End Turn 0
          </button>
          <button id="pt-toolbar-life"
                  type="button"
                  class="pt-toolbar-button"
                  data-toolbar-menu-toggle="life">
            Life 0
          </button>
          <button id="pt-toolbar-damage"
                  type="button"
                  class="pt-toolbar-button"
                  data-toolbar-menu-toggle="damage">
            Cmd 0
          </button>
          <button id="pt-toolbar-mana"
                  type="button"
                  class="pt-toolbar-button"
                  data-toolbar-menu-toggle="mana">
            Mana 0
          </button>
          <button type="button"
                  class="pt-toolbar-button"
                  data-toolbar-menu-toggle="tools">
            Tools
          </button>
          <button type="button"
                  class="pt-toolbar-button"
                  data-toolbar-menu-toggle="game">
            Game
          </button>
        </div>
        <button id="pt-visible-status"
                type="button"
                class="pt-visible-status"
                aria-label="View game history">
          <span id="pt-visible-status-text" class="pt-visible-status__text">Opening hand ready.</span>
          <span class="pt-visible-status__hint">Click to view history</span>
        </button>
        <div class="hidden pt-toolbar-menu" data-toolbar-menu="life">
          <div class="pt-toolbar-menu__counter">
            <button id="pt-life-down"
                    type="button"
                    class="pt-overlay-metric__step"
                    aria-label="Lose 1 life">
              -
            </button>
            <span id="pt-life-total" class="pt-toolbar-menu__value">0</span>
            <button id="pt-life-up"
                    type="button"
                    class="pt-overlay-metric__step"
                    aria-label="Gain 1 life">
              +
            </button>
          </div>
        </div>
        <div class="hidden pt-toolbar-menu" data-toolbar-menu="damage">
          <div class="pt-toolbar-menu__counter">
            <button id="pt-commander-damage-down"
                    type="button"
                    class="pt-overlay-metric__step"
                    aria-label="Reduce commander damage">
              -
            </button>
            <span id="pt-commander-damage-total" class="pt-toolbar-menu__value">0</span>
            <button id="pt-commander-damage-up"
                    type="button"
                    class="pt-overlay-metric__step"
                    aria-label="Increase commander damage">
              +
            </button>
          </div>
        </div>
        <div class="hidden pt-toolbar-menu pt-toolbar-menu--wide" data-toolbar-menu="mana">
          <div class="pt-mana-list">
            <div class="pt-mana-item pt-mana-item--w">
              <button type="button" class="pt-mana-step" data-mana="w" data-delta="-1" aria-label="Spend white mana">-</button>
              <span class="pt-mana-symbol">W</span>
              <span id="pt-mana-w" class="pt-mana-count">0</span>
              <button type="button" class="pt-mana-step" data-mana="w" data-delta="1" aria-label="Add white mana">+</button>
            </div>
            <div class="pt-mana-item pt-mana-item--u">
              <button type="button" class="pt-mana-step" data-mana="u" data-delta="-1" aria-label="Spend blue mana">-</button>
              <span class="pt-mana-symbol">U</span>
              <span id="pt-mana-u" class="pt-mana-count">0</span>
              <button type="button" class="pt-mana-step" data-mana="u" data-delta="1" aria-label="Add blue mana">+</button>
            </div>
            <div class="pt-mana-item pt-mana-item--b">
              <button type="button" class="pt-mana-step" data-mana="b" data-delta="-1" aria-label="Spend black mana">-</button>
              <span class="pt-mana-symbol">B</span>
              <span id="pt-mana-b" class="pt-mana-count">0</span>
              <button type="button" class="pt-mana-step" data-mana="b" data-delta="1" aria-label="Add black mana">+</button>
            </div>
            <div class="pt-mana-item pt-mana-item--r">
              <button type="button" class="pt-mana-step" data-mana="r" data-delta="-1" aria-label="Spend red mana">-</button>
              <span class="pt-mana-symbol">R</span>
              <span id="pt-mana-r" class="pt-mana-count">0</span>
              <button type="button" class="pt-mana-step" data-mana="r" data-delta="1" aria-label="Add red mana">+</button>
            </div>
            <div class="pt-mana-item pt-mana-item--g">
              <button type="button" class="pt-mana-step" data-mana="g" data-delta="-1" aria-label="Spend green mana">-</button>
              <span class="pt-mana-symbol">G</span>
              <span id="pt-mana-g" class="pt-mana-count">0</span>
              <button type="button" class="pt-mana-step" data-mana="g" data-delta="1" aria-label="Add green mana">+</button>
            </div>
            <div class="pt-mana-item pt-mana-item--c">
              <button type="button" class="pt-mana-step" data-mana="c" data-delta="-1" aria-label="Spend colorless mana">-</button>
              <span class="pt-mana-symbol">C</span>
              <span id="pt-mana-c" class="pt-mana-count">0</span>
              <button type="button" class="pt-mana-step" data-mana="c" data-delta="1" aria-label="Add colorless mana">+</button>
            </div>
          </div>
          <button id="pt-mana-clear"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Clear
          </button>
        </div>
        <div class="hidden pt-toolbar-menu" data-toolbar-menu="tools">
          <button id="pt-token-toggle"
                  type="button"
                  class="pt-inline-menu__item pt-inline-menu__item--split"
                  aria-expanded="false">
            <span>Token</span>
            <span aria-hidden="true">›</span>
          </button>
          <div id="pt-token-panel"
               class="hidden pt-toolbar-submenu">
            <button type="button"
                    class="pt-inline-menu__item pt-token-preset"
                    data-token-preset="treasure">
              Treasure
            </button>
            <button type="button"
                    class="pt-inline-menu__item pt-token-preset"
                    data-token-preset="food">
              Food
            </button>
            <button type="button"
                    class="pt-inline-menu__item pt-token-preset"
                    data-token-preset="clue">
              Clue
            </button>
            <button id="pt-token-open"
                    type="button"
                    class="pt-inline-menu__item">
              Custom
            </button>
          </div>
          <button id="pt-coin-flip"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--sm w-full">
            Coin
          </button>
          <button id="pt-organize-board"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--sm w-full">
            Organize board
          </button>
          <button id="pt-dice-toggle"
                  type="button"
                  class="pt-inline-menu__item pt-inline-menu__item--split"
                  aria-expanded="false">
            <span>Dice</span>
            <span aria-hidden="true">›</span>
          </button>
          <div id="pt-dice-panel"
               class="hidden pt-toolbar-submenu">
            <button type="button" class="pt-inline-menu__item pt-dice-option" data-sides="4">d4</button>
            <button type="button" class="pt-inline-menu__item pt-dice-option" data-sides="6">d6</button>
            <button type="button" class="pt-inline-menu__item pt-dice-option" data-sides="8">d8</button>
            <button type="button" class="pt-inline-menu__item pt-dice-option" data-sides="10">d10</button>
            <button type="button" class="pt-inline-menu__item pt-dice-option" data-sides="12">d12</button>
            <button type="button" class="pt-inline-menu__item pt-dice-option" data-sides="20">d20</button>
          </div>
        </div>
        <div class="hidden pt-toolbar-menu" data-toolbar-menu="game">
          <button id="pt-game-menu-restart"
                  type="button"
                  class="mt-btn mt-btn--warning mt-btn--sm w-full">
            Restart Playtest
          </button>
          <a id="pt-game-menu-return"
             href="{{ $authNext }}"
             class="mt-btn mt-btn--primary mt-btn--sm w-full">
            Back to Deckbuilder
          </a>
        </div>
      </section>
    </div>

    <div id="pt-opening-screen" class="pt-opening-overlay">
      <div class="pt-opening-overlay__backdrop"></div>
      <section class="pt-opening-dialog">
        <div class="pt-opening-dialog__hero">
          <div class="pt-opening-title-row">
            <h1 id="pt-opening-label" class="pt-opening-label">Opening Hand</h1>
            <span id="pt-opening-progress" class="mt-chip">7 cards</span>
          </div>
          <p id="pt-opening-hint" class="pt-opening-hint">Review this hand, then keep or take a fresh seven.</p>
        </div>

        <div id="pt-opening-hand" class="pt-opening-hand-grid"></div>

        <div class="pt-opening-actions">
          <button id="pt-mulligan"
                  class="mt-btn mt-btn--warning pt-opening-action">
            Mulligan (0)
          </button>
          <button id="pt-keep"
                  class="mt-btn mt-btn--primary pt-opening-action">
            Keep
          </button>
          <a id="pt-opening-return"
             href="{{ $authNext }}"
             class="hidden mt-btn mt-btn--primary pt-opening-action">
            Back to Deckbuilder
          </a>
        </div>
      </section>
    </div>

    <div id="pt-token-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-token-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(360px,92vw)] mt-panel bg-slate-950/95 p-4 space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-100">Token</h2>
          <button id="pt-token-close"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Close
          </button>
        </div>
        <div class="space-y-2">
          <div>
            <label for="pt-token-name" class="block text-xs text-slate-400 mb-1">Name</label>
            <input id="pt-token-name"
                   type="text"
                   value="Token"
                   class="mt-control mt-control--sm">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="pt-token-power" class="block text-xs text-slate-400 mb-1">Power</label>
              <input id="pt-token-power"
                     type="number"
                     value="1"
                     min="0"
                     class="mt-control mt-control--sm">
            </div>
            <div>
              <label for="pt-token-toughness" class="block text-xs text-slate-400 mb-1">Toughness</label>
              <input id="pt-token-toughness"
                     type="number"
                     value="1"
                     min="0"
                     class="mt-control mt-control--sm">
            </div>
          </div>
          <div>
            <label for="pt-token-type" class="block text-xs text-slate-400 mb-1">Type</label>
            <input id="pt-token-type"
                   type="text"
                   placeholder="e.g. Creature — Soldier"
                   class="mt-control mt-control--sm">
          </div>
          <div>
            <label for="pt-token-qty" class="block text-xs text-slate-400 mb-1">Quantity</label>
            <input id="pt-token-qty"
                   type="number"
                   value="1"
                   min="1"
                   max="20"
                   class="mt-control mt-control--sm">
          </div>
        </div>
        <button id="pt-token-submit"
                class="mt-btn mt-btn--primary w-full">
          Add to Battlefield
        </button>
      </section>
    </div>

    <div id="pt-scry-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-scry-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-opening-dialog pt-scry-dialog">
        <div class="pt-opening-dialog__hero">
          <div class="pt-opening-title-row">
            <h2 id="pt-scry-title" class="pt-opening-label">Scry</h2>
            <span id="pt-scry-count" class="pt-scry-count">0 cards</span>
          </div>
          <p id="pt-scry-hint" class="pt-opening-hint">Choose which cards stay on top and which go to the bottom.</p>
        </div>

        <div id="pt-scry-cards" class="pt-opening-hand-grid pt-scry-grid"></div>

        <div class="pt-opening-actions">
          <button id="pt-scry-cancel"
                  type="button"
                  class="mt-btn mt-btn--secondary pt-opening-action">
            Cancel
          </button>
          <button id="pt-scry-finish"
                  type="button"
                  class="mt-btn mt-btn--primary pt-opening-action">
            Done
          </button>
        </div>
      </section>
    </div>

    <div id="pt-library-search-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-library-search-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-library-search-dialog">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div class="space-y-2 min-w-0">
            <h2 class="pt-opening-label">Search Library</h2>
            <p id="pt-library-search-count" class="pt-opening-hint">Search your remaining library.</p>
          </div>
          <button id="pt-library-search-close"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Close
          </button>
        </div>
        <label class="block">
          <span class="sr-only">Search library</span>
          <input id="pt-library-search-input"
                 type="search"
                 autocomplete="off"
                 class="mt-control"
                 placeholder="Search by name, type, or text">
        </label>
        <div id="pt-library-search-results" class="pt-library-search-results"></div>
      </section>
    </div>

    <div id="pt-count-picker-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-count-picker-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-count-picker-dialog">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-1">
            <h2 id="pt-count-picker-title" class="pt-opening-label">Choose Count</h2>
            <p id="pt-count-picker-hint" class="pt-opening-hint">Choose how many cards.</p>
          </div>
          <button id="pt-count-picker-close"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Close
          </button>
        </div>
        <div id="pt-count-picker-options" class="pt-count-picker-options"></div>
        <button id="pt-count-picker-custom"
                type="button"
                class="mt-btn mt-btn--secondary w-full">
          Choose X
        </button>
      </section>
    </div>

    <div id="pt-custom-count-overlay" class="hidden fixed inset-0 z-50">
      <button id="pt-custom-count-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(360px,92vw)] mt-panel bg-slate-950/95 p-4 space-y-3">
        <div class="flex items-center justify-between">
          <h2 id="pt-custom-count-title" class="text-sm font-semibold text-slate-100">Choose X</h2>
          <button id="pt-custom-count-close"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Close
          </button>
        </div>
        <label for="pt-custom-count-input" class="block text-xs text-slate-400 mb-1">Count</label>
        <input id="pt-custom-count-input"
               type="text"
               inputmode="numeric"
               pattern="[0-9]*"
               value="1"
               class="mt-control mt-control--sm">
        <button id="pt-custom-count-submit"
                type="button"
                class="mt-btn mt-btn--primary w-full">
          Confirm
        </button>
      </section>
