          transform 170ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform, margin-left;
      }

      .pt-scry-fan-card .pt-card {
        width: var(--pt-card-width);
      }

      .pt-reveal-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        border: 1px solid rgba(51, 65, 85, 0.78);
        background: rgba(15, 23, 42, 0.64);
        padding: 0.65rem 0.75rem;
      }

      .pt-reveal-tools__label {
        color: rgb(226 232 240);
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1.2;
      }

      .pt-reveal-toggle {
        display: inline-grid;
        grid-template-columns: repeat(2, minmax(3rem, 1fr));
        gap: 0.25rem;
        border-radius: 9999px;
        border: 1px solid rgba(51, 65, 85, 0.72);
        background: rgba(2, 6, 23, 0.72);
        padding: 0.18rem;
      }

      .pt-reveal-toggle__option {
        border-radius: 9999px;
        color: rgb(148 163 184);
        font-size: 0.72rem;
        font-weight: 900;
        line-height: 1;
        padding: 0.42rem 0.62rem;
      }

      .pt-reveal-toggle__option[aria-pressed="true"] {
        background: rgba(14, 165, 233, 0.24);
        color: rgb(240 249 255);
        box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.42) inset;
      }

      .pt-reveal-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(var(--pt-card-width), 1fr));
        gap: 0.75rem;
        align-items: start;
      }

      .pt-reveal-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
      }

      .pt-reveal-card .pt-card {
        width: var(--pt-card-width);
      }

      .pt-reveal-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.28rem;
        width: min(100%, calc(var(--pt-card-width) + 2.6rem));
      }

      .pt-reveal-action {
        border-radius: 0.55rem;
        border: 1px solid rgba(51, 65, 85, 0.84);
        background: rgba(15, 23, 42, 0.78);
        color: rgb(226 232 240);
        font-size: 0.66rem;
        font-weight: 800;
        line-height: 1;
        padding: 0.45rem 0.35rem;
        text-align: center;
      }

      .pt-reveal-action:hover {
        border-color: rgba(56, 189, 248, 0.48);
        background: rgba(8, 47, 73, 0.42);
        color: rgb(240 249 255);
      }

      .pt-scry-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: var(--pt-card-height);
        color: rgb(100 116 139);
        font-size: 0.84rem;
        text-align: center;
      }

      .pt-card--selected {
        box-shadow:
          0 0 0 2px rgba(56, 189, 248, 0.9),
          0 16px 28px rgba(2, 6, 23, 0.55);
        transform: translateY(-2px);
      }

      .pt-library-stack {
        position: relative;
        width: var(--pt-card-width);
        height: var(--pt-card-height);
        margin: 2px auto 0;
      }

      .pt-library-stack__card {
        position: absolute;
        inset: 0;
        border-radius: 0;
        border: 1px solid rgba(15, 23, 42, 0.92);
        background-image:
          url("https://cards.scryfall.io/back.png"),
          radial-gradient(circle at 18% 20%, rgba(220, 38, 38, 0.82), transparent 6%),
          radial-gradient(circle at 29% 10%, rgba(245, 158, 11, 0.84), transparent 6%),
          radial-gradient(circle at 43% 6%, rgba(250, 204, 21, 0.9), transparent 6%),
          radial-gradient(circle at 57% 10%, rgba(34, 197, 94, 0.84), transparent 6%),
          radial-gradient(circle at 68% 20%, rgba(59, 130, 246, 0.84), transparent 6%),
          radial-gradient(circle at center, rgba(221, 194, 124, 0.62) 0%, rgba(143, 94, 46, 0.74) 22%, transparent 24%),
          radial-gradient(circle at center, rgba(21, 69, 122, 0.98) 0%, rgba(21, 69, 122, 0.98) 34%, rgba(58, 35, 16, 1) 36%, rgba(136, 87, 37, 0.96) 47%, rgba(39, 22, 8, 1) 61%, rgba(90, 56, 20, 0.96) 73%, rgba(14, 21, 34, 1) 100%);
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        box-shadow: 0 8px 20px rgba(2, 6, 23, 0.42);
      }

      .pt-library-stack__card:nth-child(2) {
        --pt-library-card-x: -5px;
        --pt-library-card-y: 4px;
        transform: translate(var(--pt-library-card-x), var(--pt-library-card-y));
      }

      .pt-library-stack__card:nth-child(3) {
        --pt-library-card-x: -10px;
        --pt-library-card-y: 8px;
        transform: translate(var(--pt-library-card-x), var(--pt-library-card-y));
      }

      .pt-library-stack__card {
        --pt-library-card-x: 0px;
        --pt-library-card-y: 0px;
      }

      .pt-library-zone--shuffle .pt-library-stack__card {
        animation: pt-library-shuffle 440ms ease-out;
      }

      .pt-library-zone--shuffle .pt-library-stack__card:nth-child(2) {
        animation-delay: 45ms;
      }

      .pt-library-zone--shuffle .pt-library-stack__card:nth-child(3) {
        animation-delay: 90ms;
      }

      @keyframes pt-library-shuffle {
        0%, 100% {
          transform: translate(var(--pt-library-card-x), var(--pt-library-card-y)) rotate(0deg);
        }
        32% {
          transform: translate(calc(var(--pt-library-card-x) + 7px), calc(var(--pt-library-card-y) - 3px)) rotate(1.2deg);
        }
        66% {
          transform: translate(calc(var(--pt-library-card-x) - 5px), calc(var(--pt-library-card-y) + 2px)) rotate(-0.8deg);
        }
      }

    </style>

    {{ template "card_ui_helpers_script" . }}
    <script>
      window.ManatombPlaytestConfig = {
        librarySeed: {{ $ctx.CardsJSON }},
        commanderSeed: {{ $ctx.CommanderJSON }},
        workbenchDraftSeed: {{ if $ctx.WorkbenchJSON }}{{ $ctx.WorkbenchJSON }}{{ else }}null{{ end }},
        deckFormat: {{ toJSON $deck.Format }},
        isWorkbenchPlaytest: {{ if $ctx.WorkbenchMode }}true{{ else }}false{{ end }}
      };
    </script>
    <script src="/assets/playtest.js"></script>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
