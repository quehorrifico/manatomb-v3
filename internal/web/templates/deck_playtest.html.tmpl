    <style>
      .pt-playtest-root {
        --pt-card-width: 108px;
        --pt-card-height: 151px;
        height: calc(100vh - 1.5rem);
        height: calc(100dvh - 1.5rem);
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        overflow: hidden;
      }

      .pt-battlefield-section {
        min-height: 0;
      }

      .pt-zones-section {
        flex: 0 0 clamp(190px, 26vh, 245px);
        height: auto;
      }

      .pt-zones-grid {
        display: grid;
        grid-template-columns: minmax(380px, 1fr) minmax(480px, 0.78fr);
        gap: 0.35rem;
        min-height: 0;
        height: 100%;
      }

      .pt-side-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(var(--pt-card-width), 1fr));
        gap: 0.35rem;
        min-height: 0;
      }

      @media (min-width: 1180px) {
        .pt-playtest-root {
          gap: 0.42rem;
        }
      }

      @media (max-width: 980px) {
        .pt-zones-section {
          flex-basis: clamp(220px, 34vh, 300px);
        }

        .pt-zones-grid {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: minmax(112px, 1fr) minmax(96px, 0.82fr);
        }

        .pt-side-grid {
          grid-template-columns: repeat(4, minmax(var(--pt-card-width), 1fr));
          overflow-x: auto;
        }
      }

      .pt-game-bar {
        position: relative;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.45rem;
        width: 100%;
        min-height: 2.8rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(30, 41, 59, 0.92);
        background: rgba(2, 6, 23, 0.92);
        box-shadow: 0 14px 36px rgba(2, 6, 23, 0.38);
        padding: 0.42rem 0.5rem;
        overflow: visible;
      }

      .pt-toolbar-buttons {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        min-width: 0;
        flex: 0 0 auto;
      }

      .pt-toolbar-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        min-height: 1.9rem;
        border-radius: 0.6rem;
        border: 1px solid rgba(51, 65, 85, 0.92);
        background: rgba(15, 23, 42, 0.88);
        color: rgb(226 232 240);
        font-size: 0.74rem;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        padding: 0.42rem 0.65rem;
      }

      .pt-toolbar-button:hover,
      .pt-toolbar-button[aria-expanded="true"] {
        border-color: rgba(56, 189, 248, 0.48);
        background: rgba(8, 47, 73, 0.42);
        color: rgb(240 249 255);
      }

      .pt-toolbar-menu {
        position: absolute;
        left: 0.5rem;
        right: auto;
        bottom: calc(100% + 0.4rem);
        z-index: 320;
        min-width: 13rem;
        max-width: min(92vw, 38rem);
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        border-radius: 0.8rem;
        border: 1px solid rgba(51, 65, 85, 0.92);
        background: rgba(2, 6, 23, 0.98);
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.5);
        padding: 0.55rem;
      }

      .pt-toolbar-menu.hidden {
        display: none;
      }

      .pt-toolbar-menu--wide {
        width: min(38rem, calc(100vw - 1.5rem));
      }

      .pt-toolbar-menu__counter {
        display: grid;
        grid-template-columns: 2rem minmax(3rem, 1fr) 2rem;
        align-items: center;
        gap: 0.5rem;
      }

      .pt-toolbar-menu__value {
        min-width: 3rem;
        text-align: center;
        color: rgb(248 250 252);
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1;
      }

      .pt-toolbar-submenu,
      .pt-library-menu__panel {
        position: fixed;
        z-index: 340;
        min-width: 9.5rem;
        max-width: calc(100vw - 1rem);
        max-height: min(54vh, 20rem);
        overflow: auto;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        border-radius: 0.85rem;
        border: 1px solid rgba(51, 65, 85, 0.92);
        background: rgba(2, 6, 23, 0.98);
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.48);
        padding: 0.35rem;
      }

      .pt-toolbar-submenu.hidden,
      .pt-library-menu__panel.hidden {
        display: none;
      }

      .pt-toolbar-mana-summary,
      .pt-toolbar-mana-pips {
        display: inline-flex;
        align-items: center;
        gap: 0.12rem;
      }

      .pt-toolbar-mana-pips img {
        width: 0.92rem;
        height: 0.92rem;
      }

      .pt-zone-card {
        position: relative;
        min-height: 0;
        display: flex;
        flex-direction: column;
        border-radius: 0.45rem;
        border: 0;
        background: transparent;
        padding: 0.18rem 0.2rem;
      }

      .pt-command-tax {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.45rem;
        width: 100%;
        border-radius: 0.65rem;
        border: 1px solid rgba(51, 65, 85, 0.78);
        background: rgba(15, 23, 42, 0.72);
        color: rgb(203 213 225);
        padding: 0.4rem;
      }

      .pt-command-tax__label {
        min-width: 2.7rem;
        text-align: center;
        font-size: 0.66rem;
        font-weight: 800;
        line-height: 1;
        text-transform: uppercase;
      }

      .pt-command-tax__step {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.05rem;
        height: 1.05rem;
        border-radius: 9999px;
        color: rgb(226 232 240);
        font-size: 0.74rem;
        font-weight: 900;
        line-height: 1;
      }

      .pt-command-tax__step:hover {
        background: rgba(30, 41, 59, 0.88);
        color: rgb(248 250 252);
      }

      .pt-command-tax__step:disabled {
        opacity: 0.36;
        cursor: not-allowed;
      }

      .pt-visible-status {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: 1 1 16rem;
        min-width: 10rem;
        max-width: 34rem;
        border: 1px solid rgba(51, 65, 85, 0.6);
        border-radius: 0.55rem;
        background: rgba(15, 23, 42, 0.58);
        padding: 0.38rem 0.6rem;
        color: rgb(203 213 225);
        font-size: 0.78rem;
        line-height: 1.25;
        text-align: left;
        overflow: hidden;
        backdrop-filter: blur(8px);
        cursor: pointer;
      }

      .pt-visible-status__text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .pt-visible-status__hint {
        margin-left: auto;
        flex: 0 0 auto;
        color: rgba(203, 213, 225, 0.5);
        font-size: 0.66rem;
        line-height: 1;
        white-space: nowrap;
      }

      .pt-visible-status:hover {
        border-color: rgba(56, 189, 248, 0.42);
        background: rgba(15, 23, 42, 0.78);
        color: rgb(226 232 240);
      }

      .pt-overlay-metric {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border: 1px solid rgba(51, 65, 85, 0.94);
        border-radius: 9999px;
        background: rgba(2, 6, 23, 0.92);
        box-shadow: 0 12px 24px rgba(2, 6, 23, 0.35);
        padding: 0.35rem 0.6rem;
        color: rgb(226 232 240);
        backdrop-filter: blur(8px);
      }

      .pt-overlay-metric__label {
        font-size: 0.63rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgb(148 163 184);
      }

      .pt-overlay-metric__value {
        min-width: 1.2rem;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1;
        color: rgb(248 250 252);
        text-align: center;
      }

      .pt-overlay-metric__step {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 9999px;
        background: rgba(15, 23, 42, 0.96);
        color: rgb(226 232 240);
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1;
      }

      .pt-overlay-metric__step:hover {
        background: rgba(30, 41, 59, 0.98);
        color: rgb(248 250 252);
      }

      .pt-mana-tracker {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border: 1px solid rgba(51, 65, 85, 0.94);
        border-radius: 9999px;
        background: rgba(2, 6, 23, 0.92);
        box-shadow: 0 12px 24px rgba(2, 6, 23, 0.35);
        padding: 0.28rem 0.45rem 0.28rem 0.6rem;
        color: rgb(226 232 240);
        backdrop-filter: blur(8px);
      }

      .pt-mana-list {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
      }

      .pt-mana-item {
        display: inline-grid;
        grid-template-columns: 1rem 1.2rem 1.05rem 1rem;
        align-items: center;
        justify-items: center;
        min-height: 1.45rem;
        border-radius: 9999px;
        border: 1px solid rgba(51, 65, 85, 0.72);
        background: rgba(15, 23, 42, 0.88);
        overflow: hidden;
      }

      .pt-mana-symbol {
        width: 1.05rem;
        height: 1.05rem;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.58rem;
        font-weight: 800;
        color: rgb(15 23 42);
        background: transparent;
      }

      .pt-mana-symbol img {
        width: 1.05rem;
        height: 1.05rem;
      }

      .pt-mana-count {
        min-width: 1rem;
        color: rgb(248 250 252);
        font-size: 0.74rem;
        font-weight: 800;
        line-height: 1;
      }

      .pt-mana-step,
      .pt-mana-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: rgb(203 213 225);
        font-size: 0.66rem;
        font-weight: 800;
        line-height: 1;
      }

      .pt-mana-step {
        width: 1rem;
        height: 1.45rem;
      }

      .pt-mana-step:hover,
      .pt-mana-clear:hover {
        color: rgb(248 250 252);
        background: rgba(30, 41, 59, 0.74);
      }

      .pt-mana-clear {
        min-height: 1.45rem;
        border-radius: 9999px;
        padding: 0 0.45rem;
      }

      @media (max-width: 760px) {
        .pt-game-bar {
          gap: 0.35rem;
          align-items: center;
          flex-direction: row;
        }

        .pt-toolbar-buttons {
          flex: 0 1 auto;
          width: auto;
          overflow-x: auto;
        }

        .pt-mana-tracker {
          width: min(100%, 22rem);
          border-radius: 0.85rem;
          flex-wrap: wrap;
        }

        .pt-mana-list {
          flex-wrap: wrap;
        }

        .pt-visible-status {
          width: auto;
          flex: 1 1 8rem;
          max-width: none;
          min-width: 7rem;
        }

        .pt-visible-status__hint {
          display: none;
        }

        .pt-card-detail-dialog {
          width: min(560px, calc(100vw - 1.25rem));
          padding: 1rem;
