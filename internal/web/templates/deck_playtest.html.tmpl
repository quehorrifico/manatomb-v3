{{ define "deck_playtest" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $deck := $ctx.Deck }}
  {{ $authNext := $ctx.AuthNextPath }}
  {{ if not $authNext }}
    {{ $authNext = "/decks/new" }}
  {{ end }}

  <main class="max-w-[1680px] mx-auto px-4 xl:px-6 overflow-hidden">
    <div class="pt-playtest-root">
      <section class="mt-panel p-4 sm:p-5 flex-1 min-h-0 flex flex-col">
        <p id="pt-status" class="sr-only" aria-live="polite"></p>

        <div class="relative flex-1 min-h-0">
          <div class="pt-battlefield-toolbar">
            <div class="pt-battlefield-metrics">
              <div class="pt-overlay-metric">
                <span class="pt-overlay-metric__label">Turn</span>
                <span id="pt-turn-count" class="pt-overlay-metric__value">0</span>
              </div>
              <div class="pt-overlay-metric pt-overlay-metric--life">
                <span class="pt-overlay-metric__label">Life</span>
                <button id="pt-life-down"
                        type="button"
                        class="pt-overlay-metric__step"
                        aria-label="Lose 1 life">
                  -
                </button>
                <span id="pt-life-total" class="pt-overlay-metric__value">0</span>
                <button id="pt-life-up"
                        type="button"
                        class="pt-overlay-metric__step"
                        aria-label="Gain 1 life">
                  +
                </button>
              </div>
            </div>
            <div class="pt-battlefield-actions">
              <button id="pt-end-turn"
                      type="button"
                      class="mt-btn mt-btn--secondary mt-btn--xs">
                End Turn
              </button>
              <button id="pt-game-menu-toggle"
                      type="button"
                      class="mt-btn mt-btn--secondary mt-btn--xs">
                Game Menu
              </button>
            </div>
          </div>
          <div id="pt-zone-battlefield"
               data-zone="battlefield"
               class="pt-drop-zone pt-battlefield-zone h-full rounded-xl bg-slate-950/80 p-3 relative overflow-hidden"></div>
        </div>
      </section>

      <section class="pt-zones-section flex flex-col min-h-0">
        <div class="pt-zones-grid flex-1 min-h-0">
          <div class="pt-zone-card">
            <div class="flex items-center justify-between gap-2">
              <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Hand</p>
              <span id="pt-count-hand" class="text-xs font-semibold text-slate-200">0</span>
            </div>
            <div id="pt-zone-hand"
                 data-zone="hand"
                 class="pt-drop-zone pt-hand-zone mt-2 flex-1 min-h-0 rounded-xl bg-slate-950/80 p-1.5 flex gap-1.5 overflow-x-auto overflow-y-hidden items-start"></div>
          </div>

          <div class="pt-side-grid">
            <div class="pt-zone-card">
              <div class="relative flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Library</p>
                  <button id="pt-library-menu-toggle"
                          type="button"
                          class="pt-menu-trigger"
                          aria-label="Library menu">
                    ...
                  </button>
                </div>
                <span id="pt-count-library" class="text-xs font-semibold text-slate-200">0</span>
                <div id="pt-library-menu"
                     class="hidden pt-inline-menu right-0 top-full mt-2">
                  <button id="pt-library-menu-shuffle"
                          type="button"
                          class="pt-inline-menu__item">
                    Shuffle
                  </button>
                  <button id="pt-library-menu-scry-1"
                          type="button"
                          class="pt-inline-menu__item">
                    Scry 1
                  </button>
                  <button id="pt-library-menu-scry-2"
                          type="button"
                          class="pt-inline-menu__item">
                    Scry 2
                  </button>
                  <button id="pt-library-menu-scry-3"
                          type="button"
                          class="pt-inline-menu__item">
                    Scry 3
                  </button>
                </div>
              </div>
              <div id="pt-zone-library"
                   data-zone="library"
                   class="pt-drop-zone pt-side-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden cursor-pointer"></div>
            </div>

            <div class="pt-zone-card">
              <div class="flex items-center justify-between gap-2">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Graveyard</p>
                <span id="pt-count-graveyard" class="text-xs font-semibold text-slate-200">0</span>
              </div>
              <div id="pt-zone-graveyard"
                   data-zone="graveyard"
                   class="pt-drop-zone pt-side-zone pt-stack-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden"></div>
            </div>

            <div class="pt-zone-card">
              <div class="flex items-center justify-between gap-2">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Exile</p>
                <span id="pt-count-exile" class="text-xs font-semibold text-slate-200">0</span>
              </div>
              <div id="pt-zone-exile"
                   data-zone="exile"
                   class="pt-drop-zone pt-side-zone pt-stack-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden"></div>
            </div>

            <div class="pt-zone-card">
              <div class="flex items-center justify-between gap-2">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Command</p>
                <span id="pt-count-command" class="text-xs font-semibold text-slate-200">0</span>
              </div>
              <div id="pt-zone-command"
                   data-zone="command"
                   class="pt-drop-zone pt-side-zone pt-stack-zone mt-2 rounded-xl bg-slate-950/80 relative overflow-hidden"></div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div id="pt-opening-screen" class="pt-opening-overlay">
      <div class="pt-opening-overlay__backdrop"></div>
      <section class="pt-opening-dialog">
        <div class="pt-opening-dialog__hero">
          <div class="pt-opening-title-row">
            <h1 id="pt-opening-label" class="pt-opening-label">Opening Hand</h1>
            <span id="pt-opening-progress" class="mt-chip">7 cards</span>
          </div>
          <p id="pt-opening-hint" class="pt-opening-hint">Review this hand, then keep or take a fresh seven.</p>
        </div>

        <div id="pt-opening-hand" class="pt-opening-hand-grid"></div>

        <div class="pt-opening-actions">
          <button id="pt-mulligan"
                  class="mt-btn mt-btn--warning pt-opening-action">
            Mulligan (0)
          </button>
          <button id="pt-keep"
                  class="mt-btn mt-btn--primary pt-opening-action">
            Keep
          </button>
        </div>
      </section>
    </div>

    <div id="pt-token-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-token-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(360px,92vw)] mt-panel bg-slate-950/95 p-4 space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-100">Token</h2>
          <button id="pt-token-close"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Close
          </button>
        </div>
        <div class="space-y-2">
          <div>
            <label for="pt-token-name" class="block text-xs text-slate-400 mb-1">Name</label>
            <input id="pt-token-name"
                   type="text"
                   value="Token"
                   class="mt-control mt-control--sm">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="pt-token-power" class="block text-xs text-slate-400 mb-1">Power</label>
              <input id="pt-token-power"
                     type="number"
                     value="1"
                     min="0"
                     class="mt-control mt-control--sm">
            </div>
            <div>
              <label for="pt-token-toughness" class="block text-xs text-slate-400 mb-1">Toughness</label>
              <input id="pt-token-toughness"
                     type="number"
                     value="1"
                     min="0"
                     class="mt-control mt-control--sm">
            </div>
          </div>
          <div>
            <label for="pt-token-type" class="block text-xs text-slate-400 mb-1">Type</label>
            <input id="pt-token-type"
                   type="text"
                   placeholder="e.g. Creature — Soldier"
                   class="mt-control mt-control--sm">
          </div>
          <div>
            <label for="pt-token-qty" class="block text-xs text-slate-400 mb-1">Quantity</label>
            <input id="pt-token-qty"
                   type="number"
                   value="1"
                   min="1"
                   max="20"
                   class="mt-control mt-control--sm">
          </div>
        </div>
        <button id="pt-token-submit"
                class="mt-btn mt-btn--primary w-full">
          Add to Battlefield
        </button>
      </section>
    </div>

    <div id="pt-game-menu-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-game-menu-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-game-menu-dialog">
        <div class="pt-opening-dialog__hero">
          <div class="pt-opening-title-row">
            <h2 class="pt-opening-label">Game Menu</h2>
          </div>
          <p class="pt-opening-hint">Leave playtest to return to deck editing, or close this menu and keep goldfishing.</p>
        </div>

        <div class="pt-opening-actions">
          <a id="pt-game-menu-return"
             href="{{ $authNext }}"
             class="mt-btn mt-btn--primary pt-opening-action">
            Back to Deck
          </a>
          <button id="pt-game-menu-restart"
                  type="button"
                  class="mt-btn mt-btn--warning pt-opening-action">
            Restart Playtest
          </button>
          <button id="pt-game-menu-close"
                  type="button"
                  class="mt-btn mt-btn--secondary pt-opening-action">
            Resume Playtest
          </button>
        </div>
      </section>
    </div>

    <div id="pt-scry-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-scry-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-opening-dialog">
        <div class="pt-opening-dialog__hero">
          <div class="pt-opening-title-row">
            <h2 class="pt-opening-label">Scry</h2>
          </div>
          <p id="pt-scry-hint" class="pt-opening-hint">Choose which cards stay on top and which go to the bottom.</p>
        </div>

        <div id="pt-scry-cards" class="pt-opening-hand-grid"></div>

        <div class="pt-opening-actions">
          <button id="pt-scry-cancel"
                  type="button"
                  class="mt-btn mt-btn--secondary pt-opening-action">
            Cancel
          </button>
          <button id="pt-scry-finish"
                  type="button"
                  class="mt-btn mt-btn--primary pt-opening-action">
            Done
          </button>
        </div>
      </section>
    </div>

    <div id="pt-card-menu-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-card-menu-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-game-menu-dialog">
        <div class="pt-opening-dialog__hero">
          <div class="pt-opening-title-row">
            <h2 id="pt-card-menu-title" class="pt-opening-label">Card</h2>
          </div>
        </div>

        <div class="space-y-4">
          <button id="pt-card-menu-details"
                  type="button"
                  class="mt-btn mt-btn--primary w-full">
            View Details
          </button>

          <div class="space-y-2">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Move To</p>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" class="mt-btn mt-btn--secondary mt-btn--sm pt-card-move-btn" data-zone="hand">Hand</button>
              <button type="button" class="mt-btn mt-btn--secondary mt-btn--sm pt-card-move-btn" data-zone="graveyard">Graveyard</button>
              <button type="button" class="mt-btn mt-btn--secondary mt-btn--sm pt-card-move-btn" data-zone="exile">Exile</button>
              <button id="pt-card-menu-move-command" type="button" class="mt-btn mt-btn--secondary mt-btn--sm pt-card-move-btn" data-zone="command">Command</button>
            </div>
          </div>

          <button id="pt-card-menu-close"
                  type="button"
                  class="mt-btn mt-btn--secondary w-full">
            Close
          </button>
        </div>
      </section>
    </div>

    <div id="pt-card-detail-overlay" class="hidden fixed inset-0 z-40">
      <button id="pt-card-detail-backdrop"
              type="button"
              class="absolute inset-0 bg-slate-950/70"></button>
      <section class="pt-card-detail-dialog">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-3">
              <h2 id="pt-card-detail-name" class="pt-opening-label">Card</h2>
              <div id="pt-card-detail-mana" class="flex flex-wrap items-center gap-1"></div>
            </div>
            <p id="pt-card-detail-type" class="text-sm text-slate-400"></p>
          </div>
          <button id="pt-card-detail-close"
                  type="button"
                  class="mt-btn mt-btn--secondary mt-btn--xs">
            Close
          </button>
        </div>

        <div class="pt-card-detail-grid">
          <div class="pt-card-detail-art">
            <img id="pt-card-detail-image"
                 alt=""
                 class="w-full h-auto rounded-xl bg-slate-900 hidden">
            <div id="pt-card-detail-fallback"
                 class="hidden min-h-[320px] rounded-xl bg-slate-900 p-6 text-center text-sm text-slate-300"></div>
          </div>
          <div class="space-y-4 min-w-0">
            <div class="space-y-2">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Oracle Text</p>
              <div id="pt-card-detail-oracle"
                   class="rounded-xl border border-slate-800 bg-slate-950/70 p-4 text-sm leading-6 text-slate-200 whitespace-pre-wrap"></div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <style>
      .pt-playtest-root {
        height: calc(100vh - 1.5rem);
        height: calc(100dvh - 1.5rem);
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        overflow: hidden;
      }

      .pt-zones-section {
        flex: 0 0 clamp(198px, 28vh, 244px);
        height: auto;
      }

      .pt-zones-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(480px, 1fr);
        gap: 0.55rem;
        min-height: 0;
      }

      .pt-side-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.55rem;
        min-height: 0;
      }

      .pt-zone-card {
        position: relative;
        min-height: 0;
        display: flex;
        flex-direction: column;
        border-radius: 0.85rem;
        border: 1px solid rgba(30, 41, 59, 0.92);
        background: rgba(2, 6, 23, 0.58);
        padding: 0.5rem 0.55rem;
      }

      .pt-battlefield-toolbar {
        position: absolute;
        top: 0.7rem;
        left: 0.7rem;
        right: 0.7rem;
        z-index: 30;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .pt-battlefield-metrics {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }

      .pt-battlefield-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }

      .pt-overlay-metric {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border: 1px solid rgba(51, 65, 85, 0.94);
        border-radius: 9999px;
        background: rgba(2, 6, 23, 0.92);
        box-shadow: 0 12px 24px rgba(2, 6, 23, 0.35);
        padding: 0.35rem 0.6rem;
        color: rgb(226 232 240);
        backdrop-filter: blur(8px);
      }

      .pt-overlay-metric__label {
        font-size: 0.63rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgb(148 163 184);
      }

      .pt-overlay-metric__value {
        min-width: 1.2rem;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1;
        color: rgb(248 250 252);
        text-align: center;
      }

      .pt-overlay-metric__step {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.25rem;
        height: 1.25rem;
        border-radius: 9999px;
        background: rgba(15, 23, 42, 0.96);
        color: rgb(226 232 240);
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1;
      }

      .pt-overlay-metric__step:hover {
        background: rgba(30, 41, 59, 0.98);
        color: rgb(248 250 252);
      }

      .pt-menu-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.45rem;
        height: 1.45rem;
        border-radius: 9999px;
        border: 1px solid rgba(51, 65, 85, 0.92);
        background: rgba(15, 23, 42, 0.9);
        color: rgb(203 213 225);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .pt-menu-trigger:hover {
        border-color: rgba(56, 189, 248, 0.45);
        color: rgb(240 249 255);
      }

      .pt-inline-menu {
        position: absolute;
        z-index: 20;
        min-width: 8.5rem;
        border-radius: 0.85rem;
        border: 1px solid rgba(51, 65, 85, 0.92);
        background: rgba(2, 6, 23, 0.96);
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.42);
        padding: 0.35rem;
      }

      .pt-inline-menu__item {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        border-radius: 0.65rem;
        padding: 0.55rem 0.7rem;
        font-size: 0.8rem;
        color: rgb(226 232 240);
        text-align: left;
      }

      .pt-inline-menu__item:hover {
        background: rgba(15, 23, 42, 0.94);
        color: rgb(240 249 255);
      }

      .pt-drop-zone.pt-drop-zone--active {
        background: rgb(8 47 73 / 0.62);
        box-shadow: 0 0 0 2px rgb(14 116 144 / 0.5) inset;
      }

      .pt-battlefield-zone {
        background-image:
          linear-gradient(rgba(51, 65, 85, 0.14) 1px, transparent 1px),
          linear-gradient(90deg, rgba(51, 65, 85, 0.14) 1px, transparent 1px),
          radial-gradient(circle at top, rgba(14, 165, 233, 0.08), transparent 55%);
        background-size: 24px 24px, 24px 24px, auto;
        background-position: center;
      }

      .pt-card {
        width: 96px;
        border-radius: 0.65rem;
        overflow: hidden;
        background: rgb(2 6 23);
        box-shadow: 0 8px 22px rgba(2, 6, 23, 0.55);
        cursor: grab;
        transition: transform 120ms ease, box-shadow 120ms ease;
        user-select: none;
        position: relative;
      }

      .pt-card:hover {
        transform: translateY(-2px);
      }

      .pt-card:active {
        cursor: grabbing;
      }

      .pt-card.pt-card--opening {
        width: clamp(140px, 11vw, 190px);
      }

      .pt-card.pt-card--stack {
        width: 72px;
      }

      .pt-card.pt-card--tapped {
        transform: rotate(90deg) scale(0.96);
        margin-left: 12px;
        margin-right: 12px;
      }

      .pt-card__image {
        width: 100%;
        aspect-ratio: 63 / 88;
        object-fit: cover;
        display: block;
        background: linear-gradient(160deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.9));
      }

      .pt-card__fallback {
        width: 100%;
        aspect-ratio: 63 / 88;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 11px;
        line-height: 1.2;
        color: rgb(203 213 225);
        padding: 10px;
        background: linear-gradient(160deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.9));
      }

      .pt-card__chips {
        position: absolute;
        top: 5px;
        left: 5px;
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
      }

      .pt-card__menu {
        position: absolute;
        top: 50%;
        right: 4px;
        transform: translateY(-50%);
        z-index: 3;
      }

      .pt-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        padding: 1px 7px;
        font-size: 10px;
        line-height: 1.25;
        letter-spacing: 0.02em;
      }

      .pt-chip--commander {
        background: rgb(186 230 253);
        color: rgb(2 6 23);
        font-weight: 700;
      }

      .pt-chip--tapped {
        background: rgb(250 204 21);
        color: rgb(15 23 42);
        font-weight: 700;
      }

      .pt-hand-zone {
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
      }

      .pt-hand-zone > .pt-card {
        flex: 0 0 auto;
        scroll-snap-align: start;
      }

      .pt-hand-zone::-webkit-scrollbar {
        height: 8px;
      }

      .pt-hand-zone::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.45);
        border-radius: 999px;
      }

      .pt-hand-zone::-webkit-scrollbar-thumb {
        background: rgba(71, 85, 105, 0.9);
        border-radius: 999px;
      }

      .pt-side-zone {
        min-height: 0;
        flex: 1;
      }

      .pt-opening-overlay {
        position: fixed;
        inset: 0;
        z-index: 40;
      }

      .pt-opening-overlay__backdrop {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at top, rgba(14, 165, 233, 0.16), transparent 34%),
          linear-gradient(180deg, rgba(2, 6, 23, 0.86), rgba(2, 6, 23, 0.94));
        backdrop-filter: blur(10px);
      }

      .pt-opening-dialog {
        position: absolute;
        inset: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        border-radius: 1.2rem;
        border: 1px solid rgba(71, 85, 105, 0.88);
        background:
          linear-gradient(180deg, rgba(2, 6, 23, 0.97), rgba(2, 6, 23, 0.94)),
          radial-gradient(circle at top, rgba(14, 165, 233, 0.14), transparent 52%);
        padding: 1.35rem 1.4rem 1.2rem;
        overflow: hidden;
        box-shadow:
          0 24px 60px rgba(2, 6, 23, 0.58),
          inset 0 1px 0 rgba(148, 163, 184, 0.12);
      }

      .pt-opening-dialog__hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-align: center;
      }

      .pt-opening-title-row {
        display: flex;
