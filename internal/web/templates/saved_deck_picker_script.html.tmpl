{{ define "saved_deck_picker_script" }}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var cardUI = window.ManatombCardUI || {};
      var trimValue = cardUI.trimValue || function (value) {
        return String(value || "").trim();
      };

      var pageStatus = document.querySelector("[data-deck-action-status]");
      var pageStatusText = document.querySelector("[data-deck-action-status-text]");
      var pageStatusLink = document.querySelector("[data-deck-action-status-link]");

      function setPageStatus(kind, message, href, linkLabel) {
        if (!pageStatus || !pageStatusText) return;

        pageStatus.hidden = false;
        pageStatus.classList.remove(
          "border-emerald-500/40",
          "bg-emerald-500/10",
          "text-emerald-100",
          "border-rose-500/40",
          "bg-rose-500/10",
          "text-rose-100"
        );

        if (kind === "error") {
          pageStatus.classList.add("border-rose-500/40", "bg-rose-500/10", "text-rose-100");
        } else {
          pageStatus.classList.add("border-emerald-500/40", "bg-emerald-500/10", "text-emerald-100");
        }

        pageStatusText.textContent = message || "";
        if (pageStatusLink && href) {
          pageStatusLink.href = href;
          pageStatusLink.textContent = linkLabel || "Open deck";
          pageStatusLink.classList.remove("hidden");
        } else if (pageStatusLink) {
          pageStatusLink.href = "#";
          pageStatusLink.textContent = "Open deck";
          pageStatusLink.classList.add("hidden");
        }
      }

      var pickerModal = document.querySelector("[data-saved-deck-picker-modal]");
      if (!pickerModal) return;

      var pickerCardName = pickerModal.querySelector("[data-deck-picker-card-name]");
      var pickerSearch = pickerModal.querySelector("[data-deck-picker-search]");
      var pickerStatus = pickerModal.querySelector("[data-deck-picker-status]");
      var pickerEmpty = pickerModal.querySelector("[data-deck-picker-empty]");
      var pickerNoDecks = pickerModal.querySelector("[data-deck-picker-no-decks]");
      var pickerOptions = Array.from(pickerModal.querySelectorAll("[data-deck-picker-option]"));
      var pickerCloseButtons = Array.from(pickerModal.querySelectorAll("[data-close-deck-picker]"));
      var pickerTriggers = Array.from(document.querySelectorAll("[data-open-deck-picker]"));
      var activeCardName = "";
      var activePickerButton = null;

      function setPickerStatus(kind, message) {
        if (!pickerStatus) return;
        if (!message) {
          pickerStatus.hidden = true;
          pickerStatus.textContent = "";
          pickerStatus.classList.remove(
            "border-rose-500/40",
            "bg-rose-500/10",
            "text-rose-100",
            "border-sky-500/40",
            "bg-sky-500/10",
            "text-sky-100"
          );
          return;
        }

        pickerStatus.hidden = false;
        pickerStatus.textContent = message;
        pickerStatus.classList.remove(
          "border-rose-500/40",
          "bg-rose-500/10",
          "text-rose-100",
          "border-sky-500/40",
          "bg-sky-500/10",
          "text-sky-100"
        );
        if (kind === "error") {
          pickerStatus.classList.add("border-rose-500/40", "bg-rose-500/10", "text-rose-100");
        } else {
          pickerStatus.classList.add("border-sky-500/40", "bg-sky-500/10", "text-sky-100");
        }
      }

      function filterDecks() {
        var query = pickerSearch ? trimValue(pickerSearch.value).toLowerCase() : "";
        var visibleCount = 0;

        pickerOptions.forEach(function (button) {
          var haystack = [
            button.dataset.deckName || "",
            button.dataset.commanderName || "",
            button.dataset.format || ""
          ].join(" ").toLowerCase();
          var visible = !query || haystack.indexOf(query) >= 0;
          button.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (pickerSearch) {
          pickerSearch.disabled = pickerOptions.length === 0;
        }
        if (pickerEmpty) {
          pickerEmpty.hidden = !(pickerOptions.length > 0 && visibleCount === 0);
        }
        if (pickerNoDecks) {
          pickerNoDecks.hidden = pickerOptions.length !== 0;
        }
      }

      function closePicker() {
        pickerModal.classList.add("hidden");
        activeCardName = "";
        activePickerButton = null;
        setPickerStatus("", "");
        if (pickerSearch) {
          pickerSearch.value = "";
        }
        filterDecks();
      }

      function openPicker(cardName) {
        activeCardName = trimValue(cardName);
        if (!activeCardName) return;
        if (pickerCardName) {
          pickerCardName.textContent = activeCardName;
        }
        setPickerStatus("", "");
        pickerModal.classList.remove("hidden");
        if (pickerSearch) {
          pickerSearch.value = "";
        }
        filterDecks();
        if (pickerSearch && !pickerSearch.disabled) {
          pickerSearch.focus();
        }
      }

      async function responseErrorMessage(res) {
        try {
          var text = trimValue(await res.text());
          if (!text) return "Could not add card to that deck.";
          if (text.indexOf("<") >= 0 && text.indexOf(">") >= 0) {
            return "Could not add card to that deck.";
          }
          return text;
        } catch (error) {
          return "Could not add card to that deck.";
        }
      }

      async function addCardToDeck(button) {
        if (!button || !activeCardName) return;

        var deckID = trimValue(button.dataset.deckId);
        var deckName = trimValue(button.dataset.deckName) || "deck";
        if (!deckID) return;

        setPickerStatus("info", "Adding " + activeCardName + " to " + deckName + "...");
        if (activePickerButton && activePickerButton !== button) {
          activePickerButton.disabled = false;
        }
        activePickerButton = button;
        button.disabled = true;

        var body = new URLSearchParams();
        body.set("card_name", activeCardName);

        try {
          var res = await fetch("/decks/" + encodeURIComponent(deckID), {
            method: "POST",
            credentials: "same-origin",
            headers: {
              "Accept": "application/json",
              "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
            },
            body: body.toString()
          });

          if (!res.ok) {
            throw new Error(await responseErrorMessage(res));
          }

          closePicker();
          setPageStatus("success", "Added " + activeCardName + " to " + deckName + ".", "/decks/" + encodeURIComponent(deckID), "Open deck");
        } catch (error) {
          setPickerStatus("error", error && error.message ? error.message : "Could not add card to that deck.");
        } finally {
          button.disabled = false;
        }
      }

      pickerTriggers.forEach(function (button) {
        button.addEventListener("click", function () {
          var closeSelector = trimValue(button.getAttribute("data-close-modal-selector"));
          if (closeSelector) {
            var modalToClose = document.querySelector(closeSelector);
            if (modalToClose) {
              modalToClose.classList.add("hidden");
            }
          }
          openPicker(button.getAttribute("data-card-name"));
        });
      });

      pickerOptions.forEach(function (button) {
        button.addEventListener("click", function () {
          addCardToDeck(button);
        });
      });

      pickerCloseButtons.forEach(function (button) {
        button.addEventListener("click", closePicker);
      });

      if (pickerSearch) {
        pickerSearch.addEventListener("input", filterDecks);
      }

      pickerModal.addEventListener("click", function (event) {
        if (event.target === pickerModal) {
          closePicker();
        }
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && !pickerModal.classList.contains("hidden")) {
          closePicker();
        }
      });

      filterDecks();
    });
  </script>
{{ end }}
