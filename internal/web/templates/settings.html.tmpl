{{ define "settings" }}
  {{ template "layout_header" . }}
  {{ $d := .Data }}

  <main class="max-w-5xl mx-auto py-10 px-4 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="space-y-2">
        <p class="mt-kicker">Account</p>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Settings</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
        <a href="/decks" class="mt-btn mt-btn--secondary mt-btn--sm">Decks</a>
      </div>
    </div>

    <section class="mt-panel p-5">
      <p class="mt-section-label mb-3">Profile</p>
      <div class="grid gap-3 sm:grid-cols-2 text-sm text-slate-200">
        <div class="mt-stat-card">
          <p class="text-slate-500 text-xs uppercase tracking-wide">Display Name</p>
          <p class="mt-1">{{ .CurrentUser.DisplayName }}</p>
        </div>
        <div class="mt-stat-card">
          <p class="text-slate-500 text-xs uppercase tracking-wide">Email</p>
          <p class="mt-1">{{ .CurrentUser.Email }}</p>
        </div>
      </div>
    </section>

    <section class="mt-panel p-5 sm:p-6">
      <p class="mt-section-label mb-4">Update Profile</p>
      <form method="POST" action="/settings" class="space-y-5">
        <input type="hidden" name="action" value="update_profile">

        <label class="block text-sm text-slate-200">
          <span class="mt-field-label">Display Name</span>
          <input
            type="text"
            name="display_name"
            value="{{ $d.DisplayName }}"
            required
            class="mt-control">
        </label>
        <div class="flex justify-end">
          <button type="submit" class="mt-btn mt-btn--primary">Save Changes</button>
        </div>
      </form>
    </section>

    <section class="mt-panel p-5 sm:p-6">
      <p class="mt-section-label mb-4">Change Password</p>
      <form method="POST" action="/settings" class="space-y-5">
        <input type="hidden" name="action" value="change_password">

        <label class="block text-sm text-slate-200">
          <span class="mt-field-label">Current Password</span>
          <input
            type="password"
            name="current_password"
            required
            class="mt-control">
        </label>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm text-slate-200">
            <span class="mt-field-label">New Password</span>
            <input
              type="password"
              name="new_password"
              required
              class="mt-control">
          </label>
          <label class="block text-sm text-slate-200">
            <span class="mt-field-label">Confirm New Password</span>
            <input
              type="password"
              name="confirm_password"
              required
              class="mt-control">
          </label>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="mt-btn mt-btn--primary">Update Password</button>
        </div>
      </form>
    </section>

    <section class="mt-panel p-5">
      <p class="mt-section-label mb-3">Sign Out</p>
      <form method="GET" action="/logout">
        <button type="submit" class="mt-btn mt-btn--secondary">Sign Out</button>
      </form>
    </section>

    <section class="mt-panel p-5 border-red-900/70 bg-red-950/35 shadow-red-900/30">
      <p class="mt-section-label mb-3 text-red-300">Danger Zone</p>
      <form method="POST" action="/settings"
            onsubmit="return confirm('Delete your account and all decks? This cannot be undone.');">
        <input type="hidden" name="action" value="delete_account">
        <button type="submit" class="mt-btn mt-btn--danger">Delete Account</button>
      </form>
    </section>

  </main>

  {{ template "layout_footer" . }}
{{ end }}
