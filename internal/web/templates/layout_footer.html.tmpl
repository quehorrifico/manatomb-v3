{{ define "layout_footer" }}
      </div>
    </main>

    {{ if not .HideFooter }}
      <footer id="site-footer" class="mt-site-footer mt-8">
        <div class="max-w-5xl mx-auto px-4 py-6 sm:py-7">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
            <div class="max-w-sm space-y-1.5">
              <a href="/" class="mt-footer-brand inline-flex items-center gap-2 text-sm">
                <img src="/assets/manatomb-square-logo.svg" alt="" class="h-5 w-5 rounded">
                <span>ManaTomb</span>
              </a>
              <p class="text-xs leading-5 mt-text-muted">Free, non-commercial MTG deck building and playtesting.</p>
            </div>

            <nav aria-label="Footer navigation">
              {{/* A future Ko-fi link can be added as another item in this flexible list. */}}
              <ul class="mt-footer-links flex flex-wrap gap-x-5 gap-y-2 text-xs">
                <li><a href="/changelog" class="mt-footer-link">Changelog <span aria-hidden="true">&middot; v{{ siteVersion }}</span></a></li>
                <li><a href="/privacy" class="mt-footer-link">Privacy</a></li>
                <li><a href="/terms" class="mt-footer-link">Terms</a></li>
                <li><a href="{{ projectRepoURL }}" class="mt-footer-link" target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a></li>
                <li><a href="{{ projectIssuesURL }}" class="mt-footer-link" target="_blank" rel="noopener noreferrer">Report an Issue<span class="sr-only"> (opens in a new tab)</span></a></li>
              </ul>
            </nav>
          </div>

          <div class="mt-footer-divider mt-5 flex flex-col gap-3 border-t pt-4 text-[11px] leading-5 mt-text-muted sm:flex-row sm:items-end sm:justify-between">
            <div class="space-y-1">
              <p>&copy; {{ currentYear }} ManaTomb</p>
              <p>
                Card data &copy; <a href="https://scryfall.com" class="mt-footer-link mt-footer-link--inline" target="_blank" rel="noopener noreferrer">Scryfall<span class="sr-only"> (opens in a new tab)</span></a>;
                card images &copy; <a href="https://company.wizards.com/en" class="mt-footer-link mt-footer-link--inline" target="_blank" rel="noopener noreferrer">Wizards of the Coast<span class="sr-only"> (opens in a new tab)</span></a>.
              </p>
            </div>
            <a href="#top" class="mt-footer-link shrink-0">Back to top</a>
          </div>
        </div>
      </footer>
    {{ end }}
  </div>
  <script>
    (function () {
      var roots = document.querySelectorAll('[data-card-autocomplete-root]');
      if (!roots.length) return;

      function setupAutocomplete(root) {
        var input = root.querySelector('[data-card-autocomplete-input]');
        var menu = root.querySelector('[data-card-autocomplete-menu]');
        var form = input ? (input.form || root.closest('form')) : null;
        if (!input || !menu || !form) return;

        var activeIndex = -1;
        var items = [];
        var requestToken = 0;
        var commanderOnly = input.getAttribute('data-card-autocomplete-commander-only') === 'true';
        var submitOnSelect = input.getAttribute('data-card-autocomplete-submit') !== 'false';
        var oracleIDInput = root.querySelector('[data-card-autocomplete-oracle-id]');
        var limit = parseInt(input.getAttribute('data-card-autocomplete-limit') || '8', 10);
        if (!Number.isFinite(limit) || limit < 1) {
          limit = 8;
        }

        function closeSuggestions() {
          menu.innerHTML = '';
          menu.classList.add('hidden');
          input.setAttribute('aria-expanded', 'false');
          input.removeAttribute('aria-activedescendant');
          activeIndex = -1;
          items = [];
        }

        function submitSelection(result) {
          var value = String(result && result.name || '').trim();
          if (!value) return;
          input.value = value;
          if (oracleIDInput) {
            oracleIDInput.value = String(result && result.oracle_id || '').trim();
          }
          closeSuggestions();
          if (!submitOnSelect) {
            requestToken++;
            input.dispatchEvent(new CustomEvent('card-autocomplete-selected', {
              bubbles: true,
              detail: result
            }));
            input.focus();
            return;
          }
          if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
          } else {
            form.submit();
          }
        }

        function setActive(nextIndex) {
          activeIndex = nextIndex;
          for (var i = 0; i < items.length; i++) {
            var active = i === activeIndex;
            items[i].classList.toggle('is-active', active);
            items[i].setAttribute('aria-selected', active ? 'true' : 'false');
          }
          if (activeIndex >= 0 && activeIndex < items.length) {
            input.setAttribute('aria-activedescendant', items[activeIndex].id);
          } else {
            input.removeAttribute('aria-activedescendant');
          }
        }

        function renderSuggestions(results) {
          menu.innerHTML = '';
          items = [];
          activeIndex = -1;
          input.removeAttribute('aria-activedescendant');

          if (!Array.isArray(results) || results.length === 0) {
            closeSuggestions();
            return;
          }

          for (var i = 0; i < results.length; i++) {
            var result = results[i] || {};
            var name = String(result.name || '').trim();
            if (!name) continue;

            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'mt-autocomplete-option';
            button.textContent = name;
            button.setAttribute('role', 'option');
            button.setAttribute('aria-selected', 'false');
            button.id = (input.id || 'card-autocomplete') + '-option-' + i;
            button.dataset.name = name;
            button._result = result;
            button.addEventListener('click', function (event) {
              event.preventDefault();
              submitSelection(this._result || {});
            });
            menu.appendChild(button);
            items.push(button);
          }

          if (items.length === 0) {
            closeSuggestions();
            return;
          }

          menu.classList.remove('hidden');
          input.setAttribute('aria-expanded', 'true');
        }

        async function fetchSuggestions() {
          var query = String(input.value || '').trim();
          if (query.length < 2) {
            closeSuggestions();
            return;
          }

          var token = ++requestToken;
          var endpoint = '/cards/autocomplete?q=' + encodeURIComponent(query) + '&limit=' + encodeURIComponent(String(limit));
          if (commanderOnly) {
            endpoint += '&commander_only=true';
          }

          try {
            var res = await fetch(endpoint, {
              method: 'GET',
              credentials: 'same-origin'
            });
            if (!res.ok) {
              closeSuggestions();
              return;
            }
            var data = await res.json();
            if (token !== requestToken) return;
            renderSuggestions(data && Array.isArray(data.results) ? data.results : []);
          } catch (error) {
            if (token !== requestToken) return;
            closeSuggestions();
          }
        }

        input.addEventListener('input', function () {
          if (oracleIDInput) oracleIDInput.value = '';
          fetchSuggestions();
        });
        input.addEventListener('focus', function () {
          if (String(input.value || '').trim().length >= 2) {
            fetchSuggestions();
          }
        });
        input.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            closeSuggestions();
            return;
          }
          if (menu.classList.contains('hidden') || items.length === 0) {
            return;
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            setActive(activeIndex < items.length - 1 ? activeIndex + 1 : 0);
            return;
          }
          if (event.key === 'ArrowUp') {
            event.preventDefault();
            setActive(activeIndex > 0 ? activeIndex - 1 : items.length - 1);
            return;
          }
          if (event.key === 'Enter' && activeIndex >= 0 && activeIndex < items.length) {
            event.preventDefault();
            submitSelection(items[activeIndex]._result || {});
          }
        });

        document.addEventListener('click', function (event) {
          if (root.contains(event.target)) return;
          closeSuggestions();
        });
      }

      for (var i = 0; i < roots.length; i++) {
        setupAutocomplete(roots[i]);
      }
    })();
  </script>
</body>
</html>
{{ end }}
