{{ define "decks_public_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}

  <div class="mt-public-deck-page">
    <article class="mt-public-showcase{{ if not $ctx.Commander }} mt-public-showcase--no-commander{{ else if not $ctx.Commander.ImageURI }} mt-public-showcase--no-commander{{ end }}"
             aria-labelledby="public-deck-title">
      {{ if and $ctx.Commander $ctx.Commander.ArtCropURI }}
        <div class="mt-public-showcase__art" aria-hidden="true">
          <img src="{{ $ctx.Commander.ArtCropURI }}" alt="" decoding="async">
        </div>
      {{ end }}

      <div class="mt-public-showcase__content">
        <div class="mt-public-showcase__intro">
          <ul class="mt-public-showcase__context" aria-label="Deck summary">
            <li>{{ if $d.Format }}{{ $d.Format }}{{ else }}Commander{{ end }}</li>
            {{ if $d.PowerBracket }}<li>{{ $d.PowerBracket }}</li>{{ end }}
            {{ if $ctx.ColorPips }}
              <li>
                <span class="mt-public-showcase__identity"
                      role="img"
                      aria-label="{{ $ctx.ColorIdentityName }} color identity">
                  {{ range $ctx.ColorPips }}
                    <img src="{{ .ImageURI }}" alt="">
                  {{ end }}
                </span>
              </li>
            {{ end }}
          </ul>

          <h1 id="public-deck-title">{{ $d.Name }}</h1>

          <p class="mt-public-showcase__byline">
            {{ if $ctx.Owner }}
              <span>by <a href="{{ userProfilePath $ctx.Owner.ID }}">{{ $ctx.Owner.DisplayName }}</a></span>
            {{ end }}
            {{ if $ctx.PublishedLabel }}<span>Published {{ $ctx.PublishedLabel }}</span>{{ end }}
            {{ if $ctx.UpdatedLabel }}<span>Updated {{ $ctx.UpdatedLabel }}</span>{{ end }}
          </p>

          <div class="mt-public-showcase__actions">
            <div class="mt-public-showcase__action-row">
              {{ if and .CurrentUser (eq .CurrentUser.ID $d.UserID) }}
                <a href="/decks/{{ $d.ID }}" class="mt-btn mt-btn--primary mt-btn--sm">Edit Deck</a>
              {{ else if .CurrentUser }}
                <form method="POST" action="/decks/public/fork">
                  <input type="hidden" name="slug" value="{{ $d.PublicSlug }}">
                  <button type="submit" class="mt-btn mt-btn--primary mt-btn--sm">Copy to My Decks</button>
                </form>
              {{ else }}
                <a href="/login?next={{ urlquery (print "/decks/public/" $d.PublicSlug) }}"
                   class="mt-btn mt-btn--primary mt-btn--sm">
                  Sign In to Copy
                </a>
              {{ end }}

              <div class="mt-public-download-split">
                <button type="button"
                        id="public-deck-export-txt"
                        class="mt-public-download-split__primary">
                  Download TXT
                </button>
                <details id="public-deck-action-menu"
                         class="mt-action-menu mt-public-download-split__menu">
                  <summary aria-label="More deck actions">
                    <span aria-hidden="true">▾</span>
                  </summary>
                  <div class="mt-action-menu__panel">
                    <button type="button" id="public-deck-copy-link" class="mt-action-menu__item">Copy deck link</button>
                    <button type="button" id="public-deck-copy-list" class="mt-action-menu__item">Copy decklist</button>
                    <button type="button" id="public-deck-export-csv" class="mt-action-menu__item">Download CSV</button>
                  </div>
                </details>
              </div>
            </div>
            <p id="public-deck-action-status"
               class="mt-public-action-status"
               role="status"
               aria-live="polite"></p>
          </div>
        </div>

        {{ if or $d.Description $d.Tags }}
          <div class="mt-public-showcase__story">
            {{ if $d.Description }}
              <p class="mt-public-showcase__description">{{ $d.Description }}</p>
            {{ end }}
            {{ if $d.Tags }}
              <nav class="mt-public-showcase__tags" aria-label="Deck archetypes">
                {{ range splitTags $d.Tags }}
                  <a href="/decks/public?archetype={{ urlquery . }}"
                     aria-label="Browse public decks with the {{ . }} archetype">#{{ . }}</a>
                {{ end }}
              </nav>
            {{ end }}
          </div>
        {{ end }}

        <dl class="mt-public-showcase__metrics" aria-label="Deck overview">
          <div>
            <dt>Cost</dt>
            <dd>{{ $ctx.DeckCostDisplay }}</dd>
            {{ if $ctx.DeckCostNote }}<small>{{ $ctx.DeckCostNote }}</small>{{ end }}
          </div>
          <div>
            <dt>Average mana value</dt>
            <dd>{{ $ctx.Analytics.AverageCMCDisplay }}</dd>
          </div>
          <div>
            <dt>Lands</dt>
            <dd>{{ $ctx.Analytics.LandCount }}</dd>
          </div>
          <div>
            <dt>Nonlands</dt>
            <dd>{{ $ctx.Analytics.NonLandCount }}</dd>
          </div>
        </dl>
      </div>

      {{ if and $ctx.Commander $ctx.Commander.ImageURI }}
        <figure class="mt-public-showcase__commander">
          <button type="button"
                  class="mt-public-showcase__commander-link"
                  data-card-detail
                  data-oracle-id="{{ $ctx.Commander.OracleID }}"
                  data-scryfall-id="{{ $ctx.Commander.ID }}"
                  data-detail-path="{{ if $ctx.Commander.OracleID }}/cards/view/{{ $ctx.Commander.OracleID }}{{ end }}"
                  data-name="{{ $ctx.Commander.Name }}"
                  data-mana-cost="{{ $ctx.Commander.ManaCost }}"
                  data-type-line="{{ $ctx.Commander.TypeLine }}"
                  data-image-uri="{{ $ctx.Commander.ImageURI }}"
                  data-price="{{ $ctx.Commander.PriceUSD }}"
                  data-artist="{{ $ctx.Commander.Artist }}"
                  data-set-code="{{ $ctx.Commander.SetCode }}"
                  data-set-name="{{ $ctx.Commander.SetName }}"
                  data-released-at="{{ $ctx.Commander.ReleasedAt }}"
                  aria-label="View {{ $d.CommanderName }} card details">
            <img src="{{ $ctx.Commander.ImageURI }}"
                 alt=""
                 loading="eager"
                 decoding="async">
          </button>
          <figcaption>
            <span>Commander</span>
            <strong>{{ if $d.CommanderName }}{{ $d.CommanderName }}{{ else }}{{ $ctx.Commander.Name }}{{ end }}</strong>
          </figcaption>
        </figure>
      {{ end }}
    </article>

    <section class="mt-public-deck-analysis" aria-label="Deck analysis">
      <div class="mt-public-deck-analysis__content">
        <section class="mt-public-analysis-group" aria-labelledby="public-deck-types-title">
          <h3 id="public-deck-types-title">Card types</h3>
          <dl class="mt-public-analysis-list">
            <div><dt>Artifacts</dt><dd>{{ $ctx.Analytics.ArtifactCount }}</dd></div>
            <div><dt>Enchantments</dt><dd>{{ $ctx.Analytics.EnchantmentCount }}</dd></div>
            <div><dt>Instants</dt><dd>{{ $ctx.Analytics.InstantCount }}</dd></div>
            <div><dt>Sorceries</dt><dd>{{ $ctx.Analytics.SorceryCount }}</dd></div>
            <div><dt>Planeswalkers</dt><dd>{{ $ctx.Analytics.PlaneswalkerCount }}</dd></div>
          </dl>
        </section>

        <section class="mt-public-analysis-group" aria-labelledby="public-deck-roles-title">
          <h3 id="public-deck-roles-title">Deck roles</h3>
          <dl class="mt-public-analysis-list">
            <div><dt>Ramp</dt><dd>{{ $ctx.Analytics.RampCount }}</dd></div>
            <div><dt>Card draw</dt><dd>{{ $ctx.Analytics.CardDrawCount }}</dd></div>
            <div><dt>Tutors</dt><dd>{{ $ctx.Analytics.TutorCount }}</dd></div>
            <div><dt>Interaction</dt><dd>{{ $ctx.Analytics.InteractionCount }}</dd></div>
            <div><dt>Board wipes</dt><dd>{{ $ctx.Analytics.BoardWipeCount }}</dd></div>
            <div><dt>Protection</dt><dd>{{ $ctx.Analytics.ProtectionCount }}</dd></div>
          </dl>
        </section>

        <section class="mt-public-analysis-group" aria-labelledby="public-deck-sample-title">
          <h3 id="public-deck-sample-title">Sample hand</h3>
          {{ if $ctx.SampleHand }}
            <div class="mt-public-sample-hand">
              <div id="public-deck-sample-cards" class="mt-public-sample-hand__cards">
                {{ range $index, $card := $ctx.SampleHand }}
                  <button type="button"
                          class="mt-public-sample-card"
                          data-sample-index="{{ $index }}"
                          aria-label="View {{ $card.CardName }} card details">
                    {{ if $card.ImageURI }}
                      <img src="{{ $card.ImageURI }}" alt="" loading="lazy" decoding="async">
                    {{ else }}
                      <span>{{ $card.CardName }}</span>
                    {{ end }}
                  </button>
                {{ end }}
              </div>
              <button type="button"
                      id="public-deck-sample-refresh"
                      class="mt-public-sample-refresh"
                      hidden
                      aria-describedby="public-deck-sample-status">
                <span class="mt-public-sample-refresh__icon" aria-hidden="true">↻</span>
                <span>Another hand</span>
              </button>
            </div>
            <p id="public-deck-sample-status"
               class="mt-visually-hidden"
               role="status"
               aria-live="polite"></p>
          {{ else }}
            <p class="mt-public-sample-hand__empty">Add at least one card to draw a sample hand.</p>
          {{ end }}
        </section>
      </div>
    </section>

    <section class="mt-public-deck-browser" aria-labelledby="public-deck-browser-title">
      <header class="mt-public-deck-browser__heading">
        <h2 id="public-deck-browser-title">Decklist</h2>
      </header>

      <div class="mt-public-deck-toolbar">
        {{ if or $ctx.SideboardDeckCards $ctx.MaybeDeckCards }}
          <div class="mt-board-tabs" role="group" aria-label="Deck sections">
            <button type="button"
                    class="mt-board-tab"
                    data-board="main"
                    aria-controls="public-deck-output"
                    aria-pressed="false">
              <span>Deck</span>
              <span data-board-count="main">0</span>
            </button>
            {{ if $ctx.SideboardDeckCards }}
              <button type="button"
                      class="mt-board-tab"
                      data-board="side"
                      aria-controls="public-deck-output"
                      aria-pressed="false">
                <span>Sideboard</span>
                <span data-board-count="side">0</span>
              </button>
            {{ end }}
            {{ if $ctx.MaybeDeckCards }}
              <button type="button"
                      class="mt-board-tab"
                      data-board="maybe"
                      aria-controls="public-deck-output"
                      aria-pressed="false">
                <span>Maybeboard</span>
                <span data-board-count="maybe">0</span>
              </button>
            {{ end }}
          </div>
        {{ end }}

        <div class="mt-public-deck-controls">
          <label class="mt-public-deck-field" for="public-deck-group">
            <span>Group cards by</span>
            <select id="public-deck-group" class="mt-control mt-control--sm">
              <option value="type" selected>Card type</option>
              <option value="none">No grouping</option>
              <option value="category">Category</option>
              <option value="alphabet">Alphabet</option>
              <option value="mv">Mana value</option>
              <option value="price">Price</option>
            </select>
          </label>

          <label class="mt-public-deck-field" for="public-deck-sort">
            <span>Sort cards by</span>
            <select id="public-deck-sort" class="mt-control mt-control--sm">
              <option value="mv" selected>Mana value</option>
              <option value="alphabet">Alphabet</option>
              <option value="type">Card type</option>
              <option value="price">Price</option>
            </select>
          </label>

          <label class="mt-public-deck-field" for="public-deck-view">
            <span>Card view</span>
            <select id="public-deck-view" class="mt-control mt-control--sm">
              <option value="text" selected>Text list</option>
              <option value="stacks">Stacks</option>
              <option value="grid">Grid</option>
              <option value="table">Table</option>
              <option value="single">Single card</option>
            </select>
          </label>
        </div>
      </div>

      <div id="public-deck-output" class="mt-public-deck-output"></div>

      <noscript>
        <ul class="mt-public-deck-noscript-list">
          {{ range $ctx.DeckCards }}
            <li>
              <div>
                <p class="mt-public-deck-noscript-name">{{ .CardName }}</p>
                <p class="mt-public-deck-noscript-meta">{{ .TypeLine }}</p>
              </div>
              <span class="mt-public-deck-noscript-quantity">x{{ .Quantity }}</span>
            </li>
          {{ else }}
            <li class="mt-public-deck-noscript-empty">This deck is empty.</li>
          {{ end }}
        </ul>
      </noscript>
    </section>
  </div>

  {{ template "card_detail_modal" . }}

  <script src="/assets/deck_browser.js"></script>
  {{ template "card_detail_modal_script" . }}
  <script>
    window.ManatombPublicDeckConfig = {
      name: {{ toJSON $d.Name }},
      format: {{ toJSON $d.Format }},
      commanderName: {{ toJSON $d.CommanderName }},
      commander: {{ if $ctx.Commander }}{
        name: {{ toJSON $ctx.Commander.Name }},
        printID: {{ toJSON $ctx.Commander.ID }},
        setCode: {{ toJSON $ctx.Commander.SetCode }},
        collectorNumber: {{ toJSON $ctx.Commander.CollectorNumber }},
        price: {{ toJSON $ctx.Commander.PriceUSD }}
      }{{ else }}null{{ end }},
      sampleHand: {{ toJSON $ctx.SampleHand }},
      sampleExcludesCommander: {{ if $ctx.SampleExcludesCommander }}true{{ else }}false{{ end }},
      boards: {
        main: {{ toJSON $ctx.DeckCards }},
        side: {{ toJSON $ctx.SideboardDeckCards }},
        maybe: {{ toJSON $ctx.MaybeDeckCards }}
      }
    };
  </script>
  <script src="/assets/public_deck.js"></script>

  {{ template "layout_footer" . }}
{{ end }}
