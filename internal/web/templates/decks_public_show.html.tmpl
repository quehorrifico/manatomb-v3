{{ define "decks_public_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}

  <main class="max-w-6xl mx-auto px-4 py-8 space-y-5">
    <section class="flex flex-col xl:flex-row xl:items-start xl:justify-between gap-5">
      <div class="flex gap-4">
        {{ if and $ctx.Commander $ctx.Commander.ImageURI }}
          <div class="h-32 w-24 mt-card-media bg-slate-900 shrink-0">
            <img src="{{ $ctx.Commander.ImageURI }}" alt="{{ $d.CommanderName }}" class="h-full w-full object-cover">
          </div>
        {{ end }}

        <div class="space-y-2">
          <p class="mt-kicker">Public Deck</p>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-semibold tracking-tight text-slate-100">{{ $d.Name }}</h1>
            <span class="mt-chip">Public</span>
          </div>
          {{ if $ctx.Owner }}
            <p class="text-sm text-slate-400">
              by <a href="{{ userProfilePath $ctx.Owner.ID }}" class="text-sky-300 hover:text-sky-200">{{ $ctx.Owner.DisplayName }}</a>
            </p>
          {{ end }}
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="mt-chip">{{ if $d.Format }}{{ $d.Format }}{{ else }}Commander{{ end }}</span>
            {{ if $d.PowerBracket }}
              <span class="mt-chip">{{ $d.PowerBracket }}</span>
            {{ end }}
            {{ if $d.CommanderName }}
              <span class="mt-chip">Commander: {{ $d.CommanderName }}</span>
            {{ end }}
          </div>
          {{ if $d.Tags }}
            <div class="flex flex-wrap gap-1.5 pt-1">
              {{ range splitTags $d.Tags }}
                <span class="{{ publicTagChipClass . }}">{{ . }}</span>
              {{ end }}
            </div>
          {{ end }}
          {{ if $d.Description }}
            <p class="text-sm text-slate-300 whitespace-pre-line max-w-3xl">{{ $d.Description }}</p>
          {{ end }}
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
        <a href="/decks/public" class="mt-btn mt-btn--secondary mt-btn--sm">Browse</a>
        {{ if .CurrentUser }}
          <form method="POST" action="/decks/public/fork">
            <input type="hidden" name="slug" value="{{ $d.PublicSlug }}">
            <button type="submit" class="mt-btn mt-btn--primary mt-btn--sm">Copy</button>
          </form>
        {{ else }}
          <a href="/login?next={{ urlquery (print "/decks/public/" $d.PublicSlug) }}"
             class="mt-btn mt-btn--warning mt-btn--sm">
            Log In
          </a>
        {{ end }}
      </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]">
      <div class="mt-panel p-4 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <h2 class="mt-section-label">Mainboard</h2>
          <p class="text-xs text-slate-500">{{ $ctx.Analytics.MainboardCards }} cards</p>
        </div>
        <ul class="mt-3 divide-y divide-slate-800 text-sm">
          {{ range $ctx.DeckCards }}
            <li class="py-2 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="font-medium text-slate-100">{{ .CardName }}</p>
                <p class="text-xs text-slate-500">{{ .TypeLine }}</p>
              </div>
              <span class="text-xs text-slate-400 shrink-0">x{{ .Quantity }}</span>
            </li>
          {{ else }}
            <li class="py-2 text-sm text-slate-500">Empty.</li>
          {{ end }}
        </ul>
      </div>

      <div class="space-y-4">
        <section class="mt-panel p-4 sm:p-5">
          <h2 class="mt-section-label">Stats</h2>
          <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
            <div class="mt-stat-card">
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Total cards</p>
              <p class="mt-1 text-lg font-semibold text-slate-100">{{ $ctx.Analytics.TotalCards }}</p>
            </div>
            <div class="mt-stat-card">
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Average CMC</p>
              <p class="mt-1 text-lg font-semibold text-slate-100">{{ $ctx.Analytics.AverageCMCDisplay }}</p>
            </div>
            <div class="mt-stat-card">
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Lands</p>
              <p class="mt-1 text-lg font-semibold text-slate-100">{{ $ctx.Analytics.LandCount }}</p>
            </div>
            <div class="mt-stat-card">
              <p class="text-[11px] uppercase tracking-wide text-slate-500">Nonlands</p>
              <p class="mt-1 text-lg font-semibold text-slate-100">{{ $ctx.Analytics.NonLandCount }}</p>
            </div>
          </div>
          {{ if $ctx.Analytics.ValidationWarnings }}
            <div class="mt-4 rounded-lg border border-amber-500/40 bg-amber-950/20 p-3">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-amber-200">Warnings</h3>
              <ul class="mt-2 space-y-1 text-xs text-amber-100">
                {{ range $ctx.Analytics.ValidationWarnings }}
                  <li>{{ . }}</li>
                {{ end }}
              </ul>
            </div>
          {{ end }}
        </section>

        <section class="mt-panel p-4 sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <h2 class="mt-section-label">Maybeboard</h2>
            <p class="text-xs text-slate-500">{{ len $ctx.MaybeDeckCards }}</p>
          </div>
          <ul class="mt-3 divide-y divide-slate-800 text-sm">
            {{ range $ctx.MaybeDeckCards }}
              <li class="py-2 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-medium text-slate-100">{{ .CardName }}</p>
                  <p class="text-xs text-slate-500">{{ .TypeLine }}</p>
                </div>
                <span class="text-xs text-slate-400 shrink-0">x{{ .Quantity }}</span>
              </li>
            {{ else }}
              <li class="py-2 text-sm text-slate-500">Empty.</li>
            {{ end }}
          </ul>
        </section>
      </div>
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
