{{ define "decks_public_show" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}

  <link rel="stylesheet" href="/assets/public_deck.css">

  <main class="max-w-7xl mx-auto px-4 py-7 sm:py-8 space-y-5">
    <section class="flex flex-col xl:flex-row xl:items-start xl:justify-between gap-5">
      <div class="flex gap-4 min-w-0">
        {{ if and $ctx.Commander $ctx.Commander.ImageURI }}
          <div class="h-32 w-24 mt-card-media bg-slate-900 shrink-0">
            <img src="{{ $ctx.Commander.ImageURI }}" alt="{{ $d.CommanderName }}" class="h-full w-full object-cover">
          </div>
        {{ end }}

        <div class="space-y-2 min-w-0">
          <p class="mt-kicker">Public Deck</p>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-semibold text-slate-100 break-words">{{ $d.Name }}</h1>
            <span class="mt-chip">Public</span>
          </div>
          {{ if $ctx.Owner }}
            <p class="text-sm text-slate-400">
              by <a href="{{ userProfilePath $ctx.Owner.ID }}" class="text-sky-300 hover:text-sky-200">{{ $ctx.Owner.DisplayName }}</a>
            </p>
          {{ end }}
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="mt-chip">{{ if $d.Format }}{{ $d.Format }}{{ else }}Commander{{ end }}</span>
            {{ if $d.PowerBracket }}
              <span class="mt-chip">{{ $d.PowerBracket }}</span>
            {{ end }}
            {{ if $d.CommanderName }}
              <span class="mt-chip">Commander: {{ $d.CommanderName }}</span>
            {{ end }}
          </div>
          {{ if $d.Tags }}
            <div class="flex flex-wrap gap-1.5 pt-1">
              {{ range splitTags $d.Tags }}
                <span class="{{ publicTagChipClass . }}">{{ . }}</span>
              {{ end }}
            </div>
          {{ end }}
          {{ if $d.Description }}
            <p class="text-sm text-slate-300 whitespace-pre-line max-w-3xl">{{ $d.Description }}</p>
          {{ end }}
        </div>
      </div>

      <div class="mt-public-hero-actions">
        <div class="flex flex-wrap gap-2">
          <a href="/" class="mt-btn mt-btn--secondary mt-btn--sm">Home</a>
          <a href="/decks/public" class="mt-btn mt-btn--secondary mt-btn--sm">Browse</a>
          {{ if .CurrentUser }}
            <form method="POST" action="/decks/public/fork">
              <input type="hidden" name="slug" value="{{ $d.PublicSlug }}">
              <button type="submit" class="mt-btn mt-btn--primary mt-btn--sm">Copy</button>
            </form>
          {{ else }}
            <a href="/login?next={{ urlquery (print "/decks/public/" $d.PublicSlug) }}"
               class="mt-btn mt-btn--warning mt-btn--sm">
              Log In
            </a>
          {{ end }}
          <details id="public-deck-action-menu" class="mt-action-menu mt-public-action-menu">
            <summary>Share &amp; export</summary>
            <div class="mt-action-menu__panel">
              <button type="button" id="public-deck-share" class="mt-action-menu__item">Share deck</button>
              <button type="button" id="public-deck-copy-list" class="mt-action-menu__item">Copy deck list</button>
              <button type="button" id="public-deck-export-txt" class="mt-action-menu__item">Download TXT</button>
              <button type="button" id="public-deck-export-csv" class="mt-action-menu__item">Download CSV</button>
            </div>
          </details>
        </div>
        <p id="public-deck-action-status" class="mt-public-action-status" aria-live="polite"></p>
      </div>
    </section>

    <details class="mt-panel mt-public-stats-disclosure p-4 sm:p-5" open>
      <summary>
        <span class="mt-section-label" role="heading" aria-level="2">Deck stats</span>
        <span class="mt-public-stats-summary-meta">
          <span>Mainboard</span>
          <svg class="mt-public-stats-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>
      </summary>
      <div class="mt-public-stats-content">
        <dl class="mt-public-stats-grid">
          <div class="mt-public-stat">
            <dt>Total cards</dt>
            <dd>{{ $ctx.Analytics.TotalCards }}</dd>
          </div>
          <div class="mt-public-stat">
            <dt>Average CMC</dt>
            <dd>{{ $ctx.Analytics.AverageCMCDisplay }}</dd>
          </div>
          <div class="mt-public-stat">
            <dt>Lands</dt>
            <dd>{{ $ctx.Analytics.LandCount }}</dd>
          </div>
          <div class="mt-public-stat">
            <dt>Nonlands</dt>
            <dd>{{ $ctx.Analytics.NonLandCount }}</dd>
          </div>
        </dl>
        {{ if $ctx.Analytics.ValidationWarnings }}
          <div class="mt-4 border-l-2 border-amber-400/70 pl-3">
            <h3 class="text-xs font-semibold uppercase text-amber-200">Warnings</h3>
            <ul class="mt-2 space-y-1 text-xs text-amber-100">
              {{ range $ctx.Analytics.ValidationWarnings }}
                <li>{{ . }}</li>
              {{ end }}
            </ul>
          </div>
        {{ end }}
      </div>
    </details>

    <section class="mt-panel p-4 sm:p-5 space-y-3">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="mt-section-label">Deck browser</h2>
          <p id="public-deck-summary" class="mt-1 text-xs text-slate-500"></p>
        </div>
      </div>

      <div class="mt-deck-toolbar flex flex-col gap-2.5 xl:flex-row xl:items-end xl:justify-between">
        <div class="mt-board-tabs" role="tablist" aria-label="Deck boards">
          <button type="button" class="mt-board-tab" data-board="main" role="tab">
            <span>Main</span>
            <span data-board-count="main">0</span>
          </button>
          <button type="button" class="mt-board-tab" data-board="side" role="tab">
            <span>Side</span>
            <span data-board-count="side">0</span>
          </button>
          <button type="button" class="mt-board-tab" data-board="maybe" role="tab">
            <span>Maybe</span>
            <span data-board-count="maybe">0</span>
          </button>
        </div>

        <div class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-4 xl:w-auto">
          <label class="block text-xs text-slate-400">
            <span class="mt-field-label mb-1">Filter</span>
            <input id="public-deck-filter"
                   type="search"
                   class="mt-control mt-control--sm"
                   placeholder="Name, type, text"
                   autocomplete="off">
          </label>
          <label class="block text-xs text-slate-400">
            <span class="mt-field-label mb-1">Group</span>
            <select id="public-deck-group" class="mt-control mt-control--sm">
              <option value="none">None</option>
              <option value="category">Categories</option>
              <option value="alphabet">Alphabet</option>
              <option value="type">Type</option>
              <option value="mv">Mana Value</option>
              <option value="price">Price</option>
            </select>
          </label>
          <label class="block text-xs text-slate-400">
            <span class="mt-field-label mb-1">Sort</span>
            <select id="public-deck-sort" class="mt-control mt-control--sm">
              <option value="alphabet">Alphabet</option>
              <option value="mv">Mana Value</option>
              <option value="type">Type</option>
              <option value="price">Price</option>
            </select>
          </label>
          <label class="block text-xs text-slate-400">
            <span class="mt-field-label mb-1">View</span>
            <select id="public-deck-view" class="mt-control mt-control--sm">
              <option value="stacks">Stacks</option>
              <option value="text">Text</option>
              <option value="grid">Grid</option>
              <option value="table">Table</option>
              <option value="single">Single card</option>
            </select>
          </label>
        </div>
      </div>

      <div id="public-deck-output" class="mt-public-deck-output" aria-live="polite"></div>

      <noscript>
        <ul class="divide-y divide-slate-800 text-sm">
          {{ range $ctx.DeckCards }}
            <li class="py-2 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="font-medium text-slate-100">{{ .CardName }}</p>
                <p class="text-xs text-slate-500">{{ .TypeLine }}</p>
              </div>
              <span class="text-xs text-slate-400 shrink-0">x{{ .Quantity }}</span>
            </li>
          {{ else }}
            <li class="py-3 text-slate-500">Empty.</li>
          {{ end }}
        </ul>
      </noscript>
    </section>
  </main>

  {{ template "card_detail_modal" . }}

  <script src="/assets/deck_browser.js"></script>
  {{ template "card_detail_modal_script" . }}
  <script>
    window.ManatombPublicDeckConfig = {
      name: {{ toJSON $d.Name }},
      format: {{ toJSON $d.Format }},
      commanderName: {{ toJSON $d.CommanderName }},
      boards: {
        main: {{ toJSON $ctx.DeckCards }},
        side: {{ toJSON $ctx.SideboardDeckCards }},
        maybe: {{ toJSON $ctx.MaybeDeckCards }}
      }
    };
  </script>
  <script src="/assets/public_deck.js"></script>

  {{ template "layout_footer" . }}
{{ end }}
