{{ define "deck_show" }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}
  {{ $c := $ctx.Commander }}
  {{ $isGuest := false }}
  {{ if $ctx.GuestMode }}
    {{ $isGuest = true }}
  {{ else }}
    {{ $isGuest = not .CurrentUser }}
  {{ end }}
  {{ template "layout_header" . }}

  <main class="w-full max-w-none py-8 px-3 sm:px-4 md:px-6 xl:px-8 2xl:px-10 space-y-6">
    <!-- Top bar: title + actions -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div class="flex items-start gap-4">
        <div id="deck-top-commander-art-wrap"
             class="h-28 w-20 sm:h-32 sm:w-24 rounded overflow-hidden border border-slate-700 bg-slate-900 shrink-0 {{ if and $c $c.ImageURI }}{{ else }}hidden{{ end }}">
          <img id="deck-top-commander-art"
               src="{{ if and $c $c.ImageURI }}{{ $c.ImageURI }}{{ end }}"
               alt="{{ if $d.CommanderName }}{{ $d.CommanderName }} commander art{{ else }}Commander art{{ end }}"
               class="h-full w-full object-cover">
        </div>

        <div class="min-w-0 flex-1 space-y-1">
          {{ if not $isGuest }}
          <!-- View state: click to edit -->
          <button
            type="button"
            id="deck-name-view"
            class="group text-left"
            title="Click to rename this deck">
            <h2 class="text-2xl font-semibold tracking-tight">
              <span class="bg-gradient-to-br from-sky-400 via-cyan-300 to-slate-100 bg-clip-text text-transparent group-hover:from-sky-300 group-hover:via-cyan-200">
                {{ $d.Name }}
              </span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5 group-hover:text-slate-400">
              Click here to rename deck.
            </p>
          </button>

          <!-- Edit state: inline form (hidden by default) -->
          <form
            id="deck-name-form"
            method="POST"
            action="/decks/edit"
            class="hidden space-y-2">
            <input type="hidden" name="id" value="{{ $d.ID }}">
            <input type="hidden" name="commander_name" value="{{ $d.CommanderName }}">
            <input type="hidden" name="description" value="{{ $d.Description }}">

            <label class="block text-sm text-slate-200">
              <span class="block text-xs font-medium text-slate-400 mb-1">Deck name</span>
              <input
                type="text"
                name="name"
                value="{{ $d.Name }}"
                required
                class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
            </label>
            <div class="flex items-center gap-2">
              <button type="submit"
                      class="inline-flex items-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
                Save name
              </button>
              <button type="button"
                      id="deck-name-cancel"
                      class="inline-flex items-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-slate-500 hover:text-slate-50 transition-colors">
                Cancel
              </button>
            </div>
          </form>
          {{ end }}

          {{ if $isGuest }}
            <div class="space-y-1">
              <h2 class="text-2xl font-semibold tracking-tight">
                <span class="bg-gradient-to-br from-sky-400 via-cyan-300 to-slate-100 bg-clip-text text-transparent">
                  <span id="guest-deck-name">{{ $d.Name }}</span>
                </span>
              </h2>
              <p class="text-xs text-amber-200/80">Guest deck — saved in this browser only.</p>
            </div>
          {{ end }}

          <div class="min-w-0">
            <p class="text-[11px] font-medium uppercase tracking-wide text-slate-400">Commander</p>
            <p id="deck-top-commander" class="text-sm text-slate-200 leading-snug break-words">{{ if $d.CommanderName }}{{ $d.CommanderName }}{{ else }}Choose an eligible commander{{ end }}</p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        {{ if not $isGuest }}
        <a href="/decks/playtest/{{ $d.ID }}"
          class="inline-flex items-center px-3 py-1.5 rounded-md bg-slate-100 text-slate-950 text-xs font-semibold hover:bg-white transition-colors">
          Playtest
        </a>

        <form method="POST" action="/decks/delete"
              onsubmit="return confirm('Delete this deck? This cannot be undone.');">
          <input type="hidden" name="id" value="{{ $d.ID }}">
          <button type="submit"
                  class="inline-flex items-center px-3 py-1.5 rounded-md border border-red-800/70 bg-red-900/40 text-xs text-red-300 hover:border-red-500 hover:text-red-200 transition-colors">
            Delete deck
          </button>
        </form>
        {{ end }}
        {{ if $isGuest }}
          <button type="button" id="guest-playtest"
                  class="inline-flex items-center px-3 py-1.5 rounded-md bg-slate-100 text-slate-950 text-xs font-semibold hover:bg-white transition-colors">
            Playtest
          </button>
          {{ if .CurrentUser }}
            <button type="button" id="guest-save-to-account"
                    class="inline-flex items-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors">
              Save to my account
            </button>
          {{ else }}
            <a href="/login?next={{ if $ctx.GuestSandbox }}{{ urlquery "/decks/guest?sandbox=1&save_guest=1" }}{{ else if $d.CommanderName }}{{ urlquery (print "/decks/guest?commander_name=" $d.CommanderName "&save_guest=1") }}{{ else }}{{ urlquery "/decks/guest?save_guest=1" }}{{ end }}"
               class="inline-flex items-center px-3 py-1.5 rounded-md bg-amber-300 text-slate-950 text-xs font-semibold hover:bg-amber-200 transition-colors">
              Log in to save
            </a>
          {{ end }}
        {{ end }}
      </div>
    </div>

    <!-- cEDH workbench: compact top panel, then cards, then analytics -->
    <section class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 shadow-md shadow-sky-500/10">
      <div class="grid gap-3 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,0.95fr)_minmax(0,1.2fr)] items-start">
        <div class="space-y-2 xl:pr-3 xl:border-r xl:border-slate-800">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Commander</h3>
          {{ if and (not $isGuest) $ctx.CommanderCandidates }}
            <form method="POST" action="/decks/commander" class="flex flex-col sm:flex-row gap-1.5">
              <input type="hidden" name="id" value="{{ $d.ID }}">
              <label class="flex-1 text-sm text-slate-200">
                <span class="block text-xs font-medium text-slate-400 mb-1">Set commander from deck</span>
                <select name="commander_name"
                        class="w-full rounded-md border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
                  <option value="" disabled {{ if not $d.CommanderName }}selected{{ end }}>Choose a card…</option>
                  {{ range $ctx.CommanderCandidates }}
                    <option value="{{ .CardName }}" {{ if eq .CardName $d.CommanderName }}selected{{ end }}>{{ .CardName }}</option>
                  {{ end }}
                </select>
              </label>
              <div class="flex items-end">
                <button type="submit"
                        class="inline-flex items-center justify-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                  Update
                </button>
              </div>
            </form>
          {{ else if not $isGuest }}
            <p class="text-xs text-slate-500">Add a legendary creature (or a card that says it can be your commander) to choose a commander.</p>
          {{ end }}

          {{ if $isGuest }}
            <div class="space-y-1.5">
              <label class="block text-sm text-slate-200">
                <span class="block text-xs font-medium text-slate-400 mb-1">Set commander from imported cards</span>
                <select id="guest-commander-select"
                        class="w-full rounded-md border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
                  <option value="">Choose an eligible commander</option>
                </select>
              </label>
              <div class="flex flex-wrap items-center gap-1.5">
                <button type="button"
                        id="guest-commander-apply"
                        class="inline-flex items-center px-2.5 py-1 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors">
                  Set commander
                </button>
                <button type="button"
                        id="guest-commander-clear"
                        class="inline-flex items-center px-2.5 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-slate-500 hover:text-slate-50 transition-colors">
                  Clear
                </button>
              </div>
              <p id="guest-commander-status" class="text-xs text-slate-500" aria-live="polite"></p>
            </div>
          {{ end }}

          {{ if and (not $isGuest) $d.CommanderName }}
            <p class="text-[11px] text-slate-500">Commander is treated as the 100th card and won’t appear in the list.</p>
          {{ end }}

          {{ if $isGuest }}
            <p class="text-sm text-slate-300">
              <span class="font-medium">Commander:</span>
              <span id="guest-commander-current">{{ if $d.CommanderName }}{{ $d.CommanderName }}{{ else }}Choose an eligible commander{{ end }}</span>
            </p>
          {{ else if $c }}
            <div class="flex gap-3">
              {{ if $c.ImageURI }}
                <div class="w-24 shrink-0">
                  <img src="{{ $c.ImageURI }}"
                       alt="{{ $c.Name }}"
                       class="w-full h-auto rounded-md shadow-md shadow-slate-900/70 border border-slate-800">
                </div>
              {{ end }}
              <div class="space-y-1 min-w-0">
                <p class="text-sm font-semibold text-slate-50 leading-tight">
                  {{ $c.Name }}
                  <span id="deck-commander-mana-cost"
                        data-mana-cost="{{ $c.ManaCost }}"
                        class="ml-1 inline-flex items-center gap-0.5 align-middle"></span>
                  <noscript>
                    <span class="ml-1 text-slate-300 text-xs">{{ $c.ManaCost }}</span>
                  </noscript>
                </p>
                <p class="text-[11px] uppercase tracking-wide text-slate-400 leading-tight">{{ $c.TypeLine }}</p>
                <p class="text-xs text-slate-200 whitespace-pre-line max-h-28 overflow-y-auto pr-1">{{ $c.OracleText }}</p>
              </div>
            </div>
          {{ else }}
            <p class="text-sm text-slate-300">
              <span class="font-medium">Commander:</span> {{ if $d.CommanderName }}{{ $d.CommanderName }}{{ else }}Choose an eligible commander{{ end }}
            </p>
          {{ end }}
        </div>

        <div class="space-y-2 xl:px-3 xl:border-r xl:border-slate-800 text-sm">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Description</h3>
          {{ if not $isGuest }}
            <button type="button"
                    id="deck-desc-view"
                    class="w-full text-left rounded-md border border-transparent px-1.5 py-1 hover:border-slate-700 hover:bg-slate-900/60 transition-colors">
              {{ if $d.Description }}
                <p class="text-sm text-slate-200 whitespace-pre-line">{{ $d.Description }}</p>
              {{ else }}
                <p class="text-sm text-slate-500 italic">Click to add a description for this deck.</p>
              {{ end }}
            </button>
            <form id="deck-desc-form"
                  method="POST"
                  action="/decks/edit"
                  class="hidden space-y-1.5">
              <input type="hidden" name="id" value="{{ $d.ID }}">
              <input type="hidden" name="commander_name" value="{{ $d.CommanderName }}">
              <input type="hidden" name="name" value="{{ $d.Name }}">
              <label class="block text-sm text-slate-200">
                <span class="block text-xs font-medium text-slate-400 mb-1">Deck description</span>
                <textarea name="description"
                          rows="3"
                          class="w-full rounded-md border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">{{ $d.Description }}</textarea>
              </label>
              <div class="flex items-center gap-1.5">
                <button type="submit"
                        class="inline-flex items-center px-2.5 py-1 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
                  Save description
                </button>
                <button type="button"
                        id="deck-desc-cancel"
                        class="inline-flex items-center px-2.5 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-slate-500 hover:text-slate-50 transition-colors">
                  Cancel
                </button>
              </div>
            </form>
          {{ else }}
            <div class="w-full rounded-md border border-slate-800 bg-slate-950 px-2.5 py-1.5">
              <p id="guest-deck-desc" class="text-sm text-slate-200 whitespace-pre-line">{{ $d.Description }}</p>
              <p id="guest-deck-desc-empty" class="text-sm text-slate-500 italic hidden">No description yet.</p>
            </div>
          {{ end }}

          <p class="text-[11px] text-slate-500">
            <span class="uppercase tracking-wide">Format:</span>
            <span class="text-slate-300">{{ if $d.Format }}{{ $d.Format }}{{ else }}Commander{{ end }}</span>
          </p>
        </div>

        <div class="space-y-2 xl:pl-3">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Card Search</h3>
          </div>
          {{ if not $isGuest }}
            <form method="POST" action="/decks/{{ $d.ID }}" class="flex flex-col md:flex-row gap-1.5">
              <label class="flex-1 text-sm text-slate-200">
                <span class="block text-xs font-medium text-slate-400 mb-1">Card name</span>
                <input type="text"
                       id="guest-card-name"
                       name="card_name"
                       required
                       placeholder="Start typing a card name..."
                       class="w-full rounded-md border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
              </label>
              <div class="flex items-end gap-1.5">
                <button type="submit"
                        name="zone"
                        value="main"
                        class="inline-flex items-center justify-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-sm font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                  Add to deck
                </button>
                <button type="submit"
                        name="zone"
                        value="maybe"
                        class="inline-flex items-center justify-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-sm font-semibold text-slate-200 hover:border-sky-400 hover:text-sky-300 transition-colors">
                  Add to maybeboard
                </button>
              </div>
            </form>
          {{ else }}
            <form id="guest-add-card-form" class="flex flex-col md:flex-row gap-1.5" novalidate>
              <label class="flex-1 text-sm text-slate-200">
                <span class="block text-xs font-medium text-slate-400 mb-1">Card name</span>
                <input type="text"
                       id="guest-card-name"
                       name="card_name"
                       required
                       placeholder="Start typing a card name..."
                       class="w-full rounded-md border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
              </label>
              <div class="flex items-end gap-1.5">
                <button type="submit"
                        name="zone"
                        value="main"
                        class="inline-flex items-center justify-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-sm font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                  Add to deck
                </button>
                <button type="submit"
                        name="zone"
                        value="maybe"
                        class="inline-flex items-center justify-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-sm font-semibold text-slate-200 hover:border-sky-400 hover:text-sky-300 transition-colors">
                  Add to maybeboard
                </button>
              </div>
            </form>
          {{ end }}

          {{ if $isGuest }}
            <p id="guest-add-status" class="text-xs text-slate-500" aria-live="polite"></p>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" id="guest-copy-decklist"
                      class="inline-flex items-center px-2.5 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-sky-400 hover:text-sky-300 transition-colors">
                Copy decklist
              </button>
              {{ if .CurrentUser }}
                <button type="button" id="guest-save-to-account-2"
                        class="inline-flex items-center px-2.5 py-1 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors">
                  Save to my account
                </button>
              {{ else }}
                <a href="/login?next={{ if $ctx.GuestSandbox }}{{ urlquery "/decks/guest?sandbox=1&save_guest=1" }}{{ else if $d.CommanderName }}{{ urlquery (print "/decks/guest?commander_name=" $d.CommanderName "&save_guest=1") }}{{ else }}{{ urlquery "/decks/guest?save_guest=1" }}{{ end }}"
                   class="inline-flex items-center px-2.5 py-1 rounded-md bg-amber-300 text-slate-950 text-xs font-semibold hover:bg-amber-200 transition-colors">
                  Log in to save
                </a>
              {{ end }}
            </div>
            <p id="guest-copy-status" class="text-xs text-slate-500" aria-live="polite"></p>
          {{ else }}
            <p class="text-xs text-slate-500">
              Tip: use full Card Search for advanced filters and browsing.
            </p>
          {{ end }}
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
          Cards in deck
          {{ if $isGuest }}
            <span id="guest-deck-count-label" class="normal-case text-slate-500">(0)</span>
          {{ else }}
            <span id="signed-deck-count-label" class="normal-case text-slate-500">({{ $ctx.VisibleCardCount }})</span>
          {{ end }}
        </h3>
      </div>

      <div id="signed-deck-view-controls" class="mb-3 flex flex-wrap items-end gap-2">
        <label class="text-[11px] text-slate-400">
          <span class="block mb-1 uppercase tracking-wide">View As</span>
          <select id="signed-layout-mode"
                  class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
            <option value="text">Text</option>
            <option value="table">Table</option>
            <option value="art_stacked">Stacks</option>
            <option value="art_grid">Grid</option>
          </select>
        </label>
        <label class="text-[11px] text-slate-400">
          <span class="block mb-1 uppercase tracking-wide">Group by</span>
          <select id="signed-group-mode"
                  class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
            <option value="none">None</option>
            <option value="type">Type</option>
            <option value="cmc">Mana Value</option>
            <option value="category">Category</option>
          </select>
        </label>
        <label class="text-[11px] text-slate-400">
          <span class="block mb-1 uppercase tracking-wide">Sort by</span>
          <select id="signed-sort-mode"
                  class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
            <option value="name">Alphabet</option>
            <option value="cmc">Mana Value</option>
            <option value="type">Type</option>
            <option value="price">Price</option>
          </select>
        </label>
        <label class="text-[11px] text-slate-400">
          <span class="block mb-1 uppercase tracking-wide">Order</span>
          <select id="signed-sort-direction"
                  class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
          </select>
        </label>
      </div>
      <div id="signed-deck-cards-view" class="hidden"></div>

      {{ if not $isGuest }}
        <ul id="signed-deck-cards-source"
            class="divide-y divide-slate-800 text-sm {{ if eq $ctx.VisibleCardCount 0 }}hidden{{ end }}">
          {{ range $ctx.DeckCards }}
            {{ if ne .CardName $d.CommanderName }}
              <li class="flex items-center justify-between gap-3 py-2"
                  data-card-id="{{ .CardID }}"
                  data-card-name="{{ .CardName }}"
                  data-card-qty="{{ .Quantity }}"
                  data-card-type-line="{{ .TypeLine }}"
                  data-card-oracle-text="{{ .OracleText }}"
                  data-card-cmc="{{ printf "%.2f" .CMC }}"
                  data-card-price="{{ .PriceUSD }}"
                  data-card-image-uri="{{ .ImageURI }}">
                <div>
                  <p class="font-medium text-slate-100">{{ .Quantity }}x {{ .CardName }}</p>
                </div>
                <div class="shrink-0 flex items-center gap-1.5">
                  <form method="POST" action="/decks/{{ $d.ID }}">
                    <input type="hidden" name="card_id" value="{{ .CardID }}">
                    <input type="hidden" name="action" value="inc_main">
                    <button type="submit"
                            class="inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors">
                      +
                    </button>
                  </form>
                  <form method="POST" action="/decks/{{ $d.ID }}">
                    <input type="hidden" name="card_id" value="{{ .CardID }}">
                    <button type="submit"
                            class="inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors">
                      −
                    </button>
                  </form>
                </div>
              </li>
            {{ end }}
          {{ end }}
        </ul>
        <p id="signed-deck-cards-empty" class="text-sm text-slate-400 {{ if gt $ctx.VisibleCardCount 0 }}hidden{{ end }}">
          No cards yet. Use card search above to start adding cards.
        </p>
      {{ else }}
        <ul id="guest-deck-cards" class="divide-y divide-slate-800 text-sm"></ul>
        <p id="guest-deck-cards-empty" class="text-sm text-slate-400 hidden">
          No cards yet. Use card search above to start adding cards.
        </p>
      {{ end }}
    </section>

    <section class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
          Maybeboard
          {{ if $isGuest }}
            <span id="guest-maybeboard-count-label" class="normal-case text-slate-500">(0)</span>
          {{ else }}
            <span id="signed-maybeboard-count-label" class="normal-case text-slate-500">({{ $ctx.MaybeCardCount }})</span>
          {{ end }}
        </h3>
      </div>

      {{ if not $isGuest }}
        <ul id="signed-maybeboard-cards"
            class="divide-y divide-slate-800 text-sm {{ if eq $ctx.MaybeCardCount 0 }}hidden{{ end }}">
          {{ range $ctx.MaybeDeckCards }}
            <li class="flex items-center justify-between gap-3 py-2">
              <div>
                <p class="font-medium text-slate-100">{{ .Quantity }}x {{ .CardName }}</p>
              </div>
              <div class="shrink-0 flex items-center gap-1.5">
                <form method="POST" action="/decks/{{ $d.ID }}">
                  <input type="hidden" name="maybe_card_id" value="{{ .CardID }}">
                  <input type="hidden" name="action" value="to_main">
                  <button type="submit"
                          class="inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors">
                    + Deck
                  </button>
                </form>
                <form method="POST" action="/decks/{{ $d.ID }}">
                  <input type="hidden" name="maybe_card_id" value="{{ .CardID }}">
                  <input type="hidden" name="action" value="inc_maybe">
                  <button type="submit"
                          class="inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors">
                    +
                  </button>
                </form>
                <form method="POST" action="/decks/{{ $d.ID }}">
                  <input type="hidden" name="maybe_card_id" value="{{ .CardID }}">
                  <button type="submit"
                          class="inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors">
                    −
                  </button>
                </form>
              </div>
            </li>
          {{ end }}
        </ul>
        <p id="signed-maybeboard-empty" class="text-sm text-slate-400 {{ if gt $ctx.MaybeCardCount 0 }}hidden{{ end }}">
          No maybeboard cards yet. Use "Add to maybeboard" in Card Search.
        </p>
      {{ else }}
        <ul id="guest-maybeboard-cards" class="divide-y divide-slate-800 text-sm"></ul>
        <p id="guest-maybeboard-empty" class="text-sm text-slate-400 hidden">
          No maybeboard cards yet. Use "Add to maybeboard" in Card Search.
        </p>
      {{ end }}
    </section>

    <section class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Deck analytics</h3>
        {{ if $isGuest }}
          <span id="guest-analytics-status" class="text-[11px] text-slate-500">Syncing...</span>
        {{ end }}
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-2 text-xs">
        <div class="rounded-md border border-slate-800 bg-slate-950 px-2.5 py-2">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Total cards</p>
          <p id="deck-analytics-total" class="text-slate-100 text-sm font-semibold">{{ $ctx.Analytics.TotalCards }}</p>
        </div>
        <div class="rounded-md border border-slate-800 bg-slate-950 px-2.5 py-2">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Mainboard</p>
          <p id="deck-analytics-mainboard" class="text-slate-100 text-sm font-semibold">{{ $ctx.Analytics.MainboardCards }}</p>
        </div>
        <div class="rounded-md border border-slate-800 bg-slate-950 px-2.5 py-2">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Commander set</p>
          <p id="deck-analytics-commander-set" class="text-slate-100 text-sm font-semibold">{{ if $ctx.Analytics.CommanderSet }}Yes{{ else }}No{{ end }}</p>
        </div>
        <div class="rounded-md border border-slate-800 bg-slate-950 px-2.5 py-2">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Average CMC</p>
          <p id="deck-analytics-avg-cmc" class="text-slate-100 text-sm font-semibold">{{ $ctx.Analytics.AverageCMCDisplay }}</p>
        </div>
        <div class="rounded-md border border-slate-800 bg-slate-950 px-2.5 py-2">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Lands</p>
          <p id="deck-analytics-lands" class="text-slate-100 text-sm font-semibold">{{ $ctx.Analytics.LandCount }}</p>
        </div>
        <div class="rounded-md border border-slate-800 bg-slate-950 px-2.5 py-2">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Nonlands</p>
          <p id="deck-analytics-nonlands" class="text-slate-100 text-sm font-semibold">{{ $ctx.Analytics.NonLandCount }}</p>
        </div>
      </div>

      <div class="mt-4 grid gap-4 xl:grid-cols-2">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 mb-1">Type breakdown</p>
          <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs text-slate-300">
            <p class="flex items-center justify-between"><span>Creatures</span><span id="deck-analytics-type-creature">{{ $ctx.Analytics.CreatureCount }}</span></p>
            <p class="flex items-center justify-between"><span>Artifacts</span><span id="deck-analytics-type-artifact">{{ $ctx.Analytics.ArtifactCount }}</span></p>
            <p class="flex items-center justify-between"><span>Enchantments</span><span id="deck-analytics-type-enchantment">{{ $ctx.Analytics.EnchantmentCount }}</span></p>
            <p class="flex items-center justify-between"><span>Instants</span><span id="deck-analytics-type-instant">{{ $ctx.Analytics.InstantCount }}</span></p>
            <p class="flex items-center justify-between"><span>Sorceries</span><span id="deck-analytics-type-sorcery">{{ $ctx.Analytics.SorceryCount }}</span></p>
            <p class="flex items-center justify-between"><span>Planeswalkers</span><span id="deck-analytics-type-planeswalker">{{ $ctx.Analytics.PlaneswalkerCount }}</span></p>
            <p class="flex items-center justify-between"><span>Battles</span><span id="deck-analytics-type-battle">{{ $ctx.Analytics.BattleCount }}</span></p>
          </div>
        </div>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 mb-1">Mana curve (nonland spells)</p>
          <div class="rounded-md border border-slate-800 bg-slate-950/80 p-2">
            <div class="h-24 overflow-hidden flex items-end gap-1.5">
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-0" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve0Count }}</p>
                <div id="deck-curve-bar-0" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">0</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-1" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve1Count }}</p>
                <div id="deck-curve-bar-1" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">1</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-2" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve2Count }}</p>
                <div id="deck-curve-bar-2" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">2</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-3" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve3Count }}</p>
                <div id="deck-curve-bar-3" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">3</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-4" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve4Count }}</p>
                <div id="deck-curve-bar-4" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">4</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-5" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve5Count }}</p>
                <div id="deck-curve-bar-5" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">5</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-6" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve6Count }}</p>
                <div id="deck-curve-bar-6" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">6</p>
              </div>
              <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                <p id="deck-analytics-curve-7p" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve7PlusCount }}</p>
                <div id="deck-curve-bar-7p" class="w-5 rounded-t bg-cyan-300/80 h-[4px] transition-all duration-200"></div>
                <p class="text-slate-500 text-[10px]">7+</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Example hand</p>
            <button type="button"
                    id="deck-analytics-new-hand"
                    class="inline-flex items-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-[11px] text-slate-200 hover:border-sky-400 hover:text-sky-300 transition-colors">
              Fresh seven
            </button>
          </div>
          <div class="rounded-md border border-slate-800 bg-slate-950/80 p-2.5">
            <ul id="deck-analytics-example-hand" class="flex items-start gap-2 overflow-x-auto pb-1"></ul>
            <p id="deck-analytics-example-hand-empty" class="text-xs text-slate-500">Add cards to generate an example hand.</p>
          </div>
        </div>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 mb-1">Deck tokens and extras</p>
          <div class="rounded-md border border-slate-800 bg-slate-950/80 p-2.5">
            <ul id="deck-analytics-extras" class="flex items-start gap-2 overflow-x-auto pb-1">
              {{ if $ctx.Analytics.DeckExtras }}
                {{ range $ctx.Analytics.DeckExtras }}
                  <li data-extra-name="{{ .Name }}" data-extra-count="{{ .Count }}" class="text-xs text-slate-300">
                    <span>{{ .Name }}</span>
                    <span>{{ .Count }}</span>
                  </li>
                {{ end }}
              {{ else }}
                <li id="deck-analytics-extras-empty" class="text-slate-500">No deck extras detected yet.</li>
              {{ end }}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  {{ template "deck_show_preview_overlay" . }}

  {{ template "deck_show_guest_draft_script" . }}
  {{ template "deck_show_cards_view_script" . }}

  {{ template "layout_footer" . }}
{{ end }}
