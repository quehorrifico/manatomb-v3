    var actionPath = '/decks/' + String(deckID);
    var lastSubmitter = null;

    if (!sourceList || !viewRoot || !groupSelect || !sortSelect || !sortDirectionSelect || !layoutSelect) return;

    function toInt(v, fallback) {
      var n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return Math.floor(n);
    }

    function toFloat(v, fallback) {
      var n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return n;
    }

    function normalize(s) {
      return String(s || '').replace(/\s+/g, ' ').trim();
    }

    function loadPrefs() {
      try {
        var raw = localStorage.getItem(prefKey);
        if (!raw) return {};
        var obj = JSON.parse(raw);
        if (!obj || typeof obj !== 'object') return {};
        return obj;
      } catch (e) {
        return {};
      }
    }

    function savePrefs(obj) {
      try {
        localStorage.setItem(prefKey, JSON.stringify(obj));
      } catch (e) {
        // ignore
      }
    }

    function syncSignedStateFromDoc(doc) {
      if (isGuest || !doc) return;

      var nextSource = doc.getElementById('signed-deck-cards-source');
      if (nextSource && sourceList) {
        sourceList.innerHTML = nextSource.innerHTML;
      }

      var nextDeckEmpty = doc.getElementById('signed-deck-cards-empty');
      if (nextDeckEmpty && signedDeckEmpty) {
        signedDeckEmpty.textContent = nextDeckEmpty.textContent;
        signedDeckEmpty.classList.toggle('hidden', nextDeckEmpty.classList.contains('hidden'));
      }

      var nextDeckCount = doc.getElementById('signed-deck-count-label');
      if (nextDeckCount && signedDeckCountLabel) {
        signedDeckCountLabel.textContent = nextDeckCount.textContent;
      }

      var nextMaybeList = doc.getElementById('signed-maybeboard-cards');
      if (nextMaybeList && signedMaybeList) {
        signedMaybeList.innerHTML = nextMaybeList.innerHTML;
        signedMaybeList.classList.toggle('hidden', nextMaybeList.classList.contains('hidden'));
      }

      var nextMaybeEmpty = doc.getElementById('signed-maybeboard-empty');
      if (nextMaybeEmpty && signedMaybeEmpty) {
        signedMaybeEmpty.textContent = nextMaybeEmpty.textContent;
        signedMaybeEmpty.classList.toggle('hidden', nextMaybeEmpty.classList.contains('hidden'));
      }

      var nextMaybeCount = doc.getElementById('signed-maybeboard-count-label');
      if (nextMaybeCount && signedMaybeCountLabel) {
        signedMaybeCountLabel.textContent = nextMaybeCount.textContent;
      }

      var metricNodes = document.querySelectorAll('[id^="deck-analytics-"]');
      for (var i = 0; i < metricNodes.length; i++) {
        var cur = metricNodes[i];
        if (!cur || !cur.id) continue;
        if (cur.id === 'deck-analytics-extras') continue;
        if (cur.id === 'deck-analytics-example-hand') continue;
        if (cur.id === 'deck-analytics-example-hand-empty') continue;
        var fresh = doc.getElementById(cur.id);
        if (!fresh) continue;
        cur.textContent = fresh.textContent;
      }

      if (window.mtDeckSyncManaCurveBars) window.mtDeckSyncManaCurveBars();
    }

    function formPayload(form, submitter) {
      var body = new URLSearchParams();
      if (!form) return body;
      var formData = new FormData(form);
      if (submitter && submitter.name && !formData.has(submitter.name)) {
        formData.append(submitter.name, submitter.value || '');
      }
      formData.forEach(function (value, key) {
        body.append(key, String(value));
      });
      if (submitter && submitter.name && !body.has(submitter.name)) {
        body.append(submitter.name, submitter.value || '');
      }
      return body;
    }

    function fieldsPayload(fields) {
      var body = new URLSearchParams();
      if (!fields || typeof fields !== 'object') return body;
      var keys = Object.keys(fields);
      for (var i = 0; i < keys.length; i++) {
        var key = keys[i];
        var value = fields[key];
        if (value === undefined || value === null) continue;
        body.append(key, String(value));
      }
      return body;
    }

    async function submitSignedDeckMutationRequest(url, body, submitter) {
      if (isGuest) return;
      if (signedMutationBusy) return;
      signedMutationBusy = true;

      var disabledBefore = false;
      if (submitter) {
        disabledBefore = !!submitter.disabled;
        submitter.disabled = true;
      }

      try {
        var res = await fetch(url || actionPath, {
          method: 'POST',
          body: body.toString(),
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
          },
          credentials: 'same-origin',
        });
        if (!res.ok) throw new Error('request failed');
        var html = await res.text();
        var parsed = (new DOMParser()).parseFromString(html, 'text/html');
        if (!parsed.getElementById('signed-deck-cards-source')) {
          window.location.reload();
          return;
        }

        syncSignedStateFromDoc(parsed);
        cards = readCardsFromSource();
        renderDeckCards();
      } catch (e) {
        window.location.reload();
      } finally {
        if (submitter) submitter.disabled = disabledBefore;
        signedMutationBusy = false;
      }
    }

    async function submitSignedDeckMutation(form, submitter) {
      if (isGuest || !form) return;
      await submitSignedDeckMutationRequest(
        form.action || actionPath,
        formPayload(form, submitter),
        submitter
      );
    }

    async function submitSignedDeckFieldMutation(fields, submitter) {
      if (isGuest) return;
      await submitSignedDeckMutationRequest(
        actionPath,
        fieldsPayload(fields),
        submitter
      );
    }

    function bindPreview(node, card) {
      if (!node || !previewApi) return;
      var needsGuestFetch = isGuest && !normalize(card.imageURI || '') && typeof window.mtDeckGuestShowCardPreview === 'function';
      if (previewApi.tapMode && previewApi.toggle) {
        node.addEventListener('click', function (event) {
          if (event.target && event.target.closest) {
            if (event.target.closest('button, a, input, select, textarea, form')) return;
          }
          if (needsGuestFetch) {
            window.mtDeckGuestShowCardPreview(card.name || '', event, node);
            return;
          }
          previewApi.toggle(card.imageURI || '', card.name || '', event, node);
        });
      } else {
        node.addEventListener('mouseenter', function (event) {
          if (previewApi.move) previewApi.move(event);
          if (needsGuestFetch) {
            window.mtDeckGuestShowCardPreview(card.name || '', event, node);
            return;
          }
          previewApi.show(card.imageURI || '', card.name || '');
        });
        node.addEventListener('mousemove', function (event) {
          if (previewApi.move) previewApi.move(event);
        });
        node.addEventListener('mouseleave', function () {
          previewApi.hide();
        });
      }
    }

    function readCardsFromSource() {
      var out = [];
      if (!sourceList) return out;

      var nodes = sourceList.querySelectorAll('li[data-card-name]');
      for (var i = 0; i < nodes.length; i++) {
        var node = nodes[i];
        var name = normalize(node.getAttribute('data-card-name'));
        var qty = toInt(node.getAttribute('data-card-qty'), 0);
        if (!name || !Number.isFinite(qty) || qty <= 0) continue;

        out.push({
          cardID: normalize(node.getAttribute('data-card-id')),
          name: name,
          qty: qty,
          typeLine: normalize(node.getAttribute('data-card-type-line')),
          oracleText: normalize(node.getAttribute('data-card-oracle-text')),
          cmc: toFloat(node.getAttribute('data-card-cmc'), 0),
          priceUSD: normalize(node.getAttribute('data-card-price')),
          imageURI: normalize(node.getAttribute('data-card-image-uri')),
        });
      }
      return out;
    }

    var cards = [];

    function typeBucket(card) {
      var t = String(card.typeLine || '').toLowerCase();
      if (t.indexOf('land') >= 0) return 'Lands';
      if (t.indexOf('creature') >= 0) return 'Creatures';
      if (t.indexOf('artifact') >= 0) return 'Artifacts';
      if (t.indexOf('enchantment') >= 0) return 'Enchantments';
      if (t.indexOf('instant') >= 0) return 'Instants';
      if (t.indexOf('sorcery') >= 0) return 'Sorceries';
      if (t.indexOf('planeswalker') >= 0) return 'Planeswalkers';
      if (t.indexOf('battle') >= 0) return 'Battles';
      return 'Other';
    }

    function cmcBucket(card) {
      var t = String(card.typeLine || '').toLowerCase();
      if (t.indexOf('land') >= 0) return 'Lands';
      var cmc = toInt(Math.floor(Number(card.cmc || 0)), 0);
      if (cmc < 0) return '0';
      return String(cmc);
    }

    function categoryBucket(card) {
      var t = String(card.typeLine || '').toLowerCase();
      var o = String(card.oracleText || '').toLowerCase();

      if (t.indexOf('land') >= 0) return 'Lands';
      if (/\bpopulate\b/.test(o)) return 'Populate';
      if (/players can\'t|can\'t cast|spells cost \{[0-9xwubrgc\/]+\} more|skip (their|your) (untap|draw|combat) step|don\'t untap during|enters tapped/.test(o)) return 'Stax';
      if (/mill(s|ed)? |put the top .* cards? of .* library into .* graveyard/.test(o)) return 'Mill';
      if (/search your library for (a|an|up to .*?) card/.test(o)) return 'Tutor';
      if (/search your library for (a|up to .*?) land|add \{[wubrgc]\}|treasure token|mana of any color/.test(o)) return 'Ramp';
      if (/draw (a|two|three|x) card|draw cards|whenever .* draw/.test(o)) return 'Draw';
      if (/from your graveyard to your hand|return .* from your graveyard|cast .* from your graveyard|reanimate|return target .* card from your graveyard/.test(o)) return 'Recursion';
      if (/hexproof|indestructible|protection from|ward \{/.test(o)) return 'Protection';
      if (/destroy all|exile all|all creatures|gets -\d\/-\d/.test(o)) return 'Board Wipes';
      if (/counter target/.test(o)) return 'Countermagic';
      if (/destroy target|exile target|return target .* to.* hand|fight target/.test(o)) return 'Removal';
      if (/create .* token/.test(o)) return 'Token Makers';
      if (/you win the game|each opponent loses the game|an opponent loses the game/.test(o)) return 'Win Conditions';
      return 'Utility';
    }

    function normalizePrice(price) {
      var n = Number(String(price || '').replace(/[^0-9.]/g, ''));
      if (!Number.isFinite(n) || n < 0) return null;
      return n;
    }

    function cardComparator(sortMode, sortDirection) {
      var dir = sortDirection === 'desc' ? -1 : 1;

      function cmpByName(a, b) {
        return String(a.name || '').localeCompare(String(b.name || ''));
      }

      return function (a, b) {
        var cmp = 0;
        if (sortMode === 'cmc') {
          var aCMC = Number(a.cmc || 0);
          var bCMC = Number(b.cmc || 0);
          cmp = aCMC - bCMC;
          if (cmp === 0) cmp = cmpByName(a, b);
        } else if (sortMode === 'type') {
          cmp = String(a.typeLine || '').localeCompare(String(b.typeLine || ''));
          if (cmp === 0) cmp = cmpByName(a, b);
        } else if (sortMode === 'price') {
          var aPrice = normalizePrice(a.priceUSD);
          var bPrice = normalizePrice(b.priceUSD);
          if (aPrice === null && bPrice === null) {
            cmp = cmpByName(a, b);
          } else if (aPrice === null) {
            cmp = 1;
          } else if (bPrice === null) {
            cmp = -1;
          } else {
            cmp = aPrice - bPrice;
            if (cmp === 0) cmp = cmpByName(a, b);
          }
        } else {
          cmp = cmpByName(a, b);
        }

        return cmp * dir;
      };
    }

    function groupedCards(groupMode, sortMode, sortDirection) {
      var groups = {};
      var order = [];
      var compareCards = cardComparator(sortMode, sortDirection);

      function ensureGroup(name) {
        if (!groups[name]) {
          groups[name] = [];
          order.push(name);
        }
      }

      for (var i = 0; i < cards.length; i++) {
        var card = cards[i];
        var name = 'All Cards';
        if (groupMode === 'type') {
          name = typeBucket(card);
        } else if (groupMode === 'cmc') {
          name = cmcBucket(card);
        } else if (groupMode === 'category') {
          name = categoryBucket(card);
        }
        ensureGroup(name);
        groups[name].push(card);
      }

      var ordered = [];
      var preferred = [];
      if (groupMode === 'type') {
        preferred = ['Lands', 'Creatures', 'Artifacts', 'Enchantments', 'Instants', 'Sorceries', 'Planeswalkers', 'Battles', 'Other'];
      } else if (groupMode === 'category') {
        preferred = ['Lands', 'Stax', 'Populate', 'Mill', 'Tutor', 'Ramp', 'Draw', 'Recursion', 'Protection', 'Board Wipes', 'Countermagic', 'Removal', 'Token Makers', 'Win Conditions', 'Utility'];
      }

      if (groupMode === 'cmc') {
        if (groups['Lands']) {
          ordered.push({ name: 'Lands', cards: groups['Lands'] });
          delete groups['Lands'];
        }

        var numericKeys = [];
        var otherKeys = [];
        var cmcKeys = Object.keys(groups);
        for (var ck = 0; ck < cmcKeys.length; ck++) {
          var key = cmcKeys[ck];
          if (/^\d+$/.test(key)) {
            numericKeys.push(key);
          } else {
            otherKeys.push(key);
          }
        }
        numericKeys.sort(function (a, b) { return Number(a) - Number(b); });
        otherKeys.sort(function (a, b) { return a.localeCompare(b); });

        var orderedKeys = numericKeys.concat(otherKeys);
        for (var ok = 0; ok < orderedKeys.length; ok++) {
          var cmcGroup = orderedKeys[ok];
          ordered.push({ name: cmcGroup, cards: groups[cmcGroup] });
        }
        for (var ci = 0; ci < ordered.length; ci++) {
          ordered[ci].cards = ordered[ci].cards.slice().sort(compareCards);
        }
        return ordered;
      }

      if (preferred.length > 0) {
        for (var p = 0; p < preferred.length; p++) {
          var groupName = preferred[p];
          if (groups[groupName]) {
            ordered.push({ name: groupName, cards: groups[groupName] });
            delete groups[groupName];
          }
        }
        var rest = Object.keys(groups).sort(function (a, b) { return a.localeCompare(b); });
        for (var r = 0; r < rest.length; r++) {
          ordered.push({ name: rest[r], cards: groups[rest[r]] });
        }
        for (var oi = 0; oi < ordered.length; oi++) {
          ordered[oi].cards = ordered[oi].cards.slice().sort(compareCards);
        }
        return ordered;
      }

      for (var j = 0; j < order.length; j++) {
        ordered.push({ name: order[j], cards: groups[order[j]] });
      }
      for (var k = 0; k < ordered.length; k++) {
        ordered[k].cards = ordered[k].cards.slice().sort(compareCards);
      }
      return ordered;
    }

