      </div>
    </section>
  </main>

  <div id="deck-card-preview"
       class="hidden fixed z-50 w-64 max-w-[45vw] pointer-events-none">
    <div class="rounded-xl border border-slate-700 bg-slate-950/95 p-2 shadow-2xl shadow-slate-950">
      <img id="deck-card-preview-img"
           src=""
           alt="Card preview"
           class="hidden w-full h-auto rounded-md">
      <div id="deck-card-preview-fallback"
           class="hidden rounded-md border border-slate-700 bg-slate-900 px-3 py-6 text-center text-sm text-slate-300"></div>
    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var isGuest = {{ if $isGuest }}true{{ else }}false{{ end }};
    var isSignedIn = {{ if .CurrentUser }}true{{ else }}false{{ end }};
    var commanderName = {{ printf "%q" $d.CommanderName }};
    var previewWrap = document.getElementById('deck-card-preview');
    var previewImg = document.getElementById('deck-card-preview-img');
    var previewFallback = document.getElementById('deck-card-preview-fallback');
    var exampleHandList = document.getElementById('deck-analytics-example-hand');
    var exampleHandEmpty = document.getElementById('deck-analytics-example-hand-empty');
    var exampleHandFreshBtn = document.getElementById('deck-analytics-new-hand');
    var requiresTapPreview = false;
    var tapPreviewSource = null;
    var previewLastX = 0;
    var previewLastY = 0;

    try {
      requiresTapPreview = !!(window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches);
    } catch (e) {
      requiresTapPreview = false;
    }
    if (!requiresTapPreview) {
      requiresTapPreview = ('ontouchstart' in window) || ((navigator && navigator.maxTouchPoints) ? navigator.maxTouchPoints > 0 : false);
    }

    function positionDeckCardPreview(clientX, clientY) {
      if (!previewWrap) return;

      if (Number.isFinite(clientX) && Number.isFinite(clientY)) {
        previewLastX = clientX;
        previewLastY = clientY;
      }

      var x = previewLastX || 0;
      var y = previewLastY || 0;
      var offset = 18;
      var width = previewWrap.offsetWidth || 256;
      var height = previewWrap.offsetHeight || 360;
      var maxX = Math.max(8, (window.innerWidth || 0) - width - 8);
      var maxY = Math.max(8, (window.innerHeight || 0) - height - 8);
      var left = Math.min(maxX, x + offset);
      var top = Math.min(maxY, y + offset);

      if (left < 8) left = 8;
      if (top < 8) top = 8;

      previewWrap.style.left = String(left) + 'px';
      previewWrap.style.top = String(top) + 'px';
    }

    function showDeckCardPreview(imageURI, cardName, sourceNode) {
      if (!previewWrap) return;
      if (sourceNode) tapPreviewSource = sourceNode;
      if (imageURI) {
        if (previewImg) {
          previewImg.src = imageURI;
          previewImg.alt = cardName || 'Card preview';
          previewImg.classList.remove('hidden');
        }
        if (previewFallback) previewFallback.classList.add('hidden');
      } else {
        if (previewImg) previewImg.classList.add('hidden');
        if (previewFallback) {
          previewFallback.textContent = cardName || 'Card preview unavailable';
          previewFallback.classList.remove('hidden');
        }
      }
      previewWrap.classList.remove('hidden');
      positionDeckCardPreview();
    }

    function moveDeckCardPreview(event) {
      if (!event) return;
      positionDeckCardPreview(event.clientX, event.clientY);
    }

    function hideDeckCardPreview() {
      if (!previewWrap) return;
      previewWrap.classList.add('hidden');
      tapPreviewSource = null;
    }

    function toggleDeckCardPreview(imageURI, cardName, event, sourceNode) {
      if (!previewWrap) return;
      if (event) {
        moveDeckCardPreview(event);
      }
      if (tapPreviewSource && sourceNode && tapPreviewSource === sourceNode && !previewWrap.classList.contains('hidden')) {
        hideDeckCardPreview();
        return;
      }
      showDeckCardPreview(imageURI, cardName, sourceNode);
    }

    function normalizeName(s) {
      // Collapse internal whitespace and trim.
      return (s || '').replace(/\s+/g, ' ').trim();
    }

    function renderManaCostPips(target) {
      if (!target) return;
      var raw = String(target.getAttribute('data-mana-cost') || '').trim();
      if (!raw) {
        target.textContent = '';
        return;
      }
      var tokens = raw.match(/\{[^}]+\}/g);
      if (!tokens || tokens.length === 0) {
        target.textContent = raw;
        return;
      }

      target.innerHTML = '';
      target.title = raw;
      for (var i = 0; i < tokens.length; i++) {
        var symbol = String(tokens[i] || '').replace(/^\{|\}$/g, '').trim();
        if (!symbol) continue;
        var img = document.createElement('img');
        img.alt = '{' + symbol + '}';
        img.src = 'https://svgs.scryfall.io/card-symbols/' + encodeURIComponent(symbol.toUpperCase()) + '.svg';
        img.className = 'h-3.5 w-3.5 inline-block';
        target.appendChild(img);
      }
    }

    renderManaCostPips(document.getElementById('deck-commander-mana-cost'));

    var analyticsCardImageCache = {};
    var exampleHandRenderToken = 0;
    var extrasRenderToken = 0;

    function extractResolvedImageURI(data) {
      if (!data || typeof data !== 'object') return '';
      if (data.image_uris) {
        return data.image_uris.normal || data.image_uris.large || data.image_uris.small || '';
      }
      return '';
    }

    async function fetchLocalResolvedImage(name) {
      var normalized = normalizeName(name);
      if (!normalized) return '';
      try {
        var res = await fetch('/cards/resolve?q=' + encodeURIComponent(normalized), {
          method: 'GET',
          credentials: 'same-origin'
        });
        if (!res.ok) return '';
        var data = await res.json();
        return extractResolvedImageURI(data);
      } catch (e) {
        return '';
      }
    }

    async function resolveCardImage(name, searchQuery) {
      var normalizedName = normalizeName(name);
      var normalizedQuery = normalizeName(searchQuery || '');
      var cacheKey = normalizedQuery ? ('q:' + normalizedQuery.toLowerCase()) : ('n:' + normalizedName.toLowerCase());
      if (Object.prototype.hasOwnProperty.call(analyticsCardImageCache, cacheKey)) {
        return analyticsCardImageCache[cacheKey];
      }

      var imageURI = '';
      if (normalizedName) {
        imageURI = await fetchLocalResolvedImage(normalizedName);
      }
      if (!imageURI && normalizedQuery) {
        imageURI = await fetchLocalResolvedImage(normalizedQuery);
      }
      analyticsCardImageCache[cacheKey] = imageURI || '';
      return analyticsCardImageCache[cacheKey];
    }

    function extraArtTarget(extraName) {
      var key = normalizeName(extraName).toLowerCase();
      var lookup = {
        'treasure tokens': { name: 'Treasure', query: '!"Treasure" t:token' },
        'clue tokens': { name: 'Clue', query: '!"Clue" t:token' },
        'food tokens': { name: 'Food', query: '!"Food" t:token' },
        'blood tokens': { name: 'Blood', query: '!"Blood" t:token' },
        'map tokens': { name: 'Map', query: '!"Map" t:token' },
        'powerstone tokens': { name: 'Powerstone', query: '!"Powerstone" t:token' },
        'incubator tokens': { name: 'Incubator', query: '!"Incubator" t:token' },
        'junk tokens': { name: 'Junk', query: '!"Junk" t:token' },
        'role tokens': { name: 'Role', query: '!"Role" t:token' },
        'gold tokens': { name: 'Gold', query: '!"Gold" t:token' },
        'other tokens': { name: 'Token', query: 't:token' },
        'city\'s blessing': { name: 'The City\'s Blessing', query: 'name:"The City\'s Blessing"' },
        'the monarch': { name: 'The Monarch', query: 'name:"The Monarch"' },
        'the initiative': { name: 'The Initiative', query: 'name:"The Initiative"' },
        'day/night': { name: 'Day', query: 'name:"Day" type:card' },
        'energy counters': { name: 'Energy Reserve', query: 'name:"Energy Reserve"' },
        'experience counters': { name: 'Experience Counter', query: 'name:"Experience Counter"' },
        'poison counters': { name: 'Poison Counter', query: 'name:"Poison Counter"' },
        'shield counters': { name: 'Shield Counter', query: 'name:"Shield Counter"' },
        'stun counters': { name: 'Stun Counter', query: 'name:"Stun Counter"' },
        '+1/+1 counters': { name: '+1/+1 Counter', query: 'name:"+1/+1 Counter"' },
      };
      if (lookup[key]) return lookup[key];
      var fallback = normalizeName(extraName).replace(/\s+tokens?$/i, '').trim();
      return { name: fallback || normalizeName(extraName), query: '' };
    }

    function createAnalyticsArtTile(opts) {
      var name = normalizeName(opts && opts.name ? opts.name : '');
      var count = Number(opts && opts.count ? opts.count : 0);
      var caption = normalizeName(opts && opts.caption ? opts.caption : name);
      var currentImageURI = normalizeName(opts && opts.imageURI ? opts.imageURI : '');

      var li = document.createElement('li');
      li.className = 'w-[78px] sm:w-[88px] shrink-0';

      var cardFrame = document.createElement('div');
      cardFrame.className = 'relative w-full aspect-[5/7] rounded-md overflow-hidden border border-slate-800 bg-slate-900';

      var img = document.createElement('img');
      img.alt = name || 'Card art';
      img.className = 'hidden w-full h-full object-cover';

      var fallback = document.createElement('div');
      fallback.className = 'w-full h-full flex items-center justify-center px-1 text-center text-[10px] text-slate-300';
      fallback.textContent = caption || 'Card';

      cardFrame.appendChild(img);
      cardFrame.appendChild(fallback);

      if (count > 1) {
        var badge = document.createElement('span');
        badge.className = 'absolute right-1 top-1 rounded bg-slate-950/95 px-1.5 py-0.5 text-[10px] font-semibold text-sky-300';
        badge.textContent = String(count);
        cardFrame.appendChild(badge);
      }

      var label = document.createElement('p');
      label.className = 'mt-1 text-[10px] text-slate-300 truncate';
      label.textContent = caption || name || 'Card';
      label.title = caption || name || 'Card';

      li.appendChild(cardFrame);
      li.appendChild(label);

      function applyImage(uri) {
        currentImageURI = normalizeName(uri);
        if (currentImageURI) {
          img.src = currentImageURI;
          img.classList.remove('hidden');
          fallback.classList.add('hidden');
        } else {
          img.removeAttribute('src');
          img.classList.add('hidden');
          fallback.classList.remove('hidden');
        }
      }

      if (window.mtDeckCardPreview && window.mtDeckCardPreview.tapMode) {
        li.addEventListener('click', function (event) {
          if (window.mtDeckCardPreview && window.mtDeckCardPreview.toggle) {
            window.mtDeckCardPreview.toggle(currentImageURI, name || caption || 'Card', event, li);
          }
        });
      } else {
        li.addEventListener('mouseenter', function (event) {
          if (window.mtDeckCardPreview && window.mtDeckCardPreview.move) window.mtDeckCardPreview.move(event);
          if (window.mtDeckCardPreview) window.mtDeckCardPreview.show(currentImageURI, name || caption || 'Card');
        });
        li.addEventListener('mousemove', function (event) {
          if (window.mtDeckCardPreview && window.mtDeckCardPreview.move) window.mtDeckCardPreview.move(event);
        });
        li.addEventListener('mouseleave', function () {
          if (window.mtDeckCardPreview) window.mtDeckCardPreview.hide();
        });
      }

      applyImage(currentImageURI);

      return {
        node: li,
        setImage: applyImage,
      };
    }

    function randomizeOrder(items) {
      for (var i = items.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = items[i];
        items[i] = items[j];
        items[j] = tmp;
      }
    }

    function renderExampleHand(cardsInHand) {
      if (!exampleHandList) return;

      var renderToken = ++exampleHandRenderToken;
      exampleHandList.innerHTML = '';
      if (!Array.isArray(cardsInHand) || cardsInHand.length === 0) {
        if (exampleHandEmpty) exampleHandEmpty.classList.remove('hidden');
        return;
      }

      if (exampleHandEmpty) exampleHandEmpty.classList.add('hidden');
      for (var i = 0; i < cardsInHand.length; i++) {
        var card = cardsInHand[i] || {};
        var name = normalizeName(card.name);
        if (!name) continue;
        var tile = createAnalyticsArtTile({
          name: name,
          caption: name,
          imageURI: normalizeName(card.imageURI || ''),
        });
        exampleHandList.appendChild(tile.node);

        if (!normalizeName(card.imageURI || '')) {
          (function (localTile, localName, localRenderToken) {
            resolveCardImage(localName, '').then(function (uri) {
              if (localRenderToken !== exampleHandRenderToken) return;
              if (!uri) return;
              localTile.setImage(uri);
            });
          })(tile, name, renderToken);
        }
      }

      if (exampleHandList.children.length === 0 && exampleHandEmpty) {
        exampleHandEmpty.classList.remove('hidden');
      }
    }

    function buildMainboardPoolFromMap(cardMap, commander, imageByName) {
      var pool = [];
      var activeCommander = normalizeName(commander).toLowerCase();
      var entries = Object.entries(cardMap || {});

      for (var i = 0; i < entries.length; i++) {
        var cardName = normalizeName(entries[i][0]);
        var qty = Number(entries[i][1] || 0);
        if (!cardName || !Number.isFinite(qty) || qty <= 0) continue;
        if (activeCommander && cardName.toLowerCase() === activeCommander) {
          qty -= 1;
        }
        for (var j = 0; j < qty; j++) {
          pool.push({
            name: cardName,
            imageURI: imageByName && imageByName[cardName] ? imageByName[cardName] : '',
          });
        }
      }

      return pool;
    }

    function buildSignedMainboardPool() {
      var source = document.getElementById('signed-deck-cards-source');
      if (!source) return [];

      var cardMap = {};
      var imageByName = {};
      var nodes = source.querySelectorAll('li[data-card-name]');
      for (var i = 0; i < nodes.length; i++) {
        var name = normalizeName(nodes[i].getAttribute('data-card-name'));
        var qty = Number(nodes[i].getAttribute('data-card-qty') || 0);
        var imageURI = normalizeName(nodes[i].getAttribute('data-card-image-uri') || '');
        if (!name || !Number.isFinite(qty) || qty <= 0) continue;
        cardMap[name] = (cardMap[name] || 0) + qty;
        if (!imageByName[name] && imageURI) imageByName[name] = imageURI;
      }
      return buildMainboardPoolFromMap(cardMap, '', imageByName);
    }

    function buildGuestMainboardPool() {
      var draft = window.mtDeckCurrentGuestDraft;
      if (!draft || typeof draft !== 'object') return [];
      var imageByName = {};
      var names = Object.keys(draft.cards || {});
      for (var i = 0; i < names.length; i++) {
        var name = normalizeName(names[i]);
        if (!name) continue;
        var meta = draftMetaForCard(draft, name);
        var imageURI = normalizeName(meta && meta.imageURI ? meta.imageURI : '');
        if (imageURI) imageByName[name] = imageURI;
      }
      return buildMainboardPoolFromMap(draft.cards || {}, currentCommanderForDraft(draft), imageByName);
    }

    function readSeedExtrasFromDOM() {
      var list = document.getElementById('deck-analytics-extras');
      if (!list) return [];

      var out = [];
      var nodes = list.querySelectorAll('li[data-extra-name]');
      for (var i = 0; i < nodes.length; i++) {
        var name = normalizeName(nodes[i].getAttribute('data-extra-name') || '');
        var count = Number(nodes[i].getAttribute('data-extra-count') || 0);
        if (!name || !Number.isFinite(count) || count <= 0) continue;
        out.push({ name: name, count: count });
      }
      return out;
    }

    function drawExampleHand() {
      var pool = isGuest ? buildGuestMainboardPool() : buildSignedMainboardPool();
      if (!Array.isArray(pool) || pool.length === 0) {
        renderExampleHand([]);
