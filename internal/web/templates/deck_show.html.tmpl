{{ define "deck_show" }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}
  {{ $c := $ctx.Commander }}
  {{ $isGuest := false }}
  {{ if $ctx.WorkbenchMode }}
    {{ $isGuest = true }}
  {{ else }}
    {{ $isGuest = not .CurrentUser }}
  {{ end }}
  {{ $isCommanderDeck := eq $d.Format "Commander" }}
  {{ $overviewFormat := "Sandbox" }}
  {{ if $isCommanderDeck }}
    {{ $overviewFormat = "Commander" }}
  {{ end }}
  {{ template "layout_header" . }}

  <main class="max-w-[1500px] mx-auto px-4 sm:px-6 py-5 space-y-4">
    <section class="space-y-3">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="mt-kicker">{{ if $isGuest }}Workspace{{ else }}Deck{{ end }}</p>
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-50">
            {{ if $isGuest }}
              <span id="guest-deck-name">New Guest Deck</span>
            {{ else }}
              <span id="saved-deck-name">{{ $d.Name }}</span>
            {{ end }}
          </h1>
        </div>

        <div class="flex flex-wrap gap-2">
          {{ if $isGuest }}
            <button type="button" id="guest-playtest" class="mt-btn mt-btn--light mt-btn--sm">Playtest</button>
            {{ if .CurrentUser }}
              <button type="button" id="guest-save-to-account" class="mt-btn mt-btn--primary mt-btn--sm">Save</button>
            {{ end }}
          {{ else }}
            <button type="button" id="deck-menu-open" class="mt-btn mt-btn--secondary mt-btn--sm">Deck Menu</button>
            <a href="/decks/playtest/{{ $d.ID }}" class="mt-btn mt-btn--light mt-btn--sm">Playtest</a>
          {{ end }}
        </div>
      </div>
    </section>

    {{ if and $isGuest (not .CurrentUser) }}
      <section id="guest-save-auth-panel" class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <h2 class="text-sm font-semibold text-emerald-100">Save This Deck to Your Account</h2>
            <p class="text-xs text-slate-300">Guest drafts stay local to this browser. Log in or sign up and Mana Tomb will bring you back here and save this deck automatically.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a id="guest-panel-login-to-save"
               href="/login?next=%2Fdecks%2Fnew%2Fworkbench%3Fsave_guest%3D1"
               class="mt-btn mt-btn--secondary mt-btn--sm">Log In</a>
            <a id="guest-panel-signup-to-save"
               href="/signup?next=%2Fdecks%2Fnew%2Fworkbench%3Fsave_guest%3D1"
               class="mt-btn mt-btn--primary mt-btn--sm">Create Account</a>
          </div>
        </div>
      </section>
    {{ end }}

    <section class="mt-panel p-4 sm:p-5 space-y-4">
      <div class="flex items-center justify-between gap-3">
        <p class="mt-kicker">Overview</p>
      </div>
      <div id="deck-overview-layout"
           class="{{ if $isCommanderDeck }}grid gap-4 xl:grid-cols-[minmax(210px,240px)_minmax(0,1fr)]{{ else }}space-y-4{{ end }}">
        <div id="deck-overview-side"
             class="min-w-0 {{ if not $isCommanderDeck }}hidden{{ end }}">

            <section id="deck-commander-panel" class="mt-commander-panel">
              <div class="mt-commander-card">
                <button type="button"
                        id="deck-top-commander-art-wrap"
                        class="mt-commander-art focus:outline-none focus:ring-2 focus:ring-sky-400 {{ if or (and $c $c.ImageURI) (and $c $c.Faces) }}{{ else }}hidden{{ end }}">
                  <img id="deck-top-commander-art"
                       src="{{ if and $c $c.ImageURI }}{{ $c.ImageURI }}{{ else if and $c (gt (len $c.Faces) 0) }}{{ (index $c.Faces 0).ImageURI }}{{ end }}"
                       alt="{{ if $d.CommanderName }}{{ $d.CommanderName }} commander art{{ else }}Commander art{{ end }}"
                       class="block h-full w-full object-cover">
                </button>
                <div id="deck-top-commander-placeholder"
                     class="mt-commander-art mt-commander-art--empty {{ if or (and $c $c.ImageURI) (and $c $c.Faces) }}hidden{{ end }}">
                  <span>Select</span>
                </div>
                <div id="deck-commander-menu-slot" class="mt-commander-menu-slot"></div>
                <button type="button" id="deck-commander-name" class="hidden">
                  {{ if $c }}{{ $c.Name }}{{ else if $d.CommanderName }}{{ $d.CommanderName }}{{ else }}No commander selected{{ end }}
                </button>
                <button type="button"
                        id="deck-commander-flip"
                        class="mt-commander-flip mt-btn mt-btn--secondary mt-btn--xs {{ if and $c (gt (len $c.Faces) 1) }}{{ else }}hidden{{ end }}">Turn Over</button>
              </div>
            </section>
        </div>

        <div class="space-y-3.5 min-w-0">
          <input type="hidden" id="deck-overview-tags-hidden" value="{{ $d.Tags }}">
          <div class="max-w-56">
            <label class="block text-sm text-slate-200">
              <span class="mt-field-label">Format</span>
              <select id="deck-overview-format" class="mt-control">
                <option value="Commander" {{ if $isCommanderDeck }}selected{{ end }}>Commander</option>
                <option value="Sandbox" {{ if not $isCommanderDeck }}selected{{ end }}>Sandbox</option>
              </select>
            </label>
          </div>
          <div class="space-y-2.5">
            <span class="mt-field-label">Tags</span>
            <div id="deck-overview-tags-list" class="flex min-h-8 flex-wrap items-center gap-2"></div>
            <div class="flex flex-wrap gap-2">
              {{ range supportedDeckTags }}
                <button type="button"
                        class="{{ deckTagButtonClass . }}"
                        data-tag-suggestion="{{ . }}">
                  {{ . }}
                </button>
              {{ end }}
            </div>
          </div>

          <label class="block text-sm text-slate-200">
            <span class="mt-field-label">Notes</span>
            <textarea id="deck-overview-notes"
                      rows="4"
                      class="mt-control">{{ $d.Description }}</textarea>
          </label>
          <p id="deck-overview-status" class="text-xs text-slate-500">{{ if $isGuest }}Local changes save automatically.{{ else }}Changes save automatically.{{ end }}</p>
        </div>
      </div>
    </section>

    <section class="mt-panel p-4 sm:p-5 space-y-4">
      <div class="flex items-center justify-between gap-3">
        <p class="mt-kicker">Cards</p>
      </div>

      <div id="deck-quick-build-wrap"
           class="{{ if and $isCommanderDeck $d.CommanderName (eq $ctx.VisibleCardCount 0) (eq $ctx.SideboardCardCount 0) (eq $ctx.MaybeCardCount 0) }}{{ else }}hidden {{ end }}rounded-xl border border-sky-500/30 bg-sky-950/20 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div class="space-y-1">
            <h3 class="text-sm font-semibold text-sky-100">Quick Build</h3>
            <p class="text-xs text-slate-300">Fills your deck with a playable starter list based on your commander. Great for playtesting and refining.</p>
            <p id="deck-quick-build-summary" class="hidden text-xs text-sky-200" aria-live="polite"></p>
          </div>
          <button type="button" id="deck-quick-build" class="mt-btn mt-btn--primary mt-btn--sm shrink-0">Quick Build</button>
        </div>
      </div>

      <form id="deck-add-card-form" {{ if not $isGuest }}method="POST" action="/decks/{{ $d.ID }}"{{ else }}novalidate{{ end }} class="grid gap-1.5">
        <label class="block text-sm text-slate-200">
          <span class="sr-only">Card Search</span>
          <div class="relative">
            <input type="text"
                   id="guest-card-name"
                   name="card_name"
                   required
                   autocomplete="off"
                   placeholder="Type a card name"
                   class="mt-control"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   aria-haspopup="listbox"
                   aria-controls="deck-card-suggestions">
            <div id="deck-card-suggestions"
                 class="mt-autocomplete-menu hidden absolute left-0 right-0 top-[calc(100%+0.35rem)] rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/70"
                 role="listbox"></div>
          </div>
        </label>
        <input type="hidden" id="deck-add-zone" name="zone" value="main">
      </form>

      <p id="deck-add-status" class="text-xs text-slate-500" aria-live="polite"></p>

      <div class="space-y-3">
        <div class="mt-deck-toolbar flex flex-col gap-2.5 xl:flex-row xl:items-end xl:justify-between">
          <div class="mt-board-tabs" role="tablist" aria-label="Deck boards">
            <button type="button" class="mt-board-tab" data-deck-board-tab="main" aria-selected="true">
              <span>Main</span>
              <span id="deck-count-label">{{ if $isGuest }}0{{ else }}{{ $ctx.VisibleCardCount }}{{ end }}</span>
            </button>
            <button type="button" class="mt-board-tab" data-deck-board-tab="side" aria-selected="false">
              <span>Side</span>
              <span id="deck-sideboard-count-label">{{ if $isGuest }}0{{ else }}{{ $ctx.SideboardCardCount }}{{ end }}</span>
            </button>
            <button type="button" class="mt-board-tab" data-deck-board-tab="maybe" aria-selected="false">
              <span>Maybe</span>
              <span id="guest-maybeboard-count-label">{{ if $isGuest }}0{{ else }}{{ $ctx.MaybeCardCount }}{{ end }}</span>
            </button>
          </div>
          <div class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-4 xl:w-auto">
            <label class="block text-xs text-slate-400">
              <span class="mt-field-label mb-1">Filter</span>
              <input id="deck-filter-query"
                     type="search"
                     class="mt-control mt-control--sm"
                     placeholder="Name, type, text"
                     autocomplete="off">
            </label>
            <label class="block text-xs text-slate-400">
              <span class="mt-field-label mb-1">Group</span>
              <select id="deck-group-mode" class="mt-control mt-control--sm">
                <option value="none">None</option>
                <option value="category">Categories</option>
                <option value="alphabet">Alphabet</option>
                <option value="type">Type</option>
                <option value="mv">Mana Value</option>
                <option value="price">Price</option>
              </select>
            </label>
            <label class="block text-xs text-slate-400">
              <span class="mt-field-label mb-1">Sort</span>
              <select id="deck-sort-mode" class="mt-control mt-control--sm">
                <option value="alphabet">Alphabet</option>
                <option value="mv">Mana Value</option>
                <option value="type">Type</option>
                <option value="price">Price</option>
              </select>
            </label>
            <label class="block text-xs text-slate-400">
              <span class="mt-field-label mb-1">View</span>
              <select id="deck-view-mode" class="mt-control mt-control--sm">
                <option value="stacks">Stacks</option>
                <option value="text">Text</option>
                <option value="grid">Grid</option>
                <option value="table">Table</option>
              </select>
            </label>
          </div>
        </div>
        <div id="deck-cards-list" class="space-y-2.5"></div>
        <p id="deck-cards-empty" class="text-sm text-slate-400 {{ if gt $ctx.VisibleCardCount 0 }}hidden{{ else }}hidden{{ end }}">
          Empty.
        </p>
      </div>
    </section>

    <section class="mt-panel p-4 sm:p-5 space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="mt-kicker">Analysis</p>
        </div>
        <span id="deck-analytics-status" class="text-[11px] text-slate-500">{{ if $isGuest }}Updating...{{ end }}</span>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        <button type="button" class="mt-stat-card mt-stat-card--button text-left" data-analytics-stat="all">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Cards</p>
          <p id="deck-analytics-total" class="text-slate-100 text-base font-semibold">{{ $ctx.Analytics.TotalCards }}</p>
        </button>
        <button type="button" class="mt-stat-card mt-stat-card--button text-left" data-analytics-stat="lands">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Lands</p>
          <p id="deck-analytics-lands" class="text-slate-100 text-base font-semibold">{{ $ctx.Analytics.LandCount }}</p>
        </button>
        <button type="button" class="mt-stat-card mt-stat-card--button text-left" data-analytics-stat="nonlands">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Avg MV</p>
          <p id="deck-analytics-avg-cmc" class="text-slate-100 text-base font-semibold">{{ $ctx.Analytics.AverageCMCDisplay }}</p>
        </button>
        <button type="button" class="mt-stat-card mt-stat-card--button text-left" data-analytics-stat="ramp">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Ramp</p>
          <p id="deck-analytics-ramp" class="text-slate-100 text-base font-semibold">{{ $ctx.Analytics.RampCount }}</p>
        </button>
        <button type="button" class="mt-stat-card mt-stat-card--button text-left" data-analytics-stat="draw">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Draw</p>
          <p id="deck-analytics-card-draw" class="text-slate-100 text-base font-semibold">{{ $ctx.Analytics.CardDrawCount }}</p>
        </button>
        <button type="button" class="mt-stat-card mt-stat-card--button text-left" data-analytics-stat="interaction">
          <p class="text-slate-500 uppercase tracking-wide text-[10px]">Interaction</p>
          <p id="deck-analytics-interaction" class="text-slate-100 text-base font-semibold">{{ $ctx.Analytics.InteractionCount }}</p>
        </button>
      </div>

      <div id="deck-analytics-card-list-panel" class="mt-subpanel hidden p-3">
        <div class="flex items-center justify-between gap-3">
          <p id="deck-analytics-card-list-title" class="mt-kicker">Cards</p>
          <button type="button" id="deck-analytics-card-list-close" class="mt-btn mt-btn--secondary mt-btn--xs">Close</button>
        </div>
        <ul id="deck-analytics-card-list" class="mt-2 grid gap-1.5 text-sm text-slate-200 sm:grid-cols-2 lg:grid-cols-3"></ul>
      </div>

      {{ $power := $ctx.Analytics.PowerEstimate }}
      <div id="deck-power-panel" class="mt-power-panel {{ if $power.Available }}{{ else }}hidden{{ end }}">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex items-center gap-3 min-w-0">
            <div class="mt-power-badge">
              <span>B</span><strong id="deck-power-bracket">{{ if $power.Available }}{{ $power.Bracket }}{{ else }}-{{ end }}</strong>
            </div>
            <div class="min-w-0">
              <p id="deck-power-label" class="text-base font-semibold text-slate-50">{{ if $power.Available }}{{ $power.BracketLabel }}{{ else }}Commander only{{ end }}</p>
              <p id="deck-power-summary" class="text-xs text-slate-400">{{ if $power.Available }}{{ $power.Summary }}{{ else }}Set the format to Commander to estimate bracket pressure.{{ end }}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs sm:grid-cols-4 lg:min-w-[420px]">
            <div class="mt-power-metric">
              <span>Game Changers</span>
              <strong id="deck-power-game-changers">{{ $power.GameChangerCount }}</strong>
            </div>
            <div class="mt-power-metric">
              <span>Land Denial</span>
              <strong id="deck-power-land-denial">{{ $power.MassLandDenialCount }}</strong>
            </div>
            <div class="mt-power-metric">
              <span>Extra Turns</span>
              <strong id="deck-power-extra-turns">{{ $power.ExtraTurnCount }}</strong>
            </div>
            <div class="mt-power-metric">
              <span>Combos</span>
              <strong id="deck-power-combos">{{ $power.CompactComboCount }}</strong>
            </div>
          </div>
        </div>
        <ul id="deck-power-signals-list" class="mt-power-signals-list">
          {{ range $power.Signals }}
            <li class="mt-power-signal mt-power-signal--{{ .Tone }}">
              <span class="mt-power-signal__label">{{ .Label }}</span>
              <strong class="mt-power-signal__value">{{ .Value }}</strong>
              {{ if .Detail }}<small class="mt-power-signal__detail">{{ .Detail }}</small>{{ end }}
              {{ if .Cards }}
                <ul class="mt-power-signal__cards">
                  {{ range .Cards }}
                    <li>{{ . }}</li>
                  {{ end }}
                </ul>
              {{ end }}
            </li>
          {{ else }}
            <li class="mt-power-signal mt-power-signal--info">
              <span class="mt-power-signal__label">Signals</span>
              <strong class="mt-power-signal__value">Pending</strong>
              <small class="mt-power-signal__detail">Add cards to estimate bracket pressure.</small>
            </li>
          {{ end }}
        </ul>
      </div>

      {{ if $ctx.Analytics.ValidationWarnings }}
        <div id="deck-guide-warnings-panel" class="rounded-xl border border-amber-500/40 bg-amber-950/20 p-3">
          <h3 class="text-[11px] font-semibold uppercase tracking-wide text-amber-200">Notes</h3>
          <ul id="deck-guide-warnings-list" class="mt-2 space-y-1 text-xs text-amber-100">
            {{ range $ctx.Analytics.ValidationWarnings }}
              <li>{{ . }}</li>
            {{ end }}
          </ul>
        </div>
      {{ else }}
        <div id="deck-guide-warnings-panel" class="hidden rounded-xl border border-amber-500/40 bg-amber-950/20 p-3">
          <h3 class="text-[11px] font-semibold uppercase tracking-wide text-amber-200">Notes</h3>
          <ul id="deck-guide-warnings-list" class="mt-2 space-y-1 text-xs text-amber-100"></ul>
        </div>
      {{ end }}

      <div class="grid gap-4 xl:grid-cols-2">
        <div class="space-y-3">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 mb-2">Mana Curve</p>
            <div class="rounded-md border border-slate-800 bg-slate-950/80 p-2">
              <div class="h-24 overflow-hidden flex items-end gap-1.5">
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-0" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve0Count }}</p>
                  <div id="deck-curve-bar-0" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">0</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-1" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve1Count }}</p>
                  <div id="deck-curve-bar-1" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">1</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-2" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve2Count }}</p>
                  <div id="deck-curve-bar-2" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">2</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-3" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve3Count }}</p>
                  <div id="deck-curve-bar-3" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">3</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-4" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve4Count }}</p>
                  <div id="deck-curve-bar-4" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">4</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-5" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve5Count }}</p>
                  <div id="deck-curve-bar-5" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">5</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-6" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve6Count }}</p>
                  <div id="deck-curve-bar-6" class="w-5 rounded-t bg-sky-400/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">6</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-7p" class="mb-1 text-slate-100 text-[11px] leading-none">{{ $ctx.Analytics.Curve7PlusCount }}</p>
                  <div id="deck-curve-bar-7p" class="w-5 rounded-t bg-cyan-300/80 h-[4px] transition-all duration-200"></div>
                  <p class="text-slate-500 text-[10px]">7+</p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 mb-2">Type Mix</p>
            <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs text-slate-300">
              <p class="flex items-center justify-between"><span>Creatures</span><span id="deck-analytics-type-creature">{{ $ctx.Analytics.CreatureCount }}</span></p>
              <p class="flex items-center justify-between"><span>Artifacts</span><span id="deck-analytics-type-artifact">{{ $ctx.Analytics.ArtifactCount }}</span></p>
              <p class="flex items-center justify-between"><span>Enchantments</span><span id="deck-analytics-type-enchantment">{{ $ctx.Analytics.EnchantmentCount }}</span></p>
              <p class="flex items-center justify-between"><span>Instants</span><span id="deck-analytics-type-instant">{{ $ctx.Analytics.InstantCount }}</span></p>
              <p class="flex items-center justify-between"><span>Sorceries</span><span id="deck-analytics-type-sorcery">{{ $ctx.Analytics.SorceryCount }}</span></p>
              <p class="flex items-center justify-between"><span>Planeswalkers</span><span id="deck-analytics-type-planeswalker">{{ $ctx.Analytics.PlaneswalkerCount }}</span></p>
              <p class="flex items-center justify-between"><span>Battles</span><span id="deck-analytics-type-battle">{{ $ctx.Analytics.BattleCount }}</span></p>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Example Opening Hand</p>
            <button type="button" id="deck-analytics-new-hand" class="mt-btn mt-btn--secondary mt-btn--xs">New Hand</button>
          </div>
          <div class="rounded-md border border-slate-800 bg-slate-950/80 p-2.5">
            <ul id="deck-analytics-example-hand" class="grid grid-cols-2 gap-2 sm:grid-cols-4"></ul>
            <p id="deck-analytics-example-hand-empty" class="text-xs text-slate-500">Add cards to sample a hand.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div id="card-detail-modal" class="mt-modal hidden">
    <div class="mt-modal-panel max-w-2xl">
      <button type="button" class="absolute top-3 right-3 mt-btn mt-btn--secondary text-xs !px-3 !py-2" data-close-modal>
        Close
      </button>

      <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] items-start">
        <div class="flex items-center justify-center">
          <img data-field="image"
               alt=""
               class="w-full max-w-xs h-auto mt-card-media shadow-md shadow-slate-900/80">
        </div>

        <div class="space-y-3 text-sm text-slate-200">
          <h3 class="text-lg font-semibold text-slate-50" data-field="name"></h3>

          <div class="space-y-1" data-field="printing-group">
            <label for="printing-select" class="mt-field-label">Version</label>
            <select id="printing-select" data-field="printing-select"
                    class="mt-control mt-control--sm text-xs text-slate-100">
              <option value="">Latest printing</option>
            </select>
            <p data-field="printing-meta" class="hidden text-[11px] uppercase tracking-wide text-slate-500"></p>
          </div>

          <p class="text-xs uppercase tracking-wide text-slate-400">
            <span data-field="type-line"></span>
          </p>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-300">
            <span>
              <span class="font-medium text-slate-200">Cost:</span>
              <span data-field="mana-cost" class="inline-flex items-center gap-1 align-middle"></span>
            </span>
            <span>
              <span class="font-medium text-slate-200">Price:</span>
              <span data-field="price-usd">—</span>
            </span>
            <span>
              <span class="font-medium text-slate-200">Artist:</span>
              <span data-field="artist">—</span>
            </span>
          </div>

          <p class="text-sm text-slate-200 whitespace-pre-line" data-field="oracle-text"></p>

          <div class="flex flex-wrap justify-between gap-2 pt-2">
            <a href="#"
               data-field="open-page-link"
               class="hidden mt-btn mt-btn--secondary text-xs !px-3 !py-2">
              Open Full Page
            </a>
            <button type="button" class="mt-btn mt-btn--secondary text-xs !px-3 !py-2 hidden" data-flip-card>
              Flip Card
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="deck-card-preview"
       class="pointer-events-none fixed left-0 top-0 z-[150] hidden w-56 overflow-hidden rounded-xl border border-slate-700 bg-slate-950 shadow-2xl shadow-slate-950/80">
    <img id="deck-card-preview-img"
         src=""
         alt=""
         class="block w-full h-auto">
    <div id="deck-card-preview-fallback"
         class="hidden flex aspect-[5/7] items-center justify-center p-4 text-center text-sm font-medium text-slate-200"></div>
  </div>

  {{ if not $isGuest }}
    <div id="deck-menu-overlay"
         class="fixed inset-0 z-[190] hidden items-center justify-center bg-slate-950/85 px-4 py-6">
      <div class="w-full max-w-md rounded-3xl border border-slate-700 bg-slate-950/95 p-5 shadow-2xl shadow-slate-950/80">
        <div class="space-y-2">
          <p class="mt-kicker">Deck Menu</p>
          <h2 class="text-xl font-semibold text-slate-50">{{ $d.Name }}</h2>
          <p class="text-sm text-slate-400">Manage this deck without leaving the editor.</p>
        </div>

        <div class="mt-5 space-y-3">
          <div class="space-y-2">
            <label for="deck-menu-name-input" class="mt-field-label">Deck Name</label>
            <div class="flex gap-2">
              <input type="text"
                     id="deck-menu-name-input"
                     class="mt-control flex-1"
                     value="{{ $d.Name }}"
                     maxlength="120"
                     autocomplete="off">
              <button type="button" id="deck-menu-name-save" class="mt-btn mt-btn--primary">Save</button>
            </div>
          </div>
          <button type="button" id="deck-menu-copy" class="mt-btn mt-btn--secondary w-full justify-center">Copy Decklist</button>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="deck-menu-export-txt" class="mt-btn mt-btn--secondary justify-center">Export TXT</button>
            <button type="button" id="deck-menu-export-csv" class="mt-btn mt-btn--secondary justify-center">Export CSV</button>
          </div>
          <button type="button" id="deck-menu-visibility" class="mt-btn mt-btn--secondary w-full justify-center">
            {{ if $d.IsPublic }}Set Private{{ else }}Set Public{{ end }}
          </button>
          <form id="deck-menu-delete-form"
                method="POST"
                action="/decks/delete"
                onsubmit="return confirm('Delete this deck? This cannot be undone.');">
            <input type="hidden" name="id" value="{{ $d.ID }}">
            <button type="submit" class="mt-btn mt-btn--danger w-full justify-center">Delete Deck</button>
          </form>
        </div>

        <p id="deck-menu-status" class="mt-4 text-center text-xs text-slate-500" aria-live="polite"></p>

        <div class="mt-5 flex justify-end">
          <button type="button" id="deck-menu-close" class="mt-btn mt-btn--primary mt-btn--sm">Close</button>
        </div>
      </div>
    </div>
  {{ end }}

  <script id="deck-workspace-seed" type="application/json">
    {{ toJSON $ctx.WorkspaceState }}
  </script>

  {{ template "card_detail_modal_script" . }}
  {{ template "deck_show_guest_draft_script" . }}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var isGuest = {{ if .Data.WorkbenchMode }}true{{ else if .CurrentUser }}false{{ else }}true{{ end }};
      var supportedTagOptions = {{ toJSON (supportedDeckTags) }};
      var tagThemeMap = {{ toJSON (deckTagThemeMap) }};
      var addForm = document.getElementById('deck-add-card-form');
      var addInput = document.getElementById('guest-card-name');
      var suggestions = document.getElementById('deck-card-suggestions');
      var tagHidden = document.getElementById('deck-overview-tags-hidden');
      var tagList = document.getElementById('deck-overview-tags-list');
      var tagButtons = Array.prototype.slice.call(document.querySelectorAll('[data-tag-suggestion]'));
      var noteField = document.getElementById('deck-overview-notes');
      var formatField = document.getElementById('deck-overview-format');
      var overviewLayout = document.getElementById('deck-overview-layout');
      var overviewSide = document.getElementById('deck-overview-side');
      var commanderPanel = document.getElementById('deck-commander-panel');
      var overviewFormatText = document.getElementById('deck-overview-format-text');
      var overviewStatus = document.getElementById('deck-overview-status');
      var flipButton = document.getElementById('deck-commander-flip');
      var commanderNameEl = document.getElementById('deck-commander-name');
      var commanderArtWrapEl = document.getElementById('deck-top-commander-art-wrap');
      var commanderPlaceholderEl = document.getElementById('deck-top-commander-placeholder');
      var commanderArtEl = document.getElementById('deck-top-commander-art');
      var commanderFaces = {{ if and $c (gt (len $c.Faces) 0) }}{{ toJSON $c.Faces }}{{ else }}[]{{ end }};
      var commanderFallback = {
        name: {{ if $c }}{{ printf "%q" $c.Name }}{{ else }}""{{ end }},
        mana_cost: {{ if $c }}{{ printf "%q" $c.ManaCost }}{{ else }}""{{ end }},
        type_line: {{ if $c }}{{ printf "%q" $c.TypeLine }}{{ else }}""{{ end }},
        oracle_text: {{ if $c }}{{ printf "%q" $c.OracleText }}{{ else }}""{{ end }},
        image_uri: {{ if $c }}{{ printf "%q" $c.ImageURI }}{{ else }}""{{ end }}
      };
      var commanderRequiresSelection = {{ if $isCommanderDeck }}true{{ else }}false{{ end }};
      var currentCommanderFaces = [];
      var currentCommanderFaceIndex = 0;
      var lastGoodCommanderArt = normalizeTag((commanderArtEl && commanderArtEl.getAttribute('src')) || '');

      function closeDeckActionMenus() {
        if (typeof window.mtDeckCloseActionMenus === 'function') {
          window.mtDeckCloseActionMenus();
          return;
        }
        var openMenus = document.querySelectorAll('details[data-card-action-menu][open]');
        for (var i = 0; i < openMenus.length; i++) {
          openMenus[i].open = false;
        }
      }

      function commanderEmptyName() {
        return commanderRequiresSelection ? 'No commander selected' : 'No commander used';
      }

      function isUsableCommanderImageURI(value) {
        var uri = normalizeTag(value);
        if (!uri) return false;
        if (uri === '[object Object]') return false;
        if (uri === 'null' || uri === 'undefined') return false;
        return /^https?:\/\//i.test(uri) || /^data:/i.test(uri) || uri.charAt(0) === '/';
      }

      function syncOverviewFormatLayout(isCommander) {
        commanderRequiresSelection = !!isCommander;
        var nextFormat = isCommander ? 'Commander' : 'Sandbox';
        if (overviewFormatText) overviewFormatText.textContent = nextFormat;
        if (overviewLayout) {
          overviewLayout.classList.toggle('grid', !!isCommander);
          overviewLayout.classList.toggle('gap-4', !!isCommander);
          overviewLayout.classList.toggle('xl:grid-cols-[minmax(210px,240px)_minmax(0,1fr)]', !!isCommander);
          overviewLayout.classList.toggle('space-y-4', !isCommander);
        }
        if (overviewSide) {
          overviewSide.classList.toggle('hidden', !isCommander);
        }
        if (commanderPanel) {
          commanderPanel.classList.toggle('hidden', !isCommander);
        }
        if (!isCommander) {
          if (commanderNameEl) commanderNameEl.textContent = commanderEmptyName();
          if (commanderArtWrapEl) commanderArtWrapEl.classList.add('hidden');
          if (commanderPlaceholderEl) commanderPlaceholderEl.classList.add('hidden');
          if (flipButton) flipButton.classList.add('hidden');
        } else {
          renderCommanderOverviewFace(currentCommanderFaceIndex);
        }
      }
      window.mtDeckSetOverviewFormat = syncOverviewFormatLayout;

      function normalizeTag(value) {
        return String(value || '').replace(/\s+/g, ' ').trim();
      }

      function canonicalDeckTag(value) {
        var normalized = normalizeTag(value).toLowerCase();
        if (!normalized) return '';
        for (var i = 0; i < supportedTagOptions.length; i++) {
          if (String(supportedTagOptions[i] || '').toLowerCase() === normalized) {
            return supportedTagOptions[i];
          }
        }
        return '';
      }

      function normalizeCommanderFace(face) {
        if (!face || typeof face !== 'object') return null;
        var normalized = {
          name: normalizeTag(face.name || ''),
          mana_cost: normalizeTag(face.mana_cost || face.manaCost || ''),
          type_line: normalizeTag(face.type_line || face.typeLine || ''),
          oracle_text: normalizeTag(face.oracle_text || face.oracleText || ''),
          image_uri: normalizeTag(face.image_uri || face.imageURI || '')
        };
        if (!normalized.name && !normalized.type_line && !normalized.oracle_text && !normalized.image_uri) {
          return null;
        }
        return normalized;
      }

      function normalizedCommanderFaces(faces) {
        if (!Array.isArray(faces)) return [];
        var out = [];
        for (var i = 0; i < faces.length; i++) {
          var face = normalizeCommanderFace(faces[i]);
          if (face) out.push(face);
        }
        return out;
      }

      function extractCommanderImageURI(cardData) {
        if (!cardData || typeof cardData !== 'object') return '';
        if (cardData.image_uris && typeof cardData.image_uris === 'object') {
          return normalizeTag(cardData.image_uris.normal || cardData.image_uris.large || cardData.image_uris.small || '');
        }
        return normalizeTag(cardData.image_uri || cardData.imageURI || '');
      }

      function syncCommanderFlipVisibility() {
        if (!flipButton) return;
        flipButton.classList.toggle('hidden', currentCommanderFaces.length <= 1);
      }

      function renderCommanderOverviewFace(index) {
        var face = currentCommanderFaces.length > 0
          ? (currentCommanderFaces[index] || currentCommanderFaces[0])
          : null;

        var name = face ? face.name : normalizeTag(commanderFallback.name || '');
        var imageURI = face ? face.image_uri : normalizeTag(commanderFallback.image_uri || '');
        var hasCommanderSelection = !!name;
        if (hasCommanderSelection && !isUsableCommanderImageURI(imageURI) && isUsableCommanderImageURI(commanderFallback.image_uri || '')) {
          imageURI = normalizeTag(commanderFallback.image_uri || '');
        }
        if (hasCommanderSelection && !isUsableCommanderImageURI(imageURI) && isUsableCommanderImageURI(lastGoodCommanderArt)) {
          imageURI = lastGoodCommanderArt;
        }
        if (!hasCommanderSelection) {
          imageURI = '';
        }

        if (commanderNameEl) commanderNameEl.textContent = name || commanderEmptyName();

        if (commanderArtEl) {
          if (isUsableCommanderImageURI(imageURI)) {
            commanderArtEl.src = imageURI;
            commanderArtEl.alt = (name || 'Commander') + ' commander art';
          } else {
            commanderArtEl.removeAttribute('src');
            commanderArtEl.alt = 'Commander art';
          }
        }
        if (commanderArtWrapEl) {
          commanderArtWrapEl.classList.toggle('hidden', !isUsableCommanderImageURI(imageURI));
        }
        if (commanderPlaceholderEl) {
          commanderPlaceholderEl.classList.toggle('hidden', hasCommanderSelection);
        }
      }

      function setCommanderOverview(cardData) {
        if (!cardData || typeof cardData !== 'object') {
          commanderFallback = {
            name: '',
            mana_cost: '',
            type_line: '',
            oracle_text: '',
            image_uri: ''
          };
          currentCommanderFaces = [];
          currentCommanderFaceIndex = 0;
          syncCommanderFlipVisibility();
          renderCommanderOverviewFace(0);
          return;
        }

        commanderFallback = {
          name: normalizeTag(cardData.name || ''),
          mana_cost: normalizeTag(cardData.mana_cost || cardData.manaCost || ''),
          type_line: normalizeTag(cardData.type_line || cardData.typeLine || ''),
          oracle_text: normalizeTag(cardData.oracle_text || cardData.oracleText || ''),
          image_uri: extractCommanderImageURI(cardData)
        };
        currentCommanderFaces = normalizedCommanderFaces(cardData.faces);
        currentCommanderFaceIndex = 0;
        syncCommanderFlipVisibility();
        renderCommanderOverviewFace(currentCommanderFaceIndex);
      }

      window.mtDeckSetCommanderOverview = setCommanderOverview;

      function currentCommanderViewState() {
        var face = currentCommanderFaces.length > 0
          ? (currentCommanderFaces[currentCommanderFaceIndex] || currentCommanderFaces[0])
          : null;
        var cardName = normalizeTag(face ? face.name : commanderFallback.name || '');
        if (!cardName) return null;
        var draft = isGuest ? (window.mtDeckCurrentGuestDraft || null) : (window.mtDeckCurrentSavedDraft || null);
        var lookupDraftMeta = window.mtDeckDraftMetaForCard;
        var cardMeta = (draft && typeof lookupDraftMeta === 'function') ? lookupDraftMeta(draft, cardName) : null;
        if (!cardMeta && commanderName) {
          cardMeta = (draft && typeof lookupDraftMeta === 'function') ? lookupDraftMeta(draft, commanderName) : null;
        }
        return {
          name: cardName,
          cardMeta: cardMeta,
          imageURI: normalizeTag(face ? face.image_uri : commanderFallback.image_uri || ''),
          manaCost: normalizeTag(face ? face.mana_cost : commanderFallback.mana_cost || ''),
          typeLine: normalizeTag(face ? face.type_line : commanderFallback.type_line || ''),
          oracleText: normalizeTag(face ? face.oracle_text : commanderFallback.oracle_text || ''),
          faces: currentCommanderFaces,
        };
      }

      function openCommanderCardView() {
        if (typeof window.mtDeckOpenWorkbenchCardView !== 'function') return;
        var state = currentCommanderViewState();
        if (!state || !state.name) return;
        window.mtDeckOpenWorkbenchCardView(state.name, state.cardMeta, {
          imageURI: state.imageURI,
          manaCost: state.manaCost,
          typeLine: state.typeLine,
          oracleText: state.oracleText,
          faces: state.faces,
          resolveExact: !(state.cardMeta && state.cardMeta.cardID),
        });
      }

      if (commanderArtEl) {
        commanderArtEl.addEventListener('load', function () {
          var next = normalizeTag(commanderArtEl.getAttribute('src') || '');
          if (isUsableCommanderImageURI(next)) {
            lastGoodCommanderArt = next;
          }
        });
        commanderArtEl.addEventListener('error', function () {
          if (isUsableCommanderImageURI(commanderFallback.image_uri || '') &&
              normalizeTag(commanderArtEl.getAttribute('src') || '') !== normalizeTag(commanderFallback.image_uri || '')) {
            commanderArtEl.src = normalizeTag(commanderFallback.image_uri || '');
            return;
          }
          if (isUsableCommanderImageURI(lastGoodCommanderArt) &&
              normalizeTag(commanderArtEl.getAttribute('src') || '') !== lastGoodCommanderArt) {
            commanderArtEl.src = lastGoodCommanderArt;
            return;
          }
          if (commanderArtWrapEl) commanderArtWrapEl.classList.add('hidden');
        });
      }

      if (commanderNameEl) {
        commanderNameEl.addEventListener('click', function () {
          openCommanderCardView();
        });
      }
      if (commanderArtWrapEl && commanderArtWrapEl.getAttribute('data-preview-bound') !== '1') {
        commanderArtWrapEl.addEventListener('click', function () {
          if (commanderArtWrapEl.classList.contains('hidden')) return;
          openCommanderCardView();
        });
      }

      function parseTags(raw) {
        if (!raw) return [];
        var parts = String(raw).split(/[,\n\r\t]+/);
        var out = [];
        var seen = {};
        for (var i = 0; i < parts.length; i++) {
          var tag = canonicalDeckTag(parts[i]);
          if (!tag) continue;
          var key = tag.toLowerCase();
          if (seen[key]) continue;
          seen[key] = true;
          out.push(tag);
          if (out.length >= 12) break;
        }
        return out;
      }

      var tags = parseTags(tagHidden ? tagHidden.value : '');

      function syncTags() {
        if (tagHidden) tagHidden.value = tags.join(', ');
      }

      function updateTagButtons() {
        for (var i = 0; i < tagButtons.length; i++) {
          var button = tagButtons[i];
          var tagValue = canonicalDeckTag(button.getAttribute('data-tag-suggestion') || '');
          var tone = tagToneClasses(tagValue);
          var active = tags.some(function (tag) {
            return tag.toLowerCase() === tagValue.toLowerCase();
          });
          button.className = tone.button;
          button.classList.toggle('hidden', active);
          button.disabled = active;
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
          button.setAttribute('data-selected', active ? 'true' : 'false');
          button.setAttribute('aria-hidden', active ? 'true' : 'false');
          button.tabIndex = active ? -1 : 0;
          button.textContent = '+ ' + tagValue;
          button.title = 'Add ' + tagValue;
        }
      }

      function queueOverviewSave() {
        if (!window.mtDeckWorkspaceUpdateOverview) return;
        window.mtDeckWorkspaceUpdateOverview({
          tags: tagHidden ? tagHidden.value : '',
          description: noteField ? noteField.value : '',
          format: formatField ? formatField.value : ''
        });
      }

      function renderTags() {
        if (!tagList) return;
        tagList.innerHTML = '';
        if (tags.length === 0) {
          var empty = document.createElement('p');
          empty.className = 'text-sm text-slate-500';
          empty.textContent = 'None selected.';
          tagList.appendChild(empty);
          updateTagButtons();
          return;
        }

        for (var i = 0; i < tags.length; i++) {
          (function (tagValue) {
            var tone = tagToneClasses(tagValue);
            var chip = document.createElement('span');
            chip.className = tone.editor_chip;
            chip.textContent = tagValue;

            var remove = document.createElement('button');
            remove.type = 'button';
            remove.className = tone.editor_remove;
            remove.textContent = 'x';
            remove.setAttribute('aria-label', 'Remove ' + tagValue);
            remove.title = 'Remove';
            remove.addEventListener('click', function () {
              tags = tags.filter(function (tag) {
                return tag.toLowerCase() !== tagValue.toLowerCase();
              });
              syncTags();
              renderTags();
              queueOverviewSave();
            });

            chip.appendChild(remove);
            tagList.appendChild(chip);
          })(tags[i]);
        }
        updateTagButtons();
      }

      window.mtDeckSetOverviewTags = function (raw) {
        tags = parseTags(raw);
        syncTags();
        renderTags();
      };

      function tagToneClasses(tagValue) {
        var key = canonicalDeckTag(tagValue);
        return tagThemeMap[key] || {
          public: 'inline-flex items-center rounded-full border border-slate-600 bg-slate-800/80 px-2.5 py-1 text-xs font-medium text-slate-100',
          editor_chip: 'inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-800/80 px-3 py-1 text-sm font-medium text-slate-100',
          editor_remove: 'text-slate-300/80 hover:text-slate-50',
          button: 'mt-btn mt-btn--xs border border-slate-600 bg-slate-800/80 !text-slate-100 hover:bg-slate-700/90',
          button_active: 'mt-btn mt-btn--xs border border-slate-300/80 bg-slate-700 !text-slate-50'
        };
      }

      function addTag(value) {
        var normalized = canonicalDeckTag(value);
        if (!normalized) return;
        var exists = tags.some(function (tag) {
          return tag.toLowerCase() === normalized.toLowerCase();
        });
        if (exists || tags.length >= supportedTagOptions.length) {
          return;
        }
        tags.push(normalized);
        syncTags();
        renderTags();
        queueOverviewSave();
      }

      function removeTag(value) {
        var normalized = canonicalDeckTag(value);
        if (!normalized) return;
        tags = tags.filter(function (tag) {
          return tag.toLowerCase() !== normalized.toLowerCase();
        });
        syncTags();
        renderTags();
        queueOverviewSave();
      }

      for (var s = 0; s < tagButtons.length; s++) {
        tagButtons[s].addEventListener('click', function () {
          var tagValue = canonicalDeckTag(this.getAttribute('data-tag-suggestion') || '');
          var exists = tags.some(function (tag) {
            return tag.toLowerCase() === tagValue.toLowerCase();
          });
          if (exists) {
            removeTag(tagValue);
            return;
          }
          addTag(tagValue);
        });
      }

      syncTags();
      renderTags();

      if (formatField) {
        formatField.addEventListener('change', function () {
          syncOverviewFormatLayout(String(formatField.value || '') === 'Commander');
          queueOverviewSave();
        });
      }

      if (noteField) {
        var noteTimer = null;
        noteField.addEventListener('input', function () {
          if (noteTimer) window.clearTimeout(noteTimer);
          noteTimer = window.setTimeout(function () {
            queueOverviewSave();
            if (overviewStatus) {
              overviewStatus.textContent = isGuest ? 'Local changes save automatically.' : 'Changes save automatically.';
            }
          }, 140);
        });
      }

      if (addForm && addInput && suggestions) {
        var activeIndex = -1;
        var items = [];
        var requestToken = 0;

        function closeSuggestions() {
          suggestions.innerHTML = '';
          suggestions.classList.add('hidden');
          addInput.setAttribute('aria-expanded', 'false');
          activeIndex = -1;
          items = [];
        }

        function submitCard(name) {
          var value = String(name || '').trim();
          if (!value) return;
          addInput.value = value;
          closeSuggestions();
          var event = new Event('submit', { bubbles: true, cancelable: true });
          if (!addForm.dispatchEvent(event)) {
            return;
          }
          if (typeof addForm.requestSubmit === 'function') {
            addForm.requestSubmit();
          } else {
            addForm.submit();
          }
        }

        function setActive(nextIndex) {
          activeIndex = nextIndex;
          for (var i = 0; i < items.length; i++) {
            var active = i === activeIndex;
            items[i].classList.toggle('bg-slate-800', active);
            items[i].classList.toggle('text-sky-200', active);
          }
        }

        function renderSuggestions(results) {
          suggestions.innerHTML = '';
          items = [];
          activeIndex = -1;

          if (!Array.isArray(results) || results.length === 0) {
            closeSuggestions();
            return;
          }

          for (var i = 0; i < results.length; i++) {
            var result = results[i] || {};
            var name = String(result.name || '').trim();
            if (!name) continue;

            var row = document.createElement('div');
            row.className = 'flex items-center gap-2 border-t border-slate-800 px-3 py-2 first:border-t-0';

            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'min-w-0 flex-1 text-left text-sm text-slate-200 transition-colors hover:text-sky-200 focus:outline-none focus:text-sky-200';
            button.textContent = name;
            button.setAttribute('role', 'option');
            button.addEventListener('mousedown', function (event) {
              event.preventDefault();
              submitCard(this.textContent || '');
            });
            row.appendChild(button);

            var viewButton = document.createElement('button');
            viewButton.type = 'button';
            viewButton.className = 'mt-btn mt-btn--secondary mt-btn--xs shrink-0';
            viewButton.textContent = 'View';
            viewButton.addEventListener('mousedown', function (event) {
              event.preventDefault();
            });
            viewButton.addEventListener('click', (function (cardName) {
              return function (event) {
                event.preventDefault();
                if (typeof window.mtDeckOpenWorkbenchCardView !== 'function') return;
                window.mtDeckOpenWorkbenchCardView(cardName, null, {
                  resolveExact: true,
                });
              };
            })(name));
            row.appendChild(viewButton);

            suggestions.appendChild(row);
            items.push(button);
          }

          if (items.length === 0) {
            closeSuggestions();
            return;
          }

          closeDeckActionMenus();
          suggestions.classList.remove('hidden');
          addInput.setAttribute('aria-expanded', 'true');
        }

        async function fetchSuggestions() {
          var query = String(addInput.value || '').trim();
          if (query.length < 2) {
            closeSuggestions();
            return;
          }

          var token = ++requestToken;
          try {
            var res = await fetch('/cards/autocomplete?q=' + encodeURIComponent(query) + '&limit=0', {
              method: 'GET',
              credentials: 'same-origin'
            });
            if (!res.ok) {
              closeSuggestions();
              return;
            }
            var data = await res.json();
            if (token !== requestToken) return;
            renderSuggestions(data && Array.isArray(data.results) ? data.results : []);
          } catch (e) {
            if (token !== requestToken) return;
            closeSuggestions();
          }
        }

        addInput.addEventListener('input', fetchSuggestions);
        addInput.addEventListener('focus', function () {
          if (String(addInput.value || '').trim().length >= 2) fetchSuggestions();
        });
        addInput.addEventListener('keydown', function (event) {
          if (suggestions.classList.contains('hidden') || items.length === 0) {
            return;
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            setActive(activeIndex < items.length - 1 ? activeIndex + 1 : 0);
            return;
          }
          if (event.key === 'ArrowUp') {
            event.preventDefault();
            setActive(activeIndex > 0 ? activeIndex - 1 : items.length - 1);
            return;
          }
          if (event.key === 'Enter' && activeIndex >= 0 && activeIndex < items.length) {
            event.preventDefault();
            submitCard(items[activeIndex].textContent || '');
            return;
          }
          if (event.key === 'Escape') {
            closeSuggestions();
          }
        });

        addInput.addEventListener('focus', closeDeckActionMenus);

        document.addEventListener('click', function (event) {
          if (event.target === addInput || suggestions.contains(event.target)) return;
          closeSuggestions();
        });
      }

      currentCommanderFaces = normalizedCommanderFaces(commanderFaces);
      setCommanderOverview({
        name: commanderFallback.name,
        mana_cost: commanderFallback.mana_cost,
        type_line: commanderFallback.type_line,
        oracle_text: commanderFallback.oracle_text,
        image_uri: commanderFallback.image_uri,
        faces: currentCommanderFaces
      });
      syncOverviewFormatLayout({{ if $isCommanderDeck }}true{{ else }}false{{ end }});
      if (isGuest && window.mtDeckCurrentGuestDraft) {
        syncOverviewFormatLayout(String(window.mtDeckCurrentGuestDraft.format || '') === 'Commander');
      }
      if (isGuest && window.mtDeckCurrentGuestDraft && window.mtDeckGuestSyncCommanderOverview) {
        window.mtDeckGuestSyncCommanderOverview(window.mtDeckCurrentGuestDraft);
      }

      if (flipButton) {
        flipButton.addEventListener('click', function () {
          if (currentCommanderFaces.length <= 1) return;
          currentCommanderFaceIndex = (currentCommanderFaceIndex + 1) % currentCommanderFaces.length;
          renderCommanderOverviewFace(currentCommanderFaceIndex);
        });
      }
    });
  </script>

  {{ template "layout_footer" . }}
{{ end }}
