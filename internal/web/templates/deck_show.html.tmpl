      } else {
        foot.appendChild(signedMutationButton(
          { action: 'to_maybe', card_id: card.cardID },
          'inline-flex items-center justify-center h-5 rounded border border-slate-700 bg-slate-900 px-1.5 text-[10px] text-slate-300 hover:border-cyan-400 hover:text-cyan-300 transition-colors',
          'Mb'
        ));
        foot.appendChild(signedMutationButton(
          { action: 'inc_main', card_id: card.cardID },
          'inline-flex items-center justify-center h-5 min-w-[20px] rounded border border-slate-700 bg-slate-900 text-[11px] text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors',
          '+'
        ));
        foot.appendChild(signedMutationButton(
          { card_id: card.cardID },
          'inline-flex items-center justify-center h-5 min-w-[20px] rounded border border-slate-700 bg-slate-900 text-[11px] text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors',
          '−'
        ));
      }
      wrap.appendChild(foot);
      return wrap;
    }

    function renderGridSection(section, root) {
      var box = document.createElement('section');
      box.className = 'self-start h-fit rounded-xl border border-slate-800 bg-slate-950/60 p-2.5 space-y-2 shadow-[inset_0_0_0_1px_rgba(14,165,233,0.08)]';
      var head = document.createElement('div');
      head.className = 'flex items-center justify-between px-1 pb-2 border-b border-slate-800';
      var title = document.createElement('p');
      title.className = 'text-base font-semibold uppercase tracking-wide text-slate-300';
      title.textContent = section.name;
      var count = document.createElement('p');
      count.className = 'text-[11px] text-slate-500';
      count.textContent = String(sectionCardTotal(section)) + ' cards';
      head.appendChild(title);
      head.appendChild(count);
      box.appendChild(head);
      var container = document.createElement('div');
      container.className = 'grid grid-cols-2 sm:grid-cols-3 gap-2';

      for (var i = 0; i < section.cards.length; i++) {
        var node = artGridCardNode(section.cards[i]);
        container.appendChild(node);
      }

      box.appendChild(container);
      root.appendChild(box);
    }

    function stackCardNode(card) {
      var wrap = document.createElement('article');
      wrap.className = 'relative w-40 h-[224px] rounded-md overflow-hidden border border-slate-800 bg-slate-950 shadow-sm shadow-slate-950';
      bindPreview(wrap, card);

      if (card.imageURI) {
        var img = document.createElement('img');
        img.src = card.imageURI;
        img.alt = card.name;
        img.className = 'w-full h-full object-cover block';
        wrap.appendChild(img);
      } else {
        var fallback = document.createElement('div');
        fallback.className = 'w-full h-full flex items-center justify-center px-2 text-center text-xs text-slate-300 bg-slate-900';
        fallback.textContent = card.name;
        wrap.appendChild(fallback);
      }

      var topStrip = document.createElement('div');
      topStrip.className = 'absolute left-0 right-0 top-0 bg-slate-950/95 border-b border-slate-700 px-1.5 py-1 flex items-center justify-between gap-1';

      var name = document.createElement('p');
      name.className = 'text-[10px] text-slate-100 truncate';
      name.title = card.name;
      name.textContent = String(card.qty) + 'x ' + card.name;
      topStrip.appendChild(name);

      if (isGuest) {
        topStrip.appendChild(guestMoveButton(
          card.name,
          'inline-flex items-center justify-center h-4 rounded border border-slate-700 bg-slate-900 px-1 text-[10px] text-slate-300 hover:border-cyan-400 hover:text-cyan-300 transition-colors',
          'Mb'
        ));
        topStrip.appendChild(guestAdjustButton(
          card.name,
          -1,
          'inline-flex items-center justify-center h-4 min-w-[16px] rounded border border-slate-700 bg-slate-900 text-[10px] text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors',
          '−'
        ));
        topStrip.appendChild(guestAdjustButton(
          card.name,
          1,
          'inline-flex items-center justify-center h-4 min-w-[16px] rounded border border-slate-700 bg-slate-900 text-[10px] text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors',
          '+'
        ));
      } else {
        topStrip.appendChild(signedMutationButton(
          { action: 'to_maybe', card_id: card.cardID },
          'inline-flex items-center justify-center h-4 rounded border border-slate-700 bg-slate-900 px-1 text-[10px] text-slate-300 hover:border-cyan-400 hover:text-cyan-300 transition-colors',
          'Mb'
        ));
        topStrip.appendChild(signedMutationButton(
          { action: 'inc_main', card_id: card.cardID },
          'inline-flex items-center justify-center h-4 min-w-[16px] rounded border border-slate-700 bg-slate-900 text-[10px] text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors',
          '+'
        ));
        topStrip.appendChild(signedMutationButton(
          { card_id: card.cardID },
          'inline-flex items-center justify-center h-4 min-w-[16px] rounded border border-slate-700 bg-slate-900 text-[10px] text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors',
          '−'
        ));
      }

      wrap.appendChild(topStrip);
      return wrap;
    }

    function renderStacksSection(section, root) {
      var box = document.createElement('section');
      box.className = 'self-start h-fit w-[170px] rounded-lg border border-slate-800 bg-slate-950/60 p-1.5 space-y-1 shadow-[inset_0_0_0_1px_rgba(14,165,233,0.08)]';
      var head = document.createElement('div');
      head.className = 'flex items-center justify-between px-0.5 pb-1 border-b border-slate-800';
      var title = document.createElement('p');
      title.className = 'text-base font-semibold uppercase tracking-wide text-slate-300';
      title.textContent = section.name;
      var count = document.createElement('p');
      count.className = 'text-[11px] text-slate-500';
      count.textContent = String(sectionCardTotal(section)) + ' cards';
      head.appendChild(title);
      head.appendChild(count);
      box.appendChild(head);

      var pile = document.createElement('div');
      pile.className = 'relative w-full';
      var peek = 24;
      var cardHeight = 224;
      pile.style.height = String(cardHeight + Math.max(0, section.cards.length - 1) * peek) + 'px';

      for (var i = 0; i < section.cards.length; i++) {
        var node = stackCardNode(section.cards[i]);
        node.style.position = 'absolute';
        node.style.left = '0';
        node.style.top = String(i * peek) + 'px';
        node.style.zIndex = String(i + 1);
        pile.appendChild(node);
      }

      box.appendChild(pile);
      root.appendChild(box);
    }

    function renderDeckCards() {
      var groupMode = groupSelect.value || 'none';
      var sortMode = sortSelect.value || 'name';
      var sortDirection = sortDirectionSelect.value || 'asc';
      var layoutMode = layoutSelect.value || 'text';
      var sections = groupedCards(groupMode, sortMode, sortDirection);

      // Grouped sections get packed into columns so multiple groups can be seen
      // side-by-side instead of each taking a full row.
      if (groupMode === 'none') {
        viewRoot.className = 'space-y-3';
      } else if (layoutMode === 'text') {
        viewRoot.className = 'grid gap-3 md:grid-cols-2 xl:grid-cols-3 items-start';
      } else if (layoutMode === 'table') {
        viewRoot.className = 'space-y-3';
      } else if (layoutMode === 'art_stacked') {
        viewRoot.className = 'flex flex-wrap items-start gap-1.5';
      } else {
        viewRoot.className = 'grid gap-4 md:grid-cols-2 xl:grid-cols-3 items-start';
      }

      viewRoot.innerHTML = '';
      if (sections.length === 0) {
        var empty = document.createElement('p');
        empty.className = 'text-sm text-slate-400';
        empty.textContent = 'No cards yet.';
        viewRoot.appendChild(empty);
        return;
      }

      if (layoutMode === 'table') {
        renderCombinedTable(sections, viewRoot);
      } else {
        for (var i = 0; i < sections.length; i++) {
          if (layoutMode === 'art_stacked') {
            renderStacksSection(sections[i], viewRoot);
          } else if (layoutMode === 'art_grid') {
            renderGridSection(sections[i], viewRoot);
          } else {
            renderListSection(sections[i], viewRoot);
          }
        }
      }
    }

    var prefs = loadPrefs();
    if (prefs.groupMode) groupSelect.value = prefs.groupMode;
    if (prefs.sortMode) sortSelect.value = prefs.sortMode;
    if (prefs.sortDirection) sortDirectionSelect.value = prefs.sortDirection;
    if (prefs.layoutMode === 'list') prefs.layoutMode = 'text';
    if (prefs.layoutMode) layoutSelect.value = prefs.layoutMode;

    function persistAndRender() {
      savePrefs({
        groupMode: groupSelect.value,
        sortMode: sortSelect.value,
        sortDirection: sortDirectionSelect.value,
        layoutMode: layoutSelect.value,
      });
      cards = readCardsFromSource();
      renderDeckCards();
    }

    groupSelect.addEventListener('change', persistAndRender);
    sortSelect.addEventListener('change', persistAndRender);
    sortDirectionSelect.addEventListener('change', persistAndRender);
    layoutSelect.addEventListener('change', persistAndRender);

    if (!isGuest) {
      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) return;
        var submitEl = target.closest('button[type="submit"], input[type="submit"]');
        if (!submitEl) return;
        lastSubmitter = submitEl;
      }, true);

      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || !form.getAttribute) return;
        var rawAction = form.getAttribute('action') || form.action || '';
        if (!rawAction) return;
        var path = '';
        try {
          path = (new URL(rawAction, window.location.origin)).pathname;
        } catch (e) {
          path = normalize(rawAction);
        }
        if (path !== actionPath) return;

        event.preventDefault();
        var submitter = event.submitter || null;
        if (!submitter && lastSubmitter && lastSubmitter.form === form) {
          submitter = lastSubmitter;
        }
        submitSignedDeckMutation(form, submitter);
      }, true);
    }

    if (isGuest) {
      document.addEventListener('mtDeckGuestDraftRendered', function () {
        cards = readCardsFromSource();
        renderDeckCards();
      });
    }

    sourceList.classList.add('hidden');
    if (guestEmpty) guestEmpty.classList.add('hidden');
    viewRoot.classList.remove('hidden');
    persistAndRender();
  });
  </script>

  {{ template "layout_footer" . }}
{{ end }}
