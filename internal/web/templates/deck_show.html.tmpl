{{ define "deck_show" }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}
  {{ $c := $ctx.Commander }}
  {{ $isGuest := false }}
  {{ if $ctx.GuestMode }}
    {{ $isGuest = true }}
  {{ else }}
    {{ $isGuest = not .CurrentUser }}
  {{ end }}
  {{ template "layout_header" . }}

  <main class="max-w-4xl mx-auto py-10 px-4 space-y-6">
    <!-- Top bar: title + actions -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div class="space-y-1">
        {{ if not $isGuest }}
        <!-- View state: click to edit -->
        <button
          type="button"
          id="deck-name-view"
          class="group text-left"
          title="Click to rename this deck">
          <h2 class="text-2xl font-semibold tracking-tight">
            <span class="bg-gradient-to-br from-sky-400 via-cyan-300 to-slate-100 bg-clip-text text-transparent group-hover:from-sky-300 group-hover:via-cyan-200">
              {{ $d.Name }}
            </span>
          </h2>
          <p class="text-xs text-slate-500 mt-0.5 group-hover:text-slate-400">
            Click here to rename deck.
          </p>
        </button>

        <!-- Edit state: inline form (hidden by default) -->
        <form
          id="deck-name-form"
          method="POST"
          action="/decks/edit"
          class="hidden space-y-2">
          <input type="hidden" name="id" value="{{ $d.ID }}">
          <input type="hidden" name="commander_name" value="{{ $d.CommanderName }}">
          <input type="hidden" name="description" value="{{ $d.Description }}">

          <label class="block text-sm text-slate-200">
            <span class="block text-xs font-medium text-slate-400 mb-1">Deck name</span>
            <input
              type="text"
              name="name"
              value="{{ $d.Name }}"
              required
              class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
          </label>
          <div class="flex items-center gap-2">
            <button type="submit"
                    class="inline-flex items-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
              Save name
            </button>
            <button type="button"
                    id="deck-name-cancel"
                    class="inline-flex items-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-slate-500 hover:text-slate-50 transition-colors">
              Cancel
            </button>
          </div>
        </form>
        {{ end }}
        {{ if $isGuest }}
          <div class="space-y-1">
            <h2 class="text-2xl font-semibold tracking-tight">
              <span class="bg-gradient-to-br from-sky-400 via-cyan-300 to-slate-100 bg-clip-text text-transparent">
                <span id="guest-deck-name">{{ $d.Name }}</span>
              </span>
            </h2>
            <p class="text-xs text-amber-200/80">Guest deck — saved in this browser only.</p>
          </div>
        {{ end }}
      </div>

      <div class="flex flex-wrap gap-2">
        {{ if not $isGuest }}
        <form method="POST" action="/decks/delete"
              onsubmit="return confirm('Delete this deck? This cannot be undone.');">
          <input type="hidden" name="id" value="{{ $d.ID }}">
          <button type="submit"
                  class="inline-flex items-center px-3 py-1.5 rounded-md border border-red-800/70 bg-red-900/40 text-xs text-red-300 hover:border-red-500 hover:text-red-200 transition-colors">
            Delete deck
          </button>
        </form>
        {{ end }}
        {{ if $isGuest }}
          {{ if .CurrentUser }}
            <button type="button" id="guest-save-to-account"
                    class="inline-flex items-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors">
              Save to my account
            </button>
          {{ else }}
            <a href="/login?next={{ urlquery (print "/decks/guest?commander_name=" $d.CommanderName) }}"
               class="inline-flex items-center px-3 py-1.5 rounded-md bg-amber-300 text-slate-950 text-xs font-semibold hover:bg-amber-200 transition-colors">
              Log in to save
            </a>
          {{ end }}
        {{ end }}
      </div>
    </div>

    <!-- Main layout: commander + deck meta / cards -->
    <div class="grid gap-6 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1.5fr)]">
      <!-- Commander & deck info -->
      <section class="space-y-4">
        <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Commander</h3>

          {{ if $c }}
            <div class="flex flex-col sm:flex-row gap-4">
              {{ if $c.ImageURI }}
                <div class="sm:w-40 shrink-0">
                  <img src="{{ $c.ImageURI }}"
                       alt="{{ $c.Name }}"
                       class="w-full h-auto rounded-md shadow-lg shadow-slate-900/80 border border-slate-800">
                </div>
              {{ end }}

              <div class="space-y-2 text-sm">
                <p class="text-base font-semibold text-slate-50">
                  {{ $c.Name }}
                  <span class="ml-1 text-slate-300 text-sm">{{ $c.ManaCost }}</span>
                </p>
                <p class="text-xs uppercase tracking-wide text-slate-400">
                  {{ $c.TypeLine }}
                </p>
                <p class="text-sm text-slate-200 whitespace-pre-line">
                  {{ $c.OracleText }}
                </p>
              </div>
            </div>
          {{ else }}
            <p class="text-sm text-slate-300">
              <span class="font-medium">Commander:</span> {{ $d.CommanderName }}
            </p>
          {{ end }}
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10 space-y-3 text-sm">
          <div class="space-y-1">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">
              Description
            </h3>

            {{ if not $isGuest }}
            <!-- View state -->
            <button
              type="button"
              id="deck-desc-view"
              class="w-full text-left rounded-md border border-transparent px-2 py-1 hover:border-slate-700 hover:bg-slate-900/60 transition-colors">
              {{ if $d.Description }}
                <p class="text-sm text-slate-200 whitespace-pre-line">
                  {{ $d.Description }}
                </p>
              {{ else }}
                <p class="text-sm text-slate-500 italic">
                  Click to add a description for this deck.
                </p>
              {{ end }}
            </button>

            <!-- Edit state -->
            <form
              id="deck-desc-form"
              method="POST"
              action="/decks/edit"
              class="hidden space-y-2">
              <input type="hidden" name="id" value="{{ $d.ID }}">
              <input type="hidden" name="commander_name" value="{{ $d.CommanderName }}">
              <input type="hidden" name="name" value="{{ $d.Name }}">

              <label class="block text-sm text-slate-200">
                <span class="block text-xs font-medium text-slate-400 mb-1">Deck description</span>
                <textarea
                  name="description"
                  rows="4"
                  class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">{{ $d.Description }}</textarea>
              </label>
              <div class="flex items-center gap-2">
                <button type="submit"
                        class="inline-flex items-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
                  Save description
                </button>
                <button type="button"
                        id="deck-desc-cancel"
                        class="inline-flex items-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-slate-500 hover:text-slate-50 transition-colors">
                  Cancel
                </button>
              </div>
            </form>
            {{ end }}

            {{ if $isGuest }}
              <div class="w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2">
                <p id="guest-deck-desc" class="text-sm text-slate-200 whitespace-pre-line">{{ $d.Description }}</p>
                <p id="guest-deck-desc-empty" class="text-sm text-slate-500 italic hidden">No description yet.</p>
              </div>
            {{ end }}
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">
              Format
            </h3>
            <p class="text-slate-200">
              {{ if $d.Format }}{{ $d.Format }}{{ else }}Commander{{ end }}
            </p>
          </div>
        </div>
      </section>

      <!-- Cards & add form -->
      <section class="space-y-4">
        <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
          <div class="flex items-center justify-between gap-2 mb-3">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Cards in deck
            </h3>
            <!-- Could add total count here in future -->
          </div>

          {{ if not $isGuest }}
          {{ if $ctx.DeckCards }}
            <ul class="divide-y divide-slate-800 text-sm">
              {{ range $ctx.DeckCards }}
                <li class="flex items-center justify-between gap-3 py-2">
                  <div>
                    <p class="font-medium text-slate-100">
                      {{ .Quantity }}x {{ .CardName }}
                    </p>
                  </div>
                  <form method="POST" action="/decks/{{ $d.ID }}" class="shrink-0">
                    <input type="hidden" name="card_id" value="{{ .CardID }}">
                    <button type="submit"
                            class="inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors">
                      −
                    </button>
                  </form>
                </li>
              {{ end }}
            </ul>
          {{ else }}
            <p class="text-sm text-slate-400">
              No cards yet. Use the form below or the card search page to start adding cards.
            </p>
          {{ end }}
          {{ end }}

          {{ if $isGuest }}
            <ul id="guest-deck-cards" class="divide-y divide-slate-800 text-sm"></ul>
            <p id="guest-deck-cards-empty" class="text-sm text-slate-400 hidden">
              No cards yet. Use the form below or the card search page to start adding cards.
            </p>
          {{ end }}
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-4 shadow-md shadow-sky-500/10">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Add card</h3>
          {{ if not $isGuest }}
            <form method="POST" action="/decks/{{ $d.ID }}" class="flex flex-col sm:flex-row gap-2">
          {{ else }}
            <form id="guest-add-card-form" class="flex flex-col sm:flex-row gap-2" novalidate>
          {{ end }}
            <label class="flex-1 text-sm text-slate-200">
              <span class="block text-xs font-medium text-slate-400 mb-1">Card name</span>
              <input type="text"
                     id="guest-card-name"
                     name="card_name"
                     required
                     class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-1 focus:ring-sky-400 focus:border-sky-400">
            </label>
            <div class="flex items-end">
              <button type="submit"
                      class="w-full inline-flex items-center justify-center px-4 py-2 rounded-md bg-sky-500 text-slate-950 text-sm font-semibold hover:bg-sky-400 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                Add
              </button>
            </div>
          {{ if not $isGuest }}
          </form>
          {{ else }}
          </form>
          {{ if $isGuest }}
            <p id="guest-add-status" class="mt-2 text-xs text-slate-500" aria-live="polite"></p>
          {{ end }}
          {{ end }}
          <p class="mt-2 text-xs text-slate-500">
            Tip: You can also add cards directly from the
            <a href="/cards/search" class="text-sky-300 hover:text-sky-200 transition-colors">
              card search
            </a>
            page.
          </p>
          {{ if $isGuest }}
            <div class="mt-3 flex flex-wrap gap-2">
              <button type="button" id="guest-copy-decklist"
                      class="inline-flex items-center px-3 py-1.5 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-200 hover:border-sky-400 hover:text-sky-300 transition-colors">
                Copy decklist
              </button>
              {{ if .CurrentUser }}
                <button type="button" id="guest-save-to-account-2"
                        class="inline-flex items-center px-3 py-1.5 rounded-md bg-sky-500 text-slate-950 text-xs font-semibold hover:bg-sky-400 transition-colors">
                  Save to my account
                </button>
              {{ else }}
                <a href="/login?next={{ urlquery (print "/decks/guest?commander_name=" $d.CommanderName) }}"
                   class="inline-flex items-center px-3 py-1.5 rounded-md bg-amber-300 text-slate-950 text-xs font-semibold hover:bg-amber-200 transition-colors">
                  Log in to save
                </a>
              {{ end }}
            </div>
            <p id="guest-copy-status" class="mt-2 text-xs text-slate-500" aria-live="polite"></p>
          {{ end }}
        </div>
      </section>
    </div>
  </main>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var isGuest = {{ if $isGuest }}true{{ else }}false{{ end }};

    // ===== Logged-in inline edit behaviors (unchanged) =====
    if (!isGuest) {
      // Deck name inline edit
      var nameView = document.getElementById('deck-name-view');
      var nameForm = document.getElementById('deck-name-form');
      var nameCancel = document.getElementById('deck-name-cancel');

      if (nameView && nameForm) {
        nameView.addEventListener('click', function () {
          nameView.classList.add('hidden');
          nameForm.classList.remove('hidden');
          var input = nameForm.querySelector('input[name="name"]');
          if (input) {
            input.focus();
            input.select();
          }
        });
      }

      if (nameCancel && nameForm && nameView) {
        nameCancel.addEventListener('click', function () {
          nameForm.classList.add('hidden');
          nameView.classList.remove('hidden');
        });
      }

      // Description inline edit
      var descView = document.getElementById('deck-desc-view');
      var descForm = document.getElementById('deck-desc-form');
      var descCancel = document.getElementById('deck-desc-cancel');

      if (descView && descForm) {
        descView.addEventListener('click', function () {
          descView.classList.add('hidden');
          descForm.classList.remove('hidden');
          var textarea = descForm.querySelector('textarea[name="description"]');
          if (textarea) {
            textarea.focus();
          }
        });
      }

      if (descCancel && descForm && descView) {
        descCancel.addEventListener('click', function () {
          descForm.classList.add('hidden');
          descView.classList.remove('hidden');
        });
      }

      return; // no guest JS needed
    }

    // ===== Guest draft deck behavior =====
    var key = 'manatomb.draftDeck';
    var commanderName = {{ printf "%q" $d.CommanderName }};

    var nameEl = document.getElementById('guest-deck-name');
    var descEl = document.getElementById('guest-deck-desc');
    var descEmptyEl = document.getElementById('guest-deck-desc-empty');

    var listEl = document.getElementById('guest-deck-cards');
    var emptyEl = document.getElementById('guest-deck-cards-empty');

    var addForm = document.getElementById('guest-add-card-form');
    var addInput = document.getElementById('guest-card-name');

    var copyBtn = document.getElementById('guest-copy-decklist');
    var copyStatus = document.getElementById('guest-copy-status');
    var addStatus = document.getElementById('guest-add-status');

    function loadDraft() {
      try {
        var raw = localStorage.getItem(key);
        if (!raw) return null;
        var d = JSON.parse(raw);
        if (!d || typeof d !== 'object') return null;
        if (d.commanderName && d.commanderName !== commanderName) return null;
        if (!d.cards || typeof d.cards !== 'object') d.cards = {};
        return d;
      } catch (e) {
        return null;
      }
    }

    function saveDraft(d) {
      try {
        d.commanderName = commanderName;
        d.updatedAt = new Date().toISOString();
        localStorage.setItem(key, JSON.stringify(d));
      } catch (e) {
        // ignore
      }
    }

    function normalizeName(s) {
      // Collapse internal whitespace and trim.
      return (s || '').replace(/\s+/g, ' ').trim();
    }

    async function validateCardNameExact(name) {
      // Use Scryfall exact-name lookup so we don't accept random strings.
      // This avoids writing junk to our DB for guest drafts.
      var url = 'https://api.scryfall.com/cards/named?exact=' + encodeURIComponent(name);
      try {
        var res = await fetch(url, { method: 'GET' });
        if (!res.ok) return null;
        var data = await res.json();
        if (!data || !data.name) return null;
        return data.name; // canonical casing/name from Scryfall
      } catch (e) {
        return null;
      }
    }

    function render(d) {
      d = d || { commanderName: commanderName, cards: {} };

      // Name/description hydration (if present)
      if (nameEl && d.name) nameEl.textContent = d.name;
      if (descEl) {
        var hasDesc = !!(d.description && d.description.trim());
        descEl.textContent = hasDesc ? d.description : '';
        if (descEmptyEl) descEmptyEl.classList.toggle('hidden', hasDesc);
      }

      if (!listEl) return;

      // Clear list
      listEl.innerHTML = '';

      var entries = Object.entries(d.cards || {});
      entries.sort(function (a, b) {
        return a[0].localeCompare(b[0]);
      });

      if (emptyEl) emptyEl.classList.toggle('hidden', entries.length !== 0);

      entries.forEach(function (pair) {
        var cardName = pair[0];
        var qty = pair[1];
        if (!qty || qty <= 0) return;

        var li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 py-2';

        var left = document.createElement('div');
        var p = document.createElement('p');
        p.className = 'font-medium text-slate-100';
        p.textContent = qty + 'x ' + cardName;
        left.appendChild(p);

        var right = document.createElement('div');
        right.className = 'shrink-0 flex items-center gap-2';

        var minus = document.createElement('button');
        minus.type = 'button';
        minus.className = 'inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors';
        minus.textContent = '−';
        minus.addEventListener('click', function () {
          var dd = loadDraft() || { commanderName: commanderName, cards: {} };
          dd.cards = dd.cards || {};
          dd.cards[cardName] = (dd.cards[cardName] || 0) - 1;
          if (dd.cards[cardName] <= 0) delete dd.cards[cardName];
          saveDraft(dd);
          render(dd);
        });

        var plus = document.createElement('button');
        plus.type = 'button';
        plus.className = 'inline-flex items-center justify-center px-2 py-1 rounded-md border border-slate-700 bg-slate-900 text-xs text-slate-300 hover:border-sky-400 hover:text-sky-300 transition-colors';
        plus.textContent = '+';
        plus.addEventListener('click', function () {
          var dd = loadDraft() || { commanderName: commanderName, cards: {} };
          dd.cards = dd.cards || {};
          dd.cards[cardName] = (dd.cards[cardName] || 0) + 1;
          saveDraft(dd);
          render(dd);
        });

        right.appendChild(minus);
        right.appendChild(plus);

        li.appendChild(left);
        li.appendChild(right);

        listEl.appendChild(li);
      });
    }

    // Init
    var draft = loadDraft();
    if (!draft) {
      draft = { commanderName: commanderName, name: (nameEl ? nameEl.textContent : ''), description: '', cards: {} };
      saveDraft(draft);
    }
    render(draft);

    if (addForm && addInput) {
      addForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (addStatus) addStatus.textContent = '';

        var raw = normalizeName(addInput.value);
        if (!raw) return;

        // Basic guardrails
        if (raw.length > 80) {
          if (addStatus) addStatus.textContent = 'That name looks too long. Please paste a real card name.';
          return;
        }

        // Disable while validating
        var submitBtn = addForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        var canonical = await validateCardNameExact(raw);

        if (submitBtn) submitBtn.disabled = false;

        if (!canonical) {
          if (addStatus) addStatus.textContent = 'No MTG card found with that exact name. Check spelling (or use Card Search for fuzzy matches).';
          return;
        }

        var dd = loadDraft() || { commanderName: commanderName, cards: {} };
        dd.cards = dd.cards || {};

        // Use canonical name so we don't store duplicates with different casing.
        dd.cards[canonical] = (dd.cards[canonical] || 0) + 1;

        saveDraft(dd);
        render(dd);

        addInput.value = '';
        addInput.focus();

        if (addStatus) addStatus.textContent = 'Added ' + canonical + '.';
        setTimeout(function () {
          if (addStatus) addStatus.textContent = '';
        }, 1500);
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async function () {
        var dd = loadDraft() || { commanderName: commanderName, cards: {} };
        var lines = [];
        lines.push('Commander: ' + commanderName);
        lines.push('');
        var entries = Object.entries(dd.cards || {});
        entries.sort(function (a, b) { return a[0].localeCompare(b[0]); });
        entries.forEach(function (pair) {
          lines.push(pair[1] + ' ' + pair[0]);
        });
        var text = lines.join('\n');

        try {
          await navigator.clipboard.writeText(text);
          if (copyStatus) copyStatus.textContent = 'Copied decklist to clipboard.';
        } catch (e) {
          // Fallback
          try {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            if (copyStatus) copyStatus.textContent = 'Copied decklist to clipboard.';
          } catch (e2) {
            if (copyStatus) copyStatus.textContent = 'Could not copy automatically. You can manually select/copy from the card list.';
          }
        }

        setTimeout(function () {
          if (copyStatus) copyStatus.textContent = '';
        }, 2500);
      });
    }

    async function importDraftToAccount() {
      var dd = loadDraft();
      if (!dd) {
        if (copyStatus) copyStatus.textContent = 'No draft found to save.';
        return;
      }

      var cards = Object.entries(dd.cards || {}).map(function (pair) {
        return { name: pair[0], qty: pair[1] };
      }).filter(function (x) {
        return x && x.name && x.qty && x.qty > 0;
      });

      var payload = {
        commander_name: commanderName,
        name: dd.name || commanderName,
        description: dd.description || '',
        cards: cards,
      };

      try {
        if (copyStatus) copyStatus.textContent = 'Saving…';

        var res = await fetch('/decks/import-draft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          if (copyStatus) copyStatus.textContent = 'Could not save deck. Please try again.';
          return;
        }

        var out = await res.json();
        if (out && out.deck_id) {
          try { localStorage.removeItem(key); } catch (e) {}
          window.location.href = '/decks/' + out.deck_id;
          return;
        }

        if (copyStatus) copyStatus.textContent = 'Saved, but did not receive a deck id.';
      } catch (e) {
        if (copyStatus) copyStatus.textContent = 'Could not save deck. Please try again.';
      }
    }

    function bindSave(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('click', function () {
        importDraftToAccount();
      });
    }

    bindSave('guest-save-to-account');
    bindSave('guest-save-to-account-2');
  });
  </script>

  {{ template "layout_footer" . }}
{{ end }}