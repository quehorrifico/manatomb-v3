    function syncManaCurveBars() {
      var keys = ['0', '1', '2', '3', '4', '5', '6', '7p'];
      var counts = keys.map(function (key) {
        return countValue('deck-analytics-curve-' + key);
      });
      var max = 0;
      for (var i = 0; i < counts.length; i++) {
        if (counts[i] > max) max = counts[i];
      }
      for (var j = 0; j < keys.length; j++) {
        var bar = document.getElementById('deck-curve-bar-' + keys[j]);
        if (!bar) continue;
        var val = counts[j];
        var pct = max > 0 ? Math.round((val / max) * 100) : 0;
        // Keep bars inside the chart box so labels never overflow.
        var h = val > 0 ? Math.max(6, Math.round((pct / 100) * 46)) : 4;
        bar.style.height = String(h) + 'px';
      }
    }

