    var sortSelect = document.getElementById('signed-sort-mode');
    var sortDirectionSelect = document.getElementById('signed-sort-direction');
    var layoutSelect = document.getElementById('signed-layout-mode');
    var previewApi = window.mtDeckCardPreview || null;
    var prefKey = 'manatomb.deckViewPrefs';
