{{ define "deck_show" }}
  {{ $ctx := .Data }}
  {{ $d := $ctx.Deck }}
  {{ $c := $ctx.Commander }}
  {{ $isGuest := false }}
  {{ if $ctx.WorkbenchMode }}
    {{ $isGuest = true }}
  {{ else }}
    {{ $isGuest = not .CurrentUser }}
  {{ end }}
  {{ $requiresCommanderDeck := formatRequiresCommander $d.Format }}
  {{ template "layout_header" . }}

  <div class="mt-deck-editor">
    <div id="deck-import-warning-toast"
         class="mt-deck-editor__import-toast hidden"
         role="alert"
         aria-live="assertive">
      <div>
        <strong>Import incomplete</strong>
        <span id="deck-import-warning-message">Some cards couldn't be matched and were skipped. See Notes below.</span>
      </div>
      <button type="button"
              id="deck-import-warning-dismiss"
              aria-label="Dismiss import warning">×</button>
    </div>
    <h1 id="deck-editor-heading" class="sr-only">Edit {{ $d.Name }}</h1>
    <header class="mt-deck-editor__header">
      <div class="mt-deck-editor__identity">
        <div class="mt-deck-editor__name-row">
          {{ if $isGuest }}
            <label for="guest-deck-name-input" class="sr-only">Deck name</label>
            <input id="guest-deck-name-input"
                   class="mt-deck-editor__name-input"
                   type="text"
                   value="{{ $d.Name }}"
                   maxlength="120"
                   autocomplete="off">
            <span id="guest-deck-name" class="sr-only" aria-live="polite">{{ $d.Name }}</span>
          {{ else }}
            <label for="deck-menu-name-input" class="sr-only">Deck name</label>
            <input id="deck-menu-name-input"
                   class="mt-deck-editor__name-input"
                   type="text"
                   value="{{ $d.Name }}"
                   maxlength="120"
                   autocomplete="off">
            <span id="saved-deck-name" class="sr-only" aria-live="polite">{{ $d.Name }}</span>
          {{ end }}
        </div>

        {{ if and $isGuest (not .CurrentUser) }}
          <p id="deck-overview-status" class="mt-deck-editor__save-state" role="status"></p>
        {{ else }}
          <div class="mt-deck-editor__meta">
            <p id="deck-overview-status" class="mt-deck-editor__save-state" role="status">
              {{ if not $isGuest }}Changes save automatically.{{ end }}
            </p>

            <div class="mt-deck-editor__header-actions">
              <div class="mt-deck-editor__actions">
                {{ if $isGuest }}
                  <button type="button" id="guest-save-to-account" class="mt-btn mt-btn--primary mt-btn--sm">Save deck</button>
                {{ else }}
                  <button type="button"
                          id="deck-menu-open"
                          class="mt-btn mt-btn--secondary mt-btn--sm"
                          aria-haspopup="dialog"
                          aria-expanded="false">Deck actions</button>
                {{ end }}
              </div>
            </div>
          </div>
        {{ end }}
      </div>
    </header>

    <nav class="mt-deck-editor__views" role="tablist" aria-label="Deck workspace">
      <button type="button"
              id="deck-workspace-tab-decklist"
              class="mt-deck-editor__view-tab"
              data-deck-workspace-tab="decklist"
              aria-controls="deck-workspace-decklist"
              aria-selected="true"
              role="tab"
              tabindex="0">Cards</button>
      <button type="button"
              id="deck-workspace-tab-analysis"
              class="mt-deck-editor__view-tab"
              data-deck-workspace-tab="analysis"
              aria-controls="deck-workspace-analysis"
              aria-selected="false"
              role="tab"
              tabindex="-1">Analysis</button>
    </nav>

    <section id="deck-workspace-decklist"
             class="mt-deck-editor__workspace"
             data-deck-workspace-panel="decklist"
             role="tabpanel"
             aria-labelledby="deck-workspace-tab-decklist">
      <h2 class="sr-only">Cards</h2>

      <div id="deck-card-entry-row"
           class="mt-deck-editor__card-entry-row {{ if not $requiresCommanderDeck }}mt-deck-editor__card-entry-row--search-only{{ end }}">
        <div id="deck-overview-layout"
             class="mt-deck-editor__commander-summary {{ if not $requiresCommanderDeck }}hidden{{ end }}">
          <div id="deck-overview-side" class="{{ if not $requiresCommanderDeck }}hidden{{ end }}">
            <section id="deck-commander-panel" class="mt-commander-panel" aria-label="Commander">
              <div class="mt-commander-card">
                <button type="button"
                        id="deck-commander-trigger"
                        class="mt-commander-card__trigger"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        aria-label="Open commander actions">
                  <span id="deck-top-commander-art-wrap"
                        class="mt-commander-art {{ if or (and $c $c.ImageURI) (and $c $c.Faces) }}{{ else }}hidden{{ end }}">
                    <img id="deck-top-commander-art"
                         src="{{ if and $c $c.ImageURI }}{{ $c.ImageURI }}{{ else if and $c (gt (len $c.Faces) 0) }}{{ (index $c.Faces 0).ImageURI }}{{ end }}"
                         alt="{{ if $d.CommanderName }}{{ $d.CommanderName }} commander art{{ else }}Commander art{{ end }}">
                  </span>
                  <span id="deck-top-commander-placeholder"
                        class="mt-commander-art mt-commander-art--empty {{ if or (and $c $c.ImageURI) (and $c $c.Faces) }}{{ else }}hidden{{ end }}"
                        aria-hidden="true">
                    <span>Select</span>
                  </span>
                  <span class="mt-deck-editor__commander-copy">
                    <span>Commander</span>
                    <span id="deck-commander-name">
                      {{ if $c }}{{ $c.Name }}{{ else if $d.CommanderName }}{{ $d.CommanderName }}{{ else }}No commander selected{{ end }}
                    </span>
                  </span>
                </button>
                <div class="mt-deck-editor__commander-actions">
                  <button type="button"
                          id="deck-commander-flip"
                          class="mt-commander-flip mt-btn mt-btn--secondary mt-btn--xs {{ if and $c (gt (len $c.Faces) 1) }}{{ else }}hidden{{ end }}">Turn over</button>
                </div>
                <div id="deck-commander-menu-slot" class="mt-commander-menu-slot"></div>
              </div>
            </section>
          </div>
        </div>

        <form id="deck-add-card-form"
              {{ if not $isGuest }}method="POST" action="/decks/{{ $d.ID }}"{{ else }}novalidate{{ end }}
              class="mt-deck-editor__add-form">
          <label for="guest-card-name" class="sr-only">Search cards to add</label>
          <div class="mt-deck-editor__add-row">
            <div class="relative">
              <input type="text"
                     id="guest-card-name"
                     name="card_name"
                     required
                     autocomplete="off"
                     placeholder="Search cards to add to Main"
                     class="mt-control"
                     role="combobox"
                     aria-autocomplete="list"
                     aria-expanded="false"
                     aria-haspopup="listbox"
                     aria-controls="deck-card-suggestions"
                     aria-keyshortcuts="/">
              <div id="deck-card-suggestions"
                   class="mt-autocomplete-menu hidden"
                   aria-label="Card suggestions"
                   role="listbox"></div>
            </div>
            <button type="button"
                    id="deck-focus-mode-toggle"
                    class="mt-btn mt-btn--secondary mt-btn--sm mt-deck-editor__focus-toggle"
                    aria-pressed="false"
                    aria-keyshortcuts="Escape"
                    aria-label="Enter full screen editing mode"
                    aria-controls="deck-workspace-decklist"
                    aria-describedby="deck-focus-mode-help"
                    hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
              </svg>
              <span id="deck-focus-mode-label">Full screen</span>
            </button>
          </div>
          <span id="deck-focus-mode-help" class="sr-only">
            Hides site navigation, the deck title, and workspace tabs. Press Escape to exit.
          </span>
          <input type="hidden" id="deck-add-zone" name="zone" value="main">
        </form>
      </div>

      <div class="mt-deck-editor__decklist-toolbar">
        <div class="mt-deck-editor__board-row">
          <div class="mt-board-tabs" role="tablist" aria-label="Deck boards">
            <button type="button"
                    class="mt-board-tab"
                    data-deck-board-tab="main"
                    aria-controls="deck-cards-list"
                    aria-selected="true"
                    role="tab"
                    tabindex="0">
              <span>Main</span>
              <span id="deck-count-label">{{ if $isGuest }}0{{ else }}{{ $ctx.VisibleCardCount }}{{ end }}</span>
            </button>
            <button type="button"
                    class="mt-board-tab"
                    data-deck-board-tab="side"
                    aria-controls="deck-cards-list"
                    aria-selected="false"
                    role="tab"
                    tabindex="-1">
              <span>Sideboard</span>
              <span id="deck-sideboard-count-label">{{ if $isGuest }}0{{ else }}{{ $ctx.SideboardCardCount }}{{ end }}</span>
            </button>
            <button type="button"
                    class="mt-board-tab"
                    data-deck-board-tab="maybe"
                    aria-controls="deck-cards-list"
                    aria-selected="false"
                    role="tab"
                    tabindex="-1">
              <span>Maybeboard</span>
              <span id="guest-maybeboard-count-label">{{ if $isGuest }}0{{ else }}{{ $ctx.MaybeCardCount }}{{ end }}</span>
            </button>
          </div>
          <div class="mt-deck-editor__board-meta">
            <label class="mt-deck-editor__format">
              <span>Format</span>
              <select id="deck-overview-format" class="mt-control mt-control--sm">
                {{ if and $d.Format (not (formatIsBuildable $d.Format)) }}
                  <option value="{{ $d.Format }}" selected disabled>{{ $d.Format }} (existing format)</option>
                {{ end }}
                {{ range buildableFormats }}
                  <option value="{{ . }}" {{ if eq $d.Format . }}selected{{ end }}>{{ . }}</option>
                {{ end }}
              </select>
            </label>
            {{ if $isGuest }}
              <button type="button"
                      id="deck-analysis-playtest"
                      class="mt-btn mt-btn--secondary mt-btn--sm"
                      data-deck-playtest>Playtest</button>
            {{ else }}
              <a href="/decks/playtest/{{ $d.ID }}"
                 id="deck-analysis-playtest"
                 class="mt-btn mt-btn--secondary mt-btn--sm"
                 data-deck-playtest>Playtest</a>
            {{ end }}
          </div>
        </div>

        <div class="mt-deck-editor__feedback">
          <p id="deck-add-status" class="mt-deck-editor__inline-status" aria-live="polite"></p>
          <div id="deck-undo"
               class="mt-deck-editor__undo hidden"
               role="status"
               aria-live="polite">
            <span id="deck-undo-message"></span>
            <button type="button" id="deck-undo-action">Undo</button>
          </div>
        </div>

        <div id="deck-display-options"
             class="mt-deck-editor__display-options"
             aria-label="View and filter cards">
          <div class="mt-deck-editor__display-grid">
            <label class="mt-deck-editor__display-field">
              <span>Filter</span>
              <input id="deck-filter-query"
                     type="search"
                     class="mt-control mt-control--sm"
                     placeholder="Filter this board"
                     autocomplete="off">
            </label>
            <label class="mt-deck-editor__display-field">
              <span>Group by</span>
              <select id="deck-group-mode" class="mt-control mt-control--sm">
                <option value="none">No grouping</option>
                <option value="category">Card role</option>
                <option value="alphabet">First letter</option>
                <option value="type">Card type</option>
                <option value="mv">Mana value</option>
                <option value="price">Price range</option>
              </select>
            </label>
            <div class="mt-deck-editor__display-field mt-deck-editor__display-field--sort">
              <label id="deck-sort-mode-label" for="deck-sort-mode">Sort by</label>
              <div class="mt-deck-editor__sort-control">
                <select id="deck-sort-mode"
                        class="mt-control mt-control--sm"
                        aria-labelledby="deck-sort-mode-label">
                  <option value="alphabet">Name</option>
                  <option value="mv">Mana value</option>
                  <option value="type">Card type</option>
                  <option value="price">Price</option>
                </select>
                <button id="deck-sort-direction"
                        type="button"
                        class="mt-deck-editor__sort-direction"
                        aria-label="Sort direction: ascending"
                        aria-pressed="false"
                        aria-controls="deck-cards-list"
                        title="Ascending; switch to descending">
                  <span aria-hidden="true">↑</span>
                </button>
              </div>
            </div>
            <label class="mt-deck-editor__display-field">
              <span>Card view</span>
              <select id="deck-view-mode" class="mt-control mt-control--sm">
                <option value="stacks">Stacks</option>
                <option value="text">Text list</option>
                <option value="grid">Card grid</option>
                <option value="table">Table</option>
              </select>
            </label>
          </div>
        </div>
      </div>

      <div id="deck-quick-build-wrap"
           class="mt-deck-editor__quick-build {{ if and (eq $d.Format "Commander") $d.CommanderName (eq $ctx.VisibleCardCount 0) (eq $ctx.SideboardCardCount 0) (eq $ctx.MaybeCardCount 0) }}{{ else }}hidden{{ end }}">
        <div>
          <h3 id="deck-empty-state-title">Your deck is ready for its first cards</h3>
          <p id="deck-quick-build-copy">Search above, or create a starter built around your commander.</p>
          <p id="deck-quick-build-summary" class="hidden" aria-live="polite"></p>
        </div>
        <button type="button" id="deck-quick-build" class="mt-btn mt-btn--primary mt-btn--sm">Quick Build</button>
      </div>

      <div id="deck-cards-list"></div>
      <p id="deck-cards-empty" class="mt-deck-editor__empty hidden">No cards in this board yet.</p>
    </section>

    <section id="deck-workspace-analysis"
             class="mt-deck-editor__workspace mt-deck-editor__analysis hidden"
             data-deck-workspace-panel="analysis"
             role="tabpanel"
             aria-labelledby="deck-workspace-tab-analysis">
      <input type="hidden" id="deck-overview-tags-hidden" value="{{ $d.Tags }}">
      <span id="deck-analytics-status"
            class="mt-deck-editor__analytics-status"
            role="status"
            aria-live="polite"></span>

      <section id="deck-stat-explorer" class="mt-deck-editor__stat-explorer" aria-label="Explore deck statistics">
        <div class="mt-deck-editor__stats"
             role="group"
             aria-label="Deck statistics">
          <button type="button" class="mt-stat-card mt-stat-card--button" data-analytics-stat="all" aria-controls="deck-analytics-card-list-panel" aria-expanded="false">
            <p>Cards</p>
            <strong id="deck-analytics-total">{{ $ctx.Analytics.TotalCards }}</strong>
          </button>
          <button type="button" class="mt-stat-card mt-stat-card--button" data-analytics-stat="lands" aria-controls="deck-analytics-card-list-panel" aria-expanded="false">
            <p>Lands</p>
            <strong id="deck-analytics-lands">{{ $ctx.Analytics.LandCount }}</strong>
          </button>
          <div class="mt-stat-card">
            <p>Average mana value</p>
            <strong id="deck-analytics-avg-cmc">{{ $ctx.Analytics.AverageCMCDisplay }}</strong>
          </div>
          <button type="button" class="mt-stat-card mt-stat-card--button" data-analytics-stat="ramp" aria-controls="deck-analytics-card-list-panel" aria-expanded="false">
            <p>Ramp</p>
            <strong id="deck-analytics-ramp">{{ $ctx.Analytics.RampCount }}</strong>
          </button>
          <button type="button" class="mt-stat-card mt-stat-card--button" data-analytics-stat="draw" aria-controls="deck-analytics-card-list-panel" aria-expanded="false">
            <p>Draw</p>
            <strong id="deck-analytics-card-draw">{{ $ctx.Analytics.CardDrawCount }}</strong>
          </button>
          <button type="button" class="mt-stat-card mt-stat-card--button" data-analytics-stat="interaction" aria-controls="deck-analytics-card-list-panel" aria-expanded="false">
            <p>Interaction</p>
            <strong id="deck-analytics-interaction">{{ $ctx.Analytics.InteractionCount }}</strong>
          </button>
        </div>

        <div id="deck-analytics-card-list-panel" class="mt-deck-editor__analysis-list hidden">
          <div>
            <p id="deck-analytics-card-list-title" class="mt-kicker">Cards</p>
            <button type="button" id="deck-analytics-card-list-close" class="mt-btn mt-btn--secondary mt-btn--xs">Close</button>
          </div>
          <ul id="deck-analytics-card-list"></ul>
        </div>
      </section>

      {{ $power := $ctx.Analytics.PowerEstimate }}
      <div id="deck-power-panel"
           class="mt-power-panel {{ if $power.Available }}{{ else }}hidden{{ end }}"
           aria-label="Commander bracket estimate">
        <div class="mt-power-summary-row">
          <div class="mt-power-rank">
            <span class="mt-field-label">Bracket estimate</span>
            <p>
              <strong>B<span id="deck-power-bracket">{{ if $power.Available }}{{ $power.Bracket }}{{ else }}-{{ end }}</span></strong>
              <span id="deck-power-label">{{ if $power.Available }}{{ $power.BracketLabel }}{{ else }}Commander only{{ end }}</span>
              <span aria-hidden="true">·</span>
              <span id="deck-power-confidence">
                {{ if eq $power.Confidence "low" }}Early estimate
                {{ else if eq $power.Confidence "medium" }}Developing estimate
                {{ else }}Full-deck estimate
                {{ end }}
              </span>
            </p>
          </div>
        </div>
      </div>

      <section class="mt-deck-editor__mana-profile" aria-labelledby="deck-mana-profile-title">
        <div class="mt-deck-editor__analysis-section-head">
          <div>
            <h3 id="deck-mana-profile-title">Mana profile</h3>
            <p>Choose a color to see the cards behind it.</p>
          </div>
        </div>

        <div class="mt-deck-editor__mana-profile-grid">
          <article class="mt-deck-editor__mana-chart">
            <header>
              <h4>Pips in costs</h4>
              <p>Mana symbols across mainboard casting costs.</p>
            </header>
            <div class="mt-deck-editor__mana-chart-body">
              <div class="mt-deck-editor__mana-bar" data-mana-profile-bar="pips" role="group" aria-label="Mana pips in card costs"></div>
              <ul class="mt-deck-editor__mana-legend" data-mana-profile-legend="pips"></ul>
            </div>
            <p class="mt-deck-editor__mana-empty" data-mana-profile-empty="pips">Add cards with mana costs to fill this bar.</p>
          </article>

          <article class="mt-deck-editor__mana-chart">
            <header>
              <h4>Mana produced</h4>
              <p>Mainboard cards capable of producing each color.</p>
            </header>
            <div class="mt-deck-editor__mana-chart-body">
              <div class="mt-deck-editor__mana-bar" data-mana-profile-bar="sources" role="group" aria-label="Colors produced by cards"></div>
              <ul class="mt-deck-editor__mana-legend" data-mana-profile-legend="sources"></ul>
            </div>
            <p class="mt-deck-editor__mana-empty" data-mana-profile-empty="sources">Add mana-producing cards to fill this bar.</p>
          </article>
        </div>

        <div id="deck-mana-locked-panel" class="mt-deck-editor__mana-locked hidden" aria-live="polite">
          <div>
            <div>
              <p class="mt-kicker">Locked in</p>
              <h4 id="deck-mana-locked-title">Mana cards</h4>
              <p id="deck-mana-locked-summary"></p>
            </div>
            <button type="button" id="deck-mana-locked-close" class="mt-btn mt-btn--secondary mt-btn--xs">Close</button>
          </div>
          <ul id="deck-mana-locked-list"></ul>
        </div>
      </section>

      {{ if $ctx.Analytics.ValidationWarnings }}
        <div id="deck-guide-warnings-panel" class="mt-deck-editor__guide-warnings">
          <h3>Notes</h3>
          <ul id="deck-guide-warnings-list">
            {{ range $ctx.Analytics.ValidationWarnings }}
              <li>{{ . }}</li>
            {{ end }}
          </ul>
        </div>
      {{ else }}
        <div id="deck-guide-warnings-panel" class="mt-deck-editor__guide-warnings hidden">
          <h3>Notes</h3>
          <ul id="deck-guide-warnings-list"></ul>
        </div>
      {{ end }}

      <div class="mt-deck-editor__analysis-overview-grid">
        <section class="mt-deck-editor__analysis-section">
          <h3>Example opening hand</h3>
          <ul id="deck-analytics-example-hand" class="mt-deck-editor__sample-hand">
            <li id="deck-analytics-new-hand-slot"
                class="mt-deck-editor__sample-refresh-item hidden">
              <button type="button"
                      id="deck-analytics-new-hand"
                      class="mt-deck-editor__sample-refresh"
                      aria-controls="deck-analytics-example-hand"
                      aria-describedby="deck-analytics-example-hand-status">
                <span class="mt-deck-editor__sample-refresh-frame">
                  <span class="mt-deck-editor__sample-refresh-icon" aria-hidden="true">↻</span>
                </span>
                <span class="mt-deck-editor__sample-refresh-label">Another hand</span>
              </button>
            </li>
          </ul>
          <p id="deck-analytics-example-hand-status"
             class="sr-only"
             role="status"
             aria-live="polite"
             aria-atomic="true"></p>
          <p id="deck-analytics-example-hand-empty" class="mt-deck-editor__empty">Add cards to sample a hand.</p>
        </section>

        <section class="mt-deck-editor__analysis-section mt-deck-editor__notes-panel">
          <h3>Notes</h3>
          <div class="mt-deck-editor__notes-box">
            <label for="deck-overview-notes" class="sr-only">Notes</label>
            <textarea id="deck-overview-notes"
                      rows="8"
                      placeholder="Add a primer, goals, or reminders for this deck.">{{ $d.Description }}</textarea>
            <div id="deck-overview-tags-list"
                 class="mt-deck-editor__selected-tags mt-deck-editor__tag-list"
                 aria-label="Selected tags"></div>
          </div>

          <div class="mt-deck-editor__tags">
            <span class="mt-field-label">Tags</span>
            <div class="mt-deck-editor__tag-options">
              {{ range supportedDeckTags }}
                <button type="button"
                        class="{{ deckTagButtonClass . }}"
                        data-tag-suggestion="{{ . }}">
                  {{ . }}
                </button>
              {{ end }}
            </div>
          </div>
        </section>
      </div>

      <div class="mt-deck-editor__analysis-composition-grid">
          <section class="mt-deck-editor__analysis-section">
            <h3>Mana curve</h3>
            <div class="mt-deck-editor__curve">
              <div class="h-24 overflow-hidden flex items-end gap-1.5">
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-0" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve0Count }}</p>
                  <div id="deck-curve-bar-0" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">0</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-1" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve1Count }}</p>
                  <div id="deck-curve-bar-1" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">1</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-2" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve2Count }}</p>
                  <div id="deck-curve-bar-2" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">2</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-3" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve3Count }}</p>
                  <div id="deck-curve-bar-3" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">3</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-4" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve4Count }}</p>
                  <div id="deck-curve-bar-4" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">4</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-5" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve5Count }}</p>
                  <div id="deck-curve-bar-5" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">5</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-6" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve6Count }}</p>
                  <div id="deck-curve-bar-6" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">6</p>
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-center justify-end">
                  <p id="deck-analytics-curve-7p" class="mt-deck-editor__curve-value">{{ $ctx.Analytics.Curve7PlusCount }}</p>
                  <div id="deck-curve-bar-7p" class="mt-deck-editor__curve-bar w-5 h-[4px]"></div>
                  <p class="mt-deck-editor__curve-label">7+</p>
                </div>
              </div>
            </div>
          </section>

          <section class="mt-deck-editor__analysis-section">
            <h3>Type mix</h3>
            <div class="mt-deck-editor__type-mix">
              <p class="flex items-center justify-between"><span>Creatures</span><span id="deck-analytics-type-creature">{{ $ctx.Analytics.CreatureCount }}</span></p>
              <p class="flex items-center justify-between"><span>Artifacts</span><span id="deck-analytics-type-artifact">{{ $ctx.Analytics.ArtifactCount }}</span></p>
              <p class="flex items-center justify-between"><span>Enchantments</span><span id="deck-analytics-type-enchantment">{{ $ctx.Analytics.EnchantmentCount }}</span></p>
              <p class="flex items-center justify-between"><span>Instants</span><span id="deck-analytics-type-instant">{{ $ctx.Analytics.InstantCount }}</span></p>
              <p class="flex items-center justify-between"><span>Sorceries</span><span id="deck-analytics-type-sorcery">{{ $ctx.Analytics.SorceryCount }}</span></p>
              <p class="flex items-center justify-between"><span>Planeswalkers</span><span id="deck-analytics-type-planeswalker">{{ $ctx.Analytics.PlaneswalkerCount }}</span></p>
              <p class="flex items-center justify-between"><span>Battles</span><span id="deck-analytics-type-battle">{{ $ctx.Analytics.BattleCount }}</span></p>
            </div>
          </section>
      </div>
    </section>
  </div>

  {{ template "card_detail_modal" . }}

  <div id="deck-card-preview"
       class="pointer-events-none fixed left-0 top-0 z-[150] hidden w-56 overflow-hidden rounded-xl border">
    <img id="deck-card-preview-img"
         alt=""
         class="block w-full h-auto">
    <div id="deck-card-preview-fallback"
         class="hidden flex aspect-[5/7] items-center justify-center p-4 text-center text-sm font-medium"></div>
  </div>

  {{ if not $isGuest }}
    <div id="deck-menu-overlay"
         class="mt-deck-editor__menu-overlay hidden"
         role="dialog"
         aria-modal="true"
         aria-hidden="true"
         aria-labelledby="deck-menu-title">
      <div class="mt-deck-editor__menu" tabindex="-1">
        <div>
          <p class="mt-kicker">Manage</p>
          <h2 id="deck-menu-title">{{ $d.Name }}</h2>
          <p>Copy, export, publish, or delete this deck.</p>
        </div>

        <div class="mt-deck-editor__menu-actions">
          <button type="button" id="deck-menu-copy" class="mt-btn mt-btn--secondary w-full justify-center">Copy Decklist</button>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="deck-menu-export-txt" class="mt-btn mt-btn--secondary justify-center">Export TXT</button>
            <button type="button" id="deck-menu-export-csv" class="mt-btn mt-btn--secondary justify-center">Export CSV</button>
          </div>
          <button type="button" id="deck-menu-visibility" class="mt-btn mt-btn--secondary w-full justify-center">
            {{ if $d.IsPublic }}Set Private{{ else }}Set Public{{ end }}
          </button>
          <form id="deck-menu-delete-form"
                method="POST"
                action="/decks/delete"
                onsubmit="return confirm('Delete this deck? This cannot be undone.');">
            <input type="hidden" name="id" value="{{ $d.ID }}">
            <button type="submit" class="mt-btn mt-btn--danger w-full justify-center">Delete Deck</button>
          </form>
        </div>

        <p id="deck-menu-status" class="mt-deck-editor__menu-status" aria-live="polite"></p>

        <div class="mt-deck-editor__menu-close">
          <button type="button" id="deck-menu-close" class="mt-btn mt-btn--primary mt-btn--sm">Close</button>
        </div>
      </div>
    </div>
  {{ end }}

  <script id="deck-workspace-seed" type="application/json">
    {{ toJSON $ctx.WorkspaceState }}
  </script>

  <script src="/assets/deck_browser.js"></script>
  {{ template "card_detail_modal_script" . }}
  {{ template "deck_show_guest_draft_script" . }}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var isGuest = {{ if .Data.WorkbenchMode }}true{{ else if .CurrentUser }}false{{ else }}true{{ end }};
      var supportedTagOptions = {{ toJSON (supportedDeckTags) }};
      var tagThemeMap = {{ toJSON (deckTagThemeMap) }};
      var addForm = document.getElementById('deck-add-card-form');
      var addInput = document.getElementById('guest-card-name');
      var suggestions = document.getElementById('deck-card-suggestions');
      var tagHidden = document.getElementById('deck-overview-tags-hidden');
      var tagList = document.getElementById('deck-overview-tags-list');
      var tagButtons = Array.prototype.slice.call(document.querySelectorAll('[data-tag-suggestion]'));
      var noteField = document.getElementById('deck-overview-notes');
      var formatField = document.getElementById('deck-overview-format');
      var overviewLayout = document.getElementById('deck-overview-layout');
      var overviewSide = document.getElementById('deck-overview-side');
      var cardEntryRow = document.getElementById('deck-card-entry-row');
      var commanderPanel = document.getElementById('deck-commander-panel');
      var overviewFormatText = document.getElementById('deck-overview-format-text');
      var overviewStatus = document.getElementById('deck-overview-status');
      var flipButton = document.getElementById('deck-commander-flip');
      var commanderTrigger = document.getElementById('deck-commander-trigger');
      var commanderNameEl = document.getElementById('deck-commander-name');
      var commanderArtWrapEl = document.getElementById('deck-top-commander-art-wrap');
      var commanderPlaceholderEl = document.getElementById('deck-top-commander-placeholder');
      var commanderArtEl = document.getElementById('deck-top-commander-art');
      var commanderFaces = {{ if and $c (gt (len $c.Faces) 0) }}{{ toJSON $c.Faces }}{{ else }}[]{{ end }};
      var commanderFallback = {
        name: {{ if $c }}{{ toJSON $c.Name }}{{ else }}""{{ end }},
        mana_cost: {{ if $c }}{{ toJSON $c.ManaCost }}{{ else }}""{{ end }},
        type_line: {{ if $c }}{{ toJSON $c.TypeLine }}{{ else }}""{{ end }},
        oracle_text: {{ if $c }}{{ toJSON $c.OracleText }}{{ else }}""{{ end }},
        image_uri: {{ if $c }}{{ toJSON $c.ImageURI }}{{ else }}""{{ end }}
      };
      var commanderRequiresSelection = {{ if $requiresCommanderDeck }}true{{ else }}false{{ end }};
      var currentCommanderFaces = [];
      var currentCommanderFaceIndex = 0;
      var lastGoodCommanderArt = normalizeTag((commanderArtEl && commanderArtEl.getAttribute('src')) || '');

      function closeDeckActionMenus() {
        if (typeof window.mtDeckCloseActionMenus === 'function') {
          window.mtDeckCloseActionMenus();
          return;
        }
        var openMenus = document.querySelectorAll('details[data-card-action-menu][open]');
        for (var i = 0; i < openMenus.length; i++) {
          openMenus[i].open = false;
        }
      }

      function commanderEmptyName() {
        return commanderRequiresSelection ? 'No commander selected' : 'No commander used';
      }

      function isUsableCommanderImageURI(value) {
        var uri = normalizeTag(value);
        if (!uri) return false;
        if (uri === '[object Object]') return false;
        if (uri === 'null' || uri === 'undefined') return false;
        return /^https?:\/\//i.test(uri) || /^data:/i.test(uri) || uri.charAt(0) === '/';
      }

      function syncOverviewFormatLayout(isCommander) {
        commanderRequiresSelection = !!isCommander;
        var nextFormat = isCommander ? 'Commander' : 'Sandbox';
        if (overviewFormatText) overviewFormatText.textContent = nextFormat;
        if (overviewLayout) {
          overviewLayout.classList.toggle('hidden', !isCommander);
        }
        if (overviewSide) {
          overviewSide.classList.toggle('hidden', !isCommander);
        }
        if (commanderPanel) {
          commanderPanel.classList.toggle('hidden', !isCommander);
        }
        if (cardEntryRow) {
          cardEntryRow.classList.toggle('mt-deck-editor__card-entry-row--search-only', !isCommander);
        }
        if (!isCommander) {
          if (commanderNameEl) commanderNameEl.textContent = commanderEmptyName();
          if (commanderArtWrapEl) commanderArtWrapEl.classList.add('hidden');
          if (commanderPlaceholderEl) commanderPlaceholderEl.classList.add('hidden');
          if (flipButton) flipButton.classList.add('hidden');
        } else {
          renderCommanderOverviewFace(currentCommanderFaceIndex);
        }
      }
      window.mtDeckSetOverviewFormat = syncOverviewFormatLayout;

      function normalizeTag(value) {
        return String(value || '').replace(/\s+/g, ' ').trim();
      }

      function canonicalDeckTag(value) {
        var normalized = normalizeTag(value).toLowerCase();
        if (!normalized) return '';
        for (var i = 0; i < supportedTagOptions.length; i++) {
          if (String(supportedTagOptions[i] || '').toLowerCase() === normalized) {
            return supportedTagOptions[i];
          }
        }
        return '';
      }

      function normalizeCommanderFace(face) {
        if (!face || typeof face !== 'object') return null;
        var normalized = {
          name: normalizeTag(face.name || ''),
          mana_cost: normalizeTag(face.mana_cost || face.manaCost || ''),
          type_line: normalizeTag(face.type_line || face.typeLine || ''),
          oracle_text: normalizeTag(face.oracle_text || face.oracleText || ''),
          image_uri: normalizeTag(face.image_uri || face.imageURI || '')
        };
        if (!normalized.name && !normalized.type_line && !normalized.oracle_text && !normalized.image_uri) {
          return null;
        }
        return normalized;
      }

      function normalizedCommanderFaces(faces) {
        if (!Array.isArray(faces)) return [];
        var out = [];
        for (var i = 0; i < faces.length; i++) {
          var face = normalizeCommanderFace(faces[i]);
          if (face) out.push(face);
        }
        return out;
      }

      function extractCommanderImageURI(cardData) {
        if (!cardData || typeof cardData !== 'object') return '';
        if (cardData.image_uris && typeof cardData.image_uris === 'object') {
          return normalizeTag(cardData.image_uris.normal || cardData.image_uris.large || cardData.image_uris.small || '');
        }
        return normalizeTag(cardData.image_uri || cardData.imageURI || '');
      }

      function syncCommanderFlipVisibility() {
        if (!flipButton) return;
        flipButton.classList.toggle('hidden', currentCommanderFaces.length <= 1);
      }

      function renderCommanderOverviewFace(index) {
        var face = currentCommanderFaces.length > 0
          ? (currentCommanderFaces[index] || currentCommanderFaces[0])
          : null;

        var name = face ? face.name : normalizeTag(commanderFallback.name || '');
        var imageURI = face ? face.image_uri : normalizeTag(commanderFallback.image_uri || '');
        var hasCommanderSelection = !!name;
        if (hasCommanderSelection && !isUsableCommanderImageURI(imageURI) && isUsableCommanderImageURI(commanderFallback.image_uri || '')) {
          imageURI = normalizeTag(commanderFallback.image_uri || '');
        }
        if (hasCommanderSelection && !isUsableCommanderImageURI(imageURI) && isUsableCommanderImageURI(lastGoodCommanderArt)) {
          imageURI = lastGoodCommanderArt;
        }
        if (!hasCommanderSelection) {
          imageURI = '';
        }

        if (commanderNameEl) commanderNameEl.textContent = name || commanderEmptyName();
        if (commanderTrigger) {
          commanderTrigger.setAttribute(
            'aria-label',
            hasCommanderSelection
              ? 'Open actions for ' + name
              : 'Open commander selection'
          );
        }

        if (commanderArtEl) {
          if (isUsableCommanderImageURI(imageURI)) {
            commanderArtEl.src = imageURI;
            commanderArtEl.alt = (name || 'Commander') + ' commander art';
          } else {
            commanderArtEl.removeAttribute('src');
            commanderArtEl.alt = 'Commander art';
          }
        }
        if (commanderArtWrapEl) {
          commanderArtWrapEl.classList.toggle('hidden', !isUsableCommanderImageURI(imageURI));
        }
        if (commanderPlaceholderEl) {
          commanderPlaceholderEl.classList.toggle('hidden', hasCommanderSelection);
        }
      }

      function setCommanderOverview(cardData) {
        if (!cardData || typeof cardData !== 'object') {
          commanderFallback = {
            name: '',
            mana_cost: '',
            type_line: '',
            oracle_text: '',
            image_uri: ''
          };
          currentCommanderFaces = [];
          currentCommanderFaceIndex = 0;
          syncCommanderFlipVisibility();
          renderCommanderOverviewFace(0);
          return;
        }

        commanderFallback = {
          name: normalizeTag(cardData.name || ''),
          mana_cost: normalizeTag(cardData.mana_cost || cardData.manaCost || ''),
          type_line: normalizeTag(cardData.type_line || cardData.typeLine || ''),
          oracle_text: normalizeTag(cardData.oracle_text || cardData.oracleText || ''),
          image_uri: extractCommanderImageURI(cardData)
        };
        currentCommanderFaces = normalizedCommanderFaces(cardData.faces);
        currentCommanderFaceIndex = 0;
        syncCommanderFlipVisibility();
        renderCommanderOverviewFace(currentCommanderFaceIndex);
      }

      window.mtDeckSetCommanderOverview = setCommanderOverview;

      if (commanderArtEl) {
        commanderArtEl.addEventListener('load', function () {
          var next = normalizeTag(commanderArtEl.getAttribute('src') || '');
          if (isUsableCommanderImageURI(next)) {
            lastGoodCommanderArt = next;
          }
        });
        commanderArtEl.addEventListener('error', function () {
          if (isUsableCommanderImageURI(commanderFallback.image_uri || '') &&
              normalizeTag(commanderArtEl.getAttribute('src') || '') !== normalizeTag(commanderFallback.image_uri || '')) {
            commanderArtEl.src = normalizeTag(commanderFallback.image_uri || '');
            return;
          }
          if (isUsableCommanderImageURI(lastGoodCommanderArt) &&
              normalizeTag(commanderArtEl.getAttribute('src') || '') !== lastGoodCommanderArt) {
            commanderArtEl.src = lastGoodCommanderArt;
            return;
          }
          if (commanderArtWrapEl) commanderArtWrapEl.classList.add('hidden');
        });
      }

      if (commanderTrigger) {
        commanderTrigger.addEventListener('click', function () {
          if (typeof window.mtDeckOpenCommanderPicker === 'function') {
            window.mtDeckOpenCommanderPicker();
          }
        });
      }

      function parseTags(raw) {
        if (!raw) return [];
        var parts = String(raw).split(/[,\n\r\t]+/);
        var out = [];
        var seen = {};
        for (var i = 0; i < parts.length; i++) {
          var tag = canonicalDeckTag(parts[i]);
          if (!tag) continue;
          var key = tag.toLowerCase();
          if (seen[key]) continue;
          seen[key] = true;
          out.push(tag);
          if (out.length >= 12) break;
        }
        return out;
      }

      var tags = parseTags(tagHidden ? tagHidden.value : '');

      function syncTags() {
        if (tagHidden) tagHidden.value = tags.join(', ');
      }

      function updateTagButtons() {
        for (var i = 0; i < tagButtons.length; i++) {
          var button = tagButtons[i];
          var tagValue = canonicalDeckTag(button.getAttribute('data-tag-suggestion') || '');
          var tone = tagToneClasses(tagValue);
          var active = tags.some(function (tag) {
            return tag.toLowerCase() === tagValue.toLowerCase();
          });
          button.className = tone.button;
          button.classList.toggle('hidden', active);
          button.disabled = active;
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
          button.setAttribute('data-selected', active ? 'true' : 'false');
          button.setAttribute('aria-hidden', active ? 'true' : 'false');
          button.tabIndex = active ? -1 : 0;
          button.textContent = '+ ' + tagValue;
          button.title = 'Add ' + tagValue;
        }
      }

      function queueOverviewSave() {
        if (!window.mtDeckWorkspaceUpdateOverview) return;
        window.mtDeckWorkspaceUpdateOverview({
          tags: tagHidden ? tagHidden.value : '',
          description: noteField ? noteField.value : '',
          format: formatField ? formatField.value : ''
        });
      }

      function renderTags() {
        if (!tagList) return;
        tagList.innerHTML = '';
        if (tags.length === 0) {
          updateTagButtons();
          return;
        }

        for (var i = 0; i < tags.length; i++) {
          (function (tagValue) {
            var tone = tagToneClasses(tagValue);
            var chip = document.createElement('button');
            chip.type = 'button';
            chip.className = tone.editor_chip + ' mt-deck-editor__tag-action';
            chip.setAttribute('aria-label', 'Remove ' + tagValue + ' tag');
            chip.title = 'Remove ' + tagValue + ' tag';

            var label = document.createElement('span');
            label.textContent = tagValue;

            var removeMark = document.createElement('span');
            removeMark.className = 'mt-deck-editor__tag-action-mark';
            removeMark.textContent = '×';
            removeMark.setAttribute('aria-hidden', 'true');

            chip.appendChild(label);
            chip.appendChild(removeMark);
            chip.addEventListener('click', function () {
              removeTag(tagValue);
              for (var buttonIndex = 0; buttonIndex < tagButtons.length; buttonIndex++) {
                var buttonTag = canonicalDeckTag(tagButtons[buttonIndex].getAttribute('data-tag-suggestion') || '');
                if (buttonTag.toLowerCase() === tagValue.toLowerCase()) {
                  tagButtons[buttonIndex].focus();
                  break;
                }
              }
            });

            tagList.appendChild(chip);
          })(tags[i]);
        }
        updateTagButtons();
      }

      window.mtDeckSetOverviewTags = function (raw) {
        tags = parseTags(raw);
        syncTags();
        renderTags();
      };

      function tagToneClasses(tagValue) {
        var key = canonicalDeckTag(tagValue);
        return tagThemeMap[key] || {
          public: 'mt-deck-editor__tag-chip',
          editor_chip: 'mt-deck-editor__tag-chip',
          editor_remove: 'mt-deck-editor__tag-remove',
          button: 'mt-btn mt-btn--secondary mt-btn--xs',
          button_active: 'mt-btn mt-btn--primary mt-btn--xs'
        };
      }

      function addTag(value) {
        var normalized = canonicalDeckTag(value);
        if (!normalized) return;
        var exists = tags.some(function (tag) {
          return tag.toLowerCase() === normalized.toLowerCase();
        });
        if (exists || tags.length >= supportedTagOptions.length) {
          return;
        }
        tags.push(normalized);
        syncTags();
        renderTags();
        queueOverviewSave();
      }

      function removeTag(value) {
        var normalized = canonicalDeckTag(value);
        if (!normalized) return;
        tags = tags.filter(function (tag) {
          return tag.toLowerCase() !== normalized.toLowerCase();
        });
        syncTags();
        renderTags();
        queueOverviewSave();
      }

      for (var s = 0; s < tagButtons.length; s++) {
        tagButtons[s].addEventListener('click', function () {
          var tagValue = canonicalDeckTag(this.getAttribute('data-tag-suggestion') || '');
          var exists = tags.some(function (tag) {
            return tag.toLowerCase() === tagValue.toLowerCase();
          });
          if (exists) {
            removeTag(tagValue);
            return;
          }
          addTag(tagValue);
        });
      }

      syncTags();
      renderTags();

      if (formatField) {
        formatField.addEventListener('change', function () {
          syncOverviewFormatLayout(
            typeof window.mtDeckFormatUsesCommander === 'function'
              ? window.mtDeckFormatUsesCommander(formatField.value || '')
              : String(formatField.value || '') === 'Commander'
          );
          queueOverviewSave();
        });
      }

      if (noteField) {
        var noteTimer = null;
        noteField.addEventListener('input', function () {
          if (noteTimer) window.clearTimeout(noteTimer);
          noteTimer = window.setTimeout(function () {
                    queueOverviewSave();
                    if (overviewStatus) {
                      overviewStatus.textContent = isGuest ? '' : 'Changes save automatically.';
                    }
          }, 140);
        });
      }

      if (addForm && addInput && suggestions) {
        var activeIndex = -1;
        var items = [];
        var requestToken = 0;
        var requestController = null;
        var suggestionTimer = 0;

        function closeSuggestions() {
          if (suggestionTimer) {
            window.clearTimeout(suggestionTimer);
            suggestionTimer = 0;
          }
          if (requestController) {
            requestController.abort();
            requestController = null;
          }
          requestToken++;
          suggestions.innerHTML = '';
          suggestions.classList.add('hidden');
          addInput.setAttribute('aria-expanded', 'false');
          addInput.removeAttribute('aria-activedescendant');
          activeIndex = -1;
          items = [];
        }

        function submitCard(name) {
          var value = String(name || '').trim();
          if (!value) return;
          addInput.value = value;
          closeSuggestions();
          if (typeof addForm.requestSubmit === 'function') {
            addForm.requestSubmit();
          } else {
            addForm.submit();
          }
        }

        function setActive(nextIndex) {
          activeIndex = nextIndex;
          for (var i = 0; i < items.length; i++) {
            var active = i === activeIndex;
            items[i].classList.toggle('is-active', active);
            items[i].setAttribute('aria-selected', active ? 'true' : 'false');
          }
          if (items[activeIndex]) {
            addInput.setAttribute('aria-activedescendant', items[activeIndex].id);
            items[activeIndex].scrollIntoView({ block: 'nearest' });
          } else {
            addInput.removeAttribute('aria-activedescendant');
          }
        }

        function renderSuggestions(results) {
          suggestions.innerHTML = '';
          items = [];
          activeIndex = -1;

          if (!Array.isArray(results) || results.length === 0) {
            closeSuggestions();
            return;
          }

          for (var i = 0; i < results.length; i++) {
            var result = results[i] || {};
            var name = String(result.name || '').trim();
            if (!name) continue;

            var button = document.createElement('button');
            button.type = 'button';
            button.id = 'deck-card-suggestion-' + String(i);
            button.className = 'mt-deck-editor__suggestion';
            button.dataset.cardName = name;
            button.setAttribute('role', 'option');
            button.setAttribute('aria-selected', 'false');
            button.setAttribute('tabindex', '-1');

            var nameEl = document.createElement('span');
            nameEl.className = 'mt-deck-editor__suggestion-name';
            nameEl.textContent = name;
            button.appendChild(nameEl);

            button.addEventListener('click', function () {
              submitCard(this.dataset.cardName || '');
            });
            suggestions.appendChild(button);
            items.push(button);
          }

          if (items.length === 0) {
            closeSuggestions();
            return;
          }

          closeDeckActionMenus();
          suggestions.classList.remove('hidden');
          addInput.setAttribute('aria-expanded', 'true');
        }

        async function fetchSuggestions() {
          var query = String(addInput.value || '').trim();
          if (query.length < 2) {
            closeSuggestions();
            return;
          }

          var token = ++requestToken;
          if (requestController) requestController.abort();
          requestController = typeof window.AbortController === 'function' ? new window.AbortController() : null;
          try {
            var res = await fetch('/cards/autocomplete?q=' + encodeURIComponent(query) + '&limit=8', {
              method: 'GET',
              credentials: 'same-origin',
              signal: requestController ? requestController.signal : undefined
            });
            if (!res.ok) {
              closeSuggestions();
              return;
            }
            var data = await res.json();
            if (token !== requestToken) return;
            requestController = null;
            renderSuggestions(data && Array.isArray(data.results) ? data.results : []);
          } catch (e) {
            if (token !== requestToken) return;
            requestController = null;
            if (e && e.name === 'AbortError') return;
            closeSuggestions();
          }
        }

        function scheduleSuggestions() {
          if (suggestionTimer) window.clearTimeout(suggestionTimer);
          if (requestController) {
            requestController.abort();
            requestController = null;
          }
          if (String(addInput.value || '').trim().length < 2) {
            closeSuggestions();
            return;
          }
          suggestionTimer = window.setTimeout(function () {
            suggestionTimer = 0;
            fetchSuggestions();
          }, 160);
        }

        addInput.addEventListener('input', scheduleSuggestions);
        addInput.addEventListener('focus', function () {
          if (String(addInput.value || '').trim().length >= 2) scheduleSuggestions();
        });
        addInput.addEventListener('keydown', function (event) {
          if (suggestions.classList.contains('hidden') || items.length === 0) {
            return;
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            setActive(activeIndex < items.length - 1 ? activeIndex + 1 : 0);
            return;
          }
          if (event.key === 'ArrowUp') {
            event.preventDefault();
            setActive(activeIndex > 0 ? activeIndex - 1 : items.length - 1);
            return;
          }
          if (event.key === 'Enter' && activeIndex >= 0 && activeIndex < items.length) {
            event.preventDefault();
            submitCard(items[activeIndex].dataset.cardName || '');
            return;
          }
          if (event.key === 'Escape') {
            closeSuggestions();
          }
        });

        addInput.addEventListener('focus', closeDeckActionMenus);

        document.addEventListener('click', function (event) {
          var modal = document.getElementById('card-detail-modal');
          if (modal && modal.contains(event.target)) return;
          if (event.target === addInput || suggestions.contains(event.target)) return;
          closeSuggestions();
        });
      }

      currentCommanderFaces = normalizedCommanderFaces(commanderFaces);
      setCommanderOverview({
        name: commanderFallback.name,
        mana_cost: commanderFallback.mana_cost,
        type_line: commanderFallback.type_line,
        oracle_text: commanderFallback.oracle_text,
        image_uri: commanderFallback.image_uri,
        faces: currentCommanderFaces
      });
      syncOverviewFormatLayout({{ if $requiresCommanderDeck }}true{{ else }}false{{ end }});
      if (isGuest && window.mtDeckCurrentGuestDraft) {
        syncOverviewFormatLayout(
          typeof window.mtDeckFormatUsesCommander === 'function'
            ? window.mtDeckFormatUsesCommander(window.mtDeckCurrentGuestDraft.format || '')
            : String(window.mtDeckCurrentGuestDraft.format || '') === 'Commander'
        );
      }
      if (isGuest && window.mtDeckCurrentGuestDraft && window.mtDeckGuestSyncCommanderOverview) {
        window.mtDeckGuestSyncCommanderOverview(window.mtDeckCurrentGuestDraft);
      }

      if (flipButton) {
        flipButton.addEventListener('click', function () {
          if (currentCommanderFaces.length <= 1) return;
          currentCommanderFaceIndex = (currentCommanderFaceIndex + 1) % currentCommanderFaces.length;
          renderCommanderOverviewFace(currentCommanderFaceIndex);
        });
      }
    });
  </script>

  {{ template "layout_footer" . }}
{{ end }}
