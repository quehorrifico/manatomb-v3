{{ define "pack_opening" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <script type="application/json" data-pack-sets>{{ toJSON $ctx.Sets }}</script>
  <script type="application/json" data-pack-type-options>{{ toJSON $ctx.PackTypeOptions }}</script>

  <div class="mt-pack" data-pack-root data-state="idle">
    <header class="mt-pack__header">
      <div>
        <h1>Pack Crack</h1>
        <p>Choose a set, pick a booster, and slide it open.</p>
      </div>
    </header>

    <section class="mt-pack-picker" aria-labelledby="pack-set-heading">
      <div class="mt-pack-picker__heading">
        <div>
          <span class="mt-pack-picker__step">1</span>
          <h2 id="pack-set-heading">Choose a set</h2>
        </div>
      </div>

      <div class="mt-pack-set-rail" tabindex="0" role="group" aria-label="Pack-ready Magic sets, oldest to newest" data-pack-set-rail>
        <p class="mt-pack-set-rail__empty">Loading sets&hellip;</p>
      </div>
    </section>

    <section class="mt-pack-picker mt-pack-picker--types" aria-labelledby="pack-type-heading" data-pack-type-section hidden>
      <div class="mt-pack-picker__heading">
        <div>
          <span class="mt-pack-picker__step">2</span>
          <h2 id="pack-type-heading">Choose a booster</h2>
        </div>
        <p data-pack-selected-set></p>
      </div>
      <div class="mt-pack-type-list" role="group" aria-label="Available booster products" data-pack-type-list></div>
      <div class="mt-pack-picker__source">
        <p data-pack-accuracy></p>
        <button type="button" class="mt-pack-picker__details" data-pack-simulation-open aria-haspopup="dialog" hidden>Simulation details</button>
      </div>
    </section>

    <dialog class="mt-pack-simulation" data-pack-simulation-dialog aria-labelledby="pack-simulation-title" aria-describedby="pack-simulation-summary">
      <div class="mt-pack-simulation__content">
        <header class="mt-pack-simulation__header">
          <div>
            <p class="mt-pack-simulation__confidence" data-pack-simulation-confidence></p>
            <h2 id="pack-simulation-title">Simulation details</h2>
          </div>
          <button type="button" class="mt-pack-simulation__close" data-pack-simulation-close aria-label="Close simulation details">&times;</button>
        </header>

        <p class="mt-pack-simulation__summary" id="pack-simulation-summary" data-pack-simulation-summary></p>

        <section class="mt-pack-simulation__section" data-pack-simulation-recipe-section aria-labelledby="pack-simulation-recipe-title">
          <h3 id="pack-simulation-recipe-title">Modeled pack recipe</h3>
          <ol data-pack-simulation-recipe></ol>
        </section>

        <section class="mt-pack-simulation__section" data-pack-simulation-limitations-section aria-labelledby="pack-simulation-limitations-title" hidden>
          <h3 id="pack-simulation-limitations-title">Known limitations</h3>
          <ul data-pack-simulation-limitations></ul>
        </section>

        <a class="mt-pack-simulation__source" data-pack-simulation-source hidden>View official product source</a>
      </div>
    </dialog>

    <section class="mt-pack-opening" aria-labelledby="pack-stage-title" data-pack-opening hidden>
      <header class="mt-pack-opening__heading">
        <div>
          <h2 id="pack-stage-title" data-pack-stage-title>Your pack</h2>
          <p data-pack-stage-instruction>Preparing your pack&hellip;</p>
        </div>
      </header>

      <div class="mt-pack-stage" data-pack-stage>
        <button type="button" class="mt-btn mt-btn--secondary mt-pack-reveal-all" data-pack-reveal-all hidden>Reveal all</button>

        <div class="mt-pack-loader" data-pack-loader role="status">
          <span aria-hidden="true"></span>
          <p>Collating your cards&hellip;</p>
        </div>

        <div class="mt-pack-scene" data-pack-scene hidden>
          <div class="mt-pack-wrapper" data-pack-wrapper>
            <div class="mt-pack-wrapper__face">
              <div class="mt-pack-wrapper__shine" aria-hidden="true"></div>
              <div class="mt-pack-wrapper__crimp mt-pack-wrapper__crimp--top" aria-hidden="true"></div>
              <div class="mt-pack-wrapper__identity">
                <span class="mt-pack-wrapper__symbol" aria-hidden="true">
                  <img class="mt-pack-wrapper__symbol-image" data-pack-wrapper-symbol-image src="/assets/favicon.svg" alt="" draggable="false" decoding="async" hidden>
                  <span class="mt-pack-wrapper__symbol-fallback" data-pack-wrapper-symbol-fallback>MTG</span>
                </span>
                <strong data-pack-wrapper-set>Magic set</strong>
                <span data-pack-wrapper-type>Booster</span>
              </div>
              <div class="mt-pack-wrapper__brand" aria-hidden="true">ManaTomb</div>
              <div class="mt-pack-wrapper__crimp mt-pack-wrapper__crimp--bottom" aria-hidden="true"></div>
            </div>

            <div class="mt-pack-open-slider" data-pack-open-slider role="slider" tabindex="0"
              aria-label="Slide right to open this booster pack" aria-valuemin="0" aria-valuemax="100"
              aria-valuenow="0" aria-valuetext="Ready to slide">
              <span class="mt-pack-open-slider__fill" aria-hidden="true"></span>
              <span class="mt-pack-open-slider__label" aria-hidden="true">Slide to open</span>
              <span class="mt-pack-open-slider__handle" data-pack-open-slider-handle aria-hidden="true">&rarr;</span>
            </div>
          </div>

          <div class="mt-pack-stack" data-pack-stack role="group" aria-label="Cards in this pack"></div>
        </div>

        <div class="mt-pack-current" data-pack-current hidden>
          <p class="mt-pack-current__name" data-pack-current-name></p>
          <p class="mt-pack-current__price" data-pack-current-price></p>
        </div>
      </div>

      <section class="mt-pack-current-pulls" aria-label="Cards revealed from this pack" data-pack-current-pulls tabindex="-1" hidden>
        <div class="mt-pack-pulls__grid mt-pack-current-pulls__grid" data-pack-current-pulls-grid></div>
        <div class="mt-pack-current-pulls__actions">
          <button type="button" class="mt-btn mt-btn--secondary mt-pack-replay" data-pack-reset hidden>Crack another one?</button>
        </div>
      </section>

      <div class="mt-pack-live sr-only" role="status" aria-live="polite" aria-atomic="true" data-pack-live></div>
    </section>

    <section class="mt-pack-pulls" aria-labelledby="pack-pulls-title" data-pack-pulls hidden>
      <div class="mt-pack-pulls__heading">
        <h2 id="pack-pulls-title">Your Pulls</h2>
        <p><span data-pack-pull-count>0</span> cards <span aria-hidden="true">&middot;</span> <strong data-pack-total-value>$0.00</strong></p>
      </div>
      <div class="mt-pack-pulls__grid" data-pack-pulls-grid></div>
    </section>
  </div>

  {{ template "layout_footer" . }}
{{ end }}
