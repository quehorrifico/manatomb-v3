{{ define "decks_list" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <main class="max-w-5xl mx-auto py-10 px-4 space-y-6">
    <div class="space-y-2">
      <p class="mt-kicker">Decks</p>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-50">My Decks</h1>
    </div>

    <section class="mt-panel p-4 sm:p-6">
      {{ if $ctx }}
        <div class="space-y-3">
          {{ range $ctx }}
            <article class="mt-action-card">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-start gap-4 min-w-0">
                  <div class="h-16 w-12 mt-card-media bg-slate-900/80 flex-shrink-0 flex items-center justify-center">
                    {{ if .CommanderImageURI }}
                      <img src="{{ .CommanderImageURI }}" alt="{{ .CommanderName }}" class="w-full h-full object-cover">
                    {{ else }}
                      <div class="w-full h-full flex items-center justify-center text-[10px] text-slate-500 uppercase tracking-wide">
                        {{ if .CommanderName }}Commander{{ else }}—{{ end }}
                      </div>
                    {{ end }}
                  </div>

                  <div class="min-w-0 space-y-2">
                    <div class="space-y-1">
                      <a href="/decks/{{ .ID }}" class="text-lg font-semibold text-slate-100 hover:text-sky-300 transition-colors">
                        {{ .Name }}
                      </a>
                      {{ if .Description }}
                        <p class="text-sm text-slate-400 line-clamp-2">{{ .Description }}</p>
                      {{ end }}
                    </div>

                    <div class="flex flex-wrap gap-2">
                      <span class="mt-chip">{{ if .Format }}{{ .Format }}{{ else }}Commander{{ end }}</span>
                      <span class="mt-chip">
                        {{ if .CommanderName }}Commander: {{ .CommanderName }}{{ else }}No commander{{ end }}
                      </span>
                      <span class="mt-chip">{{ if .IsPublic }}Public{{ else }}Private{{ end }}</span>
                      {{ if .PowerBracket }}
                        <span class="mt-chip">Power: {{ .PowerBracket }}</span>
                      {{ end }}
                    </div>
                  </div>
                </div>

                <div class="flex flex-wrap gap-2 md:justify-end">
                  <a href="/decks/{{ .ID }}" class="mt-btn mt-btn--primary mt-btn--sm">Open</a>
                  {{ if and .IsPublic .PublicSlug }}
                    <a href="/decks/public/{{ .PublicSlug }}" class="mt-btn mt-btn--secondary mt-btn--sm">Public</a>
                  {{ end }}
                </div>
              </div>
            </article>
          {{ end }}
        </div>
      {{ else }}
        <div class="text-center space-y-4 py-6">
          <p class="text-sm text-slate-400">No decks.</p>
          <div class="flex flex-wrap justify-center gap-2">
            <a href="/decks/new" class="mt-btn mt-btn--primary">Builder</a>
            <a href="/decks/public" class="mt-btn mt-btn--secondary">Public</a>
          </div>
        </div>
      {{ end }}
    </section>
  </main>

  {{ template "layout_footer" . }}
{{ end }}
