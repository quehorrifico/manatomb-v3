{{ define "decks_list" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <div class="mt-account-page mt-deck-library">
    <header class="mt-deck-library__header">
      <div>
        <h1>My Decks</h1>
        <p>{{ if $ctx }}{{ len $ctx }} saved deck{{ if ne (len $ctx) 1 }}s{{ end }}{{ else }}0 saved decks{{ end }}</p>
      </div>
      <a href="/decks/new" class="mt-btn mt-btn--primary mt-deck-library__new">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        Build New Deck
      </a>
    </header>

    {{ if $ctx }}
      <section class="mt-deck-library__grid" aria-label="Saved decks">
        {{ range $ctx }}
          <article class="mt-deck-library-card">
            <a href="/decks/{{ .ID }}" class="mt-deck-library-card__link" aria-label="Open {{ .Name }}"></a>
            <div class="mt-deck-library-card__media">
              {{ if .CommanderImageURI }}
                <img src="{{ .CommanderImageURI }}" alt="" loading="lazy">
              {{ else }}
                <span aria-hidden="true">{{ if .CommanderName }}Commander{{ else }}Deck{{ end }}</span>
              {{ end }}
            </div>

            <div class="mt-deck-library-card__body">
              <div class="mt-deck-library-card__title-row">
                <h2>{{ .Name }}</h2>
                <span class="mt-deck-library-card__visibility">{{ if .IsPublic }}Public{{ else }}Private{{ end }}</span>
              </div>

              {{ if .Description }}
                <p class="mt-deck-library-card__description">{{ .Description }}</p>
              {{ end }}

              <div class="mt-deck-library-card__commander">
                <span>Commander</span>
                <strong>{{ if .CommanderName }}{{ .CommanderName }}{{ else }}None selected{{ end }}</strong>
              </div>

              <div class="mt-deck-library-card__footer">
                <div class="mt-deck-library-card__meta">
                  <span>{{ if .Format }}{{ .Format }}{{ else }}Commander{{ end }}</span>
                  {{ if .PowerBracket }}<span>{{ .PowerBracket }}</span>{{ end }}
                </div>
                {{ if and .IsPublic .PublicSlug }}
                  <a href="/decks/public/{{ .PublicSlug }}" class="mt-deck-library-card__public">View public page</a>
                {{ end }}
              </div>
            </div>
          </article>
        {{ end }}
      </section>
    {{ else }}
      <section class="mt-deck-library__empty" aria-labelledby="empty-deck-library-title">
        <h2 id="empty-deck-library-title">No decks yet</h2>
        <p>Start a new deck or browse public lists for inspiration.</p>
        <div>
          <a href="/decks/new" class="mt-btn mt-btn--primary">Build a Deck</a>
          <a href="/decks/public" class="mt-btn mt-btn--secondary">Browse Public Decks</a>
        </div>
      </section>
    {{ end }}
  </div>

  {{ template "layout_footer" . }}
{{ end }}
