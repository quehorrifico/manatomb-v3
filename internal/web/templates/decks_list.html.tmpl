{{ define "decks_list" }}
  {{ template "layout_header" . }}
  {{ $ctx := .Data }}

  <div class="mt-account-page mt-deck-library">
    <header class="mt-deck-library__header">
      <div>
        <h1>My Decks</h1>
        <p>{{ if $ctx }}{{ len $ctx }} saved deck{{ if ne (len $ctx) 1 }}s{{ end }}{{ else }}0 saved decks{{ end }}</p>
      </div>
      <a href="/decks/new" class="mt-btn mt-btn--primary mt-deck-library__new">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        Build New Deck
      </a>
    </header>

    {{ if $ctx }}
      <section class="mt-deck-library__grid" aria-label="Saved decks">
        {{ range $ctx }}
          {{ template "deck_tile" . }}
        {{ end }}
      </section>
    {{ else }}
      <section class="mt-deck-library__empty" aria-labelledby="empty-deck-library-title">
        <h2 id="empty-deck-library-title">No decks yet</h2>
        <p>Start a new deck or browse public lists for inspiration.</p>
        <div>
          <a href="/decks/new" class="mt-btn mt-btn--primary">Build a Deck</a>
          <a href="/decks/public" class="mt-btn mt-btn--secondary">Browse Public Decks</a>
        </div>
      </section>
    {{ end }}
  </div>

  {{ template "layout_footer" . }}
{{ end }}
